{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "APMATH_QUESTION_QUALITY_CLOSURE_SET_v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "revision",
    "currentRunInputSha",
    "questionUids",
    "questionUidSetSha",
    "closureSetSha",
    "closures",
    "productionAuthorized",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "APMATH_QUESTION_QUALITY_CLOSURE_SET_v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "currentRunInputSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "questionUids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "questionUidSetSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "closureSetSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "closures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "APMATH_QUESTION_QUALITY_CLOSURE_v2",
        "type": "object",
        "required": [
          "schemaVersion",
          "questionUid",
          "currentRunInputSha",
          "requiredAxes",
          "axes",
          "closureSha",
          "productionAuthorized",
          "status"
        ],
        "properties": {
          "schemaVersion": {
            "const": "APMATH_QUESTION_QUALITY_CLOSURE_v2"
          },
          "questionUid": {
            "type": "string",
            "minLength": 1
          },
          "currentRunInputSha": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "requiredAxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "SOURCE",
                "MATH_A1",
                "MATH_A2",
                "SOLUTION",
                "METADATA",
                "STATIC",
                "V1",
                "V2",
                "V3",
                "RENDER_CAPTURE",
                "RENDER_REVIEW"
              ]
            },
            "uniqueItems": true
          },
          "axes": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "questionUid",
                "axis",
                "mode",
                "evidenceId",
                "evidenceSha",
                "receiptSha",
                "axisInputSha",
                "status"
              ],
              "properties": {
                "questionUid": {
                  "type": "string",
                  "minLength": 1
                },
                "axis": {
                  "enum": [
                    "SOURCE",
                    "MATH_A1",
                    "MATH_A2",
                    "SOLUTION",
                    "METADATA",
                    "STATIC",
                    "V1",
                    "V2",
                    "V3",
                    "RENDER_CAPTURE",
                    "RENDER_REVIEW"
                  ]
                },
                "mode": {
                  "enum": [
                    "FRESH",
                "MACHINE_CURRENT",
                    "REUSED"
                  ]
                },
                "evidenceId": {
                  "type": "string",
                  "minLength": 1
                },
                "evidenceSha": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "receiptSha": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "axisInputSha": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "status": {
                  "enum": [
                    "PASS",
                    "BLOCKED"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "closureSha": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "productionAuthorized": {
            "const": false
          },
          "status": {
            "enum": [
              "PASS",
              "BLOCKED"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "productionAuthorized": {
      "const": false
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    }
  },
  "additionalProperties": true
}
