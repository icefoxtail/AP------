{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "APMATH_PIPELINE_RUN_v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "pipeline",
    "runId",
    "revision",
    "builderId",
    "builderSessionId",
    "builderModelOrAgent",
    "inputSha",
    "inputs",
    "evidence",
    "questions",
    "sourceAuthority",
    "uidAuthority",
    "semanticDependencyBindings",
    "auditorPacketRefs",
    "buildWorkLedgerRefs",
    "questionQualityClosureSetRef",
    "examReleaseClosureRef",
    "workBatchId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "APMATH_PIPELINE_RUN_v2"
    },
    "pipeline": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "builderId": {
      "type": "string",
      "minLength": 1
    },
    "builderSessionId": {
      "type": "string",
      "minLength": 1
    },
    "builderModelOrAgent": {
      "type": "string",
      "minLength": 1
    },
    "inputSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "questionUid",
          "sourceExamId",
          "sourceQuestionOrdinal",
          "sourcePath",
          "candidatePath",
          "qid",
          "requiredAxes",
          "axisInputShas",
          "evidence"
        ],
        "properties": {
          "questionUid": {
            "type": "string",
            "minLength": 1
          },
          "slotUid": {
            "type": "string",
            "minLength": 1
          },
          "effectiveArtifactUid": {
            "type": "string",
            "minLength": 1
          },
          "sourceExamId": {
            "type": "string",
            "minLength": 1
          },
          "sourceQuestionOrdinal": {
            "type": "integer",
            "minimum": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "candidatePath": {
            "type": "string",
            "minLength": 1
          },
          "qid": {
            "type": "integer",
            "minimum": 1
          },
          "requiredAxes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "SOURCE",
                "MATH_A1",
                "MATH_A2",
                "SOLUTION",
                "METADATA",
                "STATIC",
                "V1",
                "V2",
                "V3",
                "RENDER_CAPTURE",
                "RENDER_REVIEW"
              ]
            },
            "uniqueItems": true
          },
          "axisInputShas": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "sourceAuthority": {
      "type": "object",
      "required": [
        "sourceTruthRefs",
        "sourceTruthBundleSha",
        "activeBaselineRef",
        "activeBaselineSha",
        "applicability"
      ],
      "properties": {
        "sourceTruthRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "sourceTruthBundleSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "activeBaselineRef": {
          "type": "object",
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        "activeBaselineSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "applicability": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "uidAuthority": {
      "type": "object",
      "required": [
        "sourceExamIdRegistryRef",
        "sourceExamIdRegistryEntrySha",
        "uidMigrationEvidenceRefs",
        "uidMigrationEvidenceSetSha"
      ],
      "properties": {
        "sourceExamIdRegistryRef": {
          "type": "object",
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        "sourceExamIdRegistryEntrySha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "uidMigrationEvidenceRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "uidMigrationEvidenceSetSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "semanticDependencyBindings": {
      "type": "object"
    },
    "auditorPacketRefs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "buildWorkLedgerRefs": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "path",
          "bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    },
    "questionQualityClosureSetRef": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "examReleaseClosureRef": {
      "type": "object",
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": true
    },
    "predecessor": {
      "type": "object",
      "required": [
        "runId",
        "revision",
        "inputSha",
        "closureSetSha",
        "candidateRefs",
        "runRef",
        "closureSetRef"
      ],
      "properties": {
        "runId": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "inputSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "closureSetSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "candidateRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "runRef": {
          "type": "object",
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        },
        "closureSetRef": {
          "type": "object",
          "required": [
            "path",
            "bytes",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            },
            "sha256": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "workBatchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "sourceRecoveryLedger": {
      "type": "object",
      "required": ["schemaVersion", "initialIncludedScopeUidSet", "initialIncludedScopeUidSetSha256", "items"],
      "properties": {
        "schemaVersion": { "const": "ALIVE_SOURCE_RECOVERY_LEDGER_v1" },
        "initialIncludedScopeUidSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "initialIncludedScopeUidSetSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "items": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": true
    },
    "sourceRecoverySignal": {
      "type": "boolean"
    },
    "sourceRecoveryStatus": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
