{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SOURCE_EXAM_ID_REGISTRY_v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "SOURCE_EXAM_ID_REGISTRY_v1"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "canonicalSourceExamId",
          "sourceExamId",
          "sourceIdentityKey",
          "status",
          "sourceQuestionOrdinal",
          "questionUidV2",
          "sourcePath",
          "sourceSha256"
        ],
        "properties": {
          "canonicalSourceExamId": {
            "type": "string",
            "minLength": 1
          },
          "sourceExamId": {
            "type": "string",
            "minLength": 1
          },
          "sourceIdentityKey": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RETIRED"
            ]
          },
          "sourceQuestionOrdinal": {
            "type": "integer",
            "minimum": 1
          },
          "questionUidV2": {
            "type": "string",
            "minLength": 1
          },
          "sourcePath": {
            "type": "string",
            "minLength": 1
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
