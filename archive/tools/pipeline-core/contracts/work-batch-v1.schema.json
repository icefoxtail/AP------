{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "APMATH_WORK_BATCH_v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "workBatchId",
    "runIds",
    "builderId",
    "builderSessionId",
    "policy",
    "status",
    "freezes",
    "launches"
  ],
  "properties": {
    "schemaVersion": {
      "const": "APMATH_WORK_BATCH_v1"
    },
    "workBatchId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "runIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "builderId": {
      "type": "string",
      "minLength": 1
    },
    "builderSessionId": {
      "type": "string",
      "minLength": 1
    },
    "jobKind": {
      "enum": ["PRODUCTION", "GOLD", "PILOT", "BENCHMARK", "HOLDOUT", "DIAGNOSTIC"]
    },
    "executionIdentity": {
      "type": "object",
      "required": ["schemaVersion", "jobKind", "requestedModel", "requestedReasoningEffort", "actualModel", "actualReasoningEffort", "modelRouteObservedAtStart", "modelRouteObservedAtClosure", "modelRouteChanged", "routeStatus", "MODEL_ROUTE_PARITY"],
      "properties": {
        "schemaVersion": {"const": "APMATH_GOLD_EXECUTION_CONTRACT_v1"},
        "jobKind": {"type": "string"},
        "requestedModel": {"type": ["string", "null"]},
        "requestedReasoningEffort": {"type": ["string", "null"]},
        "actualModel": {"type": ["string", "null"]},
        "actualReasoningEffort": {"type": ["string", "null"]},
        "modelRouteObservedAtStart": {"type": ["string", "null"]},
        "modelRouteObservedAtClosure": {"type": ["string", "null"]},
        "modelRouteChanged": {"type": "boolean"},
        "routeStatus": {"type": "string"},
        "MODEL_ROUTE_PARITY": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE"]}
      },
      "additionalProperties": true
    },
    "jobAuthority": {
      "type": ["object", "null"]
    },
    "workflowProfile": {
      "enum": ["LEGACY", "PAST_EXAM"]
    },
    "tokenBudget": {},
    "status": {
      "enum": [
        "PRODUCTION",
        "FROZEN",
        "REPAIR_REQUIRED",
        "HOLD"
      ]
    },
    "openDefectSet": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/targetIdentity"
      }
    },
    "openDefects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["runId", "questionUid"],
        "properties": {
          "runId": {"type": "string", "minLength": 1},
          "questionUid": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "repairIterations": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["iteration", "status", "openDefectSet"],
        "properties": {
          "iteration": {"type": "integer", "minimum": 1, "maximum": 3},
          "status": {"enum": ["REPAIR_REQUIRED", "REPAIR_RECORDED", "FROZEN_FOR_RECHECK", "CLOSED", "HOLD"]},
          "openDefectSet": {"type": "array", "items": {"$ref": "#/$defs/targetIdentity"}},
          "recheckScope": {"type": "array", "items": {"$ref": "#/$defs/targetIdentity"}},
          "triggerLaunchId": {"type": "string"},
          "freezeSha": {"type": "string"},
          "inputSha": {"type": "string"},
          "auditInputSha": {"type": "string"},
          "repairInputSha": {"type": "string"},
          "revision": {"type": "integer", "minimum": 1},
          "dispositions": {"type": "array"},
          "defects": {"type": "array"},
          "repairRef": {},
          "openedAt": {"type": "string"},
          "recordedAt": {"type": "string"},
          "closedAt": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object"
    },
    "freezes": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "freezeSha",
          "frozenAt",
          "targets",
          "affected",
          "bindings",
          "runRefs"
        ],
        "properties": {
          "benchmarkDenominator": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "status",
                  "totalTargetCount",
                  "eligibleTargetCount",
                  "excludedTargetCount",
                  "eligibleTargets",
                  "excludedTargets",
                  "excludedRuns"
                ],
                "properties": {
                  "status": {"const": "FROZEN"},
                  "totalTargetCount": {"type": "integer", "minimum": 0},
                  "eligibleTargetCount": {"type": "integer", "minimum": 0},
                  "excludedTargetCount": {"type": "integer", "minimum": 0},
                  "eligibleTargets": {"type": "array", "items": {"$ref": "#/$defs/targetIdentity"}},
                  "excludedTargets": {"type": "array", "items": {"$ref": "#/$defs/targetIdentity"}},
                  "excludedRuns": {"type": "array", "items": {"$ref": "#/$defs/excludedRun"}}
                },
                "additionalProperties": true
              },
              {
                "type": "object",
                "required": ["status", "eligibleTargetCount", "excludedRuns"],
                "properties": {
                  "status": {"const": "NOT_APPLICABLE"},
                  "eligibleTargetCount": {"type": "integer", "minimum": 0},
                  "excludedRuns": {"type": "array", "items": {"$ref": "#/$defs/excludedRun"}}
                },
                "additionalProperties": true
              }
            ]
          }
        }
      }
    },
    "launches": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "launchId",
          "purpose",
          "freezeSha",
          "scope",
          "auditorId",
          "auditorSessionId",
          "parentLaunchId",
          "recursiveSubagentLaunchCount",
          "status",
          "reservedAt",
          "contexts",
          "contextIsolation",
          "subagentToolsEnabled"
        ],
        "properties": {
          "purpose": {
            "enum": [
              "FINAL_AUDIT",
              "TARGETED_RECHECK",
              "SECOND_AUDIT"
            ]
          },
          "parentLaunchId": {
            "type": "null"
          },
          "recursiveSubagentLaunchCount": {
            "const": 0
          },
          "subagentToolsEnabled": {
            "const": false
          },
          "contextIsolation": {
            "const": "STATELESS_INPUTS"
          },
          "maxTokens": {},
          "inputSha": {"type": "string"},
          "repairIteration": {"type": "integer", "minimum": 0, "maximum": 3},
          "status": {
            "enum": [
              "RESERVED",
              "DISPATCHED",
              "COMPLETED",
              "FAILED"
            ]
          }
        }
      }
    },
    "lastHold": {
      "type": "object",
      "required": [
        "at",
        "code"
      ],
      "properties": {
        "at": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "targetIdentity": {
      "type": "object",
      "required": ["runId", "questionUid"],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "questionUid": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "excludedRun": {
      "type": "object",
      "required": ["runId", "status"],
      "properties": {
        "runId": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
