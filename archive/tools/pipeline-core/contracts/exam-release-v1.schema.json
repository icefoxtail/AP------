{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "APMATH_EXAM_RELEASE_CLOSURE_v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "revision",
    "applicability",
    "currentRunInputSha",
    "productionAuthorized",
    "status",
    "closureSha"
  ],
  "properties": {
    "schemaVersion": {
      "const": "APMATH_EXAM_RELEASE_CLOSURE_v1"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "applicability": {
      "enum": [
        "REQUIRED",
        "NOT_APPLICABLE"
      ]
    },
    "currentRunInputSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "productionAuthorized": {
      "const": false
    },
    "status": {
      "enum": [
        "PASS",
        "BLOCKED"
      ]
    },
    "closureSha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": true,
  "oneOf": [
    {
      "properties": {
        "applicability": {
          "const": "NOT_APPLICABLE"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "reason"
      ]
    },
    {
      "properties": {
        "applicability": {
          "const": "REQUIRED"
        },
        "cases": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "required": [
              "mode",
              "viewportProfile",
              "captureEvidenceId",
              "captureEvidenceSha",
              "reviewEvidenceId",
              "reviewEvidenceSha",
              "runtimeBundleSha",
              "runtimeResponseBundleSha",
              "candidateRef",
              "assetRefs",
              "itemWitnessesSha",
              "lastQuestionId"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "exam",
                  "solution",
                  "answer"
                ]
              },
              "viewportProfile": {
                "enum": [
                  "desktop",
                  "mobile"
                ]
              },
              "captureEvidenceId": {
                "type": "string",
                "minLength": 1
              },
              "captureEvidenceSha": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "reviewEvidenceId": {
                "type": "string",
                "minLength": 1
              },
              "reviewEvidenceSha": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "runtimeBundleSha": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "runtimeResponseBundleSha": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "candidateRef": {
                "type": "object",
                "required": [
                  "path",
                  "bytes",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "bytes": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": true
              },
              "assetRefs": {
                "type": "array",
                "minItems": 0,
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "bytes",
                    "sha256"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": true
                }
              },
              "itemWitnessesSha": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "lastQuestionId": {
                "type": "integer",
                "minimum": 1
              }
            },
            "additionalProperties": true
          },
          "maxItems": 6
        },
        "candidateRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "assetRefs": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "required": [
              "path",
              "bytes",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "sha256": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            },
            "additionalProperties": true
          }
        },
        "runtimeBundleSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "qualityClosureSetSha": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "lastQuestion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "cases",
        "candidateRefs",
        "assetRefs",
        "runtimeBundleSha",
        "qualityClosureSetSha",
        "lastQuestion"
      ]
    }
  ]
}
