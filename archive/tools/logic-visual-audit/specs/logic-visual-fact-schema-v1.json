{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AP Math Logic Visual Fact v1",
  "type": "object",
  "required": ["factSchemaVersion", "questionUid", "unit", "visualType", "visualRole", "requiredLabels", "decisiveStepIds"],
  "properties": {
    "factSchemaVersion": { "const": "LOGIC_VISUAL_FACT_v1" },
    "questionUid": { "type": "string", "minLength": 1 },
    "unit": { "enum": ["집합", "명제"] },
    "visualType": { "type": "string", "enum": ["SET_REGION_VENN_2", "SET_REGION_VENN_3", "SET_INCLUSION_VENN", "SET_NUMBER_LINE", "SET_CARDINALITY_VENN", "SET_FORCE_FORBID_FREE", "SET_CASE_PARTITION", "SET_GRAPH_DEFINED", "SET_LATTICE_POINT_COUNT", "TRUTH_SET_VENN", "TRUTH_SET_NUMBER_LINE", "IMPLICATION_FLOW", "CONTRAPOSITIVE_MAP", "QUANTIFIER_NEGATION_MAP", "COUNTEREXAMPLE_CARD", "PROOF_FLOW", "TRUTH_TABLE", "CASE_TABLE", "NONE"] },
    "visualRole": { "type": "string" },
    "requiredLabels": { "type": "array", "items": { "type": "string" } },
    "decisiveStepIds": { "type": "array", "items": { "type": "string" } },
    "universe": { "type": ["object", "null"] },
    "expectedRegions": { "type": "array", "items": { "type": "string" } },
    "boundaryIdentity": { "type": ["object", "null"] },
    "forcedElements": { "type": "array", "items": { "type": ["string", "number"] } },
    "forbiddenElements": { "type": "array", "items": { "type": ["string", "number"] } },
    "freeElements": { "type": "array", "items": { "type": ["string", "number"] } },
    "freeCount": { "type": ["integer", "null"], "minimum": 0 },
    "countingResult": { "type": ["string", "number", "null"] },
    "intervalComponents": { "type": "array" },
    "implicationDirection": { "type": ["string", "null"] },
    "truthSetRelation": { "type": ["string", "null"] },
    "necessarySufficientRole": { "type": ["string", "null"] },
    "originalQuantifier": { "type": ["string", "null"] },
    "originalDomain": { "type": ["string", "null"] },
    "originalPredicate": { "type": ["string", "null"] },
    "negatedQuantifier": { "type": ["string", "null"] },
    "negatedDomain": { "type": ["string", "null"] },
    "negatedPredicate": { "type": ["string", "null"] },
    "proofSteps": { "type": "array" },
    "proofEdges": { "type": "array" },
    "contradictionTarget": { "type": ["string", "null"] },
    "finalConclusion": { "type": ["string", "null"] },
    "caseRows": { "type": "array" },
    "latticePointFamilies": { "type": "array" },
    "domainDescription": { "type": ["string", "null"] },
    "truthVector": { "type": "array" }
  },
  "additionalProperties": true
}
