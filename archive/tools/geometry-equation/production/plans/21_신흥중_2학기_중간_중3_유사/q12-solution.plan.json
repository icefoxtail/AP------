  "sourceConditions": [
    {
      "id": "problem",
      "condition": "다음 그림과 같이 폭이 $6\\text{ cm}$인 종이테이프를 선분 $\\text{AC}$를 접는 선으로 하여 접었다. $\\angle\\text{ABC}=45^\\circ$일 때, $\\triangle\\text{ABC}$의 넓이는?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "접은 각과 평행선의 엇각 성질에 의해 $\\angle\\text{BAC}=\\angle\\text{ACB}$이므로 $\\triangle\\text{ABC}$는 $\\overline{\\text{AB}}=\\overline{\\text{BC}}$인 이등변삼각형이다. 점 $\\text{A}$에서 변 $\\text{BC}$에 내린 수선의 발을 $\\text{H}$라 하면 $\\overline{\\text{AH}}=6\\text{ cm}$이고 $\\angle\\text{ABH}=45^\\circ$이므로 $$\\overline{\\text{AB}} = \\frac{6}{\\sin 45^\\circ} = 6\\sqrt{2}\\text{ (cm)} \\implies \\overline{\\text{BC}} = 6\\sqrt{2}\\text{ (cm)}$$ 따라서 $\\triangle\\text{ABC}$의 넓이는 $$\\frac{1}{2} \\times 6\\sqrt{2} \\times 6 = 18\\sqrt{2}\\text{ (cm}^2\\text{)}$$ 따라서 정답은 ④이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
}
