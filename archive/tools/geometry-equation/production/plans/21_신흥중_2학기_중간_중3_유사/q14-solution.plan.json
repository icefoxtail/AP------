  "newVisualInformation": [
    "해설의 관계: 원 내 접선 길이가 아닌 중심에서 두 현으로 내린 수선의 동일 길이 3"
  ],
  "sourceConditions": [
    {
      "id": "problem",
      "condition": "다음 그림과 같은 원 $\\text{O}$ 위의 세 점 $\\text{A}$, $\\text{B}$, $\\text{C}$에 대하여 $\\overline{\\text{OM}} \\perp \\overline{\\text{AC}}$, $\\overline{\\text{ON}} \\perp \\overline{\\text{BC}}$이고 $\\overline{\\text{OM}}=3$, $\\overline{\\text{ON}}=3$, $\\angle\\text{BAC}=68^\\circ$일 때, $\\angle x = \\angle\\text{ACB}$의 크기는?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "$\\overline{\\text{OM}} \\perp \\overline{\\text{AC}}$, $\\overline{\\text{ON}} \\perp \\overline{\\text{BC}}$이고 $\\overline{\\text{OM}}=\\overline{\\text{ON}}=3$이므로 중심에서 같은 거리에 있는 두 현 $\\text{AC}$와 $\\text{BC}$의 길이가 같다. 즉 $\\triangle\\text{ABC}$는 $\\overline{\\text{AC}}=\\overline{\\text{BC}}$인 이등변삼각형이므로 $\\angle\\text{ABC}=\\angle\\text{BAC}=68^\\circ$이다. 따라서 $$\\angle x = 180^\\circ - 68^\\circ - 68^\\circ = 44^\\circ$$ 따라서 정답은 ③이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
}
