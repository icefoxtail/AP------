  "sourceConditions": [
    {
      "id": "problem",
      "condition": "다음 그림에서 $\\overline{\\text{PA}}$, $\\overline{\\text{PB}}$, $\\overline{\\text{CE}}$는 원 $\\text{O}$의 접선이고, 세 점 $\\text{A}$, $\\text{B}$, $\\text{D}$는 접점이다. $\\overline{\\text{AC}}=4$, $\\overline{\\text{CE}}=10$, $\\overline{\\text{PC}}=12$일 때, $\\overline{\\text{PE}}$의 길이는?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "점 $\\text{P}$에서 원 $\\text{O}$에 그은 두 접선의 길이가 같으므로 $\\overline{\\text{PB}} = \\overline{\\text{PA}} = \\overline{\\text{PC}} + \\overline{\\text{AC}} = 12 + 4 = 16$이다. 점 $\\text{C}$에서 그은 접선의 길이에서 $\\overline{\\text{CD}} = \\overline{\\text{AC}} = 4$이므로 $\\overline{\\text{DE}} = 10 - 4 = 6$이다. 점 $\\text{E}$에서 그은 접선의 길이에서 $\\overline{\\text{EB}} = \\overline{\\text{DE}} = 6$이므로 $$\\overline{\\text{PE}} = \\overline{\\text{PB}} - \\overline{\\text{EB}} = 16 - 6 = 10$$ 따라서 정답은 ③이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
}
