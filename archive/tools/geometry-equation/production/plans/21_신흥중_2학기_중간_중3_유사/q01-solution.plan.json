  "sourceConditions": [
    {
      "id": "problem",
      "condition": "다음 직각삼각형 $\\text{ABC}$에서 $\\angle\\text{B}=90^\\circ$, $\\overline{\\text{AB}}=12$, $\\overline{\\text{BC}}=5$, $\\overline{\\text{AC}}=13$일 때, $\\sin A + \\cos A$의 값은?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "직각삼각형 $\\text{ABC}$에서 $\\angle\\text{B}=90^\\circ$이므로 빗변은 $\\overline{\\text{AC}}=13$이다. $$\\sin A = \\frac{\\overline{\\text{BC}}}{\\overline{\\text{AC}}} = \\frac{5}{13}, \\quad \\cos A = \\frac{\\overline{\\text{AB}}}{\\overline{\\text{AC}}} = \\frac{12}{13}$$ 따라서 $$\\sin A + \\cos A = \\frac{5}{13} + \\frac{12}{13} = \\frac{17}{13}$$ 따라서 정답은 ②이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
}
