  "sourceConditions": [
    {
      "id": "source",
      "condition": "오른쪽 그림과 같은 $\\angle\\text{C}=90^\\circ$인 직각삼각형 $\\text{ABC}$에서 점 $\\text{D}$는 선분 $\\text{BC}$ 위에 있다. $\\overline{\\text{AB}}=8$, $\\overline{\\text{AD}}=5$, $\\overline{\\text{CD}}=3$일 때, $\\cos B$의 값을 구하여라.",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "직각삼각형 $\\text{ACD}$에서 $\\angle\\text{C}=90^\\circ$, $\\overline{\\text{AD}}=5$, $\\overline{\\text{CD}}=3$이므로 $$\\overline{\\text{AC}} = \\sqrt{5^2 - 3^2} = 4$$ 직각삼각형 $\\text{ABC}$에서 $\\overline{\\text{AB}}=8$, $\\overline{\\text{AC}}=4$이므로 $$\\overline{\\text{BC}} = \\sqrt{8^2 - 4^2} = \\sqrt{48} = 4\\sqrt{3}$$ 따라서 $$\\cos B = \\frac{\\overline{\\text{BC}}}{\\overline{\\text{AB}}} = \\frac{4\\sqrt{3}}{8} = \\frac{\\sqrt{3}}{2}$$",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
}
