  "sourceConditions": [
    {
      "id": "q20-solution-text",
      "condition": "$AB = \\sqrt{6^2+8^2} = 10,\\mathrm{cm}$이고, $\\triangle ABC$의 넓이는 $\\dfrac{1}{2}\\times 6\\times 8 = 24,\\mathrm{cm}^2$이다. 내접원의 반지름을 $r,\\mathrm{cm}$라 하면 $\\dfrac{1}{2}r(6+8+10) = 24 \\implies 12r = 24 \\implies r = 2,\\mathrm{cm}$이다. 정답은 ②이다.",
      "mappedTo": [
        "mathPlan",
        "displaySegments",
        "planeMarks"
      ]
    },
