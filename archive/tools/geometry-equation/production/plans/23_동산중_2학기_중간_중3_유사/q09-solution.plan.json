  "sourceConditions": [
    {
      "id": "q09-solution",
      "condition": "$\\triangle BDE \\sim \\triangle BAC$이므로 $x = \\angle A$이다. $AB = \\sqrt{8^2+4^2} = 4\\sqrt{5}$이므로 $\\sin x = \\dfrac{8}{4\\sqrt{5}} = \\dfrac{2\\sqrt{5}}{5}$, $\\tan x = \\dfrac{8}{4} = 2$이다. 따라서 $\\sin x \\tan x = \\dfrac{2\\sqrt{5}}{5}\\times 2 = \\dfrac{4\\sqrt{5}}{5}$이므로 정답은 ⑤이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ]
