  "sourceConditions": [
    {
      "id": "q08-solution",
      "condition": "$\\cos A = \\dfrac{AC}{6} = \\dfrac{2}{3}$이므로 $AC = 4,\\mathrm{cm}$이다. 피타고라스 정리에 의해 $BC = \\sqrt{6^2 - 4^2} = \\sqrt{20} = 2\\sqrt{5},\\mathrm{cm}$이다. 따라서 $\\tan A = \\dfrac{BC}{AC} = \\dfrac{2\\sqrt{5}}{4} = \\dfrac{\\sqrt{5}}{2}$이므로 정답은 ③이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ],
