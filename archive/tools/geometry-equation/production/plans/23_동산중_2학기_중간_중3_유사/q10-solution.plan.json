  "sourceConditions": [
    {
      "id": "q10-solution",
      "condition": "$x = \\angle B$, $y = \\angle A$이고 $AB = \\sqrt{5^2+10^2} = 5\\sqrt{5}$이다. $\\sin x = \\dfrac{5}{5\\sqrt{5}} = \\dfrac{\\sqrt{5}}{5}$, $\\sin y = \\dfrac{10}{5\\sqrt{5}} = \\dfrac{2\\sqrt{5}}{5}$이므로 $$ \\sin x + \\sin y = \\dfrac{3\\sqrt{5}}{5} $$ 따라서 정답은 ①이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ]
