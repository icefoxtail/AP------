{
  "capability": "multi-curve-figure-v1",
  "graphPlan": {
    "family": "multi-curve",
    "viewport": [-8, 6, -2, 7],
    "curves": [
      {
        "id": "linear",
        "kind": "LINE",
        "coefficients": ["7", "1"],
        "domain": {"from": "-8", "to": "-2", "fromState": "NONE", "toState": "OPEN"},
        "color": "BLUE",
        "label": "y=x+7"
      },
      {
        "id": "decline",
        "kind": "EXPONENTIAL",
        "base": "2",
        "coefficients": ["1", "-1", "-4"],
        "shiftX": "1",
        "domain": {"from": "-2", "to": "-1", "fromState": "CLOSED", "toState": "CLOSED"},
        "color": "WARM",
        "hideLabel": true
      },
      {
        "id": "rise",
        "kind": "EXPONENTIAL",
        "base": "2",
        "coefficients": ["-1", "-1", "4"],
        "shiftX": "1",
        "domain": {"from": "-1", "to": "6", "fromState": "NONE", "toState": "NONE"},
        "color": "WARM",
        "hideLabel": true
      }
    ],
    "axisTickValues": {"x": ["-2", "-1"], "y": ["4", "5"]},
    "overlays": {
      "points": [
        {"id": "L", "x": "-2", "y": "5", "marker": "OPEN", "coordinates": true},
        {"id": "K", "x": "-2", "y": "4", "marker": "FILLED", "coordinates": true},
        {"id": "V", "x": "-1", "y": "0", "coordinates": true}
      ],
      "lines": [
        {"id": "asym", "slope": "0", "intercept": "4", "style": "DASHED", "label": "y=4"}
      ]
    }
  },
  "caption": "x<-2는 y=x+7이고 (-2,5)는 열린 점이다. -2≤x≤-1에서는 2^(1-x)-4가 4에서 0으로 감소하며, x≥-1에서는 4-2^(1-x)가 0에서 4로 증가한다. x=-2에서는 (-2,4)가 닫혀 있고 오른쪽 가지는 y=4에 아래에서 접근한다.",
  "accessibilityDescription": "왼쪽의 직선 y=x+7이 (-2,5)에서 열린 점으로 끝난다. (-2,4) 닫힌 점에서 지수곡선이 (-1,0)으로 내려간 뒤 우상향하여 y=4 점근선에 접근한다. x=-2의 두 점이 서로 다른 높이에 있는 불연속 그래프이다.",
  "sourceQuote": "f(x)=\\begin{cases}x+7&(x<-2)\\\\|2^{1-x}-4|&(x\\ge-2)\\end{cases}",
  "sourceConditions": [
    {"id": "c1", "condition": "x<-2에서 f=x+7이며 x=-2 미포함, 왼쪽 극한 5", "mappedTo": ["graphPlan.curves[0].domain.toState", "graphPlan.overlays.points[0]"]},
    {"id": "c2", "condition": "-2≤x≤-1에서 f=2^(1-x)-4, (-2,4) 포함", "mappedTo": ["graphPlan.curves[1]", "graphPlan.overlays.points[1]"]},
    {"id": "c3", "condition": "x≥-1에서 f=4-2^(1-x), (-1,0)을 지난 뒤 y=4에 접근", "mappedTo": ["graphPlan.curves[2]", "graphPlan.overlays.points[2]", "graphPlan.overlays.lines[0]"]}
  ],
  "newVisualInformation": ["불연속인 x=-2의 서로 다른 열린/닫힌 끝점, 절댓값에 의한 x=-1의 꺾임, y=4 수평점근선을 모두 실제 곡선과 표식으로 나타낸다."]
}
