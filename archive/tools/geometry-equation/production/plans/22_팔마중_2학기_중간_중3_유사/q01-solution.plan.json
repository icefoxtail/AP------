  ],
  "sourceConditions": [
    {
      "id": "source",
      "condition": "오른쪽 직각삼각형 $\\text{ABC}$에서 $\\angle\\text{C}=90^\\circ$, $\\overline{\\text{AB}}=5$, $\\overline{\\text{BC}}=2$일 때, $\\cos A \\times \\tan B$의 값은?",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    },
    {
      "id": "solution",
      "condition": "직각삼각형 $\\text{ABC}$에서 $\\angle\\text{C}=90^\\circ$이므로 빗변은 $\\overline{\\text{AB}}=5$이다. $$\\begin{aligned} \\overline{\\text{AC}} &= \\sqrt{\\overline{\\text{AB}}^2 - \\overline{\\text{BC}}^2} \\ &= \\sqrt{5^2 - 2^2} = \\sqrt{21} \\end{aligned}$$ 따라서 $\\cos A = \\frac{\\overline{\\text{AC}}}{\\overline{\\text{AB}}} = \\frac{\\sqrt{21}}{5}$, $\\tan B = \\frac{\\overline{\\text{AC}}}{\\overline{\\text{BC}}} = \\frac{\\sqrt{21}}{2}$이므로 $$\\cos A \\times \\tan B = \\frac{\\sqrt{21}}{5} \\times \\frac{\\sqrt{21}}{2} = \\frac{21}{10}$$ 따라서 정답은 ③이다.",
      "mappedTo": "INDEPENDENT_SOLUTION_REVIEW"
    }
  ]
}
