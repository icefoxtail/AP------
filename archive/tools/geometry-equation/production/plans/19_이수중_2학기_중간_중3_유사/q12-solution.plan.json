  "sourceConditions": [
    {
      "id": "q12_solution",
      "condition": "$\\overline{\\text{BD}}=\\frac{b}{2}$이므로 $\\triangle\\text{ABD}$에서 $b^2 = h^2 + \\left(\\frac{b}{2}\\right)^2 = h^2 + \\frac{b^2}{4}$이다. 따라서 (가)는 $\\frac{b^2}{4}$이고, $h = \\sqrt{b^2 - \\frac{b^2}{4}} = \\sqrt{\\frac{3b^2}{4}} = \\frac{\\sqrt{3}}{2}b$이므로 (나)는 $\\frac{\\sqrt{3}}{2}b$이다. 정답은 ④이다.",
      "mappedTo": "mathPlan.nodes"
    }
  ],
  "sourceQuote": "$\\overline{\\text{BD}}=\\frac{b}{2}$이"
}
