  "sourceConditions": [
    {
      "id": "source",
      "condition": "다음 그림과 같이 학생이 나무로부터 $15\\text{ m}$ 떨어진 지점 $\\text{A}$에서 나무의 꼭대기 $\\text{B}$를 올려본 각의 크기가 $28^\\circ$이다. 이 학생의 눈높이가 $1.5\\text{ m}$일 때, 이 나무의 높이는? (단, $\\sin 28^\\circ = 0.470$, $\\cos 28^\\circ = 0.883$, $\\tan 28^\\circ = 0.532$로 계산한다.) (4점)",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
