  "sourceConditions": [
    {
      "id": "source",
      "condition": "【서술형 3】 그림과 같은 $\\triangle\\mathrm{ABC}$에서 $\\overline{\\mathrm{AB}} = \\sqrt{15}$, $\\overline{\\mathrm{BC}} = 4$, $\\angle B = 30^\\circ$일 때, $\\triangle\\mathrm{ABC}$의 넓이를 구하는 풀이 과정과 답을 쓰시오.",
      "mappedTo": "ORIGINAL_PROBLEM_REVIEW"
    },
    {
      "id": "solution",
      "condition": "점 $\\mathrm{A}$에서 $\\overline{\\mathrm{BC}}$에 내린 수선의 길이를 $h$라 하면 $h = \\sqrt{15}\\sin 30^\\circ = \\dfrac{\\sqrt{15}}{2}$이다. 따라서 $\\triangle\\mathrm{ABC}$의 넓이는 $$\\frac{1}{2} \\times 4 \\times \\frac{\\sqrt{15}}{2} = \\sqrt{15}$$",
      "mappedTo": "INDEPENDENT_SOLUTION_REVIEW"
    }
  ],
  "newVisualInformation": [
    "원문 해설에서 도출한 보조선과 기하 관계"
  ]
