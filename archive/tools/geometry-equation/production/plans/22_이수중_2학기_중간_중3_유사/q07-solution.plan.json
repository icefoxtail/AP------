  "sourceConditions": [
    {
      "id": "source",
      "condition": "그림과 같이 $\\angle C = 90^\\circ$인 직각삼각형 $\\mathrm{ABC}$에서 $\\overline{\\mathrm{AC}} = 6$, $\\angle A = 60^\\circ$, $\\overline{\\mathrm{BC}} = x$, $\\overline{\\mathrm{AB}} = y$일 때, $x + y$의 값은?",
      "mappedTo": "ORIGINAL_PROBLEM_REVIEW"
    },
    {
      "id": "solution",
      "condition": "$x = 6\\tan 60^\\circ = 6\\sqrt{3}$, $y = \\dfrac{6}{\\cos 60^\\circ} = 12$이므로 $$x + y = 12 + 6\\sqrt{3}$$ 정답은 ①이다.",
      "mappedTo": "INDEPENDENT_SOLUTION_REVIEW"
    }
  ],
