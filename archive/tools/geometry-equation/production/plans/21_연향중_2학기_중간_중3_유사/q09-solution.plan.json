  "sourceConditions": [
    {
      "id": "problem",
      "condition": "오른쪽 그림에서 원 $\\text{O}$는 $\\triangle\\text{ABC}$의 내접원이고 세 점 $\\text{D}$, $\\text{E}$, $\\text{F}$는 각각 변 $\\text{AB}$, $\\text{BC}$, $\\text{CA}$ 위의 접점이다. $\\overline{\\text{AC}}=14\\text{ cm}$, $\\overline{\\text{BC}}=12\\text{ cm}$, $\\overline{\\text{BD}}=7\\text{ cm}$일 때, $\\overline{\\text{AD}}$의 길이는?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "같은 점에서 원에 그은 두 접선의 길이는 같으므로 $\\overline{\\text{BE}}=\\overline{\\text{BD}}=7\\text{ cm}$이다. $\\overline{\\text{BC}}=12\\text{ cm}$이므로 $\\overline{\\text{CE}} = 12 - 7 = 5\\text{ (cm)}$이고, $\\overline{\\text{CF}}=\\overline{\\text{CE}}=5\\text{ cm}$이다. $\\overline{\\text{AC}}=14\\text{ cm}$이므로 $\\overline{\\text{AD}}=\\overline{\\text{AF}} = 14 - 5 = 9\\text{ (cm)}$이다. 정답은 ④이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
