      {
        "id": "t1",
        "at": "L1",
        "text": "ㄱ. A, B가 배반이면 P(A∪B)=1 (거짓, 반례 1/3)",
        "labelKind": "TEXT"
      },
      {
        "id": "t2",
        "at": "L2",
        "text": "ㄴ. 0≤P(A∪B)≤1 (참)",
        "labelKind": "TEXT"
      },
      {
        "id": "t3",
        "at": "L3",
        "text": "ㄷ. 독립이면 P(A의 여사건|B)=1-P(A|B) (참)",
        "labelKind": "TEXT"
      },
      {
        "id": "t4",
        "at": "L4",
        "text": "옳은 것: ㄴ, ㄷ → ④",
        "labelKind": "TEXT"
      }
    ]
