  "sourceConditions": [
    {
      "id": "q17-solution",
      "condition": "중심 $O$에서 현 $AB$까지의 거리는 반지름의 절반인 $4$이다. 현의 절반의 길이는 $\\sqrt{8^2 - 4^2} = 4\\sqrt{3}$이므로 $\\overline{AB} = 8\\sqrt{3}$이다. 정답은 ③이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
