  "sourceConditions": [
    {
      "id": "source",
      "condition": "직각삼각형 $\\text{ABC}$에서 $\\angle\\text{C}=90^\\circ$, $\\overline{\\text{BC}}=9$, $\\tan A = \\frac{3}{4}$일 때, $\\overline{\\text{AB}}$의 길이는?",
      "mappedTo": "CURRENT_EXAM_TEXT"
    },
    {
      "id": "solution",
      "condition": "$\\tan A = \\frac{\\overline{\\text{BC}}}{\\overline{\\text{AC}}} = \\frac{9}{\\overline{\\text{AC}}} = \\frac{3}{4}$이므로 $\\overline{\\text{AC}} = 12$이다. 피타고라스 정리에 의해 $$\\overline{\\text{AB}} = \\sqrt{12^2 + 9^2} = \\sqrt{225} = 15$$ 따라서 정답은 ②이다.",
      "mappedTo": "SOLUTION_AXIS"
    }
  ]
