  "sourceConditions": [
    {
      "id": "source",
      "condition": "아래 그림과 같이 $\\overline{\\text{AB}}=6$, $\\overline{\\text{BC}}=8$, $\\angle\\text{B}=150^\\circ$인 $\\triangle\\text{ABC}$의 넓이는?",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    },
    {
      "id": "solution",
      "condition": "$\\angle\\text{B}=150^\\circ$가 둔각이므로 $\\triangle\\text{ABC}$의 넓이는 $$\\frac{1}{2} \\times 6 \\times 8 \\times \\sin(180^\\circ - 150^\\circ) = \\frac{1}{2} \\times 6 \\times 8 \\times \\sin 30^\\circ = 24 \\times \\frac{1}{2} = 12$$ 따라서 정답은 ③이다.",
      "mappedTo": "INDEPENDENT_SOLUTION_REVIEW"
    }
  ]
