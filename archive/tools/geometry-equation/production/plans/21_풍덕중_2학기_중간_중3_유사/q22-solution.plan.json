    "dimensions 2개",
    "angles 3개"
  ],
  "sourceConditions": [
    {
      "id": "q22s",
      "condition": "$\\text{B}$, $\\text{D}$, $\\text{C}$가 이 순서로 한 직선 위에 있으므로 $\\angle\\text{ADB} = 180^\\circ - 30^\\circ = 150^\\circ$이다. $\\triangle\\text{ABD}$에서 $\\angle\\text{BAD} = 180^\\circ - 150^\\circ - 15^\\circ = 15^\\circ = \\angle\\text{ABD}$이므로 $\\triangle\\text{ABD}$는 이등변삼각형이고 $\\overline{\\text{AD}}=\\overline{\\text{BD}}=4\\text{ cm}$이다. 직각삼각형 $\\text{ACD}$에서 $$\\overline{\\text{AC}} = 4\\sin 30^\\circ = 4 \\times \\frac{1}{2} = 2\\text{ (cm)}, \\quad \\overline{\\text{DC}} = 4\\cos 30^\\circ = 4 \\times \\frac{\\sqrt{3}}{2} = 2\\sqrt{3}\\text{ (cm)}$$ 따라서 $\\overline{\\text{BC}} = \\overline{\\text{BD}} + \\overline{\\text{DC}} = 4 + 2\\sqrt{3}\\text{ (cm)}$이므로 $$\\tan 15^\\circ = \\frac{\\overline{\\text{AC}}}{\\overline{\\text{BC}}} = \\frac{2}{4 + 2\\sqrt{3}} = \\frac{1}{2 + \\sqrt{3}} = \\frac{2 - \\sqrt{3}}{(2+\\sqrt{3})(2-\\sqrt{3})} = 2 - \\sqrt{3}$$",
      "mappedTo": "mathPlan.nodes"
    }
  ],
  "sourceQuote": "다음 $\\angle\\text{C}=90^\\circ$인 직각삼각형"
}
