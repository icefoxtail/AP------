  "sourceConditions": [
    {
      "id": "q10_solution",
      "condition": "건물의 높이 $\\overline{\\text{AC}}=h\\text{ m}$라 하면 $\\angle\\text{ADC}=45^\\circ$이므로 $\\overline{\\text{DC}}=h$이고, $\\angle\\text{ABC}=30^\\circ$이므로 $\\overline{\\text{BC}}=\\sqrt{3}h$이다. $\\overline{\\text{BD}} = \\overline{\\text{BC}} - \\overline{\\text{DC}} = 20$이므로 $$(\\sqrt{3} - 1)h = 20 \\implies h = \\frac{20}{\\sqrt{3} - 1} = 10(\\sqrt{3} + 1)\\text{ (m)}$$ 따라서 정답은 ⑤이다.",
      "mappedTo": "mathPlan.nodes"
    }
  ],
  "sourceQuote": "건물의 높이 $\\overline{\\text{AC}}=h\\text{ m}$라 하면 $\\angle\\text{ADC}=45^\\circ$이므로"
