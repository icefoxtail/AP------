  "sourceConditions": [
    {
      "id": "q23-solution",
      "condition": "$OB=OC=8$이므로 $\\angle BCO = \\angle CBO = 15^\\circ$, 따라서 $\\angle BOC = 150^\\circ$이다. 부채꼴 $BOC$의 넓이는 $\\pi\\times 8^2\\times\\dfrac{150^\\circ}{360^\\circ} = \\dfrac{80\\pi}{3}$이다. $\\triangle BOC$의 넓이는 $\\dfrac{1}{2}\\times 8\\times 8\\sin(180^\\circ-150^\\circ) = 32\\times\\dfrac{1}{2} = 16$이다. 따라서 활꼴의 넓이는 $S = \\dfrac{80\\pi}{3} - 16$이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ]
