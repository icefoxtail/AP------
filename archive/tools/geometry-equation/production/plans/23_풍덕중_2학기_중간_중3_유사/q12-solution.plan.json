  "sourceConditions": [
    {
      "id": "q12-solution",
      "condition": "$AH=h$라 하면 $BH=3h$, $HC=\\dfrac{h}{3}$이므로 $3h+\\dfrac{h}{3}=20 \\implies \\dfrac{10h}{3}=20 \\implies h=6$이다. 따라서 $BH=18$, $HC=2$이고 $AB = \\sqrt{6^2+18^2} = 6\\sqrt{10}$, $AC = \\sqrt{6^2+2^2} = 2\\sqrt{10}$이다. 그러므로 $\\triangle ABC$의 둘레의 길이는 $20 + 6\\sqrt{10} + 2\\sqrt{10} = 20+8\\sqrt{10}$이다. 정답은 ⑤이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ]
}
