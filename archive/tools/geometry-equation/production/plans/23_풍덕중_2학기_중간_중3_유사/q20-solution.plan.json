  "sourceConditions": [
    {
      "id": "q20-solution",
      "condition": "$C$에서 직선 $AB$의 $A$ 쪽 연장선에 내린 수선의 발을 $H$라 하면 $\\angle CAH = 180^\\circ - a = 90^\\circ - (a-90^\\circ)$이므로 $\\tan\\angle CAH = \\dfrac{4}{3}$이다. $AC=10$이므로 $AH=6$, $CH=8$이고, $HB = 6+10 = 16$이므로 $BC = \\sqrt{16^2+8^2} = 8\\sqrt{5}$이다. $A$에서 $BC$에 내린 수선의 발을 $M$이라 하면 $BM = 4\\sqrt{5}$, $AM = \\sqrt{10^2-(4\\sqrt{5})^2} = 2\\sqrt{5}$이다. 따라서 $\\cos\\dfrac{a}{2} = \\dfrac{AM}{AB} = \\dfrac{2\\sqrt{5}}{10} = \\dfrac{\\sqrt{5}}{5}$이다. 정답은 ④이다.",
      "mappedTo": "ORIGINAL_QUESTION_OR_SOLUTION"
    }
  ]
}
