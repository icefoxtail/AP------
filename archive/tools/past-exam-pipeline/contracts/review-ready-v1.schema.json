{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "APMATH_REVIEW_READY_v1",
  "type": "object",
  "required": ["schemaVersion", "state", "status", "productionAuthorized", "examId", "reviewReadyRunId", "revision", "candidateRef", "candidateSha256", "assetRefs", "assetBindings", "stagedAssetSetSha256", "finalClosureRef", "finalClosureRefSha256", "finalClosureSha", "finalAuditClosureRef", "requiredRenderCases", "gateStatuses", "openDefectCount", "renderCases", "telemetry", "reviewReadySha"],
  "properties": {
    "schemaVersion": {"const": "APMATH_REVIEW_READY_v1"},
    "state": {"const": "REVIEW_READY"},
    "status": {"const": "REVIEW_READY"},
    "productionAuthorized": {"const": false},
    "examId": {"type": "string", "minLength": 1},
    "reviewReadyRunId": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "candidateRef": {"$ref": "#/$defs/fileRef"},
    "candidateSha256": {"$ref": "#/$defs/sha"},
    "assetRefs": {"type": "array", "items": {"$ref": "#/$defs/fileRef"}},
    "assetBindings": {"type": "array", "items": {"type": "object", "required": ["candidatePath", "assetRef"], "properties": {"candidatePath": {"type": "string", "minLength": 1}, "assetRef": {"$ref": "#/$defs/fileRef"}}, "additionalProperties": false}},
    "stagedAssetSetSha256": {"$ref": "#/$defs/sha"},
    "finalClosureRef": {"$ref": "#/$defs/fileRef"},
    "finalClosureRefSha256": {"$ref": "#/$defs/sha"},
    "finalClosureSha": {"$ref": "#/$defs/sha"},
    "finalAuditClosureRef": {"$ref": "#/$defs/fileRef"},
    "requiredRenderCases": {"const": ["exam/desktop", "exam/mobile", "solution/desktop", "solution/mobile", "answer/desktop", "answer/mobile"]},
    "gateStatuses": {"type": "object", "additionalProperties": {"const": "PASS"}},
    "openDefectCount": {"const": 0},
    "renderCases": {"type": "array", "minItems": 6},
    "telemetry": {"type": "object", "required": ["questionCount", "finalAuditInvocationCount", "targetedRecheckInvocationCount", "reviewedQuestionAxisCount", "reusedPassQuestionAxisCount", "repairIterationCount", "newSolutionVisualCount", "reusedVisualCount", "renderFreshCount", "renderReusedCount", "providerInvocationCount", "modelInvocationCount", "skipExistingExam"], "properties": {"totalElapsedMs": {"type": ["integer", "null"], "minimum": 0}, "questionCount": {"type": "integer", "minimum": 0}, "finalAuditInvocationCount": {"type": "integer", "minimum": 0}, "targetedRecheckInvocationCount": {"type": "integer", "minimum": 0}, "reviewedQuestionAxisCount": {"type": "integer", "minimum": 0}, "reusedPassQuestionAxisCount": {"type": "integer", "minimum": 0}, "repairIterationCount": {"type": "integer", "minimum": 0}, "newSolutionVisualCount": {"type": "integer", "minimum": 0}, "reusedVisualCount": {"type": "integer", "minimum": 0}, "renderFreshCount": {"type": "integer", "minimum": 0}, "renderReusedCount": {"type": "integer", "minimum": 0}, "providerInvocationCount": {"type": "integer", "minimum": 0}, "modelInvocationCount": {"type": "integer", "minimum": 0}, "skipExistingExam": {"type": "boolean"}}, "additionalProperties": true},
    "reviewReadySha": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fileRef": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha"}}, "additionalProperties": false}
  },
  "additionalProperties": true
}
