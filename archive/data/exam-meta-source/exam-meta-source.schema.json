{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "archive-exam-meta-source-v1",
  "title": "Archive exam metadata source",
  "type": "object",
  "required": [
    "schemaVersion",
    "sourceArchiveFile",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "archive-exam-meta-source-v1"
    },
    "sourceArchiveFile": {
      "type": "string",
      "minLength": 1
    },
    "reviewStatus": {
      "enum": [
        "APPROVED",
        "REVIEW_REQUIRED",
        "CANDIDATE_REQUIRED"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceOrdinal",
          "standardUnitKey",
          "subUnitKey",
          "difficultyBucket",
          "difficultyConfidence"
        ],
        "properties": {
          "sourceOrdinal": {
            "type": "integer",
            "minimum": 1
          },
          "sourceQuestionNo": {
            "type": [
              "string",
              "number"
            ]
          },
          "sourceFingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "standardUnitKey": {
            "type": "string",
            "minLength": 1
          },
          "subUnitKey": {
            "type": "string",
            "minLength": 1
          },
          "problemTypeKey": {
            "type": "string"
          },
          "templateKey": {
            "type": "string"
          },
          "difficultyBucket": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "difficultyConfidence": {
            "enum": [
              "high",
              "medium",
              "low"
            ]
          },
          "difficultyBoundaryFlag": {
            "enum": [
              "NONE",
              "B12",
              "B23",
              "B34",
              "B45"
            ]
          },
          "legacyLevelCompatibility": {
            "enum": [
              "NORMAL",
              "BORDERLINE_ACCEPTABLE",
              "STRONG_CONFLICT"
            ]
          },
          "crossConceptKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "conditionKeys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "integrationPattern": {
            "type": "string"
          },
          "reviewStatus": {
            "enum": [
              "APPROVED",
              "REVIEW_REQUIRED",
              "CANDIDATE_REQUIRED"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
