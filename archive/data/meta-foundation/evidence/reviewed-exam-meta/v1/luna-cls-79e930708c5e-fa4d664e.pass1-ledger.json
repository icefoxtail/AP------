 "sourceArchiveFile":"original/high/h2/1mid/21_매산고_1학기_중간_고2_수학II.js",
 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"x²−3x+8은 x=1에서 연속인 다항함수이므로 극한에 x=1을 직접 대입한다.","decisiveStep":"1−3+8=6이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"극한값 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"y=x³+2x+2의 도함수 3x²+2를 점 (1,5)의 x좌표 1에 대입해 접선 기울기를 구한다.","decisiveStep":"f′(1)=3·1²+2=5이므로 접선의 기울기는 5이다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"x²+2x+3의 꼭짓점 x=−1에서 최솟값 2를 구하고 닫힌구간 끝점 −1,3의 함숫값 2,18과 비교한다.","decisiveStep":"최댓값 a=18, 최솟값 b=2이므로 a+b=20이다.","standardUnitKey":"H15-M2-06","subUnitKey":"H15-M2-06-DERIVATIVE_APPLICATION","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"x=3에서 연속이려면 x²+a의 인수 x−3이 분자를 없애야 하므로 a=−9이고, 그때의 몫의 극한을 f(3)=b와 같게 둔다.","decisiveStep":"(x²−9)/(x−3)=x+3의 극한은 6이어서 b=6, |a+b|=3이다.","standardUnitKey":"H15-M2-02","subUnitKey":"H15-M2-02-CONTINUITY","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"x→∞에서 √(4x²+2x−2)/(x−3)의 분자와 분모를 x로 나누고 양의 x에서 최고차항의 계수비를 취한다.","decisiveStep":"√(4+2/x−2/x²)/(1−3/x)→2이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"f(x)=(x³+1)(2x−1)을 곱의 미분법으로 미분해 x=1의 도함수값을 계산한다.","decisiveStep":"f′(1)=3·1²·1+(1³+1)·2=7이다.","standardUnitKey":"H15-M2-04","subUnitKey":"H15-M2-04-DERIVATIVE","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"x=1에서 각 선택지의 좌우 극한과 함수값을 비교한 뒤, |x²−1|의 좌우 미분계수를 따로 계산한다.","decisiveStep":"|x²−1|은 x=1에서 연속이지만 왼쪽 기울기 −2와 오른쪽 기울기 2가 달라 미분가능하지 않다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"f(x)=x²−6x의 평균변화율을 [−1,4]에서 계산해 −3을 얻고, f′(a)=2a−6과 같게 놓는다.","decisiveStep":"2a−6=−3이므로 a=3/2이다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE_DEFINITION","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"평균변화율·순간변화율"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"x+1<f(x)<x+3을 2배하고 x²로 나누어 f(x)/x가 1로 수렴함을 좁힌 뒤 분자와 분모의 최고차 성장률을 비교한다.","decisiveStep":"2f(x)/x→2이므로 {2f(x)}²/(4x²+1)→1이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"x³+27=(x+3)(x²−3x+9)로 나누고 x+2→−1을 이용해 f(−1)=5와 f′(−1)=270을 먼저 정한다.","decisiveStep":"몫의 극한이 10이고 x²−3x+9→27이므로 f′(−1)=270, f′(−1)/f(−1)=54이다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE_DEFINITION","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":11,"questionUid":"","primaryMethod":"그래프에서 x=−1의 왼쪽·오른쪽 극한이 −1,1이고 f(−1)=0임을 읽어 세 후보 g의 g(−1)을 비교한다.","decisiveStep":"곱이 연속이려면 g(−1)=0이어야 하며 이를 만족하는 후보는 x³+3x²+2x=x(x+1)(x+2)뿐이다.","standardUnitKey":"H15-M2-02","subUnitKey":"H15-M2-02-CONTINUITY","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"구간별 함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":12,"questionUid":"","primaryMethod":"f가 미분가능하므로 [f(1+3h)−f(1−h)]/h의 극한은 4f′(1)이고, 목표 극한은 f′(1)에 x³의 변화율 3을 곱한 값이다.","decisiveStep":"4f′(1)=20에서 f′(1)=5이므로 목표값은 3·5=15이다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE_DEFINITION","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"그래프에서 f의 불연속점 0,1,2를 읽고 g와 fg의 연속 조건으로 각각 g(0)=g(1)=g(2)=0 및 x=1에서 두 식의 일치를 둔다.","decisiveStep":"b=0, a=1, d=c−1, 4−2c+d=0에서 c=3,d=2이므로 a+b+c+d=6이다.","standardUnitKey":"H15-M2-02","subUnitKey":"H15-M2-02-CONTINUITY","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"구간별 함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":14,"questionUid":"","primaryMethod":"f(2)=0, f′(2)=4와 꼭짓점 x=5/2를 이용해 이차함수 f(x)=−4(x−2)(x−3)을 정하고 합성함수의 변화율을 반영한다.","decisiveStep":"f′(3)=−4이고 2x−1이 3으로 가는 속도는 2이므로 극한은 2f′(3)=−8이다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE_DEFINITION","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":15,"questionUid":"","primaryMethod":"중심 (2,0), 반지름 r의 원과 y=[x]의 각 정수 높이 수평선분 교점을 세어 불연속 반지름을 찾는다.","decisiveStep":"두 번째와 네 번째 불연속점은 a₂=√2, a₄=√5이고 지정된 한쪽 극한은 각각 2와 1이라 합은 3이다.","standardUnitKey":"H15-M2-02","subUnitKey":"H15-M2-02-CONTINUITY","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속의 뜻","l4":"한 점에서의 연속"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":16,"questionUid":"","primaryMethod":"lim f=∞, lim g=α와 lim f=∞, lim g=−∞ 조건에서는 차와 몫의 극한 법칙을 적용하고, lim(f/g)=α와 lim g=0에서는 곱 fg의 극한을 따진다.","decisiveStep":"ㄱ은 두 극한이 같을 수 있어 거짓, ㄴ은 참, ㄷ은 비율을 정할 수 없어 거짓, ㄹ은 참이라 순서는 거짓·참·거짓·참이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":17,"questionUid":"","primaryMethod":"첫째 안쪽 식 (1−x)/(2+x)는 x→∞에서 −1의 오른쪽으로 가고, 둘째 √(−9x)/(√(2−x)+2)는 x→−∞에서 3의 왼쪽으로 가므로 그래프의 해당 한쪽 극한을 읽는다.","decisiveStep":"그래프에서 f(−1+)=1, f(3−)=−2라 두 극한의 합은 −1이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"좌극한·우극한"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":18,"questionUid":"","primaryMethod":"P=(0,t), O=(0,0), Q=(t+1,t)인 직각삼각형의 내접원 반지름 r을 빗변 √(t²+(t+1)²)과 두 직각변 t,t+1로 나타내 중심 좌표를 쓴다.","decisiveStep":"f(t)=r, g(t)=t−r이고 r/t→1−1/√2이므로 g(t)/f(t)→1+√2이다.","standardUnitKey":"H15-M2-01","subUnitKey":"H15-M2-01-LIMIT","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":19,"questionUid":"","primaryMethod":"x>0에서 f(x)=−x²+(12+2|t|)x−30의 꼭짓값을 구해 g(t)=t²+12|t|+6으로 나눈 뒤 h(t)=(t²−a)g(t)의 t=0 좌우미분을 맞춘다.","decisiveStep":"h의 |t| 항 계수는 −12a이므로 미분가능하려면 a=0이어야 한다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":20,"questionUid":"","primaryMethod":"성장률 조건에서 f(x)를 4차 단항식으로 시작하고 도함수 조건으로 x³ 계수 1을 정한 뒤 f(2)=0, f′(2)=19를 나머지 계수식으로 푼다.","decisiveStep":"f(x)=x⁴+x³−6x²−x+2가 f(0)=2, f(2)=0, f′(2)=19를 만족하며 각 극한 조건을 충족한다.","standardUnitKey":"H15-M2-03","subUnitKey":"H15-M2-03-DERIVATIVE","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
 ]
