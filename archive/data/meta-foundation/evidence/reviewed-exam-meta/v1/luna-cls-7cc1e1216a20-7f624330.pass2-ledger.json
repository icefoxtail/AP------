    {"ordinal":4,"questionUid":"","primaryMethod":"−7π/3, 11π/6, 9π/4를 삼각함수의 주기에 맞는 특수각으로 줄인다.","decisiveStep":"세 항은 각각 1/2, −1/2, 1이므로 합은 1이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"각 함수의 주기를 계수와 절댓값에 따라 구해 2π와 비교한다.","decisiveStep":"|sin(x/2)|의 주기는 2π이고 나머지 주기는 π 또는 4π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"기본 그래프","l4":"sin·cos"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"180°−x, 90°−x 여각과 tan의 여각 관계로 세 합과 곱을 짝짓는다.","decisiveStep":"각 묶음은 −1, 5, 1이어서 세 진술이 모두 참이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"sin(π/2+x)=cos x로 바꾸고 cos 2x=2cos²x−1을 넣어 인수분해한다.","decisiveStep":"cos x=1 또는 −1/2이며 0≤x<2π에서 해는 0, 2π/3, 4π/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"|sin x|>√3/2를 양·음 두 부등식으로 나눠 0≤x<2π에서 각 구간의 끝을 찾는다.","decisiveStep":"끝각은 π/3, 2π/3, 4π/3, 5π/3이므로 합은 4π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각방정식·부등식","l3":"그래프를 이용한 해","l4":"그래프를 이용한 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"AB=12의 맞은편 각 C를 180°−45°−75°로 구한 뒤 사인법칙을 쓴다.","decisiveStep":"sin C=sin60°이므로 12/sin60°=2R에서 R=4√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"외접원 반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":10,"questionUid":"","primaryMethod":"사인법칙으로 세 변을 3k, 5k, 7k라 두고 코사인법칙으로 가장 큰 각을 구한다.","decisiveStep":"cos C=−1/2이므로 sin C=√3/2이고 c=2·7·sin C=7√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":11,"questionUid":"","primaryMethod":"변 5, 6, 7에 코사인법칙을 적용해 두 변 사이 각의 코사인을 구한다.","decisiveStep":"cos C=1/5라서 sin C=2√6/5이고 넓이는 1/2·5·6·sin C=6√6이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"두 변과 끼인각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":12,"questionUid":"","primaryMethod":"제3사분면 각의 범위를 360° 주기로 나타내 θ/2의 범위를 짝수·홀수 주기로 나눈다.","decisiveStep":"주기 지수의 짝홀에 따라 θ/2는 제2 또는 제4사분면에 놓인다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"최댓값 5와 최솟값 −1에서 a와 c를 구하고 주기 4π에서 b를 구한다.","decisiveStep":"a=3, c=2, b=1/2이므로 abc=3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
