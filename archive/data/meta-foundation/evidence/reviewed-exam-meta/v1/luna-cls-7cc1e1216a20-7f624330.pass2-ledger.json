    {"ordinal":2,"questionUid":"","primaryMethod":"중심각 1.5와 넓이 12를 부채꼴 넓이 공식에 넣어 반지름과 호 길이를 구한다.","decisiveStep":"r=4, 호 길이=6이므로 둘레는 2·4+6=14이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
