  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"일차식 2x+2에서 x를 3으로 보내면 2×3+2를 계산한다.","decisiveStep":"2×3+2=8이므로 극한값은 8이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"극한값 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"f(x)=3x²+x를 미분해 f′(x)=6x+1을 만든 뒤 x=1에서 값을 구한다.","decisiveStep":"f′(1)=6+1=7로 미분계수를 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"분자와 분모를 x³으로 나누어 삼차식의 무한대 극한을 최고차항 계수로 줄인다.","decisiveStep":"나머지 항은 0으로 가고 계수 비 3/1이 남는다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"-x²+1과 x²-4x+3의 x=1에서의 극한을 양쪽에서 계산해 f의 극한을 고정한다.","decisiveStep":"두 경계식이 모두 0으로 가므로 사이의 f(x)도 0으로 간다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"경계 x=2에서 왼쪽 식의 값 6+a를 오른쪽 식의 값 8과 같게 둔다.","decisiveStep":"6+a=8을 풀어 a=2를 얻는다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"f(3-h)-f(3)의 증분이 -h임을 반영해 정의된 미분계수와 분모를 맞춘다.","decisiveStep":"주어진 극한은 -f′(3)/6이고 f′(3)=18이므로 -3이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"그래프에서 x가 1의 왼쪽으로 갈 때 f(x)와 f(x-1)의 접근값을 각각 읽어 곱한다.","decisiveStep":"두 접근값은 -1과 2이므로 곱의 극한은 -2이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"좌극한·우극한"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"그래프에서 a,c,d의 접선 기울기와 c에서 d까지의 평균변화율 부호를 차례로 비교한다.","decisiveStep":"ㄴ만 성립하므로 옳은 선택은 ㄴ이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"그래프에서 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"F(x)=x³-x²+9x+1의 도함수 부호로 유일한 근이 -1과 0 사이에 있음을 확인한다.","decisiveStep":"F(-1)<0<F(0)이므로 열린구간 (-2,0)에 근이 들어가 최솟값은 m=0이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속함수의 성질","l4":"사잇값 정리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"곱함수의 식이 바뀌는 x=1과 x=2에서 좌극한과 함수값을 비교한다.","decisiveStep":"두 경계 모두 좌우 값이 다르므로 불연속점은 2개이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"구간별 함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"평균값 정리와 f′(x)=3x²-2x-6의 증가 범위로 평균변화율 k의 가능한 값을 묶는다.","decisiveStep":"가능한 정수는 -4부터 33까지 모두이며 그 수는 38개이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"평균값 정리 기초","l4":"기울기 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"x=3에서 좌우 미분계수 -f′(3), f′(3)을 같게 하고 함수값도 이어지게 한다.","decisiveStep":"f′(3)=0에서 a=9, 연속 조건에서 b=20이 되어 2a+3b=78이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"원점을 지나는 접선의 접점 조건으로 음의 기울기 -1을 찾고 수직 접선의 도함수 값을 1로 둔다.","decisiveStep":"3x²-12x+7=0의 두 근의 곱은 7/3이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"접선","l4":"접점 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"포물선에서 직선과 평행한 접점 P를 구하고 OP와 직선의 교점 Q를 계산해 거리를 t로 나타낸다.","decisiveStep":"거리 비를 정리하면 (1+2t)√(1+4t²)/t가 남아 극한은 4√2이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"접선","l4":"접점 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"두 극한에서 f(0)=-3, g(0)=3과 f′(0)+g′(0)=3, f′(0)/g(0)=2를 얻는다.","decisiveStep":"f′(0)=6, g′(0)=-3을 곱의 미분식에 넣어 h′(0)=27을 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"x=-1의 비 극한은 f가 더 높은 중복도를 갖게 하고 x=1의 비 극한 부재는 g가 더 높은 중복도를 갖게 한다.","decisiveStep":"삼차식 꼴을 정한 뒤 g(0)=2로 계수를 고정하면 g(-2)=-18이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"f의 점프점 x=1과 f(x-a)의 점프점 x=a+1에서 다른 인수가 각각 0이 되게 한다.","decisiveStep":"f(1-a)=0에서 a=3, f(4)=b에서 b=2이므로 10a+b=32이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"유한한 절댓값 극한으로 f(x)=x³+ax²+2를 정한 뒤 부등식을 x²(x²+ax+9)≥0으로 바꾼다.","decisiveStep":"이차식의 판별식 조건은 -6≤a≤6이고 f(4)는 a=6에서 162이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"절댓값 합을 가장 작게 만드는 가지를 네 지정점에서 정하고 각 구간의 곡선과 직선 교점 수를 k별로 센다.","decisiveStep":"교점이 두 개인 가장 작은 값은 k=-2+2√2이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"f(x)=-k의 교점에서 절댓값 그래프의 꺾임과 접점을 구분해 A(k), B(k)를 센다.","decisiveStep":"곱이 6이 되는 범위는 k<0 또는 0<k<9/4이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
