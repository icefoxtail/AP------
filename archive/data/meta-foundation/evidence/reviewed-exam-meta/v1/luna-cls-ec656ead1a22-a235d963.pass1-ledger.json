  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"A(-6,2), B(2,10)의 좌표를 내분비 3:1에 맞춰 가중 평균해 P를 구한 뒤 a+2b를 계산한다.","decisiveStep":"P의 좌표는 ((-6+3·2)/4,(2+3·10)/4)=(0,8)이므로 a+2b=16이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"선분의 내분·외분","l4":"내분점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"3x+y-4=0의 기울기 -3을 구하고, 점 (-1,6)을 지나는 같은 기울기의 직선에서 절편 b를 정한다.","decisiveStep":"6=3+b에서 b=3이므로 a+b=-3+3=0이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"두 직선의 위치 관계","l4":"평행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"x²+6x와 y²-8y를 각각 완전제곱식으로 바꿔 원의 중심 좌표를 읽는다.","decisiveStep":"(x+3)²+(y-4)²=16이므로 중심은 (-3,4), 따라서 a-b=-7이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 방정식","l4":"일반형에서 원 찾기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"원의 중심 (1,-1)에서 2x-y+k=0까지의 거리를 반지름 √5와 같게 두고 두 k를 구한다.","decisiveStep":"|k+3|/√5=√5에서 k=2,-8이므로 합은 -6이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"기울기가 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"원 중심 (-2,1)을 x방향 4, y방향 -3만큼 옮기고 반지름 3을 유지해 2a+b+r을 계산한다.","decisiveStep":"새 중심은 (2,-2), 반지름은 3이므로 2a+b+r=4-2+3=5이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"평행이동","l4":"원의 이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"P(-4,1)을 (a,-2)만큼 옮긴 Q의 좌표를 구한 뒤 y=x 대칭에서 좌표를 맞춘다.","decisiveStep":"대칭점은 (-1,a-4)=(b,7)이어서 b=-1, a=11이고 a+b=10이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"대칭이동","l4":"직선에 대한 대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"P(a,b)가 A(-1,0), B(3,4)에서 같은 거리라는 식과 직선 b=2a-6을 연립한다.","decisiveStep":"거리 제곱을 같게 두면 a+b=3이고, 직선 조건과 함께 풀면 (a,b)=(3,0)이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"두 점 사이의 거리","l4":"거리 공식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"x²-6kx와 y²-4y를 완전제곱해 반지름 조건을 k에 대한 부등식으로 바꾼다.","decisiveStep":"r²=4k²+12≤36이므로 자연수 k는 1,2이고 합은 3이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 방정식","l4":"일반형에서 원 찾기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"OAB의 무게중심 G와 각의 이등분선 정리로 얻은 C의 좌표를 사용해 GBC의 무게중심을 구한다.","decisiveStep":"OC:CB=3:5라서 C=(0,3/2)이고 GBC의 무게중심은 (1/3,41/18)이므로 6b/a=41이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"삼각형의 무게중심","l4":"좌표 도형 활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"AB의 기울기와 정사각형의 변 길이를 이용해 B와 A에서 수직인 방향으로 같은 길이만큼 이동한 C,D를 정한다.","decisiveStep":"C=(6,9), D=(9,3)이므로 CD는 y=-2x+21이고 x절편은 21/2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"두 점 사이의 거리","l4":"도형의 변 길이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"중심 (-1,2)에서 직선 2x-y+k=0까지의 거리가 √5보다 커지도록 k의 범위를 정한다.","decisiveStep":"|k-4|>5에서 자연수 조건은 k>9이므로 최소값은 10이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원과 직선","l4":"교점 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"원 위의 A(3,-4), B(4,3)에서 접선 방정식을 각각 세워 P를 구하고 세 꼭짓점의 좌표 평균을 계산한다.","decisiveStep":"두 접선을 풀면 P=(7,-1)이고 무게중심 좌표 합은 (14/3)+(-2/3)=4이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"y=x+a를 x축 대칭해 y=-x-a로 바꾸고 위로 4만큼 옮겨 두 직선 사이 삼각형 넓이를 식으로 만든다.","decisiveStep":"x=2에서 높이는 2a, 교점에서 세로선까지의 거리는 a라서 넓이 a²=9이고 양수 a=3이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"이동의 합성","l4":"연속 이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"A를 지나 BC에 수직인 높이선과 C를 지나 AB에 수직인 높이선을 세워 H를 구한 다음 밑변 BC까지의 거리를 잰다.","decisiveStep":"H=(4,4), BC=5이고 H와 BC의 거리는 1이므로 넓이는 5/2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"점과 직선 사이의 거리","l4":"도형의 넓이·최소거리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"원 x²+y²-8x+6y+13=0의 중심과 반지름을 구하고, x축 대칭 뒤 점 (0,3)에서 그은 접선의 기울기 범위를 계산한다.","decisiveStep":"접선 조건 4|m|/√(m²+1)=2√3에서 m²=3이므로 최대 기울기 제곱은 3이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"기울기가 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"원 식을 완전제곱해 C=(3,-1), r=6을 읽고 PC=10인 직각삼각형에서 접점현 AB의 길이를 구한다.","decisiveStep":"CM=CA²/CP=18/5여서 AM=24/5, AB=48/5이고 직교 대각선 넓이는 48이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"두 일차식의 교점 Q를 a,b로 나타내고 QR의 기울기 조건을 직선식으로 바꿔 a²+b²=10과 연립한다.","decisiveStep":"-4a+3b=5와 원 조건에서 양수 해는 (a,b)=(1,3)이므로 a+b=4이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"두 직선의 위치 관계","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"삼각형 CAB의 넓이에서 공통현 중심거리 d를 2 또는 3으로 구하고 그 거리가 중심 C와 공통현 직선 사이 거리와 같게 둔다.","decisiveStep":"|38-k|/10=2 또는 3에서 k=8,18,58,68이고 네 값의 평균은 38이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"두 원","l4":"공통현·공통접선 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"직각이 O,A,P에 놓이는 세 경우를 나누고 각각 원 위 조건과 직각 조건으로 가능한 P 및 삼각형 넓이를 구한다.","decisiveStep":"가능한 넓이는 16과 32뿐이므로 최댓값과 최솟값의 차는 16이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"두 원","l4":"두 원의 위치 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"원점 대칭한 두 원의 중심 (-3,-1),(3,1)에 대해 외공통접선과 내공통접선의 기울기 조건을 각각 푼다.","decisiveStep":"양의 기울기는 1/3과 3/4이므로 서로 다른 값의 합은 13/12이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"두 원","l4":"공통현·공통접선 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"CP=25와 반지름 15로 접선 삼각형의 직각 관계를 이용해 접점현 AB와 높이 PM을 구한다.","decisiveStep":"CM=15²/25=9, PM=16, AB=24이므로 삼각형 PAB의 넓이는 192이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"원래 포물선을 대칭·평행이동해 C′의 식을 만들고 두 곡선의 교점 조건과 수평선의 교점 개수를 비교한다.","decisiveStep":"공통점 A(4,4)가 중근이 되도록 하면 a=5,b=8이고 가능한 k는 -9/4,4,41/4이다.","hold":"공통수학2 선택지의 함수 경로에는 이차함수 그래프의 이동·교점 유형 조합이 없어 경로를 정할 수 없다."}
