  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"두 주사위에서 눈 차가 3인 확률 1/6을 구해 180회 성공 횟수의 이항분포 평균과 표준편차를 계산한다.","decisiveStep":"분산은 180×1/6×5/6=25이므로 표준편차는 5이고 평균 30과 더하면 35이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"B(45,1/3)의 평균 15와 분산 10을 구해 X²의 기댓값을 분산과 평균 제곱의 합으로 바꾼다.","decisiveStep":"E(X²)=10+15²=235이므로 보기의 다섯째 값을 고른다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"명중 횟수가 B(4,1/3)이므로 세 발 명중과 네 발 명중의 확률을 각각 이항확률로 구해 합한다.","decisiveStep":"4C3(1/3)³(2/3)+(1/3)⁴=8/81+1/81=1/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"한 번에 같은 색 공을 뽑을 확률 3/7로 98회 시행을 이항분포로 두고 선형변환한 확률변수의 표준편차를 구한다.","decisiveStep":"V(X)=98×3/7×4/7=24이고 상수항은 분산에 영향을 주지 않아 σ(5X+2)=√(25×24)=10√6이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"E(2X+5)=95와 V(2X+5)=36에서 X의 평균 45와 표준편차 3을 정한 다음 같은 꼬리 확률의 경계가 평균에서 대칭임을 쓴다.","decisiveStep":"(3+a)+(5-b)=90이므로 a-b=82이고 여기에 σ=3을 더해 85를 얻는다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"그림에서 평균을 나타내는 대칭축의 위치와 표준편차에 따른 곡선의 폭을 읽어 자연수 m과 σ의 범위를 센다.","decisiveStep":"m은 4보다 작은 자연수 3개이고 σ는 7보다 작은 자연수 6개이므로 가능한 순서쌍은 18개이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"전체 구간 확률 a에서 왼쪽 바깥 띠의 확률을 빼 b를 얻고, 평균 대칭으로 오른쪽 바깥 띠도 a-b임을 이용한다.","decisiveStep":"중심 구간의 확률은 b-(a-b)=2b-a이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"주사위 눈과 지각 학생 수는 셀 수 있는 값만 가지며, 몸무게는 연속 구간의 실숫값을 가질 수 있는지로 구분한다.","decisiveStep":"ㄱ과 ㄴ만 참이고 학생 수는 정수값이므로 이산확률변수이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"확률표의 합 b가 1임을 먼저 써서 가운데 확률 a를 구하고, 각 값에 확률을 곱해 X의 평균을 확인한다.","decisiveStep":"a=1/2일 때 평균은 1/4+1+3/4=2이므로 ㄱ은 거짓, ㄴ과 ㄷ은 참이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"검은 공 3개와 흰 공 2개 중 2개를 뽑는 조합으로 X가 0, 1, 2일 확률을 구해 10X+1의 평균을 계산한다.","decisiveStep":"E(X)=0·3/10+1·6/10+2·1/10=4/5이므로 E(10X+1)=9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"분산 조건으로 양수 b를 결정한 뒤 선형 변환의 평균 조건에 대입해 a를 찾는다.","decisiveStep":"18b²=18에서 b=1, 이어서 6a+1=43에서 a=7이므로 ab=7이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"(xᵢ-m)²을 전개하고 확률의 합과 확률변수의 평균을 각각 1과 m으로 바꾸어 A와 B를 비교한다.","decisiveStep":"A=2m, B=m²이므로 f(m)=m²+2m이고 f(-1)=-1이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"선형변환 평균과 분산에서 E(X)=5와 V(X)=4를 복원해 이차 기댓값을 구한다.","decisiveStep":"E(X²)=V(X)+E(X)²=4+25=29이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"꼬리확률 차로 0부터 4까지의 점확률을 복원하고 최댓값 5의 확률은 P(X≥5)로 둔 뒤 제곱값의 가중합을 구한다.","decisiveStep":"가중합의 분자는 355이므로 E(X²)=355/30=71/6이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"직선과 포물선의 교점 방정식에서 판별식을 세워 X가 가능한 정수 중 어느 값일 때 음수가 되는지 찾고 그 공 조합을 센다.","decisiveStep":"D=100-2X²<0은 X>5√2를 뜻해 X=8만 남고, 3·3·2를 뽑는 확률은 2/20=1/10이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"숫자 k가 적힌 카드가 k장씩 있다는 점으로 P(X=k)=2k/[n(n+1)]을 세우고 평균 조건에서 n을 정한 다음 제2모멘트를 계산한다.","decisiveStep":"E(X)= (2n+1)/3=9에서 n=13이며 E(X²)=91이므로 분산은 91-81=10이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"둘레 12인 직사각형의 가로를 X라 두면 넓이는 X(6-X)이므로 주어진 평균과 분산으로 이 식의 기댓값을 계산한다.","decisiveStep":"E(X²)=2+4²=18이고 6E(X)-E(X²)=24-18=6이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"다섯 번째 시행 이후 두 번째 흰 구슬이 나오는 사건을 처음 네 번에 흰 구슬이 0개 또는 1개 나오는 경우로 바꾸어 조합 수를 센다.","decisiveStep":"유리한 경우는 C(5,4)+C(3,1)C(5,3)=35, 전체는 C(8,4)=70이어서 확률은 1/2이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"확률밀도 그래프의 전체 삼각형 넓이를 1로 놓아 k를 구하고, x=3부터 9/2까지의 사다리꼴 넓이를 확률로 계산한다.","decisiveStep":"9k=1에서 k=1/9이고 두 끝 높이가 1/3과 1/6이므로 해당 넓이는 3/8이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"주사위 한 번의 점수 분포에서 평균 11/3과 분산 8/9를 구하고, 450회 독립 시행 총점의 평균과 분산으로 확장한다.","decisiveStep":"총점 평균 1650과 분산 400의 합은 2050이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"확률 질량식의 분모 a를 전체 확률 합이 1이라는 조건으로 정하고 네 점의 평균과 제곱평균을 계산한다.","decisiveStep":"a=16, E(X)=25/8, E(X²)=85/8이므로 V(X)=85/8-(25/8)²=55/64이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"합의 각 항을 B(200,1/4) 확률에 k²를 곱한 항으로 보고 이항확률변수의 제곱 평균으로 바꾼다.","decisiveStep":"평균은 50, 분산은 75/2이므로 합은 E(X²)=75/2+50²=5075/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
}