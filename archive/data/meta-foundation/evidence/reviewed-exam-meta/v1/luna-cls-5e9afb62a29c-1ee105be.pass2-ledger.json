  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"F(x)=x²-x+1이 f의 한 부정적분이므로 F를 미분해 f(x)=2x-1을 구한다.","decisiveStep":"x=3을 넣으면 f(3)=5다.","rpmPath":{"majorUnit":"적분","midUnit":"부정적분","l3":"부정적분의 뜻","l4":"원시함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"f'(x)=3(x+1)(x-3)의 부호 변화로 극댓값 위치 -1과 극솟값 위치 3을 정하고 주어진 극솟값으로 k를 찾는다.","decisiveStep":"f(3)=-6에서 k=21, 따라서 f(-1)=26이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"구간 안 임계점 0,√2와 양 끝 -1,2에서 x⁴-4x²+3의 값을 계산해 최댓값과 최솟값을 비교한다.","decisiveStep":"최댓값 3에서 최솟값 -1을 빼면 4다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"h(x)=x³+3x²-9x의 도함수 부호를 x≥0에서 살펴 최소가 되는 x=1의 값을 a와 비교한다.","decisiveStep":"h(1)=-5이므로 모든 값이 양수가 되려면 a>5이고 최소 정수는 6이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"위치 x=2t³-5t²를 미분해 속도 2t(3t-5)를 구하고 방향이 바뀌는 시각을 가속도 식에 넣는다.","decisiveStep":"양의 시각 t=5/3에서 속도 부호가 바뀌며 가속도는 10이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"속도와 가속도","l4":"위치·속도·가속도"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"삼차식 P의 극댓값과 극솟값 부호로 세 실근 조건을 잡고 근의 곱과 합으로 부호를 가려 정수 k를 센다.","decisiveStep":"-22<k<5인 정수는 -21부터 4까지 26개다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"교점 x=0,(a+3)/2를 구하고 직선에서 포물선을 뺀 차를 두 교점 사이 적분한다.","decisiveStep":"넓이가 (a+3)³/24=9이므로 a+3=6, a=3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"두 곡선 사이"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"적분구간을 뒤집는 법칙과 구간 분할을 각 식에 대입하고, 짝함수 적분과 다항식 넓이 조건을 따로 판정한다.","decisiveStep":"ㄱ, ㄴ, ㄹ만 항상 참이라 옳은 명제는 세 개다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분의 성질","l4":"상하한 교환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"두 곡선의 차를 (x+1)(x-1)(x-3)으로 인수분해해 교점 구간마다 위아래를 정하고 차의 절댓값을 적분한다.","decisiveStep":"두 구간의 넓이는 4와 4이므로 전체 넓이는 8이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"두 곡선 사이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"모든 x₁,x₂에서 부등식이 성립하려면 f의 전역 최댓값이 g의 전역 최솟값 이하가 되게 두 함수의 극값을 구한다.","decisiveStep":"최댓값은 18-k, 최솟값은 0이어서 k≥18이고 최솟값은 18이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_UNIVERSAL_INPUTS"],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"f'(x)=4-(x-k)²를 양의 x에서 항상 음수가 되게 하는 k의 범위를 도함수의 최댓값으로 정한다.","decisiveStep":"k≤0일 때 가장 큰 값은 x→0+에서 4-k²이므로 k≤-2이고 경계값 -2도 된다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"증감표"},"crossConceptKeys":[],"conditionKeys":["COND_UNIVERSAL_INPUTS"],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"f(3)-f(-1)을 f'의 -1부터 3까지 적분으로 바꾸고 절댓값 경계 0,2에서 식을 나눈다.","decisiveStep":"세 구간 적분값 3,4,3의 합은 10이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"원시함수 관계를 미분해 f'의 계수를 정하고 x=3 극값 조건과 x=1에서 적분이 0이라는 조건을 함께 푼다.","decisiveStep":"f'(x)=3x²-10x+3이 되어 f'(4)=11이고 짧은 대칭구간 평균의 두 배는 22다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"상한이 변수인 적분"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"속도 식의 부호가 바뀌는 t=2를 찾아 그때까지 부호 있는 적분으로 위치를, 0부터 3까지 속력 적분으로 거리를 구한다.","decisiveStep":"위치는 -8/3, 이동 거리는 5이므로 3a+b=-3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"속도와 거리","l4":"위치 변화"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"x(t)=-2.5t²+20t를 미분해 속도가 0이 되는 정지 시각을 찾고 그때의 누적 이동거리를 계산한다.","decisiveStep":"t=4에서 x(4)=40이므로 정지선까지 필요한 최소 거리는 40m다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"속도와 가속도","l4":"위치·속도·가속도"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"적분식 양변을 두 차례 미분해 f(x)=3x²+2ax+b를 얻고 x=1에서 원식과 한 번 미분한 식을 이용한다.","decisiveStep":"연립 결과 a=-3/2,b=1/2라서 20f(a+b)=130이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"상한이 변수인 적분"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"밑면에서 높이 h인 평행단면의 한 변을 닮음으로 써 부피를 h의 함수로 만든 뒤 도함수로 최대를 찾는다.","decisiveStep":"h=H/3일 때 단면 변은 2이고 부피의 최댓값은 2√2다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"도형 활용"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"x=a 연속 조건으로 k를 a식으로 바꾸고 S₁은 a부터 a+1까지, S₂는 x축 아래 구간을 적분해 비를 맞춘다.","decisiveStep":"넓이 등식의 양수 해는 a=3이고 k=9/2라서 k-a=3/2다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"곡선과 x축"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"g의 유한 극한 조건으로 f(x)-1의 다른 실근을 배제하고, f가 일대일이 아니려면 도함수 이차식이 음수가 되는 구간이 있어야 함을 쓴다.","decisiveStep":"3q<p²<4q를 만족하는 최소 자연수 조합은 q=5,p=4이며 f(1)=11이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL_NUMBER"],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"f'의 두 영점 -1,5로 도함수 3(x+1)(x-5)를 정하고 계수를 비교한 뒤 극댓값 f(-1)=10으로 r을 구한다.","decisiveStep":"p=-6,q=-15,r=2여서 p+q+r=-19다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"두 부분의 넓이가 같다는 조건을 0부터 4까지 포물선과 수평선의 차를 적분한 값이 0인 식으로 바꾼다.","decisiveStep":"128/3-4k=0이므로 k=32/3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"두 곡선 사이"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"극값 위치 a,1,b를 f'의 세 근으로 놓고 f'(-1)=8과 (b-a)²=13으로 합과 곱을 구한다.","decisiveStep":"a+b=1, ab=-3이므로 f'(2)=4(4-2(a+b)+ab)=-4다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"g'=x³-6x²+a의 극값과 영점 수로 수평선 g(x)=k와 만나는 최대 횟수를 판단해 양수 a의 경계를 찾는다.","decisiveStep":"a=32이면 g'=(x+2)(x-4)²로 부호가 한 번만 바뀌므로 최대 교점 수가 2개다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE","COND_EXACT_INTERSECTION_COUNT"],"integrationPattern":"NONE"}
  ]
