  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"nΠ4=n⁴로 바꾸어 n⁴=81을 만족하는 자연수를 찾는다.","decisiveStep":"81=3⁴이고 n은 자연수이므로 n=3이다.","standardUnitKey":"","subUnitKey":"","rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"중복순열을 나타내는 유형 경로가 선택지 표에 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"상자마다 과자 하나씩 먼저 두고 남은 6개를 A,B,C에 나누어 담는다.","decisiveStep":"x'+y'+z'=6의 음이 아닌 해는 8C2=28가지다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"중복조합","l4":"정수해 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"C(n,2)=15에서 n을 구한 뒤 C(n,3)으로 x³의 계수를 구한다.","decisiveStep":"n(n-1)=30에서 n=6이고 C(6,3)=20이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"특정 항의 계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"남학생 3명을 원탁에 먼저 놓고 그 사이 세 자리에 여학생을 배열한다.","decisiveStep":"남학생 원순열 2가지와 여학생 배열 3!가지를 곱해 12가지다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"흰 공 하나와 검은 공 하나를 뽑는 수를 전체 8개 중 2개를 뽑는 수로 나눈다.","decisiveStep":"3·5=15가지 중 색이 다른 경우를 세어 15/28을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"합집합 확률에서 A의 확률을 빼 B와 A의 여집합이 겹치는 부분을 구한다.","decisiveStep":"P(B∩Aᶜ)=3/4−1/3=5/12이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"서로 다른 두 주사위 눈의 합이 5 또는 10인 순서쌍을 세어 전체 36가지로 나눈다.","decisiveStep":"유리한 순서쌍은 4+3=7개여서 확률은 7/36이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"3학년 둘을 한 묶음으로 세운 뒤 네 틈 중 서로 다른 두 곳에 1학년을 둔다.","decisiveStep":"3!·2!로 바탕을 놓고 4P2를 곱해 144가지다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"일렬 배열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"15=14+1로 바꾸어 14로 나눈 나머지가 되는 항만 남긴다.","decisiveStep":"(14+1)¹⁰의 상수항만 14의 배수가 아니므로 나머지는 1이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"전개식의 항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"주머니 A와 B에서 노랑·파랑 하나씩 나올 확률을 구하고 선택 확률을 곱한다.","decisiveStep":"A의 결합 확률 3/10을 두 주머니 합 17/30으로 나누어 9/17을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"동전 앞면 수가 1~4일 때 각각 주사위가 같은 눈을 낼 확률을 합한다.","decisiveStep":"앞면 수가 0인 경우는 제외하고 (4+6+4+1)/(16·6)=5/32이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"두 조건부확률을 P(A∩B)로 나타내어 교집합 확률을 구한 뒤 합집합 식에 넣는다.","decisiveStep":"P(A∩B)=3/10이므로 1/2+3/5−3/10=4/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"복원 추출 세 번에서 곱이 4의 배수가 아닌 경우를 두 유형으로 나누어 뺀다.","decisiveStep":"홀수만 64가지, 홀수 둘과 2 또는 6 하나 96가지여서 1−160/343=183/343이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"주사위 홀짝에 따라 동전 수를 나누고 앞면 둘이 나오는 결합 확률을 비교한다.","decisiveStep":"홀수 분기 확률 3/16을 전체 앞면 둘 확률 5/16으로 나눈다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"A에서 옮긴 공의 색 구성별 확률과 그때 B에서 흰 공을 뽑을 확률을 곱한다.","decisiveStep":"검은 공 둘 이동 뒤 흰 공을 뽑는 결합 확률 9/70을 흰 공 전체 확률 38/70로 나눈다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"5번 던질 때 3의 배수가 나오는 횟수의 이항분포 분산 공식을 쓴다.","decisiveStep":"5·(2/6)·(4/6)=10/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"E(3X−1)=35를 E(X)로 정리한 뒤 24회 시행의 평균과 연결한다.","decisiveStep":"3E(X)−1=35에서 E(X)=12, 따라서 24p=12로 p=1/2다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"독립인 A,B의 교집합과 두 여집합의 교집합 확률을 곱으로 나타낸다.","decisiveStep":"(1−P(A))(1−P(B))=3/8과 P(A)P(B)=1/8에서 합은 3/4다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"앞면 횟수를 x라 두어 2x+(6−x)=9를 풀고 해당 횟수의 독립시행 확률을 구한다.","decisiveStep":"앞면 세 번이므로 6C3/2⁶=5/16이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"이항형 시행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"평균 5/4를 네 수의 합 5로 바꾸어 가능한 순서 배열을 센다.","decisiveStep":"합을 5로 만드는 꼴은 1,1,1,2의 네 배열이므로 4/6⁴=1/324다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"진짜 환자와 비환자 분기에서 암 진단이 나오는 비율을 더한 뒤 사후확률을 구한다.","decisiveStep":"진양성 90/500을 전체 암 진단 110/500으로 나누어 9/11이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"카드 두 장의 차가 1,2,3,4인 경우를 세어 확률표를 만든다.","decisiveStep":"도수 4,3,2,1을 10으로 나누어 평균 2와 분산 1을 계산한다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
