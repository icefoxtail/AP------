{"ordinal":8,"questionUid":"","primaryMethod":"반지름 3인 원의 점 좌표를 삼각함수로 놓고 cosθ tanθ를 sinθ로 줄인다.","decisiveStep":"세로 좌표가 -2라 가로 좌표 절댓값은 루트5이고 |ab|=2루트5이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
