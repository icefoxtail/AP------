{"ordinal":10,"questionUid":"","primaryMethod":"x+y=4와 1/x제곱+1/y제곱=14를 xy에 대한 방정식으로 만들어 세제곱합을 구한다.","decisiveStep":"xy=1이므로 x세제곱+y세제곱=4세제곱-3×4=52이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
