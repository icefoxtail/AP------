  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"2⁻²×8⁵⁄³을 밑 2의 거듭제곱으로 바꾸어 지수를 합친다.","decisiveStep":"8⁵⁄³=2⁵이므로 2⁻²×2⁵=2³=8이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"두 세제곱근의 곱을 먼저 곱셈공식으로 묶고, ⁹√8을 ³√2로 바꾸어 나눈다.","decisiveStep":"(√21+3)(√21-3)=12이므로 ³√12÷³√2=³√6이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"log₂9와 log₃(2√2)를 각각 로그의 거듭제곱 성질로 바꾸고 역수 관계를 곱한다.","decisiveStep":"2log₂3×(3/2)log₃2에서 로그곱은 1이므로 값은 3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"-1.2464를 log 5.67-2로 쓰고 2를 log 100으로 바꾸어 log x를 하나의 로그로 정리한다.","decisiveStep":"log x=log(5.67/100)=log 0.0567이므로 x=0.0567이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"소수점 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"도 단위를 라디안으로 고치고, 동경의 x축 대칭과 -5π/6의 사분면을 각각 확인한다.","decisiveStep":"45°는 π/4이고 300°는 π/3의 x축 대칭이며 -5π/6은 제3사분면이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"sinθtanθ=sin²θ/cosθ의 부호에서 cosθ를, sinθ+tanθ의 부호에서 sinθ를 정해 사분면을 찾는다.","decisiveStep":"cosθ>0, sinθ<0이므로 0≤θ<2π에서 제4사분면 각인 5π/3을 고른다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"로그의 진수 양수와 밑 양수·1이 아님을 각각 부등식으로 바꾸어 정수 x를 걸러낸다.","decisiveStep":"-2<x<5에서 x=2, 1, 3을 밑 조건으로 제외해 -1, 0, 4만 남긴다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"밑과 진수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"밑을 ((a-4)²+1)/2로 완전제곱 정리하고, 음수 지수에서 함수값이 1보다 커질 밑의 범위를 적용한다.","decisiveStep":"0<A<1에서 (a-4)²<1이며 정수 a는 4뿐이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"로그 진수 조건 -4<x<7을 먼저 두고, 로그 합을 log((7-x)(x+4))로 합쳐 정수해를 찾는다.","decisiveStep":"(x-6)(x+3)≥0과 정의역을 함께 적용하면 x=-3, 6만 남아 합은 3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"두 소음도 식을 빼 상수항을 없애고 속력 비 vA/vB=1.5를 로그에 넣는다.","decisiveStep":"LA-LB=28log(vA/vB)=28log1.5=28(log3-log2)이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"분모를 sin²θ=1-cos²θ로 바꾸어 cosθ(1+3cosθ)로 인수분해하고 tanθ를 결정한다.","decisiveStep":"제3사분면에서 sinθ=-3/√10, cosθ=-1/√10이므로 차는 -√10/5이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"t=(1/3)ˣ>0으로 치환해 t²-6kt+18k≤0이 양의 t에서 해를 갖지 않을 조건을 나눈다.","decisiveStep":"0≤k<2이면 양의 영역에서 부등식이 성립하지 않고 k=2에서는 t=6이 해가 된다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"부채꼴 넓이 조건에서 세 변이 피타고라스 관계임을 얻고, 넓이 30인 자연수 직각삼각형 변을 찾은 뒤 호의 합으로 θ를 구한다.","decisiveStep":"변은 5, 12, 13이고 θ=2π/5이므로 반지름 13인 부채꼴의 넓이는 169π/5이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"복합도형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"접선의 절편으로 Sₙ=1/2·3^(2n+8/n-3)을 구하고 자연수 n에서 지수 2n+8/n의 최소를 비교한다.","decisiveStep":"최소 지수는 n=2에서 5가 되어 m=243/2, k+m=247/2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"공선 조건으로 a=2ᵐ, b=2⁴ᵐ, c=2⁵ᵐ을 둔 뒤, p와 q의 밑을 2의 로그로 바꾸어 곱을 최소화한다.","decisiveStep":"s=2ᵐ은 s⁴-s=14에서 2이고, u=3, v=6이 등식 조건에서 최소 u+v=9를 이룬다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"(abc)ⁿ=3^(n/3)·7^(n/5)·11^(n/9)에서 각 소인수 지수가 정수가 되도록 n의 최소 공배수를 취한다.","decisiveStep":"3, 5, 9의 최소공배수는 45이므로 최소 n=45이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"(n-5)(n-9)의 부호와 n의 짝홀을 이용해 n제곱근의 실수 개수를 4부터 11까지 표로 나열한 뒤 증가 지점을 찾는다.","decisiveStep":"f(n)<f(n+1)은 n=6, 8, 9에서만 성립하므로 합은 23이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
