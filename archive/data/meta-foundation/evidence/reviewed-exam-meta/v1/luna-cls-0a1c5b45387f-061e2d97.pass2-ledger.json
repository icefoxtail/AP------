  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"$2x^2-2x+4$에 $x=1$을 대입해 극한을 계산한다.","decisiveStep":"다항식은 $x=1$에서 연속이므로 대입값 $2-2+4=4$가 극한이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"극한값 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"$f(x)$와 $g(x)$를 각각 극한값 $3$과 $-1$로 바꾸어 $3f-2fg$를 계산한다.","decisiveStep":"곱의 극한은 $3\\cdot(-1)=-3$이므로 전체 값은 $9-2(-3)=15$이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"$x=-2$에서 왼쪽 직선의 기울기와 오른쪽 $x^3$의 도함수 값을 같게 두고 연속 조건을 적용한다.","decisiveStep":"미분가능성에서 $a=12$이고 연속성에서 $-2a+b=-8$이므로 $b=16$, 두 상수의 차는 $4$이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":["COND_PIECEWISE_DOMAIN_PARTITION"],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"$P(x)=3x^3-x^2-x+2$의 보기 구간 끝점 값을 비교해 부호가 바뀌는 구간을 찾는다.","decisiveStep":"$P(-1)=-1$과 $P(0)=2$의 부호가 다르므로 연속성에 의해 $(-1,0)$ 안에 근이 있다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속함수의 성질","l4":"사잇값 정리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"대칭 차분 극한을 $x=1$에서의 좌우 미분계수로 나누어 $f'(1)$을 구한 뒤 인수를 약분한다.","decisiveStep":"차분 극한은 $2f'(1)=6$이므로 $f'(1)=3$이고, 약분 뒤 분자와 분모의 남은 인수 값이 모두 3이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"$(x+1)^2$로 나눈 나머지와 원래 다항식의 값 및 도함수 값을 $x=-1$에서 같게 둔다.","decisiveStep":"도함수 조건 $-10-a=4$에서 $a=-14$를 구하고, 함수값 조건에서 $2b=5$를 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"절댓값 그래프의 두 직선 가지와 $y=kx-2k$의 교점을 각각 구하고 교점이 각 가지에 놓일 조건으로 개수를 나눈다.","decisiveStep":"교점 수가 바뀌는 경계 $k=-2,-1,2$에서 불연속이 생기며 세 값의 곱은 4이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"그림의 직선과 그래프 차를 $h(x)=f(x)-x/2$로 두어 영점과 접선 기울기를 비교한다.","decisiveStep":"$h(0)=h(p)=0$이므로 롤의 정리로 내부에 $h'(\\alpha)=0$이 있어 $f'(\\alpha)=1/2$이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"평균값 정리 기초","l4":"기울기 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"$P=(t,9t^2)$로 놓고 $PQ-HQ$를 켤레식으로 유리화한 다음 $t^2$으로 나누어 극한을 구한다.","decisiveStep":"유리화한 식의 분모는 $t\\to\\infty$에서 9로 수렴하므로 차의 극한은 $1/9$이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"무한대 극한으로 $f$의 최고차항을 정하고 $x=2$의 극한으로 $(x-2)^2$ 인수를 둔 뒤 남은 계수를 결정한다.","decisiveStep":"$(나)$에서 $-(2-r)/2=3$이므로 $r=8$, 따라서 $f(3)=5$이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"각 보기를 극한의 곱과 몫의 법칙 및 함수값 대소 관계가 적용되는 조건에 비추어 반례나 성질로 판정한다.","decisiveStep":"ㄱ은 $f\\to0$, $g\\to\\infty$에서 곱 극한이 없어질 수 있고 ㄷ은 극한 존재가 보장되지 않지만, ㄴ의 몫은 0으로 간다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"접점의 가로좌표 $t$를 접선 조건에 대입해 세 접점의 좌표가 근이 되는 삼차방정식을 만든다.","decisiveStep":"세 근이 등비수열이면 가운데 근의 제곱이 양 끝 근의 곱이고, 계수 관계에서 가운데 근은 $4/3$이어서 $k=7/27$이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"접선","l4":"접점 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"$OP=OQ=s=t\\sqrt{1+t^2}$와 삼각형 넓이로 외접원 지름을 나타내고 각 제곱 길이를 $t^4$로 나누어 비교한다.","decisiveStep":"$s^2/t^4\\to1$이고 $PQ^2/t^4\\to2$이므로 지름 제곱 비의 극한은 2이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"$g=(x^2-2x+a)f$에서 극한 조건이 주는 $g-f$의 값과 도함수를 $x=2$에서 계산한 뒤 남은 계수를 정한다.","decisiveStep":"$a\\ne1$이면 $f(2)=f'(2)=0$이 되어 $g'(2)\\ne0$와 모순이므로 $a=1$이고 $f$는 $(x-2)(x-r)$ 꼴이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"$f'(x)=-3x^2+2ax-12$가 모든 실수에서 0 이하가 되도록 판별식 조건을 세운다.","decisiveStep":"$4a^2-144\\le0$에서 $-6\\le a\\le6$이므로 구간 길이는 12이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"증감표"},"crossConceptKeys":[],"conditionKeys":["COND_UNIVERSAL_INPUTS"],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"$x=1$에서 좌우 함수값이 이어지는 조건으로 $a,b$의 관계를 구하고, 좌우 미분계수 차와 치역 조건을 적용한다.","decisiveStep":"연속 조건 $2a+b=-4$와 치역 합으로 $4+2a=6$을 얻어 $a=1,b=-6$이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":["COND_PIECEWISE_DOMAIN_PARTITION"],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"함수방정식에 $y=0$을 넣고 다항식 계수를 비교해 $f$를 정한 뒤 $f-f'$의 극한을 도함수 조건으로 바꾼다.","decisiveStep":"$(f-f')(1)=0$이며 $(f-f')'(1)=2$이므로 미지 계수 $C=1/2$, 따라서 $f'(0)=1/2$이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"할선 기울기 $S$를 구해 $f'(c)=S$의 해가 $(-2,0)$과 $(0,a)$에 하나씩 놓이는 부등식으로 바꾼다.","decisiveStep":"$S>4-6a$를 정리하면 $3a^2+12a-4>0$이고 양의 범위와 함께 $-2+4\\sqrt3/3<a<2$를 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"평균값 정리 기초","l4":"변화율"},"crossConceptKeys":[],"conditionKeys":["COND_PIECEWISE_DOMAIN_PARTITION"],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"$a\\ne4$일 때 $|x-a|^n$의 $x=4$ 미분계수를 $n(4-a)|4-a|^{n-2}$로 나타내고 자연수 조건을 조사한다.","decisiveStep":"최댓값은 $a=3,n=9$에서 $b=9$일 때 $a^2+b^2=90$이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"평균변화율과 $f'(a)$가 같다는 식을 인수분해해 $g(a)$를 정하고, 이를 두 번째 방정식에 넣어 $k$를 구한다.","decisiveStep":"$a\\ne g(a)$ 조건은 $g(a)=-2a$를 남기며, 비영 근의 곱 $5k/12=-5$에서 $k=-12$이고 $g(k/12)=2$이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
