 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"각 보기의 x²=n, x³=n, x⁴=n에서 실수해 개수를 구분해 옳은 진술을 고른다.","decisiveStep":"짝수 n에서 xⁿ=3은 양의 실수와 음의 실수 두 근을 가지므로 ④가 맞다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"125=5³, 81=3⁴로 바꾸어 log₅125−log₃81의 두 값을 계산한다.","decisiveStep":"3−4=−1이므로 간단한 값은 −1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"필터 한 개 뒤 남는 비율 0.8을 n번 거듭 곱해 0.1 이하가 되는 정수 n을 구한다.","decisiveStep":"log 0.8=−0.1이므로 부등식은 n≥10이 되고 최소 횟수는 10이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"243=3⁵로 바꾸어 243^(4/5)를 계산한 뒤 a^(−2)=81을 양수 조건과 함께 푼다.","decisiveStep":"a²=1/81이고 a>0이므로 a=1/9이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"30°, 75°, π, 130°를 라디안과 도 단위로 서로 바꾸어 네 진술을 확인한다.","decisiveStep":"30°=π/6이고 130°=13π/18인 ㄱ, ㄹ만 맞다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"13π/6, −π/3, 3π/4를 주기와 기준각으로 바꾸어 cos, sin, tan의 값을 곱한다.","decisiveStep":"곱은 (√3/2)(−√3/2)(−1)=3/4이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"2sin(3x−π/2)−1을 −2cos3x−1로 바꾸어 최댓값, 최솟값, 주기와 원점 세로 좌표를 확인한다.","decisiveStep":"x=0에서 y=−3이며 주기는 2π/3이고 범위는 [−3,1]이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"기본 그래프","l4":"sin·cos"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"−8의 세제곱근 −2, 1±i√3을 각각 α, β, γ로 두어 제곱합을 계산한다.","decisiveStep":"β²+γ²=−4이고 α=−2이므로 나눈 값은 2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"√((-3)⁶)을 |(−3)³|로 바꾸어 제시된 제곱근 계산의 첫 오류를 찾는다.","decisiveStep":"㉠은 맞고 ㉡은 음수의 제곱근을 실수로 취해 틀렸으며 올바른 값은 27이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"수평 점근선 y=−1로 b를 정하고 그래프의 x절편 x=3을 3^(x+a)+b에 대입한다.","decisiveStep":"3^(3+a)=1에서 a=−3이므로 a+b=−4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":11,"questionUid":"","primaryMethod":"9^(x+1)−9^x에서 9^x를 묶어 8·9^x=24로 낮춘 뒤 밑을 3으로 통일한다.","decisiveStep":"9^x=3=9^(1/2)이므로 x=1/2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"밑 통일"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":12,"questionUid":"","primaryMethod":"그래프의 x절편에서 log₃(4a)=0을 풀고 y=1일 때의 x좌표 k를 로그식에 넣는다.","decisiveStep":"a=1/4, k=12이므로 8a+k=14이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"tan θ=−3/4와 sin θ·tan θ<0으로 사분면을 정한 뒤 3-4-5 비를 사용한다.","decisiveStep":"제2사분면이므로 sin θ=3/5, cos θ=−4/5이고 10배 합은 −2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"단위원"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":14,"questionUid":"","primaryMethod":"A와 B의 보폭 15,5와 다리 길이 9,3을 속력식의 비에 넣어 공통 인자를 없앤다.","decisiveStep":"두 밑의 비가 모두 3이므로 지수 차 1.67−1.17=0.5가 남아 속력비는 √3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"실수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":15,"questionUid":"","primaryMethod":"f(2)=log_a2=−1/2에서 밑 a=1/4를 정하고 f(12)=log_(1/4)32를 밑 2의 지수식으로 바꾼다.","decisiveStep":"2^(−2t)=2⁵이므로 t=−5/2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그방정식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":16,"questionUid":"","primaryMethod":"t=log₃x로 치환해 [−1,2]에서 (t−1)(t−2)의 꼭짓값과 끝값을 비교한다.","decisiveStep":"최솟값은 −1/4, 최댓값은 6이라 M−m=25/4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":17,"questionUid":"","primaryMethod":"y축 대칭인 동경 조건을 5θ≡π−θ (mod 2π)로 놓고 열린 구간의 각을 고른다.","decisiveStep":"θ=5π/6, 7π/6만 남아 합은 2π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":18,"questionUid":"","primaryMethod":"그림에서 f가 짝함수이고 0≤f(x)≤1임을 확인해 a의 범위별 g(x)=a^f(x)의 극값을 판정한다.","decisiveStep":"0<a<1에서는 g의 최솟값이 a이고 a>1이면 최댓값은 a라 ㄱ,ㄴ만 참이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":19,"questionUid":"","primaryMethod":"log₁₅30을 밑 5 로그의 비로 쓰고 log₅2=log₅3·log₃2를 이용해 a,b로 정리한다.","decisiveStep":"분자는 ab+b+1, 분모는 b+1이므로 값은 (ab+b+1)/(b+1)이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":20,"questionUid":"","primaryMethod":"사인 그래프의 y=a 교점 A와 다음 x절편 B를 좌표로 나타내고 직각 조건과 넓이 9를 함께 쓴다.","decisiveStep":"수직 조건과 넓이로 a=3, b=π/6을 얻어 a+b=3+π/6이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":21,"questionUid":"","primaryMethod":"x,y를 로그값의 역수로 두고 (x+y)/2=xy를 로그합 식으로 바꾸어 세 변 관계를 찾는다.","decisiveStep":"log_a((b+c)(b−c))=2에서 b²=a²+c²이므로 b가 빗변인 직각삼각형이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":22,"questionUid":"","primaryMethod":"f의 역함수를 구한 뒤 왼쪽 2, 위 a만큼 옮긴 로그 그래프와 y=3의 교점을 구해 중점 좌표를 쓴다.","decisiveStep":"A의 x좌표는 1이고 B는 3^(2−a)이므로 (1+3^(2−a))/2=14에서 a=−1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":23,"questionUid":"","primaryMethod":"t=sin²x로 두어 0≤t≤1에서 sin⁶x+cos⁶x+2sin²x를 이차식으로 바꾼다.","decisiveStep":"식은 3(t−1/6)²+11/12라 최솟값 11/12, 끝점 최댓값 3이며 합은 47/12이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
