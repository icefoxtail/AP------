"items":[
{"ordinal":1,"questionUid":"","primaryMethod":"분수 지수와 음의 지수를 거듭제곱근과 역수로 바꾸어 7^(2/3)=∛49인지 확인한다.","decisiveStep":"9^(-3/2)=1/27이고 (-3)^(-4)=1/81이므로 옳은 등식은 네 번째뿐이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":2,"questionUid":"","primaryMethod":"밑이 6인 두 로그의 합을 log₆(4×9)로 합친다.","decisiveStep":"4×9=36=6²이므로 합은 2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":3,"questionUid":"","primaryMethod":"21=2.1×10으로 나타내고 표의 2.1행과 0열에서 log 2.1을 읽는다.","decisiveStep":"표의 0.3222에 log 10=1을 더하면 log 21=1.3222이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"상용로그표·자릿수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":4,"questionUid":"","primaryMethod":"135°, -4π/3, 510°, 29π/6, -855°를 한 바퀴 안의 각으로 고쳐 사분면을 비교한다.","decisiveStep":"앞의 네 각은 둘째 사분면이고 -855°만 225°와 동경이 같아 셋째 사분면이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":5,"questionUid":"","primaryMethod":"y=2^(x-a)+b의 점근선 y=-2와 그래프 위의 점 (0,2)를 식에 반영한다.","decisiveStep":"b=-2를 대입하면 2^(-a)=4이므로 a=-2이고 ab=4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":6,"questionUid":"","primaryMethod":"log_(x+3)(-x²+4x+45)의 밑 조건 x>-3, x≠-2와 진수 조건 -5<x<9를 함께 푼다.","decisiveStep":"가능한 정수는 -1부터 8까지이므로 합은 35이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"밑과 진수 조건"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
{"ordinal":7,"questionUid":"","primaryMethod":"log_(1/3)(-x+2)>1에서 진수의 양수 조건을 먼저 구하고 밑 1/3의 감소성을 이용한다.","decisiveStep":"0<-x+2<1/3을 풀면 5/3<x<2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":8,"questionUid":"","primaryMethod":"x≤0인 직선 y=√3x에서 P=(-1,-√3)을 잡아 sinθ를 세로 좌표와 원점까지 거리의 비로 계산한다.","decisiveStep":"P는 셋째 사분면이고 OP=2이므로 sinθ=-√3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":9,"questionUid":"","primaryMethod":"y=log₃(x-1)의 진수 조건과 증가성 및 역함수를 구하여 각 설명을 대조한다.","decisiveStep":"x와 y를 바꾸어 풀면 y=3^x+1이 되므로 다섯 번째 대칭 설명이 옳다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":10,"questionUid":"","primaryMethod":"∛(9√3)×∛9÷√√243을 3의 거듭제곱으로 고쳐 a를 구한 뒤 b=a¹²을 계산한다.","decisiveStep":"지수의 합이 5/6+2/3-5/4=1/4이므로 b=3³=27이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":11,"questionUid":"","primaryMethod":"짝수와 홀수 거듭제곱근의 실수 해를 구별하고 √729의 세제곱근을 직접 계산한다.","decisiveStep":"√729=27의 실수 세제곱근은 3이므로 27이라고 한 다섯 번째 설명이 틀리다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":12,"questionUid":"","primaryMethod":"1/4≤x≤8에서 y=|log₂x|+2로 고쳐 양 끝점과 로그가 0인 x=1의 값을 비교한다.","decisiveStep":"x=1에서 최솟값 2, x=8에서 최댓값 5를 얻으므로 합은 7이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RESTRICTED_INTERVAL"],"integrationPattern":"NONE"},
{"ordinal":13,"questionUid":"","primaryMethod":"두 부채꼴의 공통 중심각을 θ라 놓고 Rθ=2π, rθ=4π/3과 넓이 차 5π를 연립한다.","decisiveStep":"(R-r)θ=2π/3을 넓이 식에 넣으면 R+r=15이므로 θ=(10π/3)/15=2π/9이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":14,"questionUid":"","primaryMethod":"0<θ<π/2에서 tanθ cos²θ를 sinθ cosθ로 고치고 (sinθ-cosθ)²≥0을 이용한다.","decisiveStep":"sinθ cosθ≤1/2이고 θ=π/4에서 등호가 성립하므로 최댓값은 1/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RESTRICTED_INTERVAL"],"integrationPattern":"NONE"},
{"ordinal":15,"questionUid":"","primaryMethod":"지수 x²-2x-1=(x-1)²-2의 범위와 0<a<1에서의 감소성을 이용해 a와 구간 최솟값 m을 구한다.","decisiveStep":"a^(-2)=9에서 a=1/3이고 0≤x≤3의 지수 최댓값은 2이므로 a+m=1/3+1/9=4/9이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RESTRICTED_INTERVAL"],"integrationPattern":"NONE"},
{"ordinal":16,"questionUid":"","primaryMethod":"모든 정수 지수에서 나눗셈이 가능한 밑의 집합 A와 모든 유리수 지수에서 실수값을 갖는 밑의 집합 B를 구한다.","decisiveStep":"A는 0이 아닌 실수 전체이고 B는 양수 전체이므로 A⊂B라는 설명이 틀리다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":17,"questionUid":"","primaryMethod":"2000년에서 n년 뒤 매출을 100(1.25)^n으로 세우고 1000 이상인 조건에 상용로그를 취한다.","decisiveStep":"주어진 log 2=0.3으로 log 1.25=0.1이므로 n≥10에서 최초 연도는 2010년이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
{"ordinal":18,"questionUid":"","primaryMethod":"x^(x²+6)≤x^(9x-8)은 x=1을 따로 확인하고 두 지수 연립부등식은 밑을 각각 2와 3으로 통일한다.","decisiveStep":"A={1,2,3,4,5,6,7}, B={1,2,3,4,5,6}이므로 교집합의 원소 합은 21이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
{"ordinal":19,"questionUid":"","primaryMethod":"t=2^x+2^(-x)≥2로 놓아 t²-kt+9의 근을 살피고 두 번째 이차부등식의 판별식을 3^k로 정리한다.","decisiveStep":"첫 식에 실근이 없으려면 자연수 k≤5이고 두 번째 조건은 (3^k-9)(3^k+5)≥0이므로 k=2,3,4,5의 합 14를 얻는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
{"ordinal":20,"questionUid":"","primaryMethod":"절대 등급 공식에 두 별의 거리 15/2, 3/4와 겉보기 등급 2, 1을 대입한 뒤 차를 구한다.","decisiveStep":"M_B-M_A=-1-5 log((3/4)/(15/2))=-1-5 log(1/10)=4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
{"ordinal":21,"questionUid":"","primaryMethod":"θ와 3θ의 동경이 y축 대칭인 조건을 4θ=(2n+1)π로 나타내고 sinθ+cosθ<0인 각을 고른다.","decisiveStep":"허용된 네 각 중 θ=5π/4만 남으므로 tan(θ+7π/12)=tan(11π/6)=-√3/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":["COND_RESTRICTED_INTERVAL"],"integrationPattern":"NONE"},
{"ordinal":22,"questionUid":"","primaryMethod":"12개 자연수의 집합에서 a₁ 이외의 원소를 a₁로 나누어도 집합 안에 남는 조건으로 원소들의 거듭제곱 구조를 찾는다.","decisiveStep":"a₁은 최소 원소이고 지수에 빈틈이 있을 수 없어 S={a₁,a₁²,…,a₁¹²}이므로 로그의 합은 2+…+12=77이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
{"ordinal":23,"questionUid":"","primaryMethod":"a⁶b=a^m에서 b=a^(m-6)을 얻어 a^m=b^n에 대입하고 자연수 m,n의 조건을 이용한다.","decisiveStep":"m=6+6/(n-1)이므로 n-1은 6의 양의 약수 1,2,3,6 중 하나이고 순서쌍은 4개이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
{"ordinal":24,"questionUid":"","primaryMethod":"y=a^(x-2)와 y=log_a(x-2)의 y=x-2에 대한 대칭을 이용해 직선 y=-x+6 위의 교점 A,B의 중점을 구한다.","decisiveStep":"중점 M=(4,2)와 C=(0,6), AM:AC=1:3에서 A=(3,3)이므로 3=a^(3-2)에서 a=3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
]}