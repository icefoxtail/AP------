  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"각 4π/3를 π+π/3으로 바꾸어 제3사분면의 코사인값을 구한다.","decisiveStep":"제3사분면에서는 코사인이 음수이므로 cos(4π/3)=-1/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"로그의 정의로 log₂4=2를 계산한 뒤 주어진 1을 더한다.","decisiveStep":"밑 2를 몇 번 곱해 4가 되는지 세면 로그값은 2이고 전체 값은 3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"25π/4에서 2π를 세 번 빼서 0 이상 2π 미만의 나머지 각을 찾는다.","decisiveStep":"25π/4=3·2π+π/4이므로 θ는 π/4이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"sinθ=3/5에서 cos²θ=1−sin²θ를 구하고 제2사분면의 부호를 반영한다.","decisiveStep":"cosθ는 −4/5이므로 tanθ=(3/5)/(−4/5)=−3/4이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"√5를 5^(1/2)로 바꾸고 밑이 같은 거듭제곱의 지수를 같게 둔다.","decisiveStep":"1−2x=1/2를 풀면 x=1/4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"밑 통일"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"반지름 6과 호 길이 2π를 s=rθ에 넣어 중심각을 구하고 부채꼴 넓이 공식으로 b를 정한다.","decisiveStep":"a=1/3, b=6이므로 ab=2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"두 그래프의 수평·수직 점근선을 찾고 y=x 대칭에서 서로 바뀌는 직선의 위치를 비교한다.","decisiveStep":"y=1이 x=1로 옮겨져야 하므로 −a=1, 따라서 a=−1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"분자와 분모의 중첩된 근호를 a의 거듭제곱으로 차례로 바꾸고 지수를 비교한다.","decisiveStep":"분자 지수 5/8과 분모 지수 1/6+k/18을 같게 두어 k=33/4를 얻는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"함수와 역함수의 교점은 y=x 대칭성을 가지며, 주어진 두 x좌표에 대응하는 함수값 조건으로 m,n을 구한다.","decisiveStep":"f(1)=1과 f(2)=2를 빼면 2^(1−m)=1이 되어 m=1, 이어 n=0이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"t=sinθ/(1+cosθ)로 두어 조건을 t+1/t=4로 바꾸고 반각 관계로 cosθ를 구한다.","decisiveStep":"0<t<1인 해는 2−√3이며 cosθ=(1−t²)/(1+t²)=√3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"cos²x=1−sin²x를 대입해 sin x에 대한 이차방정식으로 바꾸고 주어진 주기 구간에서 해를 찾는다.","decisiveStep":"가능한 값은 sin x=1/2이고 해 π/6, 5π/6의 합은 π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"0<θ≤2π에서 sinθ>1/2와 cosθ<0의 각 범위를 각각 구해 교집합을 취한다.","decisiveStep":"교집합은 π/2<θ<5π/6이므로 a+b=1/2+5/6=4/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"(1/1024)^(1/n)을 2^(−10/n)으로 바꾸고 자연수 조건에 맞는 음의 정수 n을 찾는다.","decisiveStep":"−10/n이 양의 정수여야 하므로 n은 −1, −2, −5, −10이며 합은 −18이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"t=2^x>0으로 치환해 t²−8t+k+1의 최솟값이 양수가 되도록 k를 정한다.","decisiveStep":"꼭짓점 t=4에서 최솟값은 k−15이므로 k의 최솟값은 16이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"삼각형의 내각합 A+B+C=π를 세 식에 대입해 부호와 항등식을 판정한다.","decisiveStep":"(다)는 tan(π−A)=−tan A로 합이 0이고 (가),(나)는 양수이므로 (다)만 참이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"첫 로그 조건을 밑변환해 a+b를 구하고 둘째 식에서 로그의 역수 관계로 ab를 구한다.","decisiveStep":"a+b=16, ab=16이므로 a²+b²=(a+b)²−2ab=224이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"2sin(πx)=x/n의 교점을 양의 반주기별로 세고 홀함수 대칭으로 전체 개수를 계산한다.","decisiveStep":"n=2일 때 f=7, n=3일 때 f=11이므로 두 값의 합은 18이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"직육면체의 세 변과 정육면체 모서리를 모두 2의 거듭제곱으로 나타내어 부피 지수를 같게 둔다.","decisiveStep":"부피 등식에서 13/3=3n/m, 즉 9n=13m이므로 서로소 조건에 따라 m+n=22이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"u=2^x3^y, v=3^x2^y로 두어 uv=6을 만든 뒤 1/u+1/v에 산술·기하평균을 적용한다.","decisiveStep":"등호는 x=y=1/2일 때 성립해 최솟값은 2/√6=√6/3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"r=3/a로 두고 r>1과 0<r<1에서 구간 끝점의 함수값이 최댓값이 되는 경우를 나누어 푼다.","decisiveStep":"a는 3/2와 12이므로 두 값의 곱은 18이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"해수면 높이 조건을 sin(πx/6)≥1/2로 바꾸고 한 주기의 시간 길이를 하루의 두 주기에 적용한다.","decisiveStep":"한 주기에서 가능한 시간은 4시간이고 하루에 두 번 반복되어 8시간이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"4⁴·8⁸을 2³²로 바꾸고 2^(32−n)의 n제곱근이 자연수가 되는 약수 조건을 세운다.","decisiveStep":"n은 32의 약수 중 2 이상인 2,4,8,16,32로 다섯 개이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"점근선과 넓이 이등분 조건으로 Q의 높이를 정한 뒤 직각이등변삼각형 조건과 로그식에 대입한다.","decisiveStep":"조건에서 P=(2,0), Q=(8,2)가 되어 b=6, log_a36=2에서 a=6이므로 a+b=12이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"","primaryMethod":"a의 부호에 따라 f(0), f(a), f(1)의 정의를 나누고 지수부등식을 2^a의 범위로 바꾼다.","decisiveStep":"a>0인 경우만 가능하며 2<2^a<8/3에서 p+q=2+8/3=14/3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":25,"questionUid":"","primaryMethod":"단위원 좌표로 BD와 OC를 sinθ, secθ로 나타내 조건에서 sinθ+cosθ를 구한 뒤 식을 통분한다.","decisiveStep":"주어진 식은 sinθ+cosθ로 정리되고 조건값은 4/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":26,"questionUid":"","primaryMethod":"두 로그 그래프 위 점과 서로 수직인 직선들의 좌표 관계를 세워 u에 대한 방정식을 만든다.","decisiveStep":"u=4일 때 B=(4,√3), D=(17,0)이므로 BD²=13²+3=172이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":27,"questionUid":"","primaryMethod":"a,b,c,d를 각각 5 또는 3의 거듭제곱으로 정리해 125,1,3,27을 얻는다.","decisiveStep":"네 값을 더하면 125+1+3+27=156이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":28,"questionUid":"","primaryMethod":"두 로그의 진수 조건 x>3을 먼저 세우고 로그의 단조성을 이용해 곱의 이차부등식으로 바꾼다.","decisiveStep":"이차부등식 해 −3<x<5와 x>3의 교집합은 3<x<5라서 a+b=8이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":29,"questionUid":"","primaryMethod":"그래프의 최댓값과 최솟값으로 진폭과 중심선을 정하고 연속한 꼭짓점 간격으로 주기와 이동량을 읽는다.","decisiveStep":"a=2, d=1, b=2, c=π/12이므로 abcd=π/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":30,"questionUid":"","primaryMethod":"거리 d에 반비례하는 제곱으로 세기를 바꾸어 두 데시벨 식의 차를 로그 몫으로 정리한다.","decisiveStep":"S₂−S₁=20log(d₁/d₂)이고 2m와 10m에서는 100−20·0.7=86dB이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
