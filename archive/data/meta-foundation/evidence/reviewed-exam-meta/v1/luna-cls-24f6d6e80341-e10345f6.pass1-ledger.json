  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"가운데 정육각형에 한 색을 두고 둘레의 여섯 자리에 나머지 색을 놓은 뒤 회전 중복을 나눈다.","decisiveStep":"둘레 배치는 회전 여섯 방향마다 한 번씩 세어지므로 7!을 6으로 나눈다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"네 학생 각각의 택시·버스·자전거 세 선택을 곱하여 전체 선택 수 3^4를 구한다.","decisiveStep":"학생마다 세 선택을 하므로 세 선택 수를 네 번 곱한다.","hold":"세 선택을 학생별로 반복하는 곱의 법칙에 맞는 유형 경로가 선택지에 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"동전 네 번 중 앞면이 나오는 세 위치를 고르고 각 배열의 확률을 더한다.","decisiveStep":"앞면 위치는 네 곳 중 세 곳을 고르므로 확률은 4(1/2)^4이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"이항형 시행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"분포표에서 X가 -1 또는 1일 때의 확률을 더해 X²=1의 확률을 구한다.","decisiveStep":"X²=1을 만족하는 값은 -1과 1뿐이므로 두 확률 1/5를 합친다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"표준정규분포의 대칭성으로 평균 왼쪽 넓이 0.5를 구하고 표의 0부터 0.5까지 넓이를 더한다.","decisiveStep":"P(0≤Z≤0.5)=0.19이므로 구하는 누적확률은 0.5+0.19이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"동전 한 개의 기대 금액 10×1/2를 구하고 다섯 동전의 기대 금액을 합한다.","decisiveStep":"동전별 기대 금액은 5원이므로 다섯 개의 합은 25원이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"땅콩 맛을 먼저 하나 포함하고 남은 네 개를 세 맛에 중복 허용하여 나누는 정수해를 센다.","decisiveStep":"x+y+z=5, x≥1을 x-1+y+z=4로 바꾸어 6C2를 얻는다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"중복조합","l4":"정수해 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"이항 전개 일반항의 x 지수 5-3k를 2와 같게 놓아 해당 항을 찾는다.","decisiveStep":"k=1일 때 계수는 5C1×(-1)^4×2=10이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"특정 항의 계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"첫 경기 승리 뒤 남은 네 경기에서 A가 두 번 이상 이기는 이항 확률을 합한다.","decisiveStep":"남은 경기의 승리 횟수 2, 3, 4의 확률 합은 8/9이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"A와 B 농장의 오분류 확률을 각각 0.6×0.02와 0.4×0.03으로 계산해 조건부확률을 구한다.","decisiveStep":"전체 오분류 확률은 0.024이고 A산 오분류 확률도 0.012이므로 비는 1/2이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"A와 B의 독립에서 여사건도 독립임을 적용해 ㄴ과 ㄷ을 확인하고 나머지는 반례식으로 판별한다.","decisiveStep":"P(A∩Bᶜ)=P(A)P(Bᶜ), P(Aᶜ|B)=1-P(A)이므로 ㄴ과 ㄷ만 참이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"수확량 27kg을 표준화해 z=2를 얻고 오른쪽 꼬리 확률을 5000그루에 곱한다.","decisiveStep":"P(Z≥2)=0.5-0.48=0.02이므로 해당 나무는 100그루이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"400회 자유투의 성공 횟수를 평균 320, 표준편차 8인 정규분포로 근사하고 상위 0.07의 경계를 표에서 찾는다.","decisiveStep":"상위 꼬리 0.07은 누적확률 0.93, z=1.5에 해당해 k=320+1.5×8=332이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"표본평균의 중심 80에서 2만큼 떨어진 구간 확률 0.68을 표준정규 넓이와 대응시킨다.","decisiveStep":"한쪽 넓이 0.34는 z=1이므로 2/(10/√n)=1에서 n=25이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"같은 신뢰도에서 구간 길이가 표본 크기의 제곱근에 반비례함을 이용해 10에서 6으로 줄어드는 비를 세운다.","decisiveStep":"6/10=9/√n을 풀면 √n=15이므로 표본 크기는 225이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"표본크기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"표본평균의 표준오차 30/√36=5로 구간 중심 800에서 끝점 791까지의 거리 9를 나눈다.","decisiveStep":"z=9/5=1.8이고 표의 중앙 넓이는 2×0.46=0.92이므로 신뢰도는 92%이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"신뢰구간"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"여섯 개의 리본·인형 작업을 배열하고 각 가방에서 리본 작업이 먼저 오도록 순서를 제한한다.","decisiveStep":"세 가방의 선후 제약은 각각 절반의 배열만 허용하므로 6!/2³=90이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"일렬 배열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"주사위 네 번 중 반시계 이동이 0회, 2회, 4회인 경우를 각각 이항 확률로 계산한다.","decisiveStep":"정사각형을 한 바퀴 돈 이동량이 4의 배수여야 하므로 반시계 횟수는 짝수이고 확률 합은 41/81이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"신뢰구간 길이가 신뢰도에 따른 z값에 비례하고 표본 크기의 제곱근에 반비례함을 보기별로 적용한다.","decisiveStep":"표본 크기 감소와 신뢰도 증가는 길이를 모두 늘리므로 ㄱ만 참이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"신뢰구간"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"표본평균에서 m부터 m+2까지의 넓이 0.34를 표준정규표에서 z=1에 대응시킨다.","decisiveStep":"2/σ(X̄)=1이므로 표본평균의 표준편차는 2이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"P(Aᶜ)=1/4에서 P(A)=3/4를 구한 뒤 조건부확률 정의에 대입한다.","decisiveStep":"P(A∩B)=P(A)P(B|A)=(3/4)(2/5)=3/10이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"95% 구간의 중심 30과 반길이 7.84로 표준오차를 구한 뒤 99%의 z값 2.58을 곱한다.","decisiveStep":"표준오차는 7.84/1.96=4이고 99% 반길이는 10.32이므로 구간은 19.68부터 40.32이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"신뢰구간"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"상자 선택과 공 뽑기를 합친 한 시행의 E(X), E(X²)를 구하고 세 독립 시행의 평균 성질을 적용한다.","decisiveStep":"한 시행의 분산은 97/48이므로 표본평균의 분산은 97/144이고 평균은 11/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
