  "items": [
    { "ordinal": 1, "questionUid": "", "primaryMethod": "$24/x$가 자연수라는 조건을 $x$가 $24$의 양의 약수라는 뜻으로 바꾸어 원소 수를 센다.", "decisiveStep": "$24=2^3\\\\cdot3$이므로 양의 약수는 $(3+1)(1+1)=8$개이다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 뜻과 포함 관계", "l3": "집합과 원소", "l4": "원소나열법·조건제시법" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 2, "questionUid": "", "primaryMethod": "$P(A)$의 원소는 모두 $A$의 부분집합임을 이용하고, 따로 더한 $\\\\{\\\\varnothing\\\\}$만 포함 여부를 검사한다.", "decisiveStep": "$\\\\varnothing\notin A$이므로 $\\\\{\\\\varnothing\\\\}$은 $A$의 부분집합이 아니다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 뜻과 포함 관계", "l3": "부분집합", "l4": "부분집합 판정" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 3, "questionUid": "", "primaryMethod": "대각선 교점 $E(2,0)$을 $A(1,3)$과 $C(a,b)$의 중점으로 놓아 $C$의 좌표를 구한다.", "decisiveStep": "$a=3$, $b=-3$이어서 제4사분면 조건도 맞고 $ab=-9$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "평면좌표", "l3": "선분의 내분·외분", "l4": "내분점" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 4, "questionUid": "", "primaryMethod": "$a-5$가 $A\\\\cap B=\\\\{6\\\\}$의 원소임을 사용해 $a$를 정한 다음 $B-A$를 직접 구한다.", "decisiveStep": "$a=11$이면 $B-A=\\\\{4,12\\\\}$이므로 합은 $16$이다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 연산", "l3": "여집합과 차집합", "l4": "차집합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 5, "questionUid": "", "primaryMethod": "$20$의 양의 약수 여섯 개로 이루어진 집합의 부분집합 수 $2^6$에서 공집합과 전체집합을 뺀다.", "decisiveStep": "$64-2=62$이므로 공집합이 아닌 진부분집합은 $62$개다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 뜻과 포함 관계", "l3": "부분집합", "l4": "부분집합의 개수" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 6, "questionUid": "", "primaryMethod": "$P(k,0)$을 지나는 평행선 $m$을 $x+y-k=0$으로 세우고 두 평행선 사이 거리 조건을 푼다.", "decisiveStep": "$|k+3|/\\\\sqrt2=4\\\\sqrt2$에서 $k=5,-11$을 얻어 합은 $-6$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "직선의 방정식", "l3": "두 직선의 위치 관계", "l4": "평행" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 7, "questionUid": "", "primaryMethod": "$M,N$의 중점 $(1,-2)$에서 직선 $5x-12y+1=0$까지의 거리를 구해 교차 조건 $r>d$를 적용한다.", "decisiveStep": "중심과 직선 사이 거리는 $30/13$이므로 이를 넘는 최소 자연수 반지름은 $3$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원과 직선", "l4": "교점 개수" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 8, "questionUid": "", "primaryMethod": "$P,Q$를 지나는 직선의 기울기 $1/2$에 수직인 이동 후 직선의 기울기를 정하고, 이동 뒤 $(-6,0)$을 지나게 한다.", "decisiveStep": "이동 후 기울기 $-2$이고 $(-6,0)$을 대입하면 원래 절편 $b=-12$라서 $a+b=-14$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "직선의 방정식", "l3": "두 직선의 위치 관계", "l4": "수직" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 9, "questionUid": "", "primaryMethod": "$Q(1,8)$을 $y$축 대칭해 $P(-1,8)$을 얻고 원의 중심을 $(-r,r)$로 놓아 반지름 방정식을 푼다.", "decisiveStep": "$(-1+r)^2+(8-r)^2=r^2$의 두 양의 해가 $5,13$이어서 합은 $18$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원의 접선", "l4": "접점이 주어진 접선" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 10, "questionUid": "", "primaryMethod": "$P(-2,0),Q(2,-3)$을 지나는 직선과 원의 중심 $(-1,3)$ 사이 거리를 구해 현 길이 공식에 넣는다.", "decisiveStep": "중심에서 $3x+4y+6=0$까지 거리는 $3$이므로 현 길이는 $2\\\\sqrt{25-9}=8$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원과 직선", "l4": "현의 길이" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 11, "questionUid": "", "primaryMethod": "색칠 영역을 $A$ 안에서 $B$ 또는 $C$에 속하는 부분으로 읽어 교집합과 합집합으로 나타낸다.", "decisiveStep": "$A$와 $B\\\\cup C$를 겹친 $A\\\\cap(B\\\\cup C)$가 두 색칠 영역을 모두 포함한다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 연산", "l3": "교집합과 합집합", "l4": "집합 연산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 12, "questionUid": "", "primaryMethod": "원점과 매개변수 직선 사이 거리의 제곱을 $k$의 식으로 만들고 완전제곱 부등식으로 최대가 되는 $k$를 찾는다.", "decisiveStep": "$k=5$에서 거리 제곱이 최대이고 직선 $6x+3y-5=0$의 두 절편 길이 합은 $5/2$다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "직선의 방정식", "l3": "점과 직선 사이의 거리", "l4": "도형의 넓이·최소거리" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 13, "questionUid": "", "primaryMethod": "차집합을 여집합과 교집합으로 바꾸고 드모르간 법칙 및 분배 법칙으로 ㄱ, ㄴ, ㄷ의 양변을 정리한다.", "decisiveStep": "세 등식 모두 같은 집합식으로 정리되어 ㄱ, ㄴ, ㄷ이 전부 참이다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 연산", "l3": "집합의 연산법칙", "l4": "드모르간 법칙" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 14, "questionUid": "", "primaryMethod": "$A_n$을 $n$의 배수 집합으로 해석해 두 포함 관계를 각각 $12\\\\mid n$과 $n\\\\mid36$으로 바꾼다.", "decisiveStep": "$36$의 약수 중 $12$의 배수는 $12,36$뿐이므로 가능한 $n$은 두 개다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 뜻과 포함 관계", "l3": "집합의 포함 관계", "l4": "두 집합의 포함" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 15, "questionUid": "", "primaryMethod": "지름 끝점에서 원의 중심 $(-2,3)$과 반지름 $2$를 구한 뒤 이동한 중심의 두 직선까지 거리를 반지름과 같게 둔다.", "decisiveStep": "$b=-1,-5$를 각각 대입한 후보 중 $a+b+1$의 최솟값은 $b=-5$일 때 $-4-2\\\\sqrt2$다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원의 접선", "l4": "기울기가 주어진 접선" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 16, "questionUid": "", "primaryMethod": "$M$이 $OA$의 중점이므로 $A=(12,0)$을 얻고, 직각삼각형 외접원 $C_2$를 지름 $AO$인 원으로 쓴다.", "decisiveStep": "두 반지름은 $6$, 중심 거리는 $8$이므로 공통현의 반쪽 길이는 $\\\\sqrt{36-16}=2\\\\sqrt5$다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "두 원", "l4": "공통현·공통접선 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 17, "questionUid": "", "primaryMethod": "접점 $T(u,v)$를 원 $(x-3)^2+(y+2)^2=16$ 위에 놓고 반지름 $CT$와 접선 $AT$의 수직 조건을 결합한다.", "decisiveStep": "수직 조건을 원의 식에 대입하면 두 접점의 $x$좌표가 모두 $5$여서 합은 $10$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원의 접선", "l4": "접점이 주어진 접선" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 18, "questionUid": "", "primaryMethod": "$G(2,3)$와 $B(0,-2),C(4,10)$에서 무게중심 식으로 $A$를 복원하고 $BC$까지의 거리를 계산한다.", "decisiveStep": "$A=(2,1)$, $BC:3x-y-2=0$이어서 높이는 $|6-1-2|/\\\\sqrt{10}=3/\\\\sqrt{10}$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "평면좌표", "l3": "삼각형의 무게중심", "l4": "좌표 도형 활용" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 19, "questionUid": "", "primaryMethod": "직선 $y=mx$를 원에 대입해 두 교점의 $x$좌표 곱을 구하고 각 원점 거리의 곱으로 바꾼다.", "decisiveStep": "$x_1x_2=-81/(1+m^2)$이고 거리 곱에 $(1+m^2)$가 곱해져 절댓값은 $81$이다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원과 직선", "l4": "현의 길이" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 20, "questionUid": "", "primaryMethod": "$B$를 $18,30$의 공약수 집합으로 구하고 $B$의 원소를 고정한 채 $A-B$의 원소를 선택한다.", "decisiveStep": "$A-B=\\\\{4,8,12,24\\\\}$의 선택은 $16$가지이며 $X=A$인 한 가지를 빼 $15$다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 뜻과 포함 관계", "l3": "부분집합", "l4": "부분집합의 개수" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 21, "questionUid": "", "primaryMethod": "$P,Q$의 중점 $A(2,-3)$에서 $l$에 수직인 직선을 세워 발 $H$를 구하고 점과 직선 사이 거리 $c$를 더한다.", "decisiveStep": "$H=(-3/2,1/2)$라서 $a+b=-1$, $c=7\\\\sqrt2/2$이므로 합은 $-1+7\\\\sqrt2/2$다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "직선의 방정식", "l3": "점과 직선 사이의 거리", "l4": "거리 공식" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 22, "questionUid": "", "primaryMethod": "원을 $(x-3)^2+(y-2)^2=9$로 고쳐 $y$축 접선을 확인하고, 점 $(0,8)$을 지나는 다른 접선의 기울기를 거리 조건으로 정한다.", "decisiveStep": "$|3m+6|/\\\\sqrt{m^2+1}=3$을 제곱해 $36m+27=0$에서 $m=-3/4$를 얻는다.", "rpmPath": { "majorUnit": "도형의 방정식", "midUnit": "원의 방정식", "l3": "원의 접선", "l4": "기울기가 주어진 접선" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 23, "questionUid": "", "primaryMethod": "$A,B$ 선택 인원 합과 차에서 $28,20$을 구한 뒤 교집합 인원 $t$로 합집합 수 $48-t$를 표현한다.", "decisiveStep": "$48-2t\\\\le34$에서 $7\\\\le t\\\\le20$이므로 합집합의 끝값은 $41,28$이고 합은 $69$다.", "rpmPath": { "majorUnit": "집합과 명제", "midUnit": "집합의 연산", "l3": "교집합과 합집합", "l4": "원소 개수" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" }
  ]
