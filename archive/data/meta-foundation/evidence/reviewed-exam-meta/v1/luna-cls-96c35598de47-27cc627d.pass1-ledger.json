  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"$(a-2)x²+(b+3)x+c-1=0이 모든 x에서 성립하므로 x², x, 상수항의 계수를 각각 0으로 둔다.","decisiveStep":"a=2, b=-3, c=1을 얻어 합하면 0이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"P(x)=x³-2x²+kx+4의 x-2 나머지를 P(2)=10으로 놓고 k를 푼다.","decisiveStep":"P(2)=2k+4이므로 2k+4=10에서 k=3이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"f(1)=0과 f(-2)=-12를 이용해 a+b=1, 2a-b=-1의 연립식을 만든다.","decisiveStep":"두 식을 더해 3a=0을 얻고, 이어 b=1을 정한다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"Q(2x-1)의 x-1 나머지는 x=1을 넣은 Q(1)이며, 주어진 나눗셈 나머지 식에 원래 변수 1을 대입한다.","decisiveStep":"x²+x-2=(x+2)(x-1)이므로 Q(1)=3-1=2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"각 명제를 나머지정리로 바꾸어 A(1/2), A(1), A(4)의 값이 같은 조건인지 확인한다.","decisiveStep":"세 보기 모두 같은 대입값을 비교하므로 모두 참이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"S(x)-2x는 1, 2, 3을 근으로 갖는 삼차식이므로 양의 정수 a에 대해 a(x-1)(x-2)(x-3)으로 둔다.","decisiveStep":"S(4)=6a+8이어서 양의 정수 a에서 보기에 있는 값은 14뿐이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"P(x)=ax²+bx+1로 두고 P(x+1)-P(x)를 전개해 2x+2와 계수를 맞춘다.","decisiveStep":"2a=2, a+b=2에서 a=b=1이므로 상수항을 뺀 계수합은 2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"(x+1)⁵+(x-1)⁴의 x와 x+2 나머지를 각각 x=0, x=-2 대입으로 계산한다.","decisiveStep":"두 나머지는 2와 80이므로 합은 82이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"k의 계수와 상수 부분을 분리해 x+y=3, x-2y=0을 얻고 두 변수의 제곱합을 구한다.","decisiveStep":"x=2, y=1이 되어 x²+y²=5이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"R(x)를 ax²+bx+c로 두고 (x-1)² 나머지 조건에 맞춰 a(x-1)²+x+2로 표현한다.","decisiveStep":"x=2에서 a+4=4이므로 a=0이고 R(0)=2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"G(1)=G(-2)=0에서 a+b=3, 4a+b=6을 풀어 계수를 정한 뒤 G(2)를 계산한다.","decisiveStep":"a=1, b=2를 대입하면 G(2)=24가 된다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"항등식에 x=2를 넣어 2a+b=3을 얻고 a=1일 때 Q(1)을 원래 식에서 계산한다.","decisiveStep":"a=b=1일 때 x=1을 넣으면 1=-Q(1)+3이므로 Q(1)=2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"수치대입법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"x=3 대입과 공통인수 x-3으로 나눈 뒤 다시 x=3을 대입해 a,b를 정한다.","decisiveStep":"a=-5, b=6이므로 ab=-30이며 30이라고 한 선택지가 틀리다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"기함수인 삼차식은 x³+px 꼴이고 f(1)=4에서 p를 정한 뒤 f(3)을 구한다.","decisiveStep":"p=3이므로 x-3 나머지는 f(3)=36이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"P(x)=(x²-x+1)Q(x)+2x-1에서 x=-1로 k를 구하고, x³+1의 나머지를 같은 이차식 기준으로 복원한다.","decisiveStep":"k=4이고 R(x)=4(x²-x+1)+2x-1이므로 R(4)=59이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"x의 값과 무관하게 성립하는 $(a-2)x²+(b+3)x+c-1=0$의 각 계수를 0으로 둔다.","decisiveStep":"a=2, b=-3, c=1을 넣어 a+b+c=0을 얻는다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"P(x)=x³-2x²+ax+4의 x-2 나머지를 P(2)=10으로 등식화한다.","decisiveStep":"P(2)=2a+4이므로 a=3이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"P(2x-1)의 x-1 나머지를 구하려고 x=1을 넣어 P(1)을 원래 나눗셈 항등식에서 찾는다.","decisiveStep":"x²+x-2에 x=1을 넣으면 0이 남고, 3x-1은 2가 된다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"x와 y의 계수를 각각 비교해 a+b=3, a-b=-1을 연립한다.","decisiveStep":"a=1, b=2이므로 ab=2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"(x+2)f(x)의 x-3 나머지는 x=3에서의 값이므로 주어진 f(3)=-1을 사용한다.","decisiveStep":"(3+2)f(3)=5(-1)=-5이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"ㄱ은 ax-a²=a(x-a), ㄴ은 P(1), ㄷ은 P(4)로 각각 바꾸어 나머지의 일치 여부를 판정한다.","decisiveStep":"세 조건 모두 같은 근에서의 함수값을 가리켜 항상 참이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"P(1)=0과 P(-2)=-12를 식으로 바꿔 a+b=1, 2a-b=-1을 푼다.","decisiveStep":"a=0, b=1이므로 a-b=-1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"P(0)=1과 P(2)-P(0)=0으로 두 값을 얻고, 나머지 ax+b의 두 조건을 맞춘다.","decisiveStep":"b=1, 2a+b=1에서 a=0이 되어 나머지는 1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"","primaryMethod":"x=2를 대입한 뒤 x²+ax+b를 (x-2)(x+a+2)로 묶어 한 번 더 나머지 조건을 적용한다.","decisiveStep":"a=-3, b=2로 결정되어 a+b=-1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":25,"questionUid":"","primaryMethod":"삼차 제수의 나머지를 R=a(x-1)²+2x+1로 나타내고 x=2에서 F(2)=4를 맞춘다.","decisiveStep":"a=-1이어서 R(x)=-x²+4x이고 계수합은 3이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":26,"questionUid":"","primaryMethod":"두 조건에서 f(2)=4, f(1)=3을 얻고, (x-1)(x-2) 나머지 ax+b의 두 함숫값을 맞춘다.","decisiveStep":"a=1, b=2이므로 R(4)=4+2=6이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":27,"questionUid":"","primaryMethod":"P(x)-x가 1, 2, 3을 근으로 가지므로 양의 정수 a를 써 a(x-1)(x-2)(x-3)으로 둔다.","decisiveStep":"P(4)=6a+4여서 보기에서 가능한 값은 a=1일 때의 10이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":28,"questionUid":"","primaryMethod":"x=1 대입으로 b=2-a를 얻고, x³+ax²-x+2-a를 (x-1)(x+1)(x+a)+2로 묶는다.","decisiveStep":"몫은 (x+1)(x+a)=x²+(a+1)x+a로 확인된다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"수치대입법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":29,"questionUid":"","primaryMethod":"홀수항만 남는 기함수 삼차식을 x³+px로 두고 f(2)=2에서 p를 결정한 뒤 f(3)을 계산한다.","decisiveStep":"p=-3이므로 f(3)=27-9=18이 나머지이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":30,"questionUid":"","primaryMethod":"P=(x²+x+1)Q+x-1에 x=1을 넣어 a=Q(1)=2를 구하고, 삼차식 나머지 R을 같은 이차식의 배수와 x-1로 나눈 나머지의 합으로 둔다.","decisiveStep":"R(x)=2(x²+x+1)+x-1이므로 R(2)=15이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
