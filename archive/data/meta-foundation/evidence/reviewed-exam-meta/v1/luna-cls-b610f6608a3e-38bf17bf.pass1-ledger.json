  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"세제곱근의 몫을 한 근호로 합친 뒤 log 1000=3을 이용해 뺄셈을 한다.","decisiveStep":"∛(81/3)=3이고 (2/3)log 1000=2이므로 차는 1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"로그의 밑 x-2와 진수 -x²+4x+5가 각각 정의되는 정수 x의 범위를 교차한다.","decisiveStep":"밑 조건은 x>2, 진수 조건은 -1<x<5이며 x=3은 밑이 1이라 제외되어 x=4만 남는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"밑과 진수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"부채꼴 넓이를 S=rl/2로 나타내고 주어진 호 길이 π와 넓이 2π를 대입한다.","decisiveStep":"2π=(rπ)/2를 풀어 반지름 r=4를 얻는다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"sinθ<0과 cosθ=-3/5에 맞는 사분면을 정해 sinθ와 tanθ를 계산한다.","decisiveStep":"제3사분면에서 sinθ=-4/5, tanθ=4/3이므로 주어진 선형 결합은 8이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"1을 log₅5로 합쳐 두 로그의 진수를 같게 하고, 원래 진수 조건과 함께 이차방정식을 푼다.","decisiveStep":"(x-4)(x+2)=0 중 x>1을 만족하는 해는 4뿐이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그방정식","l4":"진수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"분자와 우변을 밑 2의 거듭제곱으로 맞춰 지수가 같은 식으로 바꾼다.","decisiveStep":"sinθ-cosθ=3cosθ에서 cosθ≠0을 확인한 뒤 tanθ=4를 얻는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"밑 통일"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"각 거듭제곱근과 네 로그식을 차례로 정리해 보기마다 참·거짓을 확인한다.","decisiveStep":"ㄷ의 근호식과 ㄹ의 밑변환 곱만 참이므로 맞게 계산한 식은 두 개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"t=a^(1/3)을 두어 x=t-t^(-1)을 대입하고 세제곱식의 묶이는 형태를 사용한다.","decisiveStep":"x³+3x=t³-t^(-3)이므로 a-a^(-1)=8/3, 양수 해는 a=3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"t=log x로 두어 열린 범위 1<t<3 안에서 두 로그의 차가 정수인 경우를 찾는다.","decisiveStep":"차의 절댓값 2t는 정수 3,4,5만 가능해 x는 10^(3/2), 10², 10^(5/2)이고 곱은 10⁶이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"log₂5=ab로 나타낸 뒤 log₆45의 분자와 분모를 밑 2의 로그로 바꾼다.","decisiveStep":"분자는 2a+ab, 분모는 1+a이므로 log₆45=(ab+2a)/(a+1)이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"aⁿ=64와 n≥2를 두고 64=2⁶의 약수 지수 n을 조사한 뒤 짝수 지수에서만 음수 해를 포함한다.","decisiveStep":"가능한 정수 a는 -8,-2,2,4,8로 서로 달라 모두 다섯 개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"로그의 합을 곱의 로그로 합쳐 ∏ ln(x+1)/ln x의 연쇄 약분을 만든다.","decisiveStep":"곱은 ln256/ln2=8이라 logₐ8=3이고, 양수 밑 a는 2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"c²=(1-s)(1+s)를 이용해 두 분수의 합을 2/c로 줄인 후 sinθ의 제곱을 구한다.","decisiveStep":"cosθ=-1/3이고 sinθ>0이므로 sinθ=2√2/3, 따라서 tanθ·sinθ=-8/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"반대 방향 동경 조건에서 4θ가 홀수배 π임을 쓰고 주어진 θ 구간에 들어오는 각을 고른다.","decisiveStep":"구간을 만족하는 θ=3π/4를 대입하면 sin(π/3)=√3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"t=log₂x로 치환해 A와 B를 닫힌 구간으로 나타내고 두 구간이 겹칠 끝점 조건을 적용한다.","decisiveStep":"2^(a-1)≤8과 2^(a+1)≥1에서 -1≤a≤4라서 정수는 여섯 개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"t=2^f로 바꿔 지수방정식을 풀고, |3^x-m|이 각 양의 상수와 같을 때의 해 수를 센다.","decisiveStep":"각 순서쌍에서 두 절댓값 방정식의 해 수를 더해 세 실근 조건에 맞지 않는 것은 (2,2)뿐이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"t=log₂x로 놓아 x^(log₂x)<16x³을 밑 2의 이차부등식으로 바꾼다.","decisiveStep":"(t-4)(t+1)<0에서 0≤t<4이고 이에 해당하는 자연수 x는 1부터 15까지다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"한 번에 남는 비율 1-x/100을 일곱 번 곱해 1/5 이하라는 조건을 로그 부등식으로 바꾼다.","decisiveStep":"계산된 경계는 x≥20.6이므로 이를 만족하는 최소 자연수는 21이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"s=sinθ, c=cosθ로 놓고 c를 곱해 sc와 s+c의 관계를 만든 뒤 u=s+c로 치환한다.","decisiveStep":"3u²-8u-3=0의 해 중 |u|≤√2를 만족하는 값은 -1/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
