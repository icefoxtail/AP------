  "items":[
    {"ordinal":1,"questionUid":"qid_v1_d447660bf92de0c32598d6016a76d92d75636b3ce18b396092c2e0ead6fefa9a","primaryMethod":"두 각 40°, 80°에서 각 B를 구한 뒤 외접원 반지름 4를 사인법칙에 넣는다.","decisiveStep":"B=60°이므로 CA=2×4×sin60°=4√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"외접원 반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"qid_v1_0ba116d8cd94031798f9677e847e21d0681865e04592975226a02166b5d43035","primaryMethod":"외접원의 넓이 16π에서 반지름을 구해 BC/sinA=2R에 대입한다.","decisiveStep":"R=4, BC=4이므로 sinA=4/8=1/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"외접원 반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"qid_v1_47ffa8de4c89c0a51a3b7944fee287f1771ec3ffde3814cb79f3310e5106a15d","primaryMethod":"그림의 AB=7, BC=4√2와 끼인각 B=3π/4를 삼각형 넓이 공식에 넣는다.","decisiveStep":"넓이는 (1/2)×7×4√2×sin(3π/4)=14이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"두 변과 끼인각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"qid_v1_32944fd0cf1fadbb9fa512b243da95df5f46750daeb3350c59c706c03871cfd1","primaryMethod":"첫째항 -5와 공차 3으로 f(n)을, 첫 두 항 3과 1로 g(n)을 각각 세운다.","decisiveStep":"f(n)=3n-8, g(n)=5-2n이므로 f(3)+g(2)=1+1=2이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"qid_v1_3eb6eaf0f70a020a1c16d923ef2162e011ecdc8916025fcab299dcb41e152e21","primaryMethod":"등비수열의 제5항을 첫째항에 공비의 네제곱을 곱해 두 수열에서 각각 구한다.","decisiveStep":"16(-1/2)⁴=1이고 (1/9)×3⁴=9이므로 두 항의 합은 10이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"qid_v1_45cc7a076ecea05dadf36fbf4e208841b53a24bad499f38156c8686de4d1a11f","primaryMethod":"a₁₀-a₃=29-8에서 공차를 구하고 첫째항을 복원해 등차수열의 합을 계산한다.","decisiveStep":"7d=21에서 d=3, a₁=2이므로 S₂₀=10(2×2+19×3)=610이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"qid_v1_998bcc0ef4af4710f8bae5859834269d7589d83d63e59a0e644a54e8fa13940e","primaryMethod":"다섯째항부터 여덟째항의 합이 r⁴S₄임을 이용해 S₈=85와 S₄=5를 연결한다.","decisiveStep":"r⁴=16에서 r=±2이나 r=-2이면 첫째항이 -1이므로 r=2, a₁=1/3이고 합은 7/3이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"qid_v1_d29d507a64ae0a70318e7440a65e9fea9e2eddd0d3a46e83ee0011ef7ec8ad80","primaryMethod":"합의 분배와 상수배 성질에 Σaₖ=-5, Σbₖ=10을 넣고 곱의 합과 합의 곱을 구분한다.","decisiveStep":"Σ(aₖbₖ)는 (Σaₖ)(Σbₖ)와 일반적으로 같지 않으므로 -50이라는 세 번째 등식은 주어진 합만으로 성립하지 않는다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"합의 기호 Σ","l4":"성질"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"qid_v1_3887f058958902f70d67801d73eb7d6d0000c85732af0bacbc78f56534028ec2","primaryMethod":"a₂=u, 공차를 d로 놓아 등비중항 조건 (u+2d)²=u(u+5d)를 세운다.","decisiveStep":"d≠0에서 u=4d이므로 a₁₂/a₅=(u+10d)/(u+3d)=14d/7d=2이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"중항"},"crossConceptKeys":[],"conditionKeys":["COND_NONZERO"],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":10,"questionUid":"qid_v1_23ac1ca5dafe6261622321346cd55f012da9d20e9f495608c2aebb0f96b9557c","primaryMethod":"삼각형 ABC에서는 C=π/3을 구해 사인법칙을 쓰고 DEF에서는 EF=√13의 맞은편 각 D에 코사인법칙을 쓴다.","decisiveStep":"a=4이고 13=8+b²-4b에서 양의 길이 b=5를 택하므로 a+b=9이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"PARALLEL"},
    {"ordinal":11,"questionUid":"qid_v1_5c3d06103a7f24d538d78117a94330f79d34e7951629980584f133561e19b7da","primaryMethod":"호의 비 5:5:2를 각 75°, 30°, 75°로 바꾸고 반지름 2에서 두 같은 변을 구해 넓이를 계산한다.","decisiveStep":"AB=BC=4sin75°이므로 넓이는 4sin²75°=2+√3이고 p/q=2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"두 변과 끼인각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":12,"questionUid":"qid_v1_f9096e0bda7500c0d037154d9b11ff59d63abd5a97fb766253a8ec2acffc5aae","primaryMethod":"원에 내접한 사각형을 대각선 AC로 나누고 B+D=180°를 이용해 두 코사인법칙의 AC²를 같게 놓는다.","decisiveStep":"34-30cosB=98+98cosB에서 cosB=-1/2이므로 넓이는 (15+49)sinB/2=16√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"복합도형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":13,"questionUid":"qid_v1_4aa63920150d8d56bd80c8f8d149db0cd66d1825563b6bfe360aae7c6fb2b0de","primaryMethod":"등차수열의 첫째항을 a, 공차를 d로 두어 S₆+S₁₂를 a₃+a₈과 같은 일차식의 배수로 나타낸다.","decisiveStep":"S₆+S₁₂=18a+81d=9(2a+9d)=9(a₃+a₈)이므로 117이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"qid_v1_0c6f9b34677686c58aa0e4968b1c2ecf7ab6dc376ba402acfdd805d00d6b19c2","primaryMethod":"Sₙ=3×2ⁿ⁺¹-6의 이웃한 두 합의 차로 a₂, a₄, a₆을 구한다.","decisiveStep":"n≥2에서 aₙ=3×2ⁿ이므로 a₂+a₄+a₆=12+48+192=252이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"계차수열","l4":"일반항 구하기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"qid_v1_63fb844a4bb7021e0cf4dd26ebcbc13f710d30e52ceb55409ada86d25ad68c97","primaryMethod":"a₃ₖ=6k-1과 b₂ₖ=6×9ᵏ⁻¹로 바꾸어 다섯 항의 등차합과 등비합을 따로 계산한다.","decisiveStep":"Σa₃ₖ=85, Σb₂ₖ=(3/4)(9⁵-1)이므로 p=85, q=9, r=5이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"합의 기호 Σ","l4":"Σ 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"PARALLEL"},
    {"ordinal":16,"questionUid":"qid_v1_4258c72db302810ab1a0e2781d56dd7eed23b4a39530f3c68596169f8934f0c0","primaryMethod":"a₁=41, a₇=11에서 공차 -5를 구해 |46-5n|이 가장 작은 자연수 n을 찾는다.","decisiveStep":"46/5=9.2의 양옆 n=9, 10에서 절댓값은 1, 4이므로 n=9이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"qid_v1_7ebf5899c0212d328adca2395266d0febc1a29e20231d7d4d6bb325eff2172bf","primaryMethod":"홀수 번째 항 a₂ₙ₋₁=2ⁿ을 구하고 S₂ₙ-S₂ₙ₋₂=0으로 짝수 번째 항을 연결한다.","decisiveStep":"n≥2에서 a₂ₙ=-2ⁿ이므로 a₁₀-a₁₄=-32-(-128)=96이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":18,"questionUid":"qid_v1_26d1f839135444bc82b89faef2774ab1cf2cf6aceb38f18a62f444790dd608f8","primaryMethod":"a₄=6a₂+a₃을 공비 r의 방정식으로 바꾸고 양수 공비를 정해 15항의 합을 구한다.","decisiveStep":"r²-r-6=0에서 r=3을 택하면 S₁₅+1=3¹⁵이므로 로그값에 5를 더한 결과는 20이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":19,"questionUid":"qid_v1_659f7ce7090947096741483b29bda7a75b091f9e2573e018f77212a2f3cf8ff4","primaryMethod":"매월 초 납입액의 이자가 한 달부터 만기까지 붙도록 A는 공비 1.005의 12항, B는 공비 1.006의 24항을 합친다.","decisiveStep":"a=200000×1.005×0.06/0.005=2412000, b=100000×1.006×0.15/0.006=2515000이므로 차는 103000원이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"qid_v1_22e7ead77235cb1512397ebf3a503335094748f6fe4fad5ba59107773e8c1df7","primaryMethod":"지수 n(n+1)/2의 홀짝에 따라 aₙ의 부호가 -1, -1, 1, 1로 반복됨을 이용해 네 항씩 묶는다.","decisiveStep":"각 네 항 묶음의 가중합은 4이므로 28항까지 28이고 마지막 -29-30을 더하면 -31이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"귀납적 패턴"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"qid_v1_fe3ad1916c0f9225a955ad97d92d0272c252dcc7f055186b8e69dcd0c69c6f3a","primaryMethod":"sinA/sinB=cosC를 사인법칙으로 a/b=cosC로 고치고 코사인법칙을 대입한다.","decisiveStep":"2a²=a²+b²-c²에서 b²=a²+c²를 얻으므로 각 B가 90°인 직각삼각형이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"삼각형 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":23,"questionUid":"qid_v1_d6f6824518ec4d7356765d58492f3dd2a884b2a7e313f55f6baf5ce46f038e04","primaryMethod":"Sₙ=-n²+9n-10에서 첫째항 S₁과 n≥2의 차 Sₙ-Sₙ₋₁을 구분해 양수 조건을 푼다.","decisiveStep":"a₁=-2이고 n≥2에서 aₙ=10-2n이므로 aₘ>0인 자연수 m은 2, 3, 4이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"계차수열","l4":"일반항 구하기"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"qid_v1_10c326dbfa30ee8a343e8442de696ea14a6ab02c1a5362b2f7e7bcc3e865a39c","primaryMethod":"1/((2k-1)(2k+1))을 (1/2)(1/(2k-1)-1/(2k+1))로 나누어 열 항을 소거한다.","decisiveStep":"합은 (1/2)(1-1/21)=10/21이므로 서로소인 p=10, q=21에서 p+q=31이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"여러 가지 수열의 합","l4":"부분분수·망원급수형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":25,"questionUid":"qid_v1_15bf922ec6793c624f46a4774aca912ab0d27ba6ebe0c2234a4c6310f8a94da8","primaryMethod":"n=1에서 1/2=1/2를 확인하고 n=k의 합이 k/(k+1)이라는 가정에 다음 항을 더한다.","decisiveStep":"k/(k+1)+1/((k+1)(k+2))=(k+1)/(k+2)이므로 n=k+1의 등식이 성립한다.","rpmPath":{"majorUnit":"수열","midUnit":"수학적 귀납법","l3":"수학적 귀납법","l4":"등식 증명"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
