  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"반대 방향인 두 동경의 차를 홀수배 π로 두고 0<θ<π의 정수 해를 찾는다.","decisiveStep":"6θ=(2n+1)π에서 범위에 맞는 θ는 π/6, π/2, 5π/6이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"둘레 24에서 호 길이를 24−2r로 놓고 넓이를 반지름의 이차식으로 최대화한다.","decisiveStep":"r=6일 때 넓이 36, 호 길이 12라서 중심각은 2이고 A+B=38이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":3,"questionUid":"","primaryMethod":"분수 두 항을 통분해 2/cos²θ=5/2를 얻고 제2사분면의 부호를 적용한다.","decisiveStep":"cosθ=−2/√5, sinθ=1/√5이므로 cosθ/(1−sinθ)=−(√5+1)/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":4,"questionUid":"","primaryMethod":"5π/12와 π/3을 각각 π/2−π/12와 π/2−π/6으로 바꾸어 앞의 제곱 사인과 짝짓는다.","decisiveStep":"두 여각 쌍은 각각 1이고 sin²(π/4)=1/2라서 합은 5/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"sin ax의 주기 2π/a를 |tan x|의 주기 π와 같게 둔다.","decisiveStep":"2π/a=π에서 양수 a=2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"기본 그래프","l4":"tan"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"π/20부터 9π/20까지 sin² 항을 π/2를 기준으로 대칭인 네 쌍과 가운데 항으로 묶는다.","decisiveStep":"네 쌍이 각각 1이고 가운데 sin²(π/4)=1/2이므로 합은 9/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"sin x를 cos(π/2−x)로 바꾸어 cos 두 각이 같은 경우와 반대 방향인 경우를 푼다.","decisiveStep":"구간 안의 근 π/8, 5π/8, 3π/4의 합은 3π/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
