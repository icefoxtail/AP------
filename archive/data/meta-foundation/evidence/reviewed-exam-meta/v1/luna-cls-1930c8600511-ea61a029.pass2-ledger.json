    {"ordinal":9,"questionUid":"","primaryMethod":"대각선 AC²를 두 삼각형에서 코사인법칙으로 나타내고 내접 사각형의 보각 관계를 쓴다.","decisiveStep":"25−24cosB=13+12cosB에서 cosB=1/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":10,"questionUid":"","primaryMethod":"세 합의 비에서 a,b,c를 각각 구해 7:5:3으로 만든 뒤 코사인법칙을 쓴다.","decisiveStep":"cosA=−1/2이고 삼각형 안각이므로 sinA=√3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"SEQUENTIAL"},
