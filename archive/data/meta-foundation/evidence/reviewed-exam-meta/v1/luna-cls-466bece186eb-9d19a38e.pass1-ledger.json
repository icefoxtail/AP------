  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"100회 시행의 성공확률이 1/5인 이항분포 B(100,1/5)에서 분산 np(1-p)를 계산한다.","decisiveStep":"100×1/5×4/5=16이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"X의 평균 18×1/3을 먼저 구한 뒤 Y=3X+2의 기댓값 선형성을 적용한다.","decisiveStep":"3×6+2=20이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"E(X)=1/2와 σ(X)=2를 Y=-4X+1에 적용해 평균과 표준편차를 따로 구한다.","decisiveStep":"E(Y)=-1이고 σ(Y)=8이므로 두 값의 합은 7이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"1,1,2,3 네 숫자의 평균이 7/4이고 표본평균의 기댓값은 모평균과 같음을 쓴다.","decisiveStep":"복원 여부와 관계없이 E(표본평균)=7/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"X가 0,1,2일 확률로 E(X)와 E(X²)를 계산해 V(X)=E(X²)-E(X)²를 적용한다.","decisiveStep":"E(X)=1, E(X²)=4/3이므로 분산은 1/3이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"2차전까지 1승 1패인 A가 3차전과 4차전을 모두 이기는 경우와 5차전까지 가서 우승하는 경우를 더한다.","decisiveStep":"두 경로의 확률은 1/9와 4/27이어서 합은 7/27이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"주사위 4회에서 4의 약수가 나온 횟수 X를 B(4,1/2)로 두고 좌표 3X-4가 양수인 경우를 센다.","decisiveStep":"3X-4>0은 X≥2이므로 6+4+1을 16으로 나눠 11/16이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"P(X≤17)=P(X≥23)의 같음으로 정규분포 중심을 두 경계값의 중점에서 찾는다.","decisiveStep":"평균 m은 20이고 P(X≥m)=1/2이므로 곱은 10이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"N(50,4)의 표준편차 2로 47과 52를 표준화해 각각 -1.5와 1로 바꾼다.","decisiveStep":"구간 확률은 표의 양쪽 넓이 0.4332+0.3413=0.7745이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"모표준편차 5인 모집단에서 신뢰구간 길이 조건 2×1.96×5/√n≤2를 푼다.","decisiveStep":"n≥96.04이므로 가능한 가장 작은 자연수는 97이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"표본크기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"A와 B의 독립성을 Aᶜ와 B, A∩B의 여사건, 합집합 공식에 각각 연결해 세 명제를 확인한다.","decisiveStep":"독립이면 Aᶜ와 B도 독립이고 P(A∩B)=P(A)P(B)이므로 세 등식 모두 성립한다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"밀도 k|x|+k를 -1부터 0, 0부터 2로 나누어 적분 합이 1이 되도록 k를 정한다.","decisiveStep":"정규화로 k=2/11을 얻고 0≤x≤1의 적분은 3/11이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"앞면 횟수 X에 대해 최종 점수 4X-100≥120을 세우고 X의 정규근사 분포에서 55를 표준화한다.","decisiveStep":"표준화값 1에서 오른쪽 꼬리는 0.5-0.3413=0.1587이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"만족 응답자 수를 평균 320, 표준편차 8인 이항분포의 정규근사로 보고 324와 k를 표준화한다.","decisiveStep":"0.2857에 0.1915를 더해 표준정규 넓이 0.4772에 해당하는 값 2를 얻어 k=336이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"표본 100개의 평균 표준오차는 1/10이고 신뢰구간 반길이 0.1에서 표준정규 임계값을 구한다.","decisiveStep":"임계값 1의 가운데 확률은 2×0.3413=0.6826이므로 신뢰도는 68.26%이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모평균 추정","l4":"신뢰구간"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"평균 70에서 75.2까지의 표준점수 1.04로 σ를 구하고 상위 10%의 표준점수 1.28로 x를 구한다.","decisiveStep":"σ=5, x=76.4여서 σ+x=81.4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"구간 [0,10]이 정규분포 평균 k를 기준으로 어떻게 놓이는지 대칭을 이용해 ㄱ, ㄴ을 판별하고 중심이 5일 때의 확률을 비교한다.","decisiveStep":"대칭 관계는 f(k)=f(10-k)이므로 ㄴ은 틀리고 ㄱ과 ㄷ은 맞다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"독립인 칫솔 4개의 합 무게는 평균 80, 분산 64인 정규분포로 보고 왼쪽 꼬리 0.0228을 표준화한다.","decisiveStep":"꼬리 확률 0.0228은 표준점수 -2에 해당하므로 x=80-16=64g이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"표본 9개씩의 평균 표준편차는 수박 5, 멜론 3이므로 동일한 양쪽 꼬리 확률에서 표준점수 크기를 같게 놓는다.","decisiveStep":"(k-3m)/5=-(k-m)/3을 풀어 k/m=7/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"4장 중 홀수 둘을 먼저 뒤집을 확률을 이용해 X=1,2,3일 때 첫 짝수가 나오는 순서를 각각 계산한다.","decisiveStep":"P(X=2)=1/3이고 P(X=3)=1/6이 되며 남은 P(X=1)=1/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"X의 확률 1/2,1/3,1/6을 이용해 E(X)와 E(X²)를 구해 분산 공식을 적용한다.","decisiveStep":"E(X)=5/3, E(X²)=10/3이므로 V(X)=5/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"p₂,p₃,p₄를 p₁로 차례로 표현하고 네 확률의 합이 1이라는 식으로 첫 확률을 정한다.","decisiveStep":"누적 차이가 10/30이므로 4p₁=2/3, p₁=1/6이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"이차식 (X-2)(X-3)≤0에서 X가 2 또는 3임을 얻고 p₂와 p₃를 p₁=1/6에서 계산한다.","decisiveStep":"p₂=1/5, p₃=4/15이므로 합은 7/15이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"","primaryMethod":"95% 신뢰구간 길이를 2×1.96×σ(X̄)=23.52로 두어 표본평균 표준편차를 구한다.","decisiveStep":"23.52를 3.92로 나누면 σ(X̄)=6이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
