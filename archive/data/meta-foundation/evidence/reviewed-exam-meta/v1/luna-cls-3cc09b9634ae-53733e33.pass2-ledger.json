  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"분자와 분모를 각각 x²으로 나누어 (2−1/x²)/(1−1/x²)의 극한을 구한다.","decisiveStep":"1/x²이 0으로 가므로 남는 최고차항 계수의 비는 2/1이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"1−4/x와 1+5/x의 양끝 극한을 각각 계산해 f(x)를 사이에 둔 값을 정한다.","decisiveStep":"두 경계식이 모두 1로 수렴하므로 샌드위치 정리로 f(x)의 극한도 1이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"4x²−3x+2를 항별로 미분해 8x−3을 만든 뒤 x=2를 대입한다.","decisiveStep":"도함수값은 8·2−3=13이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"구간 [1,2]와 [2,4]에서의 함숫값 변화량 3과 2를 합한 다음 전체 구간 길이 3으로 나눈다.","decisiveStep":"전체 변화량은 3+2=5이므로 평균변화율은 5/3이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"평균값 정리 기초","l4":"변화율"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"그래프에서 좌우 높이가 다른 x=0을 극한 불존재점으로 잡고, 열린구간 안의 불연속점 −1, 0, 1을 센다.","decisiveStep":"a=0, b=3이어서 a+b=3이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속의 뜻","l4":"한 점에서의 연속"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"각 보기의 입력이 접근하는 조각을 확인하고 x=−1에서 좌우식을 따로 대입해 비교한다.","decisiveStep":"왼쪽 식 1/(x+1)+2는 −무한대로 발산하고 오른쪽 식은 1로 가서 양쪽 극한이 다르다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"좌극한·우극한"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"x=1을 대입해 b=−a를 얻고, x−1=(√x−1)(√x+1)로 약분한 식의 연속값을 이용한다.","decisiveStep":"약분한 함수의 x=1 극한은 a/2이므로 a=6, b=−6이고 a−b=12이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"절댓값의 꼭짓점 x=−1과 양끝 x=−3, 2에서 |x+1|+2를 비교한다.","decisiveStep":"최솟값은 2, 최댓값은 5이므로 합은 7이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속함수의 성질","l4":"최대·최소 정리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"ㄱ과 ㄴ에는 각각 반례를 대고, ㄷ은 g=(f+g)−f로 고쳐 극한의 차를 본다.","decisiveStep":"ㄷ만 항상 참이므로 맞는 설명은 ㄷ 하나다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"x=1에서 좌우 함수값을 맞춘 식 a−b=5와 양쪽 도함수  a, 3+2b를 같게 둔다.","decisiveStep":"두 조건에서 b=2, a=7이 되어 a+b=9이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"분자에 f(1)을 더하고 빼서 두 차분을 미분계수 정의로 바꾸며 증분 −2h와 h의 배수를 맞춘다.","decisiveStep":"주어진 극한은 −(2/3)f′(1)−(1/3)f′(1)=−f′(1)이므로 f′(1)=−2이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"분모 x²−4의 영점에서 f(2)=3을 얻고, 분모를 (x−2)(x+2)로 나눠 f′(2)를 정한다.","decisiveStep":"극한은 f′(2)/4=1이므로 접선은 y−3=4(x−2), y절편은 −5다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"접선","l4":"접선의 방정식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"(1,−3)에서 기울기 −1인 접선 y=−x−2를 만든 뒤 곡선과 연립해 두 번째 교점을 찾는다.","decisiveStep":"교점식 (x−1)²(x+2)=0에서 B의 x좌표는 −2이고 그곳의 도함수값은 8이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(1)","l3":"접선","l4":"접점 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"h(x)=x²f(x)−2x−1의 여섯 점 값을 이용해 사잇값 정리의 근 하한을 세운 뒤, 점들을 잇는 구체적인 연속함수로 그 하한이 달성됨을 확인한다.","decisiveStep":"모든 함수에서 세 열린구간에 하나씩과 x=1에서 한 근이 강제되며, 선분 연결 함수에서는 추가 근이 없어 최소는 4다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속함수의 성질","l4":"사잇값 정리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"f(x+y)=f(x)+f(y)+2xy−f(0)을 x에 대해 미분해 f′(x+y)=f′(x)+2y를 얻는다.","decisiveStep":"x=0, y=2를 넣으면 f′(2)−f′(0)=4이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"첫 무한대 조건에서 f(x)=x³−4x²+ax+b로 두고, x=2에서의 영점 및 미분계수 조건으로 a,b를 정한다.","decisiveStep":"f(2)=0과 f′(2)=5에서 a=9, b=−10이므로 f(1)=−4다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"첫 조건에서 xf(x)→5, 둘째에서 g(x)/x→4를 얻어 f(x)g(x)=(xf(x))(g(x)/x)로 바꾼다.","decisiveStep":"곱의 극한은 20이고 전체 식의 극한은 2·20−3·5=25다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"f의 차수를 n이라 두고 (f′)²의 차수 2(n−1)가 x⁴항과 맞아야 함을 이용해 삼차식으로 정한 뒤 계수를 비교한다.","decisiveStep":"계수 비교로 f(x)=x³−x²/4+1이 되어 f(2)=8이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"AP=BQ=t로 두고 P=(3−t,0), Q=(0,2+t)를 지나가는 직선과 AB를 연립해 교점 R을 구한다.","decisiveStep":"연립식에서 R의 좌표는 ( (9−3t)/5, (4+2t)/5 )이므로 t→0에서 (9/5,4/5)에 간다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"(x−1)²이 인수이면 x=1에서 f(1)=0과 f′(1)=0을 세워 a,b를 구한다.","decisiveStep":"f′(1)=3+2a=0에서 a=−3/2이고 f(1)=0에서 b=1/2다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"f의 점프점 0과 1에서 안쪽 함수의 좌우 극한값을 각각 대입해 g(1)=g(2)=g(3) 조건을 세운다.","decisiveStep":"두 등식은 3a+b=−7, 5a+b=−19이므로 a=−6, b=11이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"구간별 함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"세 분모가 x=1에서 0이 되므로 f(1), f(2), f(3)이 모두 0인 삼차식 a(x−1)(x−2)(x−3)으로 놓는다.","decisiveStep":"세 극한은 각각 2a, −2a, 6a라서 6a=12이고 f(0)=−12다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
