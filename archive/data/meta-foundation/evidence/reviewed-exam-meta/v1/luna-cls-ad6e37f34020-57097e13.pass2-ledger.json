  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"독립사건의 교집합 확률을 P(A)P(B)로 놓아 1/6=(1/3)P(B)를 푼다.","decisiveStep":"양변을 1/3으로 나누면 P(B)=1/2이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-INDEPENDENCE","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립사건의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"이항분포 B(12,1/3)의 시행 횟수와 성공 확률을 평균 공식 E(X)=np에 넣는다.","decisiveStep":"12·1/3=4이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-RANDOM_VARIABLE","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"x²-3x+2를 인수분해해 확률변수 값 중 1과 2만 조건을 만족함을 찾고 전체 확률이 1임을 쓴다.","decisiveStep":"a+b=1-0.1-0.2=0.7이므로 구하는 확률은 0.7이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-PROBABILITY_DISTRIBUTION","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"선형변환 평균 E(3X-a)=3E(X)-a를 145와 같게 놓는다.","decisiveStep":"150-a=145에서 a=5이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-RANDOM_VARIABLE","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"값이 실수 구간에서 연속적으로 측정되는 항목과 정수 횟수로 세는 항목을 구분한다.","decisiveStep":"당도, 달리기 시간, 주행 거리는 연속 측정값이고 관람객 수와 성공 횟수는 이산값이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-PROBABILITY_DISTRIBUTION","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"4회 중 3회 4 이하가 나오는 경우를 고르고 성공 확률 2/3과 실패 확률 1/3을 곱한다.","decisiveStep":"C(4,3)(2/3)^3(1/3)=32/81이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"이항형 시행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"쓴맛을 좋아하는 사건으로 조건을 걸어 여학생이면서 쓴맛인 확률을 전체 쓴맛 확률로 나눈다.","decisiveStep":"(0.4·0.05)/(0.6·0.10+0.4·0.05)=1/4이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-CONDITIONAL_PROBABILITY","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"참여한 70명만 표본공간으로 삼고 그중 남학생 38명의 비율을 계산한다.","decisiveStep":"38/70을 약분하면 19/35이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-CONDITIONAL_PROBABILITY","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"A가 첫 여섯 경기에서 네 번 이기고 일곱 번째를 이겨 우승하는 순서를 조합으로 세어 각 경기 확률을 곱한다.","decisiveStep":"C(6,4)(1/3)^5(2/3)^2=20/729이므로 a+k=20+6=26이다.","standardUnitKey":"H15-PS-03","subUnitKey":"H15-PS-03-PROBABILITY_APPLICATION","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"확률밀도함수 아래 전체 삼각형 넓이를 1로 두어 a를 구하고 0부터 1까지 넓이의 여사건으로 P(X≥1)을 계산한다.","decisiveStep":"a=2, P(X≥1)=3/4이므로 a+b=11/4이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-PROBABILITY_DISTRIBUTION","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"228번째의 누적 비율 0.0228을 표준정규분포표의 왼쪽 꼬리와 맞춰 z=-2로 표준화한다.","decisiveStep":"x=450+10(-2)=430점이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"공통 대칭축을 평균으로 읽고 두 정규곡선의 높이와 폭으로 분산의 대소를 비교하며 밀도함수의 전체 넓이를 확인한다.","decisiveStep":"좁고 높은 f의 분산이 더 작고 두 밀도함수의 전체 넓이는 각각 1이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-PROBABILITY_DISTRIBUTION","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"한 번의 시행에서 받을 금액의 기댓값을 빨간 공과 파란 공의 보상에 확률을 곱해 더한 뒤 400회를 곱한다.","decisiveStep":"회당 기댓값은 20원이므로 총 기댓값은 8000원이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-RANDOM_VARIABLE","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"정상·확진 각각의 사전확률과 음성 판정 확률을 곱해 음성 전체 확률을 만들고 베이즈 공식으로 조건을 뒤집는다.","decisiveStep":"확진 음성은 3/500, 전체 음성은 395/500이므로 조건부확률은 3/395이고 p+q=398이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-TOTAL_BAYES","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"X를 표준화해 10부터 13까지의 확률을 표에서 읽고 Y의 왼쪽 꼬리 확률로 평균 위치를 얻는다.","decisiveStep":"Y의 기준점은 z=-1.5이고 10-σ/2는 z=-2이므로 오른쪽 꼬리는 0.9772이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"불량 확률을 표준화해 0.02로 구한 뒤 이항분포의 평균 50과 표준편차 7로 정규근사한다.","decisiveStep":"상위 0.02 꼬리는 z=2이므로 n=50+2·7=64이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"두 동전 결과로 주머니 선택 확률을 나누고 각 주머니에서 검은 공 두 개를 뽑을 확률을 조합으로 구한 뒤 조건부확률을 계산한다.","decisiveStep":"P(H∩K)=1/60, P(K)=1/6이므로 P(H|K)=1/10이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-TOTAL_BAYES","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"복소수 거듭제곱 식을 n의 나머지별로 나누어 사건이 되는 카드 네 장을 찾고 이항분포를 정규근사한다.","decisiveStep":"p=1/4일 때 평균 300, 표준편차 15이며 315와 330은 z=1,2이므로 확률은 0.1359이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"84점을 표준화해 상위 10% 순위를 48명으로 추정하고 포기자 수의 이항분포를 정규근사해 k를 비교한다.","decisiveStep":"k=44이면 기준 꼬리 확률이 0.98보다 작고 k=45이면 0.98보다 커서 최소값은 45이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-BINOMIAL_NORMAL","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"세 번의 주사위 결과에서 P와 Q의 좌표를 이동 횟수로 나타내고 원과 선분이 한 점에서 만나는 경우를 안팎 판정으로 분류한다.","decisiveStep":"한 점에서 만나려면 한 끝점만 원 밖이어야 하므로 p=5/12, 24p=10이다.","standardUnitKey":"H15-PS-03","subUnitKey":"H15-PS-03-PROBABILITY_APPLICATION","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"확률의 합이 1인 식에서 a를 정한 다음 E(X), E(X²)를 계산해 분산과 선형변환 분산을 구한다.","decisiveStep":"a=1/2에서 V(X)=5/4-(1/2)²=1이고 V(3X-2)=9이다.","standardUnitKey":"H15-PS-05","subUnitKey":"H15-PS-05-RANDOM_VARIABLE","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"한 시행의 주사위 결과를 공을 담는 경우와 카드 두 장을 담는 경우로 나누고, 공과 카드 수가 같은 시점과 마지막 총량 조건을 누적 횟수로 표현한다.","decisiveStep":"공과 카드가 같아지는 경우는 세 번째 시행 뒤 약수 두 번이며 조건부확률 P(E∩C)/P(C)=60/131이다.","standardUnitKey":"H15-PS-04","subUnitKey":"H15-PS-04-CONDITIONAL_PROBABILITY","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
