  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"흰 공 4개와 검은 공 3개 중 4개를 뽑을 때 흰 공이 없는 경우를 여사건으로 살핀다.","decisiveStep":"검은 공이 3개뿐이라 4개를 모두 검은 공으로 뽑을 수 없어 확률은 1이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"버스 이용 학생 30명을 조건의 전체로 두고 그중 A학급 학생 12명의 비율을 구한다.","decisiveStep":"A학급이면서 버스 이용인 12명을 버스 이용 30명으로 나눠 2/5를 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"P(A)=p, P(B)=1-p로 두고 독립인 A와 B의 여사건 교집합 확률을 p²=1/9로 놓는다.","decisiveStep":"확률이 양수이므로 p=1/3이고 P(B)=1-p=2/3이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립사건의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"공정한 동전을 50번 던진 앞면 횟수를 B(50,1/2)로 보고 분산 npq를 적용한다.","decisiveStep":"50×1/2×1/2=25/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"x=1,2,3,4일 때 (2a-x)/30 네 값을 더해 확률의 총합 1과 같게 둔다.","decisiveStep":"(8a-10)/30=1을 풀어 a=5를 얻는다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"남학생 4명과 여학생 5명 중 3명을 뽑는 조합에서 남학생이 2명 또는 3명인 경우를 합한다.","decisiveStep":"유리한 경우는 30+4=34, 전체는 84라서 확률은 17/42이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"확률표에서 a+1/9+a+2/9=1을 풀어 각 값의 확률을 정한 뒤 xP(X=x)를 모두 더한다.","decisiveStep":"a=1/3을 대입해 2×1/3+4×1/9+6×1/3+8×2/9=44/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"곱셈정리로 A와 B의 교집합을 구하고 합집합의 여사건을 A의 여사건 확률로 나눈다.","decisiveStep":"P(A∩B)=1/12, P(A∪B)=5/6이어서 P(Bᶜ|Aᶜ)=(1/6)/(3/4)=2/9이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"A와 Bᶜ가 배반이므로 A가 B 안에 포함됨을 이용해 B를 A와 Aᶜ∩B로 나눈다.","decisiveStep":"P(B)=1/3+1/6=1/2이므로 P(Bᶜ)=1/2이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"이차방정식의 두 근 n/2와 n/3 중 하나가 정수인 조건을 n의 2의 배수 또는 3의 배수 여부로 바꾼다.","decisiveStep":"20 이하에서 2의 배수 10개와 3의 배수 6개 중 겹치는 6의 배수 3개를 빼 13/20을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"주사위가 6일 때 A에서 흰 공, 나머지일 때 B에서 흰 공이 나오는 두 경로의 확률을 곱해 더한다.","decisiveStep":"P(A와 흰 공)=1/10, 전체 흰 공 확률=1/10+1/3=13/30이므로 조건부 비율은 3/13이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"1학년 이용 경험자 수를 x라 놓고 전체 이용자 수, 1학년 수, 이용자 수로 독립 조건식을 만든다.","decisiveStep":"x/(x+165)=(x+75)(x+40)/(x+165)²로 두어 x=60을 푼다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"주사위에서 5의 약수 사건 A의 확률을 1/2로 두고 독립인 B에 대해 합집합 확률 조건을 식으로 세운다.","decisiveStep":"독립식 2/3=1/2+P(B)-P(B)/2에서 P(B)=1/2이므로 B에는 눈 3개가 포함된다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"사건의 독립","l4":"독립 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"6개 중 흰 공 3개를 뽑는 횟수의 기댓값은 각 흰 공이 뽑힐 확률을 합해 구한 뒤 선형성을 적용한다.","decisiveStep":"E(X)=3×3/6=3/2이므로 E(3X/2+3)=9/4+3=21/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"홀수가 9번 중 나온 횟수 X를 B(9,1/2)로 두고 P(X≥6)의 세 항을 더한다.","decisiveStep":"(84+36+9+1)/512=130/512=65/256이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"확률의 합과 3P(X=0)=P(X=1)+P(X=2)를 연립해 a,b를 찾고 V(2X-3)=4V(X)를 이용한다.","decisiveStep":"a=1/4, b=-3/8에서 확률은 1/4, 5/8, 1/8이고 V(X)=23/64이므로 -2V(2X-3)=-23/8이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"a/[x(x+1)]를 a(1/x-1/(x+1))로 분해해 전체 범위와 20부터 29까지의 합을 각각 망원합으로 계산한다.","decisiveStep":"전체 합으로 a=40/7을 얻고 구간 합 1/20-1/30에 곱해 2/21을 얻는다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"주사위 두 눈 (a,b)에 대해 f-g의 이차식이 모든 실수에서 양수가 될 계수 조건과 판별식 조건을 세운다.","decisiveStep":"a>b와 3a>4b를 만족하는 순서쌍은 12개라서 확률은 12/36=1/3이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"곱이 100의 배수인 짝수 쌍을 조건의 표본공간으로 세고 그중 합이 60 미만인 쌍을 제외한다.","decisiveStep":"조건을 만족하는 31쌍 중 합이 60 미만인 8쌍을 빼면 23/31이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"5회 중 눈이 3의 배수인 횟수 X로 A점수 X+5와 B점수 20-6X를 써서 B>A를 확률조건으로 바꾼다.","decisiveStep":"X≤2일 때만 B가 앞서므로 B(5,1/3)의 0,1,2회 확률을 합해 64/81을 얻는다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"불량품 2개와 정상품 6개 중 두 개를 고르는 조합을 X=0,1,2별로 세어 확률질량함수와 평균을 만든다.","decisiveStep":"전체 28가지 중 경우 수는 15,12,1이고 이에 따른 평균은 (12+2)/28=1/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"X가 0 또는 2만 가지므로 p=P(X=2)로 놓아 평균 2p와 분산 4p(1-p)를 관계식에 넣는다.","decisiveStep":"4p²=12p(1-p), 0<p<1에서 p=3/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"두 주사위 눈 차가 4의 약수인 확률은 22/36이고 40회 성공 횟수 Y로 점 P의 좌표 X=6Y-160을 표현한다.","decisiveStep":"V(X)+E(X)²=3080/9+1600/9=520이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
