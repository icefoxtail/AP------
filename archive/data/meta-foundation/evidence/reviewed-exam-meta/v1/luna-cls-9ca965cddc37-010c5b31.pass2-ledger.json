 "items":[
 {"ordinal":1,"questionUid":"","primaryMethod":"중복순열 nΠ₄를 n⁴으로 바꾸어 n⁴=81을 푼다.","decisiveStep":"81=3⁴이고 n은 자연수이므로 n=3이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
 {"ordinal":2,"questionUid":"","primaryMethod":"과자 9개 중 상자 A, B, C에 1개씩 먼저 넣고 남은 6개를 중복조합으로 분배한다.","decisiveStep":"각 상자의 추가 개수를 x,y,z라 두면 x+y+z=6의 음이 아닌 정수해는 ₈C₂=28개이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"중복조합","l4":"정수해 개수"},"crossConceptKeys":[],"conditionKeys":["COND_LOWER_BOUND"],"integrationPattern":"NONE"},
 {"ordinal":3,"questionUid":"","primaryMethod":"(1+x)ⁿ의 x² 계수 ₙC₂=15에서 n을 정한 뒤 ₙC₃를 계산한다.","decisiveStep":"n(n−1)=30의 자연수 해는 6이므로 x³의 계수는 ₆C₃=20이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"특정 항의 계수"},"crossConceptKeys":["CC_BINOMIAL_GENERAL_TERM"],"conditionKeys":["COND_NATURAL"],"integrationPattern":"NONE"},
 {"ordinal":4,"questionUid":"","primaryMethod":"남학생 3명을 원탁에 먼저 앉힌 뒤 사이의 세 자리에 여학생 3명을 배열한다.","decisiveStep":"남학생의 원순열 2!과 여학생의 배열 3!을 곱하면 12가지이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":5,"questionUid":"","primaryMethod":"흰 공 3개와 검은 공 5개에서 하나씩 고르는 수를 전체 8개 중 2개를 고르는 수로 나눈다.","decisiveStep":"색이 다른 선택은 3×5=15가지이고 전체 선택은 ₈C₂=28가지여서 확률은 15/28이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":["CC_COMBINATION_PROBABILITY"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":6,"questionUid":"","primaryMethod":"B∩Aᶜ를 합집합 A∪B에서 A를 제외한 사건으로 보아 3/4에서 1/3을 뺀다.","decisiveStep":"A와 B∩Aᶜ는 서로 배반이므로 P(B∩Aᶜ)=3/4−1/3=5/12이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":7,"questionUid":"","primaryMethod":"두 주사위의 합이 5 또는 10인 순서쌍을 세어 전체 36가지로 나눈다.","decisiveStep":"합이 5인 경우는 4가지, 10인 경우는 3가지여서 확률은 7/36이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":8,"questionUid":"","primaryMethod":"3학년 2명을 한 묶음으로 배열한 수에서 1학년 2명까지 이웃한 배열 수를 뺀다.","decisiveStep":"5!×2!−4!×2!×2!=240−96=144로 두 조건을 동시에 만족시킨다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"일렬 배열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":9,"questionUid":"","primaryMethod":"15¹⁰을 (14+1)¹⁰으로 바꾸고 이항전개에서 14를 인수로 갖는 항을 가려낸다.","decisiveStep":"상수항 1을 제외한 모든 항이 14의 배수이므로 나머지는 1이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"전개식의 항"},"crossConceptKeys":["CC_BINOMIAL_GENERAL_TERM"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":10,"questionUid":"","primaryMethod":"노란 공과 파란 공이 하나씩 나올 확률을 A에서는 6/10, B에서는 8/15로 구해 조건부확률을 계산한다.","decisiveStep":"두 주머니의 선택 확률이 같으므로 A일 확률은 (3/5)/(3/5+8/15)=9/17이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":["CC_COMBINATION_PROBABILITY"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":11,"questionUid":"","primaryMethod":"동전 4개의 앞면 개수를 k=1,2,3,4로 나누고 주사위가 k일 확률 1/6을 곱해 더한다.","decisiveStep":"앞면이 하나도 없는 경우만 제외되어 확률은 (1−1/16)×1/6=5/32이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":["CC_COIN_TOSS_EXPERIMENT"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":12,"questionUid":"","primaryMethod":"P(A∩B)=t로 놓고 t/(3/5)+t/(1/2)=11/10을 풀어 합집합의 확률을 구한다.","decisiveStep":"(11/3)t=11/10에서 t=3/10이므로 P(A∪B)=1/2+3/5−3/10=4/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":13,"questionUid":"","primaryMethod":"1부터 7까지 복원 추출한 세 수의 곱이 4의 배수가 아닌 경우를 홀수만 나오거나 2,6이 한 번 나오는 경우로 센다.","decisiveStep":"실패 경우가 4³+3×2×4²=160개이므로 원하는 확률은 (7³−160)/7³=183/343이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":14,"questionUid":"","primaryMethod":"홀수 눈일 때 동전 3개에서 앞면 2개가 나올 확률 3/8과 짝수 눈일 때의 확률 1/4를 비교한다.","decisiveStep":"홀수와 짝수의 사전확률이 1/2로 같아 조건부확률은 (3/8)/(3/8+1/4)=3/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":["CC_COIN_TOSS_EXPERIMENT"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":15,"questionUid":"","primaryMethod":"A에서 옮기는 흰 공 수를 0,1,2로 나누어 B의 흰 공 추출 확률과 함께 계산한다.","decisiveStep":"흰 공 추출의 전체 확률은 (3×3+6×4+1×5)/70=38/70이고 검은 공 두 개 이동과 흰 공 추출의 확률은 9/70이므로 9/38이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":["CC_COMBINATION_PROBABILITY"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":16,"questionUid":"","primaryMethod":"주사위에서 3 또는 6이 나올 확률 1/3을 성공확률로 하여 X를 이항분포 B(5,1/3)로 나타낸다.","decisiveStep":"분산은 5×(1/3)×(2/3)=10/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":["CC_BINOMIAL_DISTRIBUTION_MOMENTS"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":17,"questionUid":"","primaryMethod":"24번의 시행에서 E(X)=24p를 사용해 E(3X−1)=35를 p의 방정식으로 바꾼다.","decisiveStep":"72p−1=35에서 72p=36이므로 p=1/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":["CC_BINOMIAL_DISTRIBUTION_MOMENTS"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":18,"questionUid":"","primaryMethod":"Aᶜ∩Bᶜ의 확률 3/8에서 합집합의 확률을 구하고 교집합의 확률 1/8을 더한다.","decisiveStep":"P(A)+P(B)=P(A∪B)+P(A∩B)=5/8+1/8=3/4이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":19,"questionUid":"","primaryMethod":"동전 6회의 앞면 횟수를 k라 두어 총점 2k+(6−k)=9를 만족시키는 독립시행 확률을 구한다.","decisiveStep":"앞면은 정확히 3번이어야 하므로 ₆C₃(1/2)⁶=5/16이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"이항형 시행"},"crossConceptKeys":["CC_BINOMIAL_PROBABILITY"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":20,"questionUid":"","primaryMethod":"네 번 복원 추출한 평균이 5/4라는 조건을 네 수의 합이 5라는 조건으로 바꾼다.","decisiveStep":"각 수가 1 이상이므로 2가 한 번, 1이 세 번 나와야 하여 확률은 4/6⁴=1/324이다.","rpmPath":{"majorUnit":"통계","midUnit":"통계적 추정","l3":"모집단과 표본","l4":"표본평균"},"crossConceptKeys":[],"conditionKeys":["COND_LOWER_BOUND"],"integrationPattern":"NONE"},
 {"ordinal":21,"questionUid":"","primaryMethod":"환자 100명 중 양성 90명과 비환자 400명 중 양성 20명을 구해 양성 집단에서 환자의 비율을 계산한다.","decisiveStep":"암 진단을 받은 110명 중 실제 환자는 90명이므로 조건부확률은 90/110=9/11이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":22,"questionUid":"","primaryMethod":"1부터 5까지 두 카드의 차가 1,2,3,4인 쌍을 각각 세어 확률분포와 두 모멘트를 구한다.","decisiveStep":"차별 경우의 수는 4,3,2,1이어서 E(X)=20/10=2, E(X²)=50/10=5이고 V(X)=1이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":["CC_COMBINATION_PROBABILITY"],"conditionKeys":[],"integrationPattern":"NONE"},
 {"ordinal":23,"questionUid":"","primaryMethod":"인형이 있는 주머니의 확인 순서 X가 1부터 7까지 같은 확률임을 이용해 평균과 분산을 구한다.","decisiveStep":"E(X)=4와 V(X)=4를 대입하면 4a+2=14와 4a²=36을 만족하는 양수는 a=3이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"}
 ]
