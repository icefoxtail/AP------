    {"ordinal":1,"questionUid":"","primaryMethod":"8^(2/3)=4와 2^(-2)=1/4를 계산해 곱한다.","decisiveStep":"4·1/4=1이므로 답은 1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"log₂a=3을 지수식 2³=a로 바꾼다.","decisiveStep":"a=8은 양수 조건을 만족한다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"라디안과 도 사이의 비례식 180°=π를 적용해 각 보기의 도 단위 값을 확인한다.","decisiveStep":"(5/3)π는 300°이므로 150°와 같지 않다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"호의 길이 rθ=2π와 θ=π/3에서 반지름을 정한 뒤 부채꼴 넓이를 계산한다.","decisiveStep":"r=6이고 (1/2)r²θ=6π이다.","rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"선택지에 부채꼴 넓이 계산을 나타내는 유형 경로 조합이 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"4ˣ과 (1/2)^(x-9)를 밑이 2인 거듭제곱으로 고쳐 지수를 같게 둔다.","decisiveStep":"2x=9-x에서 x=3을 얻는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"밑 통일"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"log₂(2x-1)=2를 진수 조건 2x-1>0과 함께 지수식으로 바꾼다.","decisiveStep":"2x-1=4라서 x=5/2이며 진수 조건도 만족한다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그방정식","l4":"진수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"32=2⁵부터 각 등호의 값을 계산해 처음 값이 달라지는 지점을 찾는다.","decisiveStep":"{(-2)²}^(5/2)=32지만 (-2)⁵=-32라서 ④에서 깨진다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"sin(-θ)에서 sinθ의 부호를 정하고 tanθ>0으로 cosθ의 부호를 정한 뒤 cos(π+θ)를 구한다.","decisiveStep":"제3사분면이므로 cosθ=-3/4이고 cos(π+θ)=3/4이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"cos(π/2-x)=sin x로 바꿔 2sin x<1을 [0,2π)에서 푼다.","decisiveStep":"a=π/6, b=5π/6이므로 a+b=π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"각 항의 이동각을 sinθ와 cosθ로 바꾸어 탄젠트 항의 상쇄를 확인한다.","decisiveStep":"첫째 항은 -tanθ, 둘째 항은 1, 마지막 분수는 -tanθ이므로 전체 값은 1이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"-64³=-2^18의 정수 실수 n제곱근을 위해 n이 홀수 약수이면서 18을 나누어야 함을 적용한다.","decisiveStep":"가능한 n은 3과 9이고 합은 12이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"네 각의 삼각함수값 부호를 구해 해당 수의 홀수 또는 짝수 제곱근 실수 개수를 더한다.","decisiveStep":"sin(5π/6)=1/2, cos(π/3)=1/2, tan(2π/3)<0, cos(5π/6)<0에서 개수는 1+2+1+0=4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"두 근 cosθ와 tanθ의 합·곱을 계수와 비교해 a와 삼각비 조건을 구한다.","decisiveStep":"cosθtanθ=sinθ이므로 4a sinθ=sinθ에서 a=1/4이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"4sin(πx/12)≥2를 sin(πx/12)≥1/2로 바꾸고 각 범위를 시간 x로 환산한다.","decisiveStep":"2≤x≤10에서 발전 가능 시간이 8시간이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"밑 1/2의 로그가 감소함수임을 이용해 로그 부등식을 0<|f(x)|<|g(x)|로 바꾼다.","decisiveStep":"그래프에서 얻은 f(x)=x²/16-4와 g(x)=3x/5+12/5를 비교하고 진수 조건을 적용한다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"OP의 좌표 (-3,4)에서 반지름 5를 구해 sinθ, cosθ, tanθ를 분수로 계산한다.","decisiveStep":"세 값의 합은 -17/15라서 p+q=15+17=32이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"단위원"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"첫 부등식에서 x<2를 얻고, 둘째 부등식은 밑을 2로 통일해 이차부등식으로 바꿔 정수 범위의 교집합을 센다.","decisiveStep":"둘째 범위는 -6≤x≤2이고 교집합 정수는 -6부터 1까지 여덟 개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":25,"questionUid":"","primaryMethod":"로그의 밑 x>0, x≠1과 진수 3-x>0을 만족하는 정수 x를 찾아 α에 대입한다.","decisiveStep":"가능한 정수는 α=2이고 log₂16-log₂4=2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
