  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"cos(2x+1)의 범위 [-1,1]에 3을 곱하고 4를 더해 y의 범위를 만든다.","decisiveStep":"가장 작은 값은 3(-1)+4=1이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"a1=4에서 시작해 점화식에 n=1,2,3,4를 차례로 대입하여 a5까지 계산한다.","decisiveStep":"각 단계에서 더하는 값은 2,4,6,8이므로 a5=4+2+4+6+8=24이다.","rpmPath":{"majorUnit":"수열","midUnit":"수학적 귀납법","l3":"수열의 귀납적 정의","l4":"점화식으로 항 구하기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"첫째항 40과 공차 -3으로 일반항 43-3n을 세우고 처음 음수가 되는 n을 찾는다.","decisiveStep":"43-3n<0을 풀면 n>43/3이므로 가장 작은 자연수는 15이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"두 번째 합 조건에서 각 항의 1/2을 열 번 뺀 합을 분리해 Σbk를 얻고 첫 조건에 대입한다.","decisiveStep":"Σbk=19/3이므로 Σak=20-3(19/3)=1이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"합의 기호 Σ","l4":"성질"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"넓이 공식 18=(1/2)·8·c·sin150°에 sin150°=1/2을 넣어 c를 구한다.","decisiveStep":"식은 18=2c가 되어 c=9이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"그래프의 최댓값 1과 최솟값 -5에서 진폭과 중심선 높이를 정하고, 반복 간격 π에서 b를 구한다.","decisiveStep":"진폭 3, 중심선 -2, 주기 π이므로 b=2이고 abc=3·2·(-2)=-12이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"a5=S5-S4로 k를 먼저 구하고 a1=S1에 같은 k를 대입한다.","decisiveStep":"a5=18+k=24이므로 k=6이고 S1=2+6=8이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"계차수열","l4":"일반항 구하기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"cos(π/3)=1/2를 기준으로 각 보기의 사인·코사인 값을 특수각 표에서 비교한다.","decisiveStep":"sin(5π/6)=1/2이므로 기준값과 같다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"세 수의 등차중항 조건과 세 수의 등비중항 조건을 식으로 바꿔 a,b를 연립한다.","decisiveStep":"등비 조건에서 b=2를 얻고 등차 조건에 넣으면 a=4이므로 합은 6이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"사인법칙으로 sin A와 sin C를 변의 비로 바꾼 뒤 cos B를 코사인법칙으로 치환한다.","decisiveStep":"조건을 정리하면 a²-b²=0이므로 변 a와 b가 같아 이등변삼각형이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 뜻","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"변 4,5,6에서 코사인법칙으로 cos A를 구하고 sin A를 계산한 뒤 사인법칙으로 R을 구한다.","decisiveStep":"cos A=3/4, sin A=√7/4이므로 2R=4/(√7/4)에서 R=8√7/7이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 뜻","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"3항씩 묶인 등비수열 합에서 S6=S3(1+r³)을 이용해 r³을 구하고 세 묶음을 더한다.","decisiveStep":"r³=8이므로 S9=7(1+8+64)=511이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"k번째 곱을 k(2k+1)로 표현해 제곱합과 자연수 합의 두 시그마로 분리한다.","decisiveStep":"2·385+55=825이므로 주어진 합은 825이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"여러 가지 수열의 합","l4":"자연수 거듭제곱의 합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"대각선 AC로 원에 내접한 사각형을 두 삼각형으로 나누고 마주 보는 각의 보각 관계로 두 넓이를 함께 계산한다.","decisiveStep":"코사인법칙으로 cos B=-2/3, sin B=√5/3을 얻어 전체 넓이 18sin B=6√5가 된다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 뜻","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"접선 PC와 반지름 OC의 수직 관계로 θ와 중심각 BOC를 연결하고 원주각 A를 구한다.","decisiveStep":"cos(BOC)=-sinθ=-1/3이므로 sin A=√((1-cos(BOC))/2)=√6/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"sin²x를 1-cos²x로 바꾸고 t=cos x로 놓아 [-1,1]에서 이차식의 양 끝값을 비교한다.","decisiveStep":"t=-1에서 최솟값 -9를 얻어 x=π, 따라서 ab=-9π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"그래프를 이용한 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"1000의 약수를 2^i5^j로 나타내고 연속 네 항의 지수쌍이 공차가 같은지 세 방향별 시작 위치를 센다.","decisiveStep":"지수 공차는 (1,0),(0,1),(1,1)뿐이며 각각 4,4,1개라 총 9개이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"f(x+π)=f(x)가 되려면 a가 짝수임을 먼저 정하고, 각 주기에서 sin(ax)=1/3인 두 교점의 x좌표 합을 누적한다.","decisiveStep":"a=2k일 때 전체 합은 (2k-1)π/2이므로 주어진 합과 같게 두면 a=14이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"cos(πx/b)가 -1 또는 1/2가 되는 x좌표로 A,B,C를 쓰고 AB=BC를 거리식으로 바꾼다.","decisiveStep":"거리 조건에서 a/b=4√3/9이고 두 기울기의 합은 a/(2b)=2√3/9이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"코사인법칙에 b=√3+1, c=2, A=30°를 넣어 a를 구한 뒤 사인법칙으로 sin C를 표현한다.","decisiveStep":"a²=2이므로 sin C=c sin A/a=1/√2=√2/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 뜻","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"sin(π/2+x)를 cos x로 바꾸고 t=cos x로 치환해 인수분해한 뒤 주어진 구간에서 해를 옮긴다.","decisiveStep":"(2t-1)(t+2)≥0과 -1≤t≤1에서 t≥1/2이므로 x는 0부터 π/3까지 또는 5π/3부터 2π 미만이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"세 직각삼각형 넓이를 AD, DB, CD로 쓰고 등차 조건에서 DB=2AD를 얻은 뒤 빗변 수선의 닮음 관계를 쓴다.","decisiveStep":"AC²=AD·AB=3AD²이므로 AC/AB=√3/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
