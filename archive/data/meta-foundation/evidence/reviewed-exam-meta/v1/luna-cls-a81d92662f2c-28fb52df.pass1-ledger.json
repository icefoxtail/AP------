  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"f(1)과 f'(-1)을 각각 a,b의 일차식으로 써 두 조건을 연립한다.","decisiveStep":"a+b=5, -2a+b=2에서 a=1, b=4를 얻어 ab=4이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"적분식을 항별로 원시함수로 바꾸고 0과 2의 값을 대입한다.","decisiveStep":"[x²/4-5x]₀²=1-10=-9이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분의 뜻","l4":"정적분 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"포물선의 두 x절편 1과 3 사이에서 함수값이 음수임을 확인해 정적분의 부호를 바꾼다.","decisiveStep":"넓이는 -∫₁³(x²-4x+3)dx=4/3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"곡선과 x축"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"위치식을 두 번 미분해 속도의 영점 중 시각 조건을 만족하는 때를 고르고 가속도를 구한다.","decisiveStep":"v(t)=-3(t-3)(t+1)에서 t=3이고 a(3)=-6·3+6=-12이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"속도와 가속도","l4":"위치·속도·가속도"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"접선에서 f(1)과 f'(1)을 읽고 곱의 미분법으로 g'(1)을 계산한다.","decisiveStep":"g'(1)=(-3)·2+(-2)·(-2)=-2이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"접선 y=3x-1과 곡선이 만나는 두 x좌표 -2,1 사이에서 곡선과 직선의 차를 적분한다.","decisiveStep":"x³-3x+2=(x-1)²(x+2)가 구간에서 음이 아니므로 넓이는 그 정적분 27/4이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"두 곡선 사이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"두 극한에서 f(3), f'(3), g(3), g'(3)을 각각 읽은 뒤 곱의 미분법을 쓴다.","decisiveStep":"(fg)'(3)=1·1+2·2=5이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"접선의 y절편을 g(t)=f(t)-tf'(t)로 나타내고 열린 구간에서 도함수가 양수인 조건을 찾는다.","decisiveStep":"g'(t)=2t(a+3-3t)이므로 0<t<6에서 증가하려면 a≥15이고 최솟값은 15이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"증감표"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"도함수가 -1과 4에서 0인 최고차항 6의 이차식임을 이용해 계수를 정하고 f(-1)을 구한다.","decisiveStep":"f'(x)=6(x+1)(x-4)에서 a=-9,b=-24이므로 f(-1)=16이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"F(x)=∫₂ˣf(t)dt로 두어 주어진 극한을 F의 x=2에서 미분계수로 바꾼다.","decisiveStep":"미적분의 기본정리로 F'(2)=f(2)=16-4+2=14이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"도함수의 인수분해로 극점 후보를 나열하고 각 인수의 부호가 바뀌는 곳만 극값으로 센다.","decisiveStep":"극값이 하나인 자연수는 a=1,2,4이므로 합은 7이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"f+g와 fg를 각각 적분해 만든 뒤 두 함수의 합과 곱으로 f,g를 복원한다.","decisiveStep":"복원하면 f(x)=x+2, g(x)=x²+4x-9이므로 f(-5)+g(1)=-7이다.","rpmPath":{"majorUnit":"적분","midUnit":"부정적분","l3":"조건을 이용한 함수 결정","l4":"도함수에서 원함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"처음 위치에 0부터 3까지 속도의 정적분으로 구한 위치 변화를 더한다.","decisiveStep":"∫₀³(t²-6t)dt=-18이므로 x(3)=1-18=-17이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"속도와 거리","l4":"위치 변화"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"속도가 0인 t=3에서 구간을 나누고 속도의 절댓값을 각각 적분한다.","decisiveStep":"0≤t≤3과 3≤t≤6의 이동거리가 각각 9라서 전체는 18이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"속도와 거리","l4":"속도에서 이동거리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"주어진 적분 등식을 x로 미분해 f'를 구하고 f(0)=0으로 f를 정한 뒤 x=0을 대입한다.","decisiveStep":"f(x)=-x²+2x이고 적분 등식의 x=0 대입값은 a=-2/3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"극솟값 m인 삼차함수에서 y=2와 y=-2의 교점 수 합이 다섯이 되는 m을 정한 뒤 계수를 구한다.","decisiveStep":"교점 수가 다섯인 경우는 m=-2이고 이를 대입하면 c=4,p=-6이라서 f(-1)=23이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"같은 상한을 가진 적분을 빼 f의 두 영점을 찾고 그 사이에서 부호가 바뀌는 넓이를 적분한다.","decisiveStep":"∫₂⁵(x-5)(x-r)dx=0에서 r=3이므로 넓이는 -∫₃⁵(x-3)(x-5)dx=4/3이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"곡선과 x축"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"접선 y=3을 기준으로 삼각형 넓이를 x의 함수로 나타내고 도함수의 부호를 살핀다.","decisiveStep":"S(x)=3x³-x⁴의 도함수 x²(9-4x)는 x=9/4에서 양에서 음으로 바뀌어 최대가 된다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"도형 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"함수 관계식에서 f를 이차식으로 정한 뒤 F'(x)=(x-2)f'(x)의 부호가 바뀌지 않을 조건을 찾는다.","decisiveStep":"극값이 없으려면 두 근이 겹쳐 f'(x)=12-6x이고 f(5)=-15이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"P의 양의 속도 적분값 4와 Q의 절댓값 속도 적분을 같게 두고 속도 부호가 바뀌는지에 따라 나눈다.","decisiveStep":"가능한 m은 2와 4라서 모든 값의 합은 6이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"속도와 거리","l4":"속도에서 이동거리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"F'(x)=x³-3x+a의 부호 변화가 한 곳에서만 생기는 a의 경계값을 조사한다.","decisiveStep":"a=2일 때 F'=(x-1)²(x+2)이므로 단순근 -2에서만 부호가 바뀌어 최솟값은 2이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"절댓값 안의 부호로 방정식을 두 구간에 나누고 x(x-3)²의 그래프와 y=k의 교점 수를 센다.","decisiveStep":"양의 구간에서 세 교점이고 음의 구간에서 한 해가 생기는 범위는 0<k<4뿐이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"g'(x)=2x∫₀ˣf(t)dt로 정리해 부호가 바뀌는 영점 수로 k를 정하고 그 h의 부호 구간 넓이를 더한다.","decisiveStep":"∫₀ᵃf(t)dt=a²(6-a²)/12이므로 극값 경계는 k=√6이고 두 넓이의 합은 2√6-1/4이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
}