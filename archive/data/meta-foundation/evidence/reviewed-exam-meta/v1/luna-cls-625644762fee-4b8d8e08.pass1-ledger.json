  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"입장객 수와 열 개 동전의 앞면 수는 셀 수 있는 정수값이고 강수량·몸무게·수명은 구간의 실숫값을 측정한다.","decisiveStep":"이산확률변수에 해당하는 것은 입장객 수 ㄱ과 앞면 수 ㄹ이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"이산확률변수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"연결 실패가 매번 1/3 확률로 일어나는 18회 시행의 실패 횟수를 이항분포로 두어 평균과 분산을 구한다.","decisiveStep":"E(X)=6, V(X)=4이므로 둘의 합은 10이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"0부터 2까지의 밀도함수 그래프와 x축 사이의 삼각형 넓이가 1이 되도록 계수 a를 정한다.","decisiveStep":"밑변 2, 높이 4a인 삼각형의 넓이가 4a이므로 a=1/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"표준정규분포의 대칭성으로 -1부터 0까지의 넓이를 0부터 1까지의 표 넓이와 같게 바꾸고 나머지 구간 넓이를 더한다.","decisiveStep":"0.34+0.19=0.53이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"동전 두 번의 앞면 수 X는 B(2,1/2)이므로 Y=2X-1의 평균과 분산을 선형 변환식으로 구한다.","decisiveStep":"E(Y)=1, V(Y)=2이어서 합은 3이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"전체 확률의 합을 1로 두고 1/[x(x+1)]을 연속된 역수의 차로 바꾸어 소거합을 계산한다.","decisiveStep":"합은 9/10이어서 k=10/9이고 P(X=1)=k/2=5/9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률질량함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"E(X²)와 평균 제곱의 차로 분산을 구한 뒤 이항분포의 np와 np(1-p)에 대입한다.","decisiveStep":"분산 20=30(1-p)에서 p=1/3이고 np=30이므로 n=90이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"E(2X-1)에서 E(X)를, E((X-1)²)에서 E(X²)를 구해 V(X)를 복원한다.","decisiveStep":"E(X)=1, E(X²)=5라서 V(X)=4이며 V(1-2X)=16이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"B(100,p)의 99회 성공 확률과 100회 성공 확률을 식으로 써 비를 비교해 p를 구한다.","decisiveStep":"100p⁹⁹(1-p)=100p¹⁰⁰에서 p=1/2이므로 평균 50, 표준편차 5, 합 55이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"이항분포의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"질량함수를 C(100,x) (1/5)^x(4/5)^(100-x)로 읽어 B(100,1/5)의 분산을 구한 뒤 절반배 변환을 적용한다.","decisiveStep":"V(X)=16이고 상수항은 분산에 영향을 주지 않아 구하는 분산은 16/4=4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"각 후보 그래프가 음수가 아닌지와 -1부터 1까지의 전체 넓이가 1인지 함께 점검한다.","decisiveStep":"절댓값 그래프 |x|만 음수가 없고 넓이가 1이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"X의 구간을 평균 36, 표준편차 4로 표준화한 뒤 대칭 구간 [1,2]로 바꾸고 Y의 상한 72에 맞춘다.","decisiveStep":"같은 넓이를 얻는 Y의 표준화 하한은 1이므로 (k-62)/5=1, k=67이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"171cm를 평균 175, 표준편차 4인 분포에서 표준화해 누적 확률을 구한 다음 500명에 곱한다.","decisiveStep":"표준화 값은 -1이고 왼쪽 꼬리 확률은 0.16이므로 80명이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"360mL를 평균 350, 표준편차 5인 정규분포에서 표준화해 오른쪽 꼬리 면적을 표에서 계산한다.","decisiveStep":"z=2이고 0.5-0.48=0.02이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"F(x+20)-F(x)를 길이 20인 구간의 확률로 보고 정규곡선의 중심 대칭을 이용해 구간 중심을 평균 40에 맞춘다.","decisiveStep":"구간 중심 x+10=40에서 x=30이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"225발 중 명중 수를 B(225,4/5)로 두고 평균 180과 표준편차 6으로 정규근사한 뒤 192를 표준화한다.","decisiveStep":"z=(192-180)/6=2이므로 오른쪽 꼬리는 약 0.02이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"복원 추출의 검은 공 횟수를 B(n,p)로 놓고 평균식과 분산식의 비로 p를 먼저 구한다.","decisiveStep":"분산/평균=1-p=1/3이므로 p=2/3이고 np=6에서 n=9이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"문학 도서 수를 B(2100,0.3)으로 놓고 평균 630, 표준편차 21로 정규근사해 651과 672를 표준화한다.","decisiveStep":"두 경계는 z=1과 z=2이므로 구간 확률은 0.48-0.34=0.14이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"합의 각 항을 B(8,1/4)의 확률에 x²을 곱한 것으로 보고 이항변수의 제곱 기댓값으로 바꾼다.","decisiveStep":"평균 2와 분산 3/2를 더한 E(X²)는 11/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"정사면체 한 번의 결과별 좌표 증가량을 확률로 가중해 평균을 구하고 20회 누적 기댓값을 계산한다.","decisiveStep":"회당 평균 이동은 (1/2,3/4)이므로 20회 뒤 기댓값 좌표는 (10,15)이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"배수 눈이 나오는 횟수의 분포를 B(n,1/3)으로 두고 중심에서 8 떨어진 구간을 표준편차 단위로 비교한다.","decisiveStep":"확률 0.96에 대응하는 두 표준편차 조건은 √(2n)/3≤4여서 n≤72이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"빨간 공 3개 중 x개와 파란 공 2개 중 2-x개를 고르는 조합으로 확률표를 만들고 평균·제곱평균을 계산한다.","decisiveStep":"E(X)=6/5, E(X²)=9/5이므로 V(X)=9/5-(6/5)²=9/25이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"Z=(X-m)/σ의 평균 0과 표준편차 1을 이용해 H=50+14Z의 평균과 표준편차를 구하고 점수 74를 표준화한다.","decisiveStep":"74점은 Z=2이므로 H=50+28=78점이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"","primaryMethod":"제품 한 개의 양쪽 불량 꼬리를 표준화해 0.04를 얻고 3750개 불량 수를 평균 150, 표준편차 12인 정규분포로 근사한다.","decisiveStep":"168의 표준화 값은 1.5이며 오른쪽 꼬리 확률은 0.5-0.43=0.07이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
