  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"xy평면에 대한 대칭은 x=3, y=2를 유지하면서 z=−4의 부호만 바꾼다.","decisiveStep":"대칭점은 (3,2,4)이다.","standardUnitKey":"H22-GE-04","subUnitKey":"H22-GE-04-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간좌표","l3":"공간의 좌표","l4":"점의 좌표"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"공통값 t로 두 등식을 나타내면 x=−12+3t, y=2−2t이므로 t가 1 늘 때 좌표 변화량을 읽는다.","decisiveStep":"좌표 변화량 (3,−2)가 직선의 방향벡터다.","standardUnitKey":"H22-GE-05","subUnitKey":"H22-GE-05-VECTOR_BASIC","rpmPath":{"majorUnit":"벡터","midUnit":"도형의 방정식","l3":"벡터를 이용한 직선","l4":"방향벡터"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"타원의 분모에서 a²=45, b²=20을 읽고 c²=a²−b²로 초점 거리를 구한다.","decisiveStep":"c=5이므로 두 초점 사이 거리는 2c=10이다.","standardUnitKey":"H22-GE-01","subUnitKey":"H22-GE-01-CORE","rpmPath":{"majorUnit":"이차곡선","midUnit":"이차곡선","l3":"타원","l4":"초점·장축·단축"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"쌍곡선 x²/a²−y²/16=1의 점근선 기울기 크기 4/a를 5와 같게 둔다.","decisiveStep":"4/a=5에서 양수 a=4/5를 얻는다.","standardUnitKey":"H22-GE-01","subUnitKey":"H22-GE-01-CORE","rpmPath":{"majorUnit":"이차곡선","midUnit":"이차곡선","l3":"쌍곡선","l4":"점근선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"벡터 내적 공식에 두 크기 6, 5와 끼인각 60°를 대입한다.","decisiveStep":"6·5·cos60°=15이다.","standardUnitKey":"H22-GE-07","subUnitKey":"H22-GE-07-VECTOR_DOT","rpmPath":{"majorUnit":"평면벡터","midUnit":"평면벡터의 성분과 내적","l3":"내적","l4":"두 벡터의 각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"평행 조건을 (-15,x)=k(5,−2)로 놓고 첫 성분으로 k를 정한 뒤 둘째 성분에 넣는다.","decisiveStep":"k=−3이므로 x=6이다.","standardUnitKey":"H22-GE-05","subUnitKey":"H22-GE-05-VECTOR_BASIC","rpmPath":{"majorUnit":"평면벡터","midUnit":"벡터의 연산","l3":"벡터의 실수배","l4":"평행 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"두 직선의 법선벡터 (1,−2), (3,−1)의 내적 절댓값을 두 크기의 곱으로 나누어 예각의 코사인을 구한다.","decisiveStep":"5/√50=√2/2이다.","standardUnitKey":"H22-GE-08","subUnitKey":"H22-GE-08-CORE","rpmPath":{"majorUnit":"벡터","midUnit":"도형의 방정식","l3":"거리와 위치 관계","l4":"교점·각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"식을 완전제곱해 중심 (−1,1,−3)와 반지름 제곱 k+11을 읽고 yz평면까지의 거리를 반지름과 같게 둔다.","decisiveStep":"중심에서 x=0까지 거리는 1이므로 k+11=1, k=−10이다.","standardUnitKey":"H22-GE-04","subUnitKey":"H22-GE-04-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간좌표","l3":"구의 방정식","l4":"구와 좌표조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"AP·BP=0을 직각 조건으로 해석해 AB를 지름으로 하는 원을 자취로 잡고 AB를 계산한다.","decisiveStep":"AB=√(4²+3²)=5이므로 자취의 둘레는 5π이다.","standardUnitKey":"H22-GE-08","subUnitKey":"H22-GE-08-CORE","rpmPath":{"majorUnit":"평면벡터","midUnit":"평면벡터의 성분과 내적","l3":"도형에의 활용","l4":"수직·평행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"지름 끝점의 중점으로 구의 중심을 구하고 반지름 제곱에서 중심과 xz평면 사이 거리의 제곱을 뺀다.","decisiveStep":"단면 반지름 제곱은 11−9=2이므로 단면 넓이는 2π이다.","standardUnitKey":"H22-GE-04","subUnitKey":"H22-GE-04-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간좌표","l3":"구의 방정식","l4":"중심·반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"정육면체 좌표를 E=(0,0,0), F=(3,0,0), D=(0,3,3)으로 놓고 내분점 P를 구해 EF까지의 거리를 높이로 쓴다.","decisiveStep":"P=(1,2,2)의 높이는 2√2이므로 넓이는 (1/2)·3·2√2=3√2이다.","standardUnitKey":"H22-GE-03","subUnitKey":"H22-GE-03-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간도형","l3":"삼수선 정리","l4":"거리·각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"고정 밑변 AB에서 가장 먼 타원 점을 매개화로 찾고 그 점을 접선식 xx₀/25+yy₀/64=1에 넣는다.","decisiveStep":"최대 넓이를 주는 점은 (−5/√2,−8/√2)이므로 접선의 x절편은 −5√2이다.","standardUnitKey":"H22-GE-02","subUnitKey":"H22-GE-02-CORE","rpmPath":{"majorUnit":"이차곡선","midUnit":"이차곡선의 접선","l3":"타원의 접선","l4":"접점형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"AB에 수직인 단면에서 CN과 MN의 끼인각을 구해 두 평면의 이면각으로 보고 원래 넓이에 코사인을 곱한다.","decisiveStep":"cos∠CNM=√(2/3)이므로 정사영 넓이는 4√3·√(2/3)=4√2이다.","standardUnitKey":"H22-GE-03","subUnitKey":"H22-GE-03-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간도형","l3":"직선과 평면","l4":"정사영"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"교선 l을 x축으로 놓고 두 평면을 좌표평면으로 두어 PA, PB의 방향벡터 외적으로 평면 PAB의 법선을 구한다.","decisiveStep":"법선 (−√3,√3,1)과 β의 법선 사이에서 cos²θ=1/7이다.","standardUnitKey":"H22-GE-03","subUnitKey":"H22-GE-03-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간도형","l3":"이면각","l4":"공간에서의 각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"x=ku+lv로 놓고 u·v=1/2를 이용해 주어진 두 내적에서 k,l을 구한 뒤 |u−x|²를 전개한다.","decisiveStep":"k=0,l=6이므로 |u−6v|²=31이고 길이는 √31이다.","standardUnitKey":"H22-GE-07","subUnitKey":"H22-GE-07-VECTOR_DOT","rpmPath":{"majorUnit":"평면벡터","midUnit":"평면벡터의 성분과 내적","l3":"내적","l4":"내적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"EG에 수직인 단면에서 M의 밑면 투영점과 EG 사이 거리를 구해 직각삼각형의 코사인을 계산한다.","decisiveStep":"cosθ=1/3이므로 30cosθ=10이다.","standardUnitKey":"H22-GE-03","subUnitKey":"H22-GE-03-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간도형","l3":"이면각","l4":"이면각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"포물선 y²=4x에서 초점까지 거리가 x+1임을 쓰고 무게중심 조건으로 두 자연수 좌표의 합을 고정한다.","decisiveStep":"합이 11일 때 가장 가까운 서로 다른 좌표는 5,6이므로 (6)(7)=42가 최댓값이다.","standardUnitKey":"H22-GE-01","subUnitKey":"H22-GE-01-CORE","rpmPath":{"majorUnit":"이차곡선","midUnit":"이차곡선","l3":"포물선","l4":"초점·준선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"OP 방향 단위벡터를 써서 OP와 OA의 내적 차이를 구하고 AB에 수직인 높이로 해석한다.","decisiveStep":"P에서 AB까지의 거리는 5−(−3)=8이므로 삼각형 넓이는 (1/2)·2·8=8이다.","standardUnitKey":"H22-GE-07","subUnitKey":"H22-GE-07-VECTOR_DOT","rpmPath":{"majorUnit":"평면벡터","midUnit":"평면벡터의 성분과 내적","l3":"도형에의 활용","l4":"거리·넓이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"직각삼각형 ABD와 두 면의 60도 조건으로 사면체 부피 및 삼각형 DBC의 넓이를 구해 선분과 평면이 이루는 각을 연결한다.","decisiveStep":"sinθ=1/√5이므로 예각 조건에서 cosθ=2√5/5이다.","standardUnitKey":"H22-GE-03","subUnitKey":"H22-GE-03-CORE","rpmPath":{"majorUnit":"공간도형과 공간좌표","midUnit":"공간도형","l3":"이면각","l4":"공간에서의 각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
