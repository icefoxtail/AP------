ation":{"problemTypeKey":"PT_M3_RADICAL_CALCULATION","templateKey":"TPL_M3_RADICAL_MIXED_OPERATION","crossConceptKeys":["CC_SQUARE_ROOT","CC_ABSOLUTE_VALUE"],"conditionKeys":[],"status":"APPROVED_CANONICAL"},"readingEvidence":{"sourceTextExcerpt":"$\\sqrt{49}-3\\sqrt{(-3)^2}+(-\\sqrt{(-1)^2})^2$을 계산하면? [3점]","solutionDecisiveExcerpt":"√49=7, √((-3)²)=3, (-√((-1)²))²=1로 각각 정리하여 7-9+1=-1 계산","visualAssetChecked":false,"visualType":"NONE"}},{"questionId":6,"standardUnitKey":"M3-02","subUnitKey":"M3-02-RADICAL_SIMPLIFY","difficultyBucket":2,"difficultyReason":"소수 형태 근호의 소인수분해 및 제곱인수를 근호 밖으로 꺼내는 기본 변형","difficultyConfidence":"source_preserved","auditVerdict":"APPROVED","classification":{"problemTypeKey":"PT_M3_RADICAL_CALCULATION","templateKey":"TPL_M3_RADICAL_MIXED_OPERATION","crossConceptKeys":["CC_SQUARE_ROOT"],"conditionKeys":[],"status":"APPROVED_CANONICAL"},"readingEvidence":{"sourceTextExcerpt":"$\\sqrt{0.28}=a\\sqrt{7}$ 일 때, $a$의 값을 구하면? [4점]","solutionDecisiveExcerpt":"√(0.28)=√(28/100)=(2√7)/10=(1/5)√7 로 변형하여 a=1/5 도출","visualAssetChecked":false,"visualType":"NONE"}},{"questionId":7,"standardUnitKey":"M3-01","subUnitKey":"M3-01-RADICAL_INEQUALITY","difficultyBucket":2,"difficultyReason":"근호를 포함한 부등식의 양변 제곱 변형을 통한 자연수 해의 개수 세기","difficultyConfidence":"source_preserved","auditVerdict":"APPROVED","classification":{"problemTypeKey":"PT_M3_REAL_NUMBER_COMPARISON","templateKey":"TPL_M3_REAL_NUMBER_INTERVAL_ESTIMATION","crossConceptKeys":["CC_SQUARE_ROOT","CC_INEQUALITY","CC_NATURAL_NUMBER"],"conditionKeys":[],"status":"APPROVED_CANONICAL"},"readingEvidence":{"sourceTextExcerpt":"$4 < \\sqrt{x-3} \\le 5$를 만족하는 자연수 $x$의 개수를 구하면? [4점]","solutionDecisiveExcerpt":"각 변을 제곱하여 16<x-3<=25를 만들고 19<x<=28에서 자연수 x의 개수 28-19=9개 산출","visualAssetChecked":false,"visualType":"NONE"}},{"questionId":8,"standardUnitKey":"M3-02","subUnitKey":"M3-02-RADICAL_OPERATION","difficultyBucket":2,"difficultyReason":"무리수 값 대입 후 무리수와 유리수 동류항 정리 연산","difficultyConfidence":"source_preserved","auditVer