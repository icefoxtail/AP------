 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"항등식의 x², x, 상수항 계수를 각각 비교해 a,b,c를 정한다.","decisiveStep":"a=1, b=0, c=3이므로 a+b+c=4이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"x-1로 나눈 나머지는 P(1)이므로 P(x)=x³+x²-2x+2에 1을 대입한다.","decisiveStep":"P(1)=1+1-2+2=2이므로 나머지는 2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"조립제법에서 첫 계수 1을 아래로 내린 뒤 1을 곱해 각 칸에 더하며 a,b를 읽는다.","decisiveStep":"a=-1, b=0이므로 a+b=-1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"다항식의 연산","l3":"다항식의 나눗셈","l4":"몫과 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"가능한 정수근 후보를 대입해 다항식값이 0이 되지 않는 후보를 찾는다.","decisiveStep":"P(2)=-12이므로 x-2는 인수가 아니며 보기의 정답은 x-2이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"인수 판정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"P(x)=(x-1)Q(x)+4에 x=2를 넣고 Q(2)=1을 이용해 P(2)를 계산한다.","decisiveStep":"P(2)=1·1+4=5이므로 x-2로 나눈 나머지는 5이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"x+y=3과 xy=2를 이용해 거듭제곱 대칭식 x⁵+y⁵를 낮은 차수의 대칭식으로 바꾼다.","decisiveStep":"x⁵+y⁵=33이지만 선택지에 대칭식 계산에 해당하는 유형 경로가 없다.","rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"근의 합과 곱으로 거듭제곱 대칭식을 계산하는 유형 경로가 선택지에 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"P(1)=0과 P'(1)=0에 해당하는 중복인수 조건을 적용해 (x-1)²의 계수를 정한다.","decisiveStep":"몫의 x=1 값은 80+a=0이므로 a=-80, b=79이고 b-a=159이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"40=39+1로 써서 40²⁵+5를 39로 나눈 나머지를 1²⁵+5의 나머지로 바꾼다.","decisiveStep":"1²⁵+5=6이므로 나머지는 6이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"α²=-α-1과 α³=1을 이용해 α⁴+kα²+1을 α의 일차식으로 줄인다.","decisiveStep":"(1-k)(α+1)=0이고 α는 허근이므로 k=1이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"복소수의 뜻","l4":"서로 같은 복소수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"실수부와 허수부의 정의, 실수의 복소수 포함 관계, 복소수의 대소 관계를 보기마다 확인한다.","decisiveStep":"실수의 복소수 포함과 7i의 허수부가 7이라는 설명이 모두 참이어서 단일 정답으로 정해지지 않는다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"복소수의 뜻","l4":"실수부·허수부"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
