  {"ordinal":12,"questionUid":"","primaryMethod":"제곱근의 분수식이 음수가 되는 정의역 조건을 분자와 분모에 나누어 적용한다.","decisiveStep":"정수 범위는 -5≤a<4여서 9개이지만 선택지에는 실수 범위와 제곱근 조건의 유형 경로가 없다.","rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"제곱근 분수의 정의역과 부호 조건을 다루는 유형 경로가 선택지에 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"f(x+2)=0은 x+2가 f의 두 근 -3,6 중 하나일 때이므로 두 근을 각각 2만큼 평행이동한다.","decisiveStep":"새 근은 -5와 4이며 곱은 -20이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식","l3":"근과 계수의 관계","l4":"근으로 방정식 구성"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
