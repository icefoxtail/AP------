    {"ordinal":1,"questionUid":"","primaryMethod":"왼쪽의 두 근호를 밑 2의 거듭제곱으로 바꾸어 지수의 합을 같게 둔다.","decisiveStep":"6/n+2/3=4/3에서 6/n=2/3이므로 n=9이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"a-a⁻¹=3을 세제곱하고 a³-a⁻³=(a-a⁻¹)³+3(a-a⁻¹) 항등식에 대입한다.","decisiveStep":"3³+3·3=36이므로 a³-a⁻³=36이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"(a²bc)^n의 소인수 지수를 각각 계산해 자연수가 되도록 세 분모를 모두 없애는 최소 n을 찾는다.","decisiveStep":"a²bc=2^{1/2}3^{1/6}5^{1/9}이므로 n은 2, 6, 9의 공배수이고 최소값은 18이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"두 번 축소한 비율 r이 r²=1/4를 만족하므로 한 번마다의 비율을 구해 다섯 번 곱한다.","decisiveStep":"축소비는 1/2이고 다섯 번 뒤 반지름은 (1/2)^5=1/32이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"로그 정의로 a²=3, b=27^{-1/3}을 구해 a²b를 계산한다.","decisiveStep":"a²=3이고 b=1/3이므로 a²b=1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"log x를 log 6.18에서 정수 3을 뺀 값으로 나타내고 로그의 곱셈 성질로 진수를 복원한다.","decisiveStep":"-2.2091=0.7909-3=log(6.18/1000)이므로 x=0.00618이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"소수점 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"이차방정식의 두 근을 로그값으로 읽어 a,b를 정하고 로그의 밑 변환으로 두 항을 계산한다.","decisiveStep":"로그값은 4,5이므로 a=81,b=243이며 log_a b=5/4, log_3(ab)=9여서 합은 41/4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"각 수평 경계 y=4, y=32에서 두 지수 그래프의 x좌표 차이를 구해 둘러싸인 띠의 넓이를 계산한다.","decisiveStep":"두 그래프의 x좌표 차이는 모든 y에서 3이고 높이는 32-4=28이므로 넓이는 84이다.","hold":"선택지 경로 표에 지수함수 두 그래프 사이의 넓이를 나타내는 조합이 없다.","rpmPath":{},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"t=3^x로 치환해 이차식 t²-8t+a의 최솟값을 t>0에서 구하고 그때 x를 정한다.","decisiveStep":"최솟값은 t=4, 즉 x=log_3 4에서 생기며 a-16=1이므로 a+b=17+log_3 4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"A가 y=2^x 위에 있어 d=2³이고 B가 y=log_2 x 위에 있어 log_2 b=3을 만족함을 이용한다.","decisiveStep":"d=8, b=8이므로 bd=64이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"수직 점근선 x=a에서 a를 읽고 점 (5,3)을 대입해 b를 구한 뒤 두 번째 점으로 맞는지 확인한다.","decisiveStep":"a=2, log_3 3+b=3이므로 b=2이며 (29,5)도 성립해 a+b=4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"공통값 81을 밑 3으로 바꾸어 세 식의 지수를 각각 4와 같게 둔다.","decisiveStep":"x=4, y=2, z=-4/3이므로 x+y+z=14/3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"몸무게 비 200에 3/4제곱을 취하고 상용로그로 값을 계산해 가장 가까운 정수 배수로 반올림한다.","decisiveStep":"log(200^{3/4})=(3/4)(0.30+2·0.70)=1.725이므로 비율은 약 53.1, 반올림하면 53배이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"첫 조건에서 b=a³을 얻고 둘째 식은 t=2^x로 놓아 t+8/t³의 양수 범위 최솟값을 구한다.","decisiveStep":"미분값 1-24/t⁴=0에서 t=24^{1/4}이고 최솟값은 (4/3)·24^{1/4}이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"u=log_a b로 두어 주어진 a^{3/2}<b<a²를 3/2<u<2로 바꾸고 네 로그를 1/u,u,u/2,2/u로 비교한다.","decisiveStep":"3/2<u<2에서 1/u<u/2<2/u<u이므로 log_b a<log_{a²}b<log_b a²<log_a b이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"A의 구간 [3,7]을 t=log_2 x로 옮겨 이차식 (t-2)²+k-4가 그 구간에서 0 이하가 되는지 확인한다.","decisiveStep":"4는 A에 속하며 t=log_2 4=2에서 이차식 값은 k-4이므로 공통 원소가 없으려면 k>4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
