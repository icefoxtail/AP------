  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"A(-2,5), B(4,8)을 2:1로 내분하는 좌표를 각각 반대쪽 비로 가중해 a+b를 구한다.","decisiveStep":"P의 좌표는 (2,7)이므로 두 좌표의 합은 9이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"선분의 내분·외분","l4":"내분점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"기울기 2인 직선이 (1,7)을 지나도록 y=2x+b에 대입해 a+b를 구한다.","decisiveStep":"7=2+b에서 b=5이고 a=2이므로 합은 7이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"두 직선의 위치 관계","l4":"평행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"x²+y²-4x-2=0에서 x항을 완전제곱식으로 바꾸어 원의 중심을 읽는다.","decisiveStep":"(x-2)²+y²=6이므로 중심은 (2,0)이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 방정식","l4":"일반형에서 원 찾기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"원점에서 3x-y+k=0까지의 거리를 반지름 √10과 같게 놓아 접하는 k를 구한다.","decisiveStep":"|k|/√10=√10에서 k=±10이므로 두 값의 합은 0이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원과 직선","l4":"교점 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"중심 (-5,5), 반지름 1인 원을 (3,-2)만큼 옮겨 새 중심과 반지름을 구한다.","decisiveStep":"이동 뒤 중심은 (-2,3), 반지름은 1이어서 a+b+r=2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"평행이동","l4":"원의 이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"(5,1)을 (a,-3)만큼 옮긴 좌표를 y=x 대칭으로 바꿔 (b,7)과 비교한다.","decisiveStep":"(-2,5+a)=(b,7)이므로 a=2, b=-2이고 합은 0이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"이동의 합성","l4":"연속 이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"P(a,b)가 y=2x+1 위에 있으면서 A(-1,2), B(2,0)에서 같은 거리이므로 거리 제곱을 같게 놓는다.","decisiveStep":"등거리 조건과 b=2a+1을 풀면 P=(-3/2,-2), 따라서 a+b=-7/2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"두 점 사이의 거리","l4":"도형의 변 길이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"x,y를 완전제곱해 반지름 제곱 3k²+4를 얻고 이를 25 이하로 제한한다.","decisiveStep":"k²≤7이고 k는 자연수이므로 k=1,2 두 개이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 방정식","l4":"일반형에서 원 찾기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"OAB의 무게중심과 각의 이등분선 정리로 C를 구한 뒤 GBC의 세 꼭짓점 좌표를 평균낸다.","decisiveStep":"G=(4/3,1), C=(0,4/3)에서 GBC의 무게중심은 (4/9,16/9)이므로 b/a=4이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"삼각형의 무게중심","l4":"좌표 도형 활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"AB의 길이 5와 기울기 -3/4를 이용해 정사각형의 수직 변 방향을 정하고 C,D를 좌표로 구한다.","decisiveStep":"제1사분면 조건으로 C=(3,7), D=(7,4)를 택하면 CD의 y절편은 37/4이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"평면좌표","l3":"두 점 사이의 거리","l4":"도형의 변 길이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"중심 (2,-1)에서 3x-y+k=0까지의 거리가 √10보다 큰 조건을 자연수 k에 적용한다.","decisiveStep":"|k+7|>10이고 k>0이므로 k>3, 최소값은 4이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원과 직선","l4":"교점 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"A(2,-3), B(3,2)에서 원 x²+y²=13에 그은 접선식을 세워 교점 P를 구하고 세 점의 평균을 낸다.","decisiveStep":"접선 2x-3y=13, 3x+2y=13의 교점은 (5,-1)이어서 무게중심은 (10/3,-2/3)이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"y=x+a를 x축 대칭한 뒤 위로 3만큼 옮겨 두 직선과 x=1이 만드는 삼각형 넓이를 식으로 나타낸다.","decisiveStep":"넓이 조건은 (2a-1)²/4=4이며 a>0을 적용하면 a=5/2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"이동의 합성","l4":"연속 이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"BC와 AB에 각각 수직인 A, C 통과 직선의 교점을 구하고 BC와 H 사이 거리로 넓이를 계산한다.","decisiveStep":"두 수선의 교점 H=(5,6), BC=3√2, 높이=1/√2이므로 넓이는 3/2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"두 직선의 위치 관계","l4":"수직"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"원점을 지나는 기울기 m 직선이 대칭이동된 원 (x-3)²+(y-2)²=8에 접하는 조건을 중심 거리로 둔다.","decisiveStep":"거리식에서 m²=8을 얻으므로 가능한 기울기 중 최댓값은 2√2이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"기울기가 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"완전제곱으로 중심 (2,-3), 반지름 5를 찾고 CP=8인 직각삼각형 두 개의 넓이를 합한다.","decisiveStep":"PA=PB=√39이므로 두 직각삼각형의 합인 사각형 넓이는 5√39이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"두 직선의 교점을 a,b로 나타내고 (5,1)을 지나는 x-2y 평행선 조건과 a²+b²=82를 연립한다.","decisiveStep":"a-3b=6과 양수 조건에서 b=1, a=9이므로 a+b=10이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"직선의 방정식","l3":"두 직선의 위치 관계","l4":"평행"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"공통현의 중점까지 거리 d로 삼각형 넓이 조건을 먼저 풀고 두 원의 교선에서 각 k를 구한다.","decisiveStep":"d²=2,8에 대응하는 k는 16,40,4,52이며 모두 양수라 합은 112이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"두 원","l4":"공통현·공통접선 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"직각이 O,A,P에 놓이는 세 경우로 나누고 각 경우의 P를 주어진 원과 교차시켜 넓이를 비교한다.","decisiveStep":"가능한 넓이는 9,12,24,36이므로 최댓값과 최솟값의 합은 45이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원과 직선","l4":"교점 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"원점 대칭인 두 반지름 1 원의 외접선 기울기와 원점을 지나는 내접선의 중심 거리 조건을 비교한다.","decisiveStep":"내접선 기울기는 0 또는 4/3이고 외접선은 1/2이므로 최댓값은 4/3이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"두 원","l4":"공통현·공통접선 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"P에서 원에 그은 접선의 길이와 접점 현 AB의 길이를 중심선에 대한 닮음으로 구해 삼각형 넓이를 계산한다.","decisiveStep":"AB=12/√5, PM=12/√5이므로 넓이는 72/5이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"원의 방정식","l3":"원의 접선","l4":"접점이 주어진 접선"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"대칭·평행이동한 포물선과 원래 포물선의 교점 방정식에 x=3 중근 조건을 써 a,b를 구한다.","decisiveStep":"이동 곡선은 -(x-5)²+7이고 수평선 교점 수를 세면 k=-1,3,7이다.","rpmPath":{"majorUnit":"도형의 방정식","midUnit":"도형의 이동","l3":"이동의 합성","l4":"조건으로 원래 도형 찾기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
