  "sourceArchiveFile": "original/high/h2/1final/26_강남여고_1학기_2차_고2_대수.js",
  "items": [
    { "ordinal": 1, "questionUid": "", "primaryMethod": "삼각형의 나머지 각 B를 구한 다음 외접원 반지름 4와 사인법칙으로 CA를 계산한다.", "decisiveStep": "CA/sin60°=2R=8이므로 CA=4√3이다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "사인법칙", "l4": "변·각 계산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 2, "questionUid": "", "primaryMethod": "외접원의 넓이에서 반지름 4를 얻고 BC와 sin A를 사인법칙에 넣는다.", "decisiveStep": "BC/sin A=8이고 BC=4이므로 sin A=1/2다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "사인법칙", "l4": "외접원 반지름" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 3, "questionUid": "", "primaryMethod": "그림에서 AB=7, BC=4√2, 끼인각 3π/4를 읽어 삼각형 넓이 공식에 대입한다.", "decisiveStep": "두 변 사이의 사인값은 √2/2이므로 넓이는 (1/2)·7·4√2·√2/2=14다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "삼각형의 넓이", "l4": "두 변과 끼인각" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 4, "questionUid": "", "primaryMethod": "각 등차수열의 첫째항과 공차를 식에 대입해 두 일반항을 만든 뒤 f(3)과 g(2)를 계산한다.", "decisiveStep": "f(n)=3n−8, g(n)=5−2n이어서 두 지정 항의 합은 2다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등차수열", "l4": "일반항" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 5, "questionUid": "", "primaryMethod": "각 등비수열에서 다섯 번째 항을 첫째항에 공비의 네제곱을 곱해 구한다.", "decisiveStep": "항은 각각 16(−1/2)^4=1과 (1/9)·3^4=9이므로 합은 10이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등비수열", "l4": "일반항" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 6, "questionUid": "", "primaryMethod": "a10−a3에서 공차를 구하고 a3으로 첫째항을 복원해 S20을 계산한다.", "decisiveStep": "공차 3과 첫째항 2로 a20=59가 되므로 S20=10(2+59)=610이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등차수열", "l4": "합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 7, "questionUid": "", "primaryMethod": "S8/S4를 이용해 공비의 네제곱을 정하고 양의 첫째항 조건으로 공비의 부호를 거른다.", "decisiveStep": "공비 −2는 S4=5일 때 첫째항이 음수가 되므로 공비 2와 첫째항 1/3만 남는다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등비수열", "l4": "합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 8, "questionUid": "", "primaryMethod": "Σ(aₖ±bₖ)와 상수배 합은 주어진 두 합으로 계산하고 Σaₖbₖ가 정해지는지는 따로 판단한다.", "decisiveStep": "각 항의 곱의 합은 각각의 합만으로 결정되지 않아 −50이라고 단정한 보기가 틀리다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "합의 기호 Σ", "l4": "성질" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 9, "questionUid": "", "primaryMethod": "등차수열의 a2,a4,a7을 첫째항과 공차로 쓰고 등비수열의 가운데 항 제곱 조건을 적용한다.", "decisiveStep": "공차가 0이 아니므로 a=3d이고, a12/a5=(14d)/(7d)=2다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등차수열", "l4": "조건으로 수열 결정" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 10, "questionUid": "", "primaryMethod": "첫 삼각형은 사인법칙으로 BC를 구하고 둘째 삼각형은 주어진 두 변과 45°에 코사인법칙을 적용한다.", "decisiveStep": "두 번째 길이 b는 b²−4b−5=0의 양의 해 5이고 첫 길이는 4여서 합이 9다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "코사인법칙", "l4": "변·각 계산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 11, "questionUid": "", "primaryMethod": "호 길이 비를 중심각 150°,150°,60°로 바꾸고 세 중심 삼각형의 넓이를 합한다.", "decisiveStep": "반지름 2에서 넓이는 2(sin150°+sin150°+sin60°)=2+√3이므로 p/q=2다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "삼각형의 넓이", "l4": "복합도형" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 12, "questionUid": "", "primaryMethod": "대각선 AC를 x로 놓고 두 삼각형의 코사인법칙과 원주각 보각 관계를 이용해 x를 정한다.", "decisiveStep": "x=7이면 ACD가 한 변 7인 정삼각형이므로 두 삼각형의 넓이를 더해 16√3을 얻는다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "삼각형의 넓이", "l4": "복합도형" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 13, "questionUid": "", "primaryMethod": "a3+a8=2a+9d로 조건을 정리하고 S6과 S12를 각각 첫째항과 공차로 나타낸다.", "decisiveStep": "두 합의 결합이 9(2a+9d)이므로 주어진 값에서 117이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등차수열", "l4": "합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 14, "questionUid": "", "primaryMethod": "n≥2에서 an=Sn−S(n−1)을 계산해 지정된 짝수 번째 항을 더한다.", "decisiveStep": "차분하면 an=3·2ⁿ이므로 a2+a4+a6=12+48+192=252다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "계차수열", "l4": "일반항 구하기" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 15, "questionUid": "", "primaryMethod": "a3k의 합은 6k−1의 합으로 계산하고 b2k는 공비 9인 등비수열의 합으로 바꾼다.", "decisiveStep": "두 부분은 각각 85와 (3/4)(9⁵−1)이므로 p,q,r은 85,9,5다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "합의 기호 Σ", "l4": "Σ 계산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 16, "questionUid": "", "primaryMethod": "a1=41과 a7=11로 공차를 구해 an=46−5n으로 나타내고 0에 가장 가까운 항을 찾는다.", "decisiveStep": "근 46/5에 가까운 n=9,10을 비교하면 절댓값은 1과 4이므로 n=9다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등차수열", "l4": "일반항" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 17, "questionUid": "", "primaryMethod": "홀수 항의 등비 규칙으로 a9,a13을 구하고 연속한 짝수 부분합의 차에서 짝수 항을 정한다.", "decisiveStep": "S2n=S2n−2이면 a(2n−1)+a(2n)=0이어서 a10−a14=96이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "수열의 활용", "l4": "조건으로 수열 결정" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 18, "questionUid": "", "primaryMethod": "양의 공비 r을 a4=6a2+a3에 넣어 결정하고 등비수열의 15항 합을 로그 진수로 만든다.", "decisiveStep": "r²−r−6=0의 양수 해는 3이고 S15+1=3¹⁵이므로 로그와 5의 합은 20이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등비수열", "l4": "합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 19, "questionUid": "", "primaryMethod": "매월 초 납입분에 한 달치 이자를 더해 월 납입액과 등비급수의 미래가치 합을 각각 계산한다.", "decisiveStep": "두 원리합계는 2,412,000원과 2,515,000원이어서 차의 절댓값은 103,000원이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "등차수열과 등비수열", "l3": "등비수열", "l4": "합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 21, "questionUid": "", "primaryMethod": "n(n+1)/2의 홀짝에 따라 an의 부호가 네 항마다 반복됨을 확인하고 4항 묶음으로 가중합한다.", "decisiveStep": "첫 28항 묶음 합은 28, 마지막 두 항은 −59이므로 전체는 −31이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "여러 가지 수열의 합", "l4": "자연수 거듭제곱의 합" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 22, "questionUid": "", "primaryMethod": "사인법칙으로 sin A/sin B를 변의 비 a/b로 바꾸고 이를 코사인법칙에 대입한다.", "decisiveStep": "정리한 식은 a²+c²=b²이므로 B가 직각인 삼각형이다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 활용", "l3": "코사인법칙", "l4": "삼각형 판정" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 23, "questionUid": "", "primaryMethod": "a1은 S1로 따로 구하고 n≥2에서 합의 차 Sn−S(n−1)로 an의 부호를 판단한다.", "decisiveStep": "n≥2일 때 an=10−2n>0은 n=2,3,4에서만 성립한다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "계차수열", "l4": "일반항 구하기" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 24, "questionUid": "", "primaryMethod": "1/((2k−1)(2k+1))을 두 홀수 분모의 차로 나누어 망원합을 만든다.", "decisiveStep": "중간 항이 소거되어 합은 (1/2)(1−1/21)=10/21이고 p+q=31이다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수열의 합", "l3": "여러 가지 수열의 합", "l4": "부분분수·망원급수형" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 25, "questionUid": "", "primaryMethod": "n=1에서 식을 확인하고 k에서 성립한다고 가정한 뒤 양변에 1/((k+1)(k+2))를 더한다.", "decisiveStep": "분자가 (k+1)²로 묶여 약분하면 (k+1)/(k+2)가 되어 다음 단계가 성립한다.", "rpmPath": { "majorUnit": "수열", "midUnit": "수학적 귀납법", "l3": "수학적 귀납법", "l4": "등식 증명" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" }
  ]
}