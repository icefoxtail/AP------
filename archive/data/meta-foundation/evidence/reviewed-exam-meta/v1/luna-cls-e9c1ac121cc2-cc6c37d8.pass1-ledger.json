  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"P(A∪B)=P(A)+P(B)-P(A∩B)를 교집합 확률에 맞게 정리한다.","decisiveStep":"1/2+3/5-7/10=2/5이므로 P(A∩B)=2/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"한 학생을 원탁에서 고정해 나머지 다섯 학생을 배열한다.","decisiveStep":"회전으로 같은 배열을 하나로 보므로 경우의 수는 5!=120이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"파란 공이 하나도 없는 사건, 즉 두 빨간 공을 고르는 사건의 확률을 전체에서 뺀다.","decisiveStep":"전체는 6C2=15가지이고 두 빨간 공을 고르는 것은 1가지이므로 확률은 1-1/15=14/15이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"A에서 P, P에서 B까지의 오른쪽 이동과 위쪽 이동 순서를 각각 배열한다.","decisiveStep":"각 구간은 오른쪽 두 번과 위쪽 한 번이라 3가지씩이며 전체는 3·3=9가지이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"일렬 배열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"2학년 사건과 빵 구매 사건의 덧셈정리에서 두 사건이 겹치는 확률을 계산한다.","decisiveStep":"3/7+1/2-4/7=5/14이므로 둘 다 해당할 확률은 5/14이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"전체 함수 수 5^3 중에서 세 입력의 함숫값이 서로 다른 배정 수 5P3를 나눈다.","decisiveStep":"일대일 함수는 60개, 전체 함수는 125개이므로 확률은 60/125=12/25이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"세 공의 색이 모두 다를 확률을 먼저 구해 어떤 두 공이 같은 색일 사건의 여사건으로 뺀다.","decisiveStep":"전체 11C3=165 중 세 색을 하나씩 고르는 3·4·4=48을 빼면 확률은 39/55이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"각 조합수를 아래첨자 2인 항으로 바꾸어 파스칼 삼각형의 사선 합을 적용한다.","decisiveStep":"합은 2C2+3C2+…+20C2=21C3=21C18이므로 고르는 값은 21C18이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항계수","l4":"조합 항등식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"괄호 안의 합을 (1+5)^30 꼴의 이항전개로 묶고 밑이 6인 로그를 계산한다.","decisiveStep":"합은 6^30이므로 log₆(6^30)=30이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"전개식의 항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"6가지 색을 여섯 면에 고정한 배열 수를 직육면체의 자기회전 동치 수로 나눈다.","decisiveStep":"세 변 길이가 모두 달라 회전 대칭은 네 가지이므로 6!/4=180가지이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"각 (1+x)^k에서 x^5 계수를 더해 조합 항등식으로 n에 관한 식을 만든다.","decisiveStep":"계수 합은 5C5+…+nC5=(n+1)C6=462이고 11C6=462이므로 n=10이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항계수","l4":"조합 항등식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"노란 공 두 개가 세 자리 간격인 여섯 위치쌍을 고르고 남은 칸에 파란 공과 빨간 공을 배열한다.","decisiveStep":"각 위치쌍마다 남은 배열은 7C3=35가지이므로 6·35=210이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"홀수와 소수의 내부 순서 조건이 1, 2, 3, 5의 상대 순서를 정하므로 그 순서를 세고 4와 6을 놓는다.","decisiveStep":"허용 상대 순서는 1,2,3,5 또는 2,1,3,5이고 자리 선택과 4,6 배열을 곱해 2·6C4·2!=60이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"일렬 배열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"두 다항식에서 x^(n-1)의 계수를 각각 일반항으로 구해 같게 놓고 자연수 n, a를 찾는다.","decisiveStep":"n은 짝수이고 24=(n-1)(n-2)a²을 만족하므로 (n,a)=(4,2), n+a=6이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"이항정리","l3":"이항정리","l4":"특정 항의 계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"짝수인 네 자리 수 전체에서 33이 이웃하는 두 위치쌍을 포함배제로 빼낸다.","decisiveStep":"전체 648에서 두 위치쌍 각각 18을 빼고 겹친 3을 더하면 615개이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"1부터 5까지 각 원소를 A만, B만, C만 중 하나로 보내고 공집합 C 및 A=B인 배정을 뺀다.","decisiveStep":"세 선택지 배정은 3^5이고 C가 비는 2^5, A=B가 되는 1을 빼어 210개이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"조합","l4":"분할·분배"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"네 학생의 나라 선택 전체에서 영국이 빠지거나 일본이 빠진 경우를 포함배제로 제외한다.","decisiveStep":"3^4-2·2^4+1=50이므로 두 나라를 모두 포함하는 선택은 50가지이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"순열","l4":"중복·원순열"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"끝 함숫값이 홀수이고 가운데 두 함숫값의 홀짝이 같다는 조건에 따라 네 값이 모두 홀수인 경우와 가운데가 짝수인 경우로 나눈다.","decisiveStep":"모두 홀수인 단조 수열은 5H4=70개이고 가운데가 짝수인 경우는 35개여서 합은 105개이다.","rpmPath":{"majorUnit":"경우의 수","midUnit":"순열과 조합","l3":"중복조합","l4":"중복을 허용한 선택"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
