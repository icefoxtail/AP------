  "items": [
    { "ordinal": 1, "questionUid": "", "primaryMethod": "두 세제곱근을 곱해 ∛162로 합치고 바깥 제곱근도 지수 1/6으로 바꾸어 ∛6의 계수를 비교한다.", "decisiveStep": "∛162=3∛6이고 √(∛36)=∛6이므로 계수는 2다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "거듭제곱근", "l4": "n제곱근" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 2, "questionUid": "", "primaryMethod": "로그의 차를 몫으로, 2log3을 log9로 바꾸어 하나의 상용로그로 합친다.", "decisiveStep": "로그의 진수는 (8/4)·9=18이므로 n=18이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 성질", "l4": "곱·몫·거듭제곱" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 3, "questionUid": "", "primaryMethod": "네제곱근 기호가 양의 근을 뜻하는 점과 음수 밑에 지수법칙을 적용하는 과정을 구별한다.", "decisiveStep": "{(−2)^4}^(1/4)=2인데 (−2)^(4·1/4)=−2이므로 세 번째 등호가 틀리다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "거듭제곱근", "l4": "실수 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 4, "questionUid": "", "primaryMethod": "부채꼴의 넓이와 호의 길이에서 반지름을 먼저 없애고 l=rθ에 대입한다.", "decisiveStep": "반지름이 14이므로 중심각은 4π/14=2π/7이다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "일반각과 호도법", "l4": "호도법" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 5, "questionUid": "", "primaryMethod": "밑 x−2가 양수이고 1이 아니며 진수 −x²+5x+6도 양수가 되도록 정수 범위를 교차한다.", "decisiveStep": "2<x<6에서 밑이 1이 되는 x=3을 제외하면 4와 5 두 개만 남는다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 뜻", "l4": "밑과 진수 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 6, "questionUid": "", "primaryMethod": "sinθ+cosθ와 sinθcosθ의 값을 구해 두 삼각함수를 이차방정식의 두 근으로 찾는다.", "decisiveStep": "사분면 조건이 sinθ=4/5, cosθ=−3/5를 골라 tanθ=−4/3이 된다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "삼각함수의 성질", "l4": "삼각함수 관계" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 7, "questionUid": "", "primaryMethod": "A=log k로 두어 x,y,z를 A와 각 밑의 로그로 나타내고 조건식을 xyz로 나눈다.", "decisiveStep": "계수 로그의 결합이 3log(4/3)이어서 A=log(4/3), k=4/3이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 뜻", "l4": "로그와 지수 관계" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 8, "questionUid": "", "primaryMethod": "로그함수의 정의역과 역함수를 확인한 뒤 기본 그래프를 옮겼을 때 점근선 위치를 판정한다.", "decisiveStep": "x축으로 a만큼 옮기면 점근선 x=0이 x=a가 되므로 y=b라는 설명이 틀리다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 그래프", "l4": "평행이동" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 9, "questionUid": "", "primaryMethod": "소리의 세기 10⁻⁷과 10⁻¹¹을 로그식에 넣어 각각의 데시벨 값을 계산한다.", "decisiveStep": "크기는 50dB와 10dB이므로 A/B=5다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 성질", "l4": "곱·몫·거듭제곱" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 10, "questionUid": "", "primaryMethod": "x=logₐb로 두면 logᵦa=1/x이고, 조건으로 x를 구해 목표 로그의 밑을 바꾼다.", "decisiveStep": "양의 해 x=(1+√5)/2를 대입해 (2+2x)/(2+x)=1+√5/5를 얻는다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 성질", "l4": "밑의 변환" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 11, "questionUid": "", "primaryMethod": "t=2ˣ+2⁻ˣ로 치환해 t≥2를 보이고 원래 식을 t에 대한 이차식으로 정리한다.", "decisiveStep": "(t−1)²−2는 t≥2에서 x=0일 때 최솟값 −1을 가지므로 m+2ᵖ=0이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수함수의 활용", "l4": "최대·최소" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 12, "questionUid": "", "primaryMethod": "역함수 조건 g(3)=3, g(6)=6을 f(3)=3, f(6)=6으로 옮겨 k,p를 연립한다.", "decisiveStep": "klog₆2=3으로부터 p/k=log₆2−log₆3=log₆(2/3)다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 뜻", "l4": "로그와 지수 관계" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 13, "questionUid": "", "primaryMethod": "각 보기의 주기와 주어진 입력에서의 삼각함수 값을 확인하고 탄젠트 그래프의 주기를 식으로 바꾼다.", "decisiveStep": "주기 π/3인 h는 a=±3이어서 h(π/6)=tan(±π)=0이며 ④의 √3과 다르다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 그래프", "l3": "기본 그래프", "l4": "tan" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 14, "questionUid": "", "primaryMethod": "f(x)=(x−1)²+2의 치역을 정하고 증가 로그와 감소 로그에서 합성함수의 끝값을 고른다.", "decisiveStep": "M=log₂19, m=−log₃32=−5log₃2여서 곱은 −5log₃19다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 활용", "l4": "최대·최소" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 15, "questionUid": "", "primaryMethod": "원 위의 직선 y=−3x 교점에서 좌표 부호를 정해 두 동경의 사인과 코사인을 구한다.", "decisiveStep": "P=(−1,3), Q=(1,−3)이므로 두 값은 3/√10과 1/√10, 합은 2√10/5다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "삼각함수의 뜻", "l4": "단위원" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 16, "questionUid": "", "primaryMethod": "원을 중심 (−3,3), 반지름 2로 바꾸고 OP의 허용 범위에서 2^(OP/3)이 자연수가 되는 값을 찾는다.", "decisiveStep": "자연수 값 2,3,4에 대응하는 세 원점 중심 원이 각각 주어진 원과 두 점에서 만나 총 6점이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수함수의 활용", "l4": "그래프 교점" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 17, "questionUid": "", "primaryMethod": "그래프의 최대·최소에서 음의 진폭을 구하고 연속한 최대점 간격으로 b와 시작점으로 c를 정한다.", "decisiveStep": "a=−2, b=4, c=π/2이므로 abc=−4π다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수의 그래프", "l3": "그래프 변환", "l4": "주기·진폭" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 18, "questionUid": "", "primaryMethod": "로그함수와 y=0, y=3의 교점을 좌우 대칭으로 구해 사다리꼴의 두 밑변을 정한다.", "decisiveStep": "밑변 길이가 1과 8, 높이가 3이므로 넓이는 (1+8)·3/2=27/2다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 활용", "l4": "그래프 교점" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 20, "questionUid": "", "primaryMethod": "−7π/4에 2π의 정수배를 더해 한 바퀴 안의 동경과 같은 각을 찾는다.", "decisiveStep": "−7π/4+2π=π/4이므로 동경은 제1사분면을 향한다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "일반각과 호도법", "l4": "일반각" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 21, "questionUid": "", "primaryMethod": "x에 대한 이차식의 판별식이 음수여야 함을 사용하고 sinθ 부등식으로 각 범위를 정리한다.", "decisiveStep": "sinθ<−1/2에서 7π/6<θ<11π/6이며 제외각 3π/2를 기준으로 탄젠트 값 범위를 나눈다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "삼각방정식·부등식", "l4": "주기 구간의 해" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 22, "questionUid": "", "primaryMethod": "n²−13n+30=(n−3)(n−10)의 부호와 n의 홀짝을 함께 살펴 실수 n제곱근 수를 센다.", "decisiveStep": "각 n=2,…,12의 근 개수를 더하면 10이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "거듭제곱근", "l4": "실수 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 23, "questionUid": "", "primaryMethod": "x<−3인 직선 부분과 x≥−3인 절댓값 지수 부분을 나눠 수평선 y=n과의 교점을 센다.", "decisiveStep": "g의 값별 개수는 0이 2개, 1이 11개, 2가 1개, 3이 7개이므로 합 조건의 순서쌍은 50개다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수함수의 활용", "l4": "그래프 교점" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" }
  ]
}