  "schemaVersion":"meta-judgment-ledger-v1","judge":"luna-pass1","createdAt":"2026-11-12T00:00:00+09:00","sourceArchiveFile":"types/high/h2/비상_대수_삼각함수_대단원_고2_유형확인.js","items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"각을 모두 π/3을 기준으로 나타내고 2π를 더하거나 빼어 같은 동경인지 확인한다.","decisiveStep":"앞의 네 각은 300°와 동경이 같지만 -11π/3은 π/3과 동경이 같으므로 이것이 다른 각이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"부채꼴 넓이 12=1/2·r²·1.5로 반지름을 구한 뒤 둘레에 두 반지름과 호의 길이 rθ를 더한다.","decisiveStep":"r=4, 호의 길이는 4·1.5=6이므로 둘레는 14이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"두 분수를 각각 tan(θ/2), cot(θ/2)로 보거나 통분해 2/sinθ로 정리한다.","decisiveStep":"2/sinθ=-4에서 sinθ=-1/2이며 θ가 제4사분면이므로 sinθ=-1/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"각을 한 바퀴 안의 동경으로 바꾸고 각 사분면에서 사인·코사인·탄젠트 값을 계산한다.","decisiveStep":"세 항은 각각 1/2, -1/2, 1이므로 합은 1이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"각 함수의 최소 양의 주기를 절댓값과 입력의 배율을 반영해 비교한다.","decisiveStep":"|sin(x/2)|의 주기는 2π이고 다른 보기의 주기는 각각 π, π, π, 4π이므로 다섯째 함수가 해당한다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"ㄱ은 1°와 179°의 코사인을 짝짓고, ㄴ은 보각의 제곱 사인을 짝짓고, ㄷ은 탄젠트 보각 곱을 묶는다.","decisiveStep":"각 합은 각각 -1, 5, 1이므로 ㄱ·ㄴ·ㄷ이 모두 옳다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"sin(π/2+x)를 cosx로 바꾸고 cosx=cos2x를 0≤x<2π에서 푼다.","decisiveStep":"cosx=2cos²x-1에서 cosx=1 또는 -1/2이므로 구간의 서로 다른 해는 3개다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"절댓값 부등식을 sinx>√3/2 또는 sinx<-√3/2로 나누어 한 주기에서 해 구간의 양 끝을 정한다.","decisiveStep":"해 구간은 (π/3,2π/3), (4π/3,5π/3)이므로 네 끝점의 합은 4π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"그래프를 이용한 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"A+B=120°에서 C=60°를 구하고 사인법칙의 c=2RsinC에 AB=12를 대입한다.","decisiveStep":"R=12/(2sin60°)=4√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"외접원 반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"사인법칙으로 변의 비를 3:5:7로 옮기고 가장 긴 변을 외접반지름과 그 맞은편 각의 사인으로 나타낸다.","decisiveStep":"cosC=-1/6이므로 sinC=√35/6이고 가장 긴 변은 2·7·sinC=7√35/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"세 변 5, 6, 7의 반둘레 9를 헤론 공식에 넣어 넓이를 구한다.","decisiveStep":"넓이는 √(9·4·3·2)=6√6이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"복합도형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"180°<θ<270°를 2로 나누어 θ/2의 범위를 구한다.","decisiveStep":"90°<θ/2<135°이므로 가능한 사분면은 제2사분면뿐이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"최댓값과 최솟값에서 진폭과 중심선을 구하고 주기 4π로 b를 정한다.","decisiveStep":"a=3, c=2, b=1/2이므로 abc=3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"OP=3r/4, OQ=r/2를 넓이식 1/2·OP·OQ·sin(π/4)에 대입한다.","decisiveStep":"넓이가 3√2r²/64=3√2/2이므로 r²=32, r=4√2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"두 변과 끼인각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"지름을 빗변으로 하는 직각삼각형에서 PB를 구하고 cosθ=AP/AB로 cos2θ를 계산한다.","decisiveStep":"PB=6, cosθ=4/5이므로 cos2θ=2(4/5)²-1=7/25이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"코사인법칙으로 b=k, c=2k일 때 a²=7k²임을 구하고 외접반지름에서 a를 정한 뒤 넓이식을 쓴다.","decisiveStep":"a=2Rsin120°=√21이므로 k=√3이고 넓이는 bc·sin120°/2=3√3/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"두 변과 끼인각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
