{"ordinal":2,"questionUid":"","primaryMethod":"첫 눈이 큰 순서쌍 15개 중 두 눈의 합이 짝수인 경우를 센다.","decisiveStep":"A 안에서 같은 홀짝 눈 쌍은 6개이므로 조건부확률은 6/15=2/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
