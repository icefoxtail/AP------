 "schemaVersion":"meta-judgment-ledger-v1","judge":"luna-pass1","createdAt":"2026-11-12T02:31:00+09:00",
 "sourceArchiveFile":"original/high/h2/2mid/23_복성고_2학기_중간_고2_확률과통계.js",
 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"주사위 눈이 3의 배수일 확률은 2/6이고 동전 앞면은 1/2이므로 두 독립 결과의 확률을 곱한다.","decisiveStep":"유리한 결과는 주사위 3 또는 6과 앞면뿐이라 확률은 (2/6)(1/2)=1/6이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"두 번 던진 눈 순서쌍 36개에서 첫 눈이 더 큰 15개만 조건 A로 잡고, 그중 합이 짝수인 6개를 사건 B와의 교집합으로 센다.","decisiveStep":"조건 A 아래의 표본공간 크기가 15, A와 B가 함께 일어나는 경우는 두 눈이 같은 짝홀수인 6쌍이므로 P(B|A)=6/15=2/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"공정한 동전 5개에서 앞면이 0,1,2개인 경우를 각각 조합수 1,5,10으로 세어 전체 2⁵가지로 나눈다.","decisiveStep":"유리한 경우의 수는 1+5+10=16이므로 확률은 16/32=1/2이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"독립시행","l4":"반복 시행의 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"365일 중 21명의 생일이 서로 다르도록 첫 학생부터 겹치지 않는 날짜를 하나씩 배정하는 확률을 순서대로 곱한다.","decisiveStep":"연속해서 남는 날짜 수가 365,364,…,345이므로 확률은 365·364·…·345를 365²¹로 나눈 값이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"흰 공 3개와 검은 공 n개 중 2개를 뽑을 때 흰 공끼리 뽑는 여사건의 확률을 전체 조합수에 대한 3C2의 비로 나타낸다.","decisiveStep":"1−3/((n+3)C2)=7/10에서 (n+3)C2=10이므로 n=2이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"1월부터 12월까지 서로 이웃하지 않는 3개월을 고르는 수는 간격을 하나씩 제외해 10C3이고, 전체 선택은 12C3이다.","decisiveStep":"조건을 만족하는 선택은 120가지, 전체는 220가지이므로 확률은 120/220=6/11이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"표에서 X=0,1,2의 확률 2/7,3/7,2/7로 E(X)=1과 E(X²)=11/7을 계산한 뒤 7배 변환의 분산을 구한다.","decisiveStep":"V(X)=11/7−1=4/7이고 V(7X)=49V(X)=28이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"20개 x의 합과 30개 y의 합을 합쳐 100으로, 제곱합을 합쳐 250으로 만들어 50개 변량의 평균과 분산을 계산한다.","decisiveStep":"평균은 100/50=2이고 분산은 250/50−2²=1이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"분산·표준편차"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"B(n,p)의 평균 np=20과 표준편차 4에서 분산 np(1−p)=16을 함께 사용해 p,n을 구한다.","decisiveStep":"두 식의 비로 1−p=16/20=4/5, 따라서 p=1/5이고 n=100이므로 B(100,1/5)이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"X=1,2,3,4,5의 확률이 3/10,p,1/10,p,p이므로 확률합에서 p를 정하고 E(5X+3)=5E(X)+3을 적용한다.","decisiveStep":"3p=3/5에서 p=1/5, E(X)=14/5이므로 E(5X+3)=17이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":11,"questionUid":"","primaryMethod":"N(0,1)의 표준편차 1인 곡선과 N(3,1/4)의 표준편차 1/2인 곡선을 각각 평균 위치 0과 3에 놓고 폭과 높이를 비교한다.","decisiveStep":"두 번째 분포는 평균이 오른쪽 3으로 이동하고 표준편차가 절반이므로 더 좁고 더 높게 그려진다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":12,"questionUid":"","primaryMethod":"복원추출 50회에서 빨간 공 개수 X는 성공확률 p인 이항분포이고 평균 50p=10에서 빨간 공 비율을 구한다.","decisiveStep":"p=1/5이므로 빨간 공은 20개, 파란 공은 100−20=80개이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"평균 750g, 표준편차 100g인 사과에서 850g을 표준화해 z=1로 바꾸고 표의 오른쪽 꼬리확률을 백분율로 나타낸다.","decisiveStep":"P(Z≥1)=0.5−0.3413=0.1587이므로 최상품 비율 a는 15.87이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":14,"questionUid":"","primaryMethod":"P(X≥64)=P(X≤56)의 대칭 조건에서 평균 m=60을 얻고, E(X²)=3616에서 분산을 구해 68을 표준화한다.","decisiveStep":"σ²=3616−60²=16이므로 68은 평균보다 2σ 위이며 P(X≤68)=0.5+0.4772=0.9772이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":15,"questionUid":"","primaryMethod":"이항분포 X에서 E(X)=30, V(X)=15를 np와 np(1−p)에 각각 대입해 n,p를 정한 뒤 ㄱ·ㄴ·ㄷ을 판별한다.","decisiveStep":"p=1/2,n=60이고 E(X²)=915라 ㄱ은 거짓, 범위와 대칭으로 ㄴ·ㄷ은 참이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"이항분포","l4":"평균·분산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":16,"questionUid":"","primaryMethod":"확률밀도 그래프의 꼭짓점 (−a,0),(0,a),(2a,0)으로 전체 삼각형 넓이와 0≤X≤a 부분의 사다리꼴 넓이를 구한다.","decisiveStep":"전체 넓이는 3a²/2, 부분 넓이는 3a²/4이므로 확률은 1/2이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"확률변수와 확률분포","l4":"확률밀도함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":17,"questionUid":"","primaryMethod":"흰 공 6개 중 8개 공에서 3개를 비복원 추출할 때 흰 공 개수 X의 기댓값을 추출 수와 흰 공 비율의 곱으로 구한다.","decisiveStep":"E(X)=3·(6/8)=9/4이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"기댓값과 분산","l4":"기댓값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":18,"questionUid":"","primaryMethod":"주봉 사과 98g을 평균 86, 표준편차 15로 표준화한 z점수와 같은 누적확률을 양현 분포 N(88,10²)에 적용한다.","decisiveStep":"두 분포의 z가 같아 (98−86)/15=(a−88)/10=0.8이므로 a=96g이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"정규분포 확률"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":19,"questionUid":"","primaryMethod":"400회 시행의 이항분포 B(400,0.9)를 평균 360, 표준편차 6인 정규분포로 근사하고 351≤X≤369를 연속성 보정한다.","decisiveStep":"보정 경계 350.5와 369.5의 z값은 약 −1.58,1.58이므로 표에서 확률은 2×0.4429=0.8858이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":20,"questionUid":"","primaryMethod":"평균 70, 표준편차 10인 점수에서 90점은 z=2로 표준화하고, 500명 중 100등은 누적비율 0.8에 해당하는 z를 찾아 점수로 되돌린다.","decisiveStep":"상위 꼬리 0.0228은 1000명 중 약 23명이고, 누적 0.8의 z≈0.84에서 점수는 70+10·0.84=78.4점이다.","rpmPath":{"majorUnit":"통계","midUnit":"확률분포","l3":"정규분포","l4":"표준정규분포"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
 ]
}