  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"√3sin(5π/3), √3tan(7π/3), cos(π/2)의 특수각 값을 각각 대입해 계산한다.","decisiveStep":"-3/2+3=3/2","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"AC=3, BC=2√2, ∠ACB=45°를 넓이식 1/2·AC·BC·sin45°에 넣는다.","decisiveStep":"1/2·3·2√2·√2/2=3","standardUnitKey":"H15-M1-05","newKeyProposal":{"key":"H15-M1-05-TRIGONOMETRIC_APPLICATION","label":"삼각함수의 활용","why":"선택지에는 삼각함수 활용 소단원 값이 없어 새 소단위 값이 필요하다."},"rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"선택지의 유형 경로에 두 변과 끼인각으로 삼각형 넓이를 구하는 조합이 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"tan2x의 주기 π/2와 0≤x≤π/2 안의 점근선 x=π/4를 각각 구해 b/a를 계산한다.","decisiveStep":"(π/4)/(π/2)=1/2","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"기본 그래프","l4":"tan"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"a₂=8과 a₆=24 사이의 네 칸에서 공차를 구한 뒤 a₁₀까지 네 칸 더한다.","decisiveStep":"d=(24-8)/4=4, a₁₀=24+4·4=40","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"등차중항에서 a+b=2를 얻고 등비중항에서 (a-b)(a+b)=64를 세워 절댓값 합을 정한다.","decisiveStep":"a-b=32이므로 (a,b)=(17,-15), |a|+|b|=32","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":6,"questionUid":"","primaryMethod":"-2cos(2x+π)+3을 2cos2x+3으로 바꾼 다음 보기의 주기·범위·대칭·점값을 대조한다.","decisiveStep":"x=0이면 y=5이므로 (0,1)을 지난다는 설명이 거짓이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"그래프의 최댓값 3과 최솟값 -1에서 진폭과 중심선을 읽고, 최저점 간격 4로 b를 정한다.","decisiveStep":"a=2, c=1, 2/b=4이므로 b=1/2, a+2b-c=2","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"0≤x<2π에서 sinx=1/3의 두 해가 서로 보각이므로 합을 π로 둔다.","decisiveStep":"sin(π/2+π/3)=sin(5π/6)=1/2","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"등변사다리꼴의 같은 대각선 길이를 d로 두고 두 대각선과 끼인각으로 넓이를 나타낸다.","decisiveStep":"4√3=(1/2)d²sin(2π/3)=d²√3/4이므로 d=4","standardUnitKey":"H15-M1-05","newKeyProposal":{"key":"H15-M1-05-TRIGONOMETRIC_APPLICATION","label":"삼각함수의 활용","why":"선택지에는 삼각함수 활용 소단원 값이 없어 새 소단위 값이 필요하다."},"rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"선택지의 유형 경로에 두 대각선과 사이각으로 사각형 넓이를 나타내는 조합이 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"S₁에서 a₁을 읽고 S₃-S₂로 a₃을 구해 두 항을 더한다.","decisiveStep":"a₁=9, a₃=23-14=9이므로 합은 18","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"첫 10항 합과 다음 10항 합의 비 9를 공비의 10제곱으로 보고 세 번째 묶음 합을 구한다.","decisiveStep":"S₃₀=4+36+36·9=364","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":12,"questionUid":"","primaryMethod":"외접반지름 4로 사인법칙에서 BC와 CA를 구한 뒤 각 B의 코사인법칙에 AB=x를 대입한다.","decisiveStep":"x²-4√2x-16=0의 양수근은 2√2+2√6이다.","standardUnitKey":"H15-M1-05","newKeyProposal":{"key":"H15-M1-05-TRIGONOMETRIC_APPLICATION","label":"삼각함수의 활용","why":"선택지에는 사인법칙과 코사인법칙을 이용하는 소단원 값이 없어 새 소단위 값이 필요하다."},"rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"선택지의 유형 경로에 사인법칙과 코사인법칙을 이어 쓰는 조합이 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":13,"questionUid":"","primaryMethod":"매 시행마다 현재 남은 수열의 홀수 번째 위치만 남으므로 제2항의 원래 위치가 시행마다 두 배 간격으로 이동한다.","decisiveStep":"9회 뒤 제2항=1+2⁹=513","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"귀납적 패턴"},"crossConceptKeys":[],"conditionKeys":["COND_ITERATION_COUNT"],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"월초 납입금 P가 만기까지 얻는 이자를 r+r²+…+r¹²의 등비합으로 나타낸다.","decisiveStep":"계수 합이 1.008·0.1/0.008=12.6이므로 P=756000/12.6=60000","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"근과 계수의 관계로 각 n에서 두 근의 합으로 a를 찾고, 두 근의 곱을 n=1부터 10까지 더한다.","decisiveStep":"330/a=33에서 a=10, 곱의 합은 (3025-275)/10=275","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"합의 기호 Σ","l4":"Σ 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":16,"questionUid":"","primaryMethod":"한 변을 1로 두어 AP와 AQ를 피타고라스로 구하고, 삼각형 APQ의 두 넓이식을 같게 둔다.","decisiveStep":"√3/12=(7/18)sinθ이므로 sinθ=3√3/14","standardUnitKey":"H15-M1-05","newKeyProposal":{"key":"H15-M1-05-TRIGONOMETRIC_APPLICATION","label":"삼각함수의 활용","why":"선택지에는 삼각형 넓이와 두 변의 길이를 연결하는 소단원 값이 없어 새 소단위 값이 필요하다."},"rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"선택지의 유형 경로에 삼각형 넓이로 끼인각의 사인값을 구하는 조합이 없다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":17,"questionUid":"","primaryMethod":"T(x)<0을 cos(π(x-1)/6)<1/2로 바꾸고 정수 달 범위에서 경계의 영하 여부를 판정한다.","decisiveStep":"3<x<11이므로 해당 달은 4월부터 10월까지이고 M-m=6","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":["COND_RANGE"],"integrationPattern":"NONE"},
