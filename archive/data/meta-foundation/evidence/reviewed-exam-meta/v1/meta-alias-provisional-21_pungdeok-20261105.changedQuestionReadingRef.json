    {
      "questionId": 20,
      "legacy": {
        "content": "$(3+1)(3^2+1)(3^4+1)=\\frac{1}{a}(3^b-1)$이 성립할 때, $ab$의 값은? (5점) (단, $a, b$는 자연수)",
        "choices": [
