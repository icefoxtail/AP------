  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"곱한 세제곱근을 ∛162=3∛6으로 고치고, 겹제곱근 √∛36을 ∛6으로 바꾼다.","decisiveStep":"두 항이 각각 3∛6과 ∛6이므로 차는 2∛6이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"log 8−log 4를 log 2로 합치고 2log 3을 log 9로 바꾸어 한 로그로 묶는다.","decisiveStep":"log 2+log 9=log 18이므로 진수 n은 18이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"네제곱근 기호는 양의 네제곱근을 나타내므로 두 번째 식의 값을 직접 비교한다.","decisiveStep":"{(-2)^4}^{1/4}=2인데 (-2)^{4·1/4}=-2여서 ③에서 등식이 깨진다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"호의 길이 l=rθ와 넓이 S=r²θ/2를 나누어 반지름을 먼저 구한다.","decisiveStep":"r=2S/l=14이므로 중심각은 4π/14=2π/7이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"로그의 밑 x−2와 진수 −x²+5x+6의 조건을 각각 부등식으로 세워 정수 범위를 좁힌다.","decisiveStep":"2<x<6에서 밑이 1인 x=3을 빼면 x=4,5 두 개만 남는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"밑과 진수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"sinθ+cosθ의 제곱으로 두 값의 곱을 구한 뒤 두 값의 합과 곱으로 sinθ, cosθ를 정한다.","decisiveStep":"제2사분면에서 sinθ=4/5, cosθ=−3/5이므로 tanθ=−4/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"공통값 k에 로그를 취해 x,y,z를 나타내고, 주어진 식을 xyz로 나눈다.","decisiveStep":"대입하면 log k=log(4/3)으로 정리되어 k=4/3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"로그함수의 정의역과 역함수 관계를 확인하고 평행이동 뒤의 점근선을 찾는다.","decisiveStep":"기본 로그 그래프의 점근선 x=0이 x방향으로 a만큼 옮겨져 x=a가 되므로 y=b라는 설명이 틀리다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"D=10(log I+12)에 두 세기 10⁻⁷과 10⁻¹¹을 각각 대입해 A와 B를 계산한다.","decisiveStep":"A=50, B=10이므로 A/B=5이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"소수점 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"x=log_a b로 두어 역수 관계 log_b a=1/x를 조건에 대입하고 양의 해를 구한다.","decisiveStep":"x=(1+√5)/2를 log_{a²b}(a²b²)의 밑변환 식에 넣으면 1+√5/5이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"t=2ˣ+2⁻ˣ로 두고 t≥2를 이용해 f(x)를 t에 대한 이차식으로 바꾼다.","decisiveStep":"f=(t−1)²−2는 t=2에서 최소 −1이고 그때 2ᵖ=1이라 합은 0이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"역함수 조건에서 g(3)=3, g(6)=6을 f(3)=3, f(6)=6으로 옮겨 두 식을 푼다.","decisiveStep":"두 등식의 차에서 k log₆2=3이 나오고 p/k=log₆(2/3)으로 정리된다.","hold":"역함수 두 점으로 로그함수의 계수와 상수항을 정하는 유형에 해당하는 선택지 조합을 찾지 못했다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"각 삼각함수식의 주기와 최댓값, 여각 관계, 점근선을 차례로 대조한다.","decisiveStep":"주기가 π/3이면 a=±3이므로 h(π/6)=tan(±π)=0이지 √3이 아니다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"f(x)=(x−1)²+2의 구간 최솟값과 최댓값을 구한 뒤 두 로그함수의 증가·감소를 반영한다.","decisiveStep":"M=log₂19, m=−log₃32이므로 곱은 −5log₃19이고 k=−5이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"y=−3x를 원 x²+y²=10에 대입해 제2·제4사분면의 좌표를 각각 구한다.","decisiveStep":"P=(−1,3), Q=(1,−3)이므로 sinθ₁+cosθ₂=4/√10=2√10/5이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"원을 중심 (−3,3), 반지름 2로 바꾸고 OP=3log₂m이 원과 만날 거리 범위에 들어가는 자연수 m을 찾는다.","decisiveStep":"가능한 m은 2,3,4이고 각 원주 거리에서 교점이 두 개씩 생겨 모두 6개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"그래프의 최댓값·최솟값에서 진폭과 a를 정하고 연속한 극댓값의 간격으로 b를 구한다.","decisiveStep":"a=−2, b=4, x=0 극대에서 c=π/2라서 abc=−4π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"log₂|2x|=0과 log₂|2x|=3을 각각 풀어 사다리꼴의 두 평행변과 높이를 구한다.","decisiveStep":"두 밑변 길이는 1과 8, 높이는 3이므로 넓이는 27/2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"−7π/4에 2π를 더해 같은 동경의 양의 각으로 고친다.","decisiveStep":"−7π/4+2π=π/4이므로 제1사분면 각이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"x에 대한 이차식의 판별식이 음수여야 한다는 조건을 sinθ로 바꾸어 각 범위를 찾는다.","decisiveStep":"(1−sinθ)(2sinθ+1)<0에서 sinθ<−1/2를 얻고 탄젠트 범위는 |tanθ|>1/√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"그래프를 이용한 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"n²−13n+30=(n−3)(n−10)의 부호와 n의 짝홀에 따라 실수 n제곱근의 수를 2부터 12까지 센다.","decisiveStep":"음수인 홀수 차수는 한 근, 음수인 짝수 차수는 없고 0은 한 근이므로 전체 합은 10이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"x<−3인 직선 부분과 x≥−3인 절댓값 지수함수에서 정수 수평선별 교점 수를 나눠 센다.","decisiveStep":"g=1인 n은 11개, g=2는 1개, g=3은 7개라서 합이 3인 순서쌍은 50개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
