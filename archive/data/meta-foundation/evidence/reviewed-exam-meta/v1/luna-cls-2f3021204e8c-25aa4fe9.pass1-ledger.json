  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"2, 3, 4, 5, 6, 7 중 사건 A={2,6}와 겹치지 않는 수를 찾으려면 각 선택지의 수 집합을 만든다.","decisiveStep":"나머지가 1인 수는 4와 7뿐이라 A와의 교집합이 비어 있다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"31부터 50까지 20개 수에서 35, 40, 45, 50 네 개가 5의 배수이므로 유리한 수를 전체 수로 나눈다.","decisiveStep":"네 장을 20장으로 나눈 뒤 약분해 1/5을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"1부터 7까지 카드의 양 끝을 차례로 채우며 짝수가 나오는 확률 3/7과 2/6을 곱한다.","decisiveStep":"첫 끝자리에 짝수 하나를 쓴 뒤 남은 짝수는 2개, 남은 카드는 6장이다.","standardUnitKey":"H15-PS-03","subUnitKey":"H15-PS-03-PROBABILITY_APPLICATION","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"P(A)=7/12와 P(A∩B)=1/4를 조건부확률 식 P(B|A)=P(A∩B)/P(A)에 대입한다.","decisiveStep":"1/4를 7/12로 나누어 3/7을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"축구 선수의 400회 슈팅에서 골이 120회였으므로 관찰된 골 횟수의 상대도수를 확률로 계산한다.","decisiveStep":"120을 400으로 나누어 3/10으로 약분한다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"반지름 1과 2 사이의 8점 고리 넓이를 반지름 5인 과녁 전체 넓이로 나눈다.","decisiveStep":"고리 넓이는 4π-π=3π이고 전체 넓이는 25π이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"주사위 A와 B의 36개 순서쌍에서 같은 눈, 합이 1인 경우, A의 눈이 B 이상인 경우를 각각 센다.","decisiveStep":"a=6/36, b=0, c=21/36이므로 0<1/6<7/12이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"표본공간과 사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"남학생 28명만을 조건의 전체로 두고 애견 미용을 체험한 남학생 8명의 비율을 구한다.","decisiveStep":"조건부확률의 분모는 전체 50명이 아니라 남학생 28명이므로 8/28=2/7이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"P(A∪B)=3/4를 덧셈정리에 넣고 P(A∩B)=P(A)+P(B)-P(A∪B)를 계산한다.","decisiveStep":"2/5+3/5가 1이므로 1-3/4=1/4이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"8권 중 2권을 고르는 경우에서 영어책 5권만으로 2권을 고르는 경우를 빼 적어도 한 수학책이 나오는 확률을 구한다.","decisiveStep":"전체 28가지에서 영어책만 고르는 10가지를 빼면 18가지라서 확률은 9/14이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"세 보기에서 덧셈정리의 교집합 항, 배반일 때 확률 합, 곱셈정리의 조건부확률 식을 각각 확인한다.","decisiveStep":"P(A)+P(B)=7/6이면 배반일 수 없고 곱셈정리 식도 맞지만 ㄱ은 교집합을 빼지 않아 틀리다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"정상품 12개 중 첫 제품을 뽑고 불량품 4개 중 다음 제품을 뽑는 순서를 따라 두 확률을 곱한다.","decisiveStep":"정상품을 뽑아도 불량품은 4개 남고 전체는 15개이므로 12/16×4/15=1/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"색별 공이 2개씩인 6개 중 2개를 고르는 전체 경우에서 같은 색 두 공을 뽑는 세 경우를 제외한다.","decisiveStep":"서로 다른 색은 15-3=12가지이므로 확률은 12/15=4/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"20대 사건과 여자 사건의 합집합 확률을 이용해 두 사건의 교집합 확률을 구한다.","decisiveStep":"5/7+1/5-4/5를 통분하면 4/35가 된다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"6개 굿즈 중 두 개를 뽑는 전체 경우에서 라이언이 없거나 인형이 없는 경우를 포함배제로 뺀다.","decisiveStep":"실패 경우는 6+3-1=8이므로 라이언과 인형이 각각 하나 이상인 경우는 7가지다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"1학년 수를 x로 두고 남학생 중 1학년 비율 72%를 0.6x/(0.6x+0.7(80-x))로 나타낸다.","decisiveStep":"방정식 0.6x=0.72(56-0.1x)를 풀어 x=60을 얻는다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"A와 A의 여사건을 나누어 P(B)를 합산한 뒤 P(A∩B)를 P(B)로 나눠 P(A|B)를 구한다.","decisiveStep":"P(B)=3/5, P(A∩B)=1/5이므로 구하는 합은 3/5+1/3=14/15이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"비가 오는 경우와 오지 않는 경우로 나누어 각각의 날씨 확률과 승리 조건부확률을 곱해 더한다.","decisiveStep":"3/10×1/3+7/10×2/7은 1/10+1/5=3/10이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"20 이하 n 중 2의 배수 또는 3의 배수인 수를 찾고 두 배수 집합의 겹침을 덧셈정리로 조정한다.","decisiveStep":"2의 배수 10개와 3의 배수 6개에서 6의 배수 3개를 빼면 13개다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"배반사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"6명의 원순열을 기준으로 6과 4 또는 6과 5가 이웃하는 사건의 합집합을 세어 그 여사건을 구한다.","decisiveStep":"각 인접 사건은 2/5이고 교집합은 1/10이므로 합집합은 7/10, 여사건은 3/10이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 덧셈정리","l4":"여사건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"P(A∩B)를 곱셈정리로 구하고 덧셈정리로 합집합을 얻은 뒤 두 조건부확률의 분자와 분모를 만든다.","decisiveStep":"교집합은 1/6, 합집합은 5/6이며 여집합 교집합도 1/6이라 마지막 조건부확률은 3/8이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"첫 공 색에 따라 다음 추출 주머니를 나누고 두 번째 검은 공 확률을 각 경로의 확률과 곱해 합산한다.","decisiveStep":"두 번째가 검은 공일 확률은 1/9+1/3=4/9이므로 첫 공 흰색 조건부확률은 (1/9)/(4/9)=1/4이다.","rpmPath":{"majorUnit":"확률","midUnit":"조건부확률","l3":"조건부확률","l4":"조건부확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
