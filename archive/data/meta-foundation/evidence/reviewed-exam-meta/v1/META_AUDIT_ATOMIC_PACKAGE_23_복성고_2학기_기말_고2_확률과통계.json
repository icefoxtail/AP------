    },
    {
      "conceptKey": "CC_COMBINATION_SELECTION",
      "labelKo": "조합의 수",
      "definition": "서로 다른 n개에서 순서를 생각하지 않고 r개를 택하는 조합의 수 nCr"
    },
    {
      "conceptKey": "CC_COMPLEMENTARY_EVENT_PROBABILITY",
      "labelKo": "여사건의 확률",
      "definition": "사건 E가 일어나지 않을 여사건 E^c에 대하여 P(E^c) = 1 - P(E)가 성립하는 성질"
    },
    {
      "conceptKey": "CC_CONDITIONAL_PROBABILITY_FORMULA",
      "labelKo": "조건부확률의 정의",
      "definition": "사건 A가 일어났을 때 사건 B가 일어날 조건부확률 P(B|A) = P(A∩B) / P(A)"
    },
    {
      "conceptKey": "CC_CONFIDENCE_INTERVAL_FORMULA",
      "labelKo": "모평균의 신뢰구간 추정 공식",
      "definition": "표본평균 x̄, 모표준편차 σ, 표본 크기 n으로부터 신뢰구간 x̄ ± k*(σ/sqrt(n))을 구하는 공식"
    },
    {
      "conceptKey": "CC_CONFIDENCE_INTERVAL_LENGTH",
      "labelKo": "모평균 신뢰구간의 길이",
      "definition": "신뢰구간 [a, b]의 길이 b-a = 2 * k * (σ / sqrt(n))와 표본의 크기 n 사이의 관계"
    },
    {
      "conceptKey": "CC_DEMORGAN_LAWS",
      "labelKo": "드모르간의 법칙",
      "definition": "합사건과 교사건의 여사건 관계 (A∪B)^c = A^c ∩ B^c"
    },
    {
      "conceptKey": "CC_DISCRETE_EXPECTATION",
      "labelKo": "이산확률변수의 기댓값(평균)",
      "definition": "이산확률변수 X가 취하는 각 값과 그 확률의 곱의 총합 E(X) = Σ x_i * p_i"
    },
    {
