    {
      "conceptKey": "CC_PROBABILITY_DENSITY_CONDITIONS",
      "labelKo": "확률밀도함수의 성질",
      "definition": "정의된 구간 [a, b]에서 항상 f(x) >= 0이고 곡선과 x축 사이의 전체 넓이(정적분)가 1이어야 하는 성질"
    },
    {
      "conceptKey": "CC_RADICAL_INEQUALITY",
      "labelKo": "제곱근을 포함한 부등식",
      "definition": "양수 조건에서 sqrt(n) >= c를 양변 제곱하여 표본 크기 n의 최솟값을 구하는 부등식 풀이"
    },
    {
      "conceptKey": "CC_SAMPLE_MEAN_MOMENTS",
      "labelKo": "표본평균의 평균과 표준편차",
      "definition": "모평균 m, 모표준편차 σ인 모집단에서 크기 n인 표본을 임의추출할 때 E(X̄)=m, σ(X̄)=σ/sqrt(n)이 되는 성질"
    },
    {
      "conceptKey": "CC_SET_DIFFERENCE_IDENTITY",
      "labelKo": "차집합과 교집합의 확률 관계",
      "definition": "사건의 연산에서 P(B^c - (A∩B^c)) = P(A^c∩B^c) = P(B^c) - P(A∩B^c)가 성립하는 성질"
    },
    {
      "conceptKey": "CC_STANDARD_NORMAL_TABLE_READING",
      "labelKo": "표준정규분포표 확률 읽기",
      "definition": "표준정규분포표에 주어진 P(0 <= Z <= z) 값을 이용해 구간 확률을 구하거나 역으로 z값을 찾는 해석"
    },
    {
      "conceptKey": "CC_Z_SCORE_STANDARDIZATION",
      "labelKo": "정규분포의 표준화",
      "definition": "정규분포 N(m, σ^2)을 따르는 확률변수 X를 Z = (X-m)/σ로 변환하여 표준정규분포 N(0, 1)로 나타내는 방법"
    }
