  "items": [
    { "ordinal": 1, "questionUid": "", "primaryMethod": "다섯 보기에서 분수 지수와 음의 지수를 각각 근호 또는 역수로 바꾸어 등식이 맞는지 확인한다.", "decisiveStep": "7^(2/3)=∛49만 성립하고 나머지는 근의 주값이나 음수 부호가 맞지 않는다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "지수법칙", "l4": "지수식 계산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 2, "questionUid": "", "primaryMethod": "같은 밑 6의 로그 두 개를 곱의 로그 하나로 합쳐 진수를 6의 거듭제곱으로 나타낸다.", "decisiveStep": "4·9=36=6²이므로 로그값은 2다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 성질", "l4": "곱·몫·거듭제곱" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 3, "questionUid": "", "primaryMethod": "21을 2.1과 10의 곱으로 분해하고 표의 log 2.1과 log 10을 합친다.", "decisiveStep": "0.3222+1=1.3222이므로 표에서 읽은 값은 1.3222다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "상용로그", "l4": "상용로그표·자릿수" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 4, "questionUid": "", "primaryMethod": "보기의 각을 한 바퀴 안에서 동경이 같은 각으로 고쳐 사분면을 비교한다.", "decisiveStep": "−855°는 1080°를 더하면 225°가 되어 제3사분면이고 나머지는 제2사분면이다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "일반각과 호도법", "l4": "일반각" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 5, "questionUid": "", "primaryMethod": "그래프의 수평 점근선에서 b를 읽고 그래프가 지나는 (0,2)를 지수식에 넣어 a를 구한다.", "decisiveStep": "b=−2이고 4=2^(−a)라서 a=−2, 따라서 ab=4다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수함수의 그래프", "l4": "평행이동" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 6, "questionUid": "", "primaryMethod": "로그 밑 x+3의 양수·1 제외 조건과 이차식 진수의 양수 범위를 정수 범위로 교차한다.", "decisiveStep": "가능한 정수 −1부터 8까지에서 합은 35다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 뜻", "l4": "밑과 진수 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 7, "questionUid": "", "primaryMethod": "밑 1/3이 1보다 작은 점을 반영해 로그 부등식을 지수 부등식으로 옮기고 진수 조건과 겹친다.", "decisiveStep": "x>5/3과 x<2를 함께 만족하는 구간이 해다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그부등식", "l4": "정의역·밑 조건" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 8, "questionUid": "", "primaryMethod": "x≤0인 직선 위에서 제3사분면의 점 하나를 잡고 원점 거리로 그 점의 사인값을 구한다.", "decisiveStep": "P=(−1,−√3)의 거리는 2이므로 sinθ=−√3/2다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "삼각함수의 뜻", "l4": "삼각함수 값" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 9, "questionUid": "", "primaryMethod": "log₃(x−1)의 정의역과 점근선을 확인하고 밑이 3인 로그 그래프의 단조성과 역함수식을 살핀다.", "decisiveStep": "진수 이동으로 정의역은 x>1, 점근선은 x=1이며 역함수는 y=3ˣ+1이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 그래프", "l4": "평행이동" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 10, "questionUid": "", "primaryMethod": "세제곱근과 겹친 제곱근을 모두 밑 3의 분수 지수로 바꿔 지수를 합친다.", "decisiveStep": "a=3^(1/4)이므로 a^12=3³=27이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "지수법칙", "l4": "지수식 계산" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 11, "questionUid": "", "primaryMethod": "각 보기의 거듭제곱근 정의에서 짝수·홀수 차수와 주근을 구분해 참인지 검사한다.", "decisiveStep": "√729=27이지만 27의 세제곱근은 3이므로 세제곱근을 27이라 한 보기가 틀리다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "거듭제곱근", "l4": "n제곱근" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 12, "questionUid": "", "primaryMethod": "절댓값 로그를 |log₂x|로 바꾸고 구간 끝점과 꼭짓점 역할을 하는 x=1에서 값을 비교한다.", "decisiveStep": "세 후보의 함수값은 4,2,5이므로 최댓값과 최솟값의 합은 7이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 활용", "l4": "최대·최소" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 13, "questionUid": "", "primaryMethod": "두 호의 길이로 Rθ와 rθ를 세우고 색칠 영역의 넓이 차 식으로 R+r을 구한다.", "decisiveStep": "R+r=15와 (R+r)θ=10π/3을 결합하면 θ=2π/9다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "일반각과 호도법", "l4": "호도법" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 14, "questionUid": "", "primaryMethod": "tanθ cos²θ를 sinθcosθ로 바꾸고 (sinθ−cosθ)²≥0을 이용한다.", "decisiveStep": "sinθcosθ≤1/2이고 θ=π/4에서 등호가 성립한다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "삼각함수의 성질", "l4": "삼각함수 관계" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 15, "questionUid": "", "primaryMethod": "밑 a가 1보다 작아 지수가 작을 때 함수값이 크다는 점을 이용해 최댓값으로 a를 정한 뒤 구간 끝에서 최솟값을 찾는다.", "decisiveStep": "지수의 최솟값 −2에서 a^(−2)=9이므로 a=1/3이고, 구간의 최대 지수 2에서 m=1/9다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수함수의 활용", "l4": "최대·최소" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 16, "questionUid": "", "primaryMethod": "정수 지수법칙이 항상 성립할 밑과 유리수 지수까지 실수로 정의될 밑을 각각 분류해 집합을 비교한다.", "decisiveStep": "A는 0이 아닌 실수, B는 양수 실수라서 A⊂B가 아니라 B⊂A다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "지수법칙", "l4": "조건식" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 17, "questionUid": "", "primaryMethod": "매년 매출을 100(1.25)^n으로 두고 1000 이상이 되는 최소 정수 n을 상용로그로 구한다.", "decisiveStep": "n·(log5−log4)≥1에서 0.1n≥1이므로 처음 해당하는 해는 2010년이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수부등식", "l4": "밑의 범위에 따른 부등호" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 18, "questionUid": "", "primaryMethod": "첫 지수부등식은 x=1과 밑 1 초과 여부로 지수 비교를 나누고 두 번째 부등식도 밑 3으로 통일한다.", "decisiveStep": "A={1,…,7}, B={1,…,6}이므로 교집합 원소의 합은 21이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수부등식", "l4": "밑의 범위에 따른 부등호" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 19, "questionUid": "", "primaryMethod": "2ˣ+2⁻ˣ을 치환해 첫 방정식에 실근이 없을 조건을 얻고 두 번째 이차부등식의 판별식을 적용한다.", "decisiveStep": "첫 조건은 k<6, 둘째는 k≥2를 주므로 자연수 합은 14다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수함수", "l3": "지수방정식", "l4": "치환" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 20, "questionUid": "", "primaryMethod": "두 별의 절대 등급 식을 각각 계산한 뒤 로그 차를 분수의 로그로 바꾸어 뺀다.", "decisiveStep": "(3/4)/(15/2)=1/10이어서 log(1/10)=−1, 결과는 MB−MA=4다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 성질", "l4": "곱·몫·거듭제곱" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 21, "questionUid": "", "primaryMethod": "y축 대칭 조건에서 θ와 3θ의 합을 홀수배 π로 두고 sinθ+cosθ 부호로 후보를 고른다.", "decisiveStep": "θ=5π/4만 부등식을 만족하고 tan(5π/4+7π/12)=tan(11π/6)=−√3/3이다.", "rpmPath": { "majorUnit": "삼각함수", "midUnit": "삼각함수", "l3": "일반각과 호도법", "l4": "일반각" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 22, "questionUid": "", "primaryMethod": "a1이 S의 최솟값임을 조건에서 보이고 모든 원소를 a1의 거듭제곱으로 나타내 그 지수를 모은다.", "decisiveStep": "서로 다른 12개 원소의 지수는 1부터 12까지라서 로그 합은 2+…+12=77이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그", "l3": "로그의 뜻", "l4": "로그와 지수 관계" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 23, "questionUid": "", "primaryMethod": "(나)에서 b=a^(m−6)을 얻어 (가)에 대입하고 a≠1이므로 지수를 같게 둔다.", "decisiveStep": "m=6+6/(n−1)이 자연수가 되는 n−1은 6의 양의 약수 네 개다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "지수", "l3": "지수법칙", "l4": "조건식" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" },
    { "ordinal": 24, "questionUid": "", "primaryMethod": "두 함수가 역함수여서 대응점이 직선 y=x−2에 대칭임을 이용하고, 비로 A의 좌표를 정한다.", "decisiveStep": "대칭축과 y=−x+6의 교점 M=(4,2), C=(0,6)에서 내분점 A=(3,3)이므로 a=3이다.", "rpmPath": { "majorUnit": "지수함수와 로그함수", "midUnit": "로그함수", "l3": "로그함수의 활용", "l4": "그래프 교점" }, "crossConceptKeys": [], "conditionKeys": [], "integrationPattern": "NONE" }
  ]
}