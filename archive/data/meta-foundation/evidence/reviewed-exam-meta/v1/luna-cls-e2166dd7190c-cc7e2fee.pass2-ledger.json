  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"12가 4의 배수인지 식으로 확인해 참과 거짓을 가릴 수 있는지 살핀다.","decisiveStep":"12=4×3으로 나타나 참인 문장임을 확인한다.","rpmPath":{"majorUnit":"집합과 명제","midUnit":"명제","l3":"명제와 조건","l4":"명제의 참·거짓"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"정의역의 두 원소 0과 2에서 두 함수의 값을 같게 놓아 a와 b를 정한다.","decisiveStep":"x=0에서 b=1을 얻고 x=2에서 2a+b=5를 얻는다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"함수의 성질","l4":"일대일함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"g(0)과 f(0)을 각각 구한 뒤 바깥 함수에 넣어 두 합성함숫값을 더한다.","decisiveStep":"f(g(0))=-1이고 g(f(0))=4이므로 합은 3이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"합성함수","l4":"합성함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"f(1)=-1로 a를 구하고 f^{-1}(3)=b를 f(b)=3으로 바꾸어 b를 구한다.","decisiveStep":"a=1일 때 b-2=3이므로 b=5이고 a+b=6이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"역함수","l4":"역함수 구하기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"분자와 분모를 인수분해하여 (x+1)과 (x+3)을 약분하고 남은 인수를 정리한다.","decisiveStep":"x²+x=x(x+1), x²-9=(x-3)(x+3)이므로 결과는 (x-3)/(x(x-2))이다.","rpmPath":{"majorUnit":"함수","midUnit":"유리함수","l3":"유리함수의 그래프","l4":"기본 그래프"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"두 집합 등식에서 포함 관계를 읽어 p와 q의 진리집합 사이 관계를 정한다.","decisiveStep":"P∪Qᶜ=Qᶜ에서 P⊆Qᶜ이므로 Q⊆Pᶜ이고 q→¬p가 참이다.","rpmPath":{"majorUnit":"집합과 명제","midUnit":"명제","l3":"명제와 조건","l4":"진리집합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"ㄱ, ㄴ, ㄷ 각각에 대해 q→p와 p→q를 따로 확인한다.","decisiveStep":"ㄱ은 a=4, ㄷ은 c=0과 a≠b로 역방향이 깨지고 q→p는 유지되며 ㄴ은 양방향이 성립한다.","rpmPath":{"majorUnit":"집합과 명제","midUnit":"명제","l3":"필요조건·충분조건","l4":"조건 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"정의역 x≤2와 식 y=4-√(2-x)를 이용해 x≥0인 부분에서 y의 부호를 따진다.","decisiveStep":"x≥0이면 y≥4-√2>0이므로 제4사분면은 지나지 않는다.","rpmPath":{"majorUnit":"함수","midUnit":"무리함수","l3":"정의역과 치역","l4":"그래프 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"조건식에 b=0과 b=-a를 차례로 넣어 f(0)과 f(a)+f(-a)를 구한다.","decisiveStep":"f(0)=0, f(a)+f(-a)=3a²이므로 a=4와 2의 쌍을 더해 60을 얻는다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"함수의 성질","l4":"항등함수·상수함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"3에서 시작해 제곱의 나머지를 반복 적용하고 2와 4가 번갈아 나오는 주기를 확인한다.","decisiveStep":"f(3)=2이고 2↔4이므로 일곱 번 적용한 값은 2이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"합성함수","l4":"합성함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"최솟값으로 b를 정한 다음 증가함수와 역함수의 교점이 y=x 위에 놓임을 이용한다.","decisiveStep":"교점 좌표 3에서 f(3)=3이므로 a=-5이고 f(9/2)=4이다.","rpmPath":{"majorUnit":"함수","midUnit":"무리함수","l3":"무리함수의 활용","l4":"무리함수의 역함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"유리함수를 3+(3a+5)/(x-a)로 고쳐 중심 (a,3)을 두 대칭 직선 위에 대입한다.","decisiveStep":"두 직선에 중심을 넣으면 a=-2, b=2이므로 ab=-4이다.","rpmPath":{"majorUnit":"함수","midUnit":"유리함수","l3":"유리함수의 그래프","l4":"기본 그래프"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"그림의 점근선으로 b와 c를 읽고 무리함수의 x절편이 음수가 되지 않을 조건을 구한다.","decisiveStep":"b=-1, c=2이며 4/a-1≥0에서 0<a≤4이므로 최대 a+b+c는 5이다.","rpmPath":{"majorUnit":"함수","midUnit":"무리함수","l3":"정의역과 치역","l4":"그래프 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"곱이 음수일 때 세 인수의 부호 조건을 p₁, p₂, p₃ 각각과 양방향으로 비교한다.","decisiveStep":"q는 p₂에 충분하지만 필요하지 않고 p₃는 q의 충분조건뿐이며 p₁은 둘 다 아니어서 값의 합은 5이다.","rpmPath":{"majorUnit":"집합과 명제","midUnit":"명제","l3":"필요조건·충분조건","l4":"조건 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"두 구간의 일차식 기울기가 양수이고 경계에서 함수값이 이어져 실수 전체를 빠짐없이 덮도록 조건을 세운다.","decisiveStep":"b=6a-9와 -2<a<5에서 정수 a의 최솟값은 -1이므로 a+b=-16이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"함수의 성질","l4":"일대일함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"|2x(x-4)|=k의 두 부호 방정식의 실근 수를 비교해 서로 다른 세 x가 가능한 k를 찾는다.","decisiveStep":"k=8일 때 두 번째 방정식이 중근 하나를 더해 세 근이 생기고 그보다 크면 두 근뿐이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"함수의 성질","l4":"항등함수·상수함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"f(x)=3/2의 역상을 찾고 이를 다시 두 번 역으로 추적해 a의 후보를 센다.","decisiveStep":"f(a)는 2/3 또는 2여야 하며 이 값들의 역상은 모두 합해 네 개다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"합성함수","l4":"합성함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"유리함수를 3+1/(x-2)로 옮겨 중심을 원점으로 바꾸고 원 방정식과 함께 교점 수를 비교한다.","decisiveStep":"XY=1과 X²+Y²=r²에서 r²=2일 때만 두 점이 되어 r=√2이다.","rpmPath":{"majorUnit":"함수","midUnit":"유리함수","l3":"유리함수의 활용","l4":"유리함수와 그래프의 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"f(x)=x+5의 역함수 x-5를 구한 뒤 g(2)를 먼저 계산해 대입한다.","decisiveStep":"g(2)=-6이고 f⁻¹(-6)=-11이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"합성함수","l4":"합성함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"두 합성식을 전개해 m과 n의 값에 관계없이 같도록 상수항의 계수를 비교한다.","decisiveStep":"m 계수에서 b=2, n 계수에서 a=5/2이므로 ab=5이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"합성함수","l4":"정의역 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"존재하는 x에서 이차식이 음수라는 명제의 부정을 모든 x에서 0 이상이라는 조건으로 바꾼다.","decisiveStep":"완전제곱의 최솟값 조건은 a²≤12이므로 가능한 정수 a는 -3부터 3까지다.","rpmPath":{"majorUnit":"집합과 명제","midUnit":"명제","l3":"명제와 조건","l4":"명제의 참·거짓"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"x<-2에서 x와 y가 모두 음수임을 이용해 t=-(x+2)>0으로 바꾸어 두 수선 길이의 합을 만든다.","decisiveStep":"길이의 합은 t+1/t+3이고 t+1/t≥2이므로 최솟값은 5다.","rpmPath":{"majorUnit":"함수","midUnit":"유리함수","l3":"유리함수의 활용","l4":"유리함수의 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"주어진 조각함수의 역함수를 구하고 f(x)=0 또는 f(x)=f⁻¹(x)로 나누어 해를 찾는다.","decisiveStep":"세 구간에 맞춰 얻은 해는 2/3, 1, -5/2이므로 합은 -5/6이다.","rpmPath":{"majorUnit":"함수","midUnit":"함수","l3":"역함수","l4":"그래프 대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
}