  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"f(x)=3x²+1을 미분해 f'(1)을 구한다.","decisiveStep":"f'(x)=6x이므로 x=1에서의 기울기는 6이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"평균변화율·순간변화율"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"x=-1의 왼쪽 식과 오른쪽 식에 각각 -1을 넣어 두 극한을 같게 만든다.","decisiveStep":"오른쪽 극한은 -5이고 왼쪽 극한은 a-1이므로 a=-4이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"분자 √(x+1)-√2를 켤레식으로 유리화해 x-1을 약분한다.","decisiveStep":"약분 뒤 분모에 남는 √(x+1)+√2에 x=1을 넣으면 √2/4가 된다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"극한값 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"x=a에서 다항식 가지의 극한과 별도로 정한 함숫값을 같게 두어 a의 방정식을 만든다.","decisiveStep":"2a²+4a=-2a-4를 풀면 a=-1,-2이고 두 값의 곱은 2이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"f(2)=0과 f'(2)=3을 각각 써서 a,b에 대한 두 일차식을 세운다.","decisiveStep":"2a-b=3과 4a-b=9에서 a=b=3을 얻어 a+b=6이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용","l3":"접선","l4":"접선의 방정식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"롤의 정리 조건에 따라 f(-k)=f(0)을 세우고 양수 k를 찾는다.","decisiveStep":"-k(4k²-8k+3)=0에서 k=1/2, 3/2이므로 합은 2이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용","l3":"롤의 정리와 평균값 정리","l4":"롤의 정리"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"수평선과 유리함수의 교점 수를 t별로 정리한 뒤 x=2에서 곱함수의 극한과 값을 맞춘다.","decisiveStep":"f(2)=0이고 x≠2에서는 f(x)=1이므로 연속 조건은 4+a=0이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"f(a+4h)+f(a)-4의 상수항이 0이어야 유한한 h→0 극한이 생긴다는 점을 이용한다.","decisiveStep":"ma=1과 4m=12에서 m=3, a=1/3이므로 f(3a)=4이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"t→∞ 극한을 먼저 계산해 f(x)=-2(x-1)²+2로 바꾸고 구간의 꼭짓점과 끝점을 비교한다.","decisiveStep":"최댓값은 x=1에서 2이고 최솟값은 x=-2에서 -16이므로 곱은 -32이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"무한대 극한으로 f의 이차항 계수를 정한 뒤 x=-1에서 분자가 이중근을 갖도록 계수를 맞춘다.","decisiveStep":"계수 비교로 f(x)=x²+2x+1=(x+1)²이 되어 f(4)=25이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"AP와 AQ의 길이 제곱을 t의 이차식으로 나타내고 분자와 분모를 t²으로 나눈다.","decisiveStep":"최고차항 계수의 비는 (5/4)/(25/4)=1/5이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"극한값 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"포물선 위 점의 직선까지 거리를 x로 나타내고 이차식을 완전제곱해 최소를 찾는다.","decisiveStep":"거리식은 ((x+2)²+5)/√2이므로 x=-2에서 최소 5√2/2를 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용","l3":"최대·최소","l4":"활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"P(x)=(x²-1)(x²+ax)-6의 (x-2)² 나머지를 P(2)+P'(2)(x-2)로 둔다.","decisiveStep":"x-2로 나누어지려면 P(2)=6+6a=0이므로 a=-1이고 R(0)=-34이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"도함수 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"x=1에서 얻은 계수 관계와 x=4에서 분자가 0이어야 한다는 조건으로 a,b를 구한다.","decisiveStep":"분자를 (x-4)(x+1)로 만들고 √x-2를 약분하면 연속인 값 f(4)=20이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"미정계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"x=0에서 곱함수의 좌우 미분계수를 맞춘 뒤 x=3에서 절댓값의 꺾임을 없애도록 g(3)=0을 둔다.","decisiveStep":"연속 조건으로 c=-3, x=0 기울기 일치로 b=1, g(3)=0으로 a=-3을 얻는다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분가능성과 연속","l4":"미분가능 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"f(0)=f(2)=0을 이용해 합성 극한을 f(f(x))/f(x), f(x)/(x-2), 나머지 인수로 나눈다.","decisiveStep":"세 인수의 극한은 각각 3, 4, 1/9이므로 전체 값은 4/3이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"주어진 그래프의 각 가지를 뒤집어 역함수의 접근값을 읽고 보기의 좌우극한을 확인한다.","decisiveStep":"x→1+에서 역함수 값은 2로 가고 a=-1/2에서는 양쪽 값이 1/2이므로 ㄱ만 참이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"함수의 극한","l4":"좌극한·우극한"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"곱의 극한에서 f의 극한값 -2로 나누어 g의 극한 a를 구한 뒤 합의 극한을 계산한다.","decisiveStep":"(-2)a=-6에서 a=3이므로 f(x)+2g(x)의 극한은 -2+6=4이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"극한의 성질","l4":"대수적 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"(3x²+2)(2-x²)를 전개해 같은 차수 항을 합친 뒤 항별로 미분한다.","decisiveStep":"정리된 식 -3x⁴+4x²+4의 도함수는 -12x³+8x이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"도함수","l4":"미분법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"[2,7]에서 평균값 정리를 적용해 f(7)-f(2)를 어떤 도함수값과 연결한다.","decisiveStep":"f'(c)≥2이므로 f(7)≥11이고 f(x)=2x-3이 등호를 이루어 최솟값은 11이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용","l3":"롤의 정리와 평균값 정리","l4":"평균값 정리의 조건과 적용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"|x|<3인 식을 -1/(3+|x|)로 약분하고 x=3,-3에서 바깥쪽 일차식과 극한을 맞춘다.","decisiveStep":"3a+b=-1/6과 -3a+b=-1/6에서 a=0, b=-1/6이므로 6a+12b=-2이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 연속","l3":"연속 조건","l4":"구간별 함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"g(x)=f(x)-x²-x로 두고 t=1,3에서 g의 영점과 도함수값을 사용해 삼차식의 나머지 근을 정한다.","decisiveStep":"g(x)=(x-1)(x-3)(x+1)이므로 f(x)=x³-2x²+3이고 f(4)=35이다.","rpmPath":{"majorUnit":"미분","midUnit":"미분계수와 도함수","l3":"미분계수","l4":"정의로 미분계수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"x→0 조건으로 f에 가장 낮은 차수항 3xⁿ을 두고 n별로 맞춘 뒤 무한대 조건의 최고차항을 비교한다.","decisiveStep":"n=1,2,3,4 이상에서 f(1)은 각각 6,6,13,8이므로 최댓값은 13이다.","rpmPath":{"majorUnit":"함수의 극한과 연속","midUnit":"함수의 극한","l3":"무한대에서의 극한","l4":"다항·유리함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
