    {"ordinal":1,"questionUid":"","primaryMethod":"x², x, 상수항의 계수를 각각 비교해 a=1, b=0, c=3을 구한다.","decisiveStep":"항등식의 세 계수에서 얻은 값을 합하면 a+b+c=4다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":2,"questionUid":"","primaryMethod":"P(x)=x³+x²−2x+2에 x=1을 대입해 x−1로 나눈 나머지를 구한다.","decisiveStep":"P(1)=1+1−2+2=2이므로 나머지는 2다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"일차식으로 나눈 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"x−1로 조립제법을 진행해 가운데 곱 a=−1과 다음 계수 b=0을 찾는다.","decisiveStep":"조립제법 표의 빈칸은 a=−1, b=0이어서 합은 −1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"다항식의 연산","l3":"다항식의 나눗셈","l4":"몫과 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
