    {"ordinal":5,"questionUid":"","primaryMethod":"P(x)=(x−1)Q(x)+4에 x=2를 넣고 Q(2)=1을 대입한다.","decisiveStep":"P(2)=(2−1)·1+4=5이므로 x−2로 나눈 나머지는 5다.","rpmPath":{"majorUnit":"다항식","midUnit":"다항식의 연산","l3":"다항식의 나눗셈","l4":"몫과 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":6,"questionUid":"","primaryMethod":"x+y=3, xy=2로부터 x²+y²과 x³+y³을 구한 뒤 두 식을 곱해 x⁵+y⁵을 만든다.","decisiveStep":"x⁵+y⁵=(x²+y²)(x³+y³)−x²y²(x+y)=45−12=33이다.","rpmPath":{"majorUnit":"다항식","midUnit":"다항식의 연산","l3":"다항식의 곱셈","l4":"곱셈공식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":7,"questionUid":"","primaryMethod":"P(1)=0으로 b를 a에 연결하고, (x−1)로 한 번 묶은 몫도 x=1에서 0이 되게 한다.","decisiveStep":"몫의 x=1 대입에서 80+a=0이므로 a=−80, b=79이고 b−a=159다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"인수정리","l4":"미정계수 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
    {"ordinal":8,"questionUid":"","primaryMethod":"40을 39보다 1 큰 수로 보고 40²⁵+5를 39를 법으로 간단히 한다.","decisiveStep":"40≡1 (mod 39)이므로 40²⁵+5≡1+5=6이고 나머지는 6이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
