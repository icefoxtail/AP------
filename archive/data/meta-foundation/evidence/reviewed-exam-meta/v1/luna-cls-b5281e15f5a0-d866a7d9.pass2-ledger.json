    {"ordinal":10,"questionUid":"","primaryMethod":"선택지의 복소수 설명을 실수부와 허수부의 정의 및 실수의 포함 관계로 각각 대조한다.","decisiveStep":"보기에는 i²=−1과 7i의 허수 부분이 7이라는 두 참인 문장이 있어 단일 정답이 성립하지 않는다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"복소수의 뜻","l4":"실수부·허수부"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"SEQUENTIAL"},
