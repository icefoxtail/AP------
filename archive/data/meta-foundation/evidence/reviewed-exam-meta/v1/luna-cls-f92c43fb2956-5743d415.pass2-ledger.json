  "schemaVersion":"meta-judgment-ledger-v1","judge":"luna-pass2","createdAt":"2026-11-13T00:02:00+09:00",
  "sourceArchiveFile":"original/high/h2/1mid/22_효천고_1학기_중간_고2_수학I.js",
  "items":[
    {"ordinal":1,"questionUid":"","primaryMethod":"실수 x에 대해 x³=-27을 만족시키는 값을 찾아 -27의 실수 세제곱근을 구한다.","decisiveStep":"(-3)³=-27이므로 음의 실수 세제곱근은 -3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"n제곱근"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"sinθ>0과 tanθ<0을 사분면별 삼각함수의 부호와 비교한다.","decisiveStep":"tanθ=sinθ/cosθ<0에서 cosθ<0이므로 θ는 제2사분면의 각이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"삼각함수 값"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"30°, 45°, 60°, 90°, 360°에 π/180을 곱해 표의 호도법 값과 대조한다.","decisiveStep":"360°는 2π이므로 3π/2로 적힌 다섯째 값이 틀렸다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"상용로그표에서 2.13의 앞부분 2.1을 행으로, 마지막 숫자 3을 열로 찾아 읽는다.","decisiveStep":"2.1행과 3열이 만나는 칸의 0.3284가 log 2.13이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"상용로그표·자릿수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"3⁰, 8^(2/3), (1/2)^(-1)을 각각 영지수·유리수 지수·음의 지수의 뜻으로 계산한다.","decisiveStep":"세 인수가 1, 4, 2로 바뀌므로 곱은 8이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"지수식 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"5³=125와 2^(-3)=1/8 등의 밑·지수·거듭제곱 값을 aˣ=N과 x=log_a N에 대응시킨다.","decisiveStep":"(1/7)^(-1)=7은 -1=log_(1/7)7과 정확히 대응하므로 넷째 선택지만 옳다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 뜻","l4":"로그와 지수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"960°, -1100°, 7π/3, -3π/4, -490°를 한 바퀴 안의 동경이 같은 각으로 바꾼다.","decisiveStep":"240°, 340°, 60°, 225°, 230° 중 제3사분면에 속하는 것은 240°, 225°, 230°의 세 개다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"log 5+log 40000-log 0.002를 하나의 로그로 합치고 √(∛64)를 안쪽부터 계산한다.","decisiveStep":"로그 부분이 log 10⁸=8이고 근호 부분이 2이므로 전체 값은 6이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"y=2^(-x)+3을 y=2ˣ의 대칭이동과 평행이동으로 해석하여 각 설명을 확인한다.","decisiveStep":"x를 -x로 바꾸는 것은 y축 대칭이므로 x축 대칭이라고 한 다섯째 설명이 틀렸다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 그래프","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"cosθ=4/5와 sin²θ+cos²θ=1로 sinθ를 구하되 제4사분면의 음의 부호를 선택한다.","decisiveStep":"sinθ=-3/5, tanθ=-3/4가 되어 두 값의 합은 -27/20이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"해일 높이 H=31을 M=log H+6.5에 대입하고 31=3.1×10으로 나누어 로그를 계산한다.","decisiveStep":"log 31=0.5+1=1.5이므로 지진 규모는 1.5+6.5=8이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"상용로그","l4":"소수점 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"-1≤x≤2에서 2x+5의 범위를 구하고 밑이 3인 로그의 증가성을 이용해 양 끝의 함숫값을 비교한다.","decisiveStep":"진수가 3부터 9까지 변하므로 최솟값 b=4, 최댓값 a=5에서 a+b=9이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":["COND_RESTRICTED_INTERVAL"],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"4ˣ-2^(x+1)-3=0에서 t=2ˣ로 치환하여 t²-2t-3=0을 푼다.","decisiveStep":"(t-3)(t+1)=0에서 t>0에 맞는 t=3만 남아 x=log₂3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수방정식","l4":"치환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"중심각 2π/3인 두 부채꼴의 넓이를 반지름 12와 6으로 각각 구해 뺀다.","decisiveStep":"종이의 넓이는 (1/2)(12²-6²)(2π/3)=36π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"sinθ+cosθ=1/2를 제곱하고 두 합차의 제곱의 합이 2임을 이용해 차의 제곱을 구한다.","decisiveStep":"(sinθ-cosθ)²=7/4이며 sinθ<cosθ이므로 차는 -√7/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":["COND_INEQUALITY_CONSTRAINT"],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"y=(1/a)ˣ에 x=-1을 대입하여 그래프 왼쪽에서의 높이를 a의 크기와 직접 비교한다.","decisiveStep":"x=-1에서 y=a이므로 그림의 왼쪽에서 가장 높은 셋째 그래프의 a가 가장 크다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 그래프","l4":"증가·감소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"|x-2|≥0으로부터 y=2^|x-2|+3의 최솟값을 구해 수평선 y=k의 높이와 비교한다.","decisiveStep":"x=2에서 최솟값 4를 가지므로 교점이 없을 범위는 k<4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":["COND_EXACT_INTERSECTION_COUNT"],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"f(x)=log₂x의 곱·몫·거듭제곱 법칙을 각 함수 관계식에 대입하고 합에 대한 식은 수치를 넣어 확인한다.","decisiveStep":"a=b=1이면 f(a+b)=1이지만 f(a)f(b)=0이므로 둘째 관계식은 성립하지 않는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"log₄t=(1/2)log₂t로 두 할선의 y절편을 비교하여 a와 b의 거듭제곱 관계를 구한다.","decisiveStep":"두 절편이 같으려면 절편이 0이어서 b log₂a=a log₂b, 즉 aᵇ=bᵃ이므로 aᵃ=bᵇ인 셋째 식이 틀렸다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":["COND_INEQUALITY_CONSTRAINT","COND_FUNCTION_VALUE_CONSTRAINT"],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"제2사분면 조건에서 -2<x<0을 얻고 두 지수함수의 교점 조건을 n=3^(x+2)-2^(x+1)-1로 정리한다.","decisiveStep":"이 식이 -2<x<0에서 증가하며 -1/2<n<6이므로 가능한 정수 n은 0부터 5까지 여섯 개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"1<a<b<2에서 밑 a는 1보다 크고 밑 a-1, b-1은 0과 1 사이임을 나누어 로그의 대소를 비교한다.","decisiveStep":"log_a b>1로 ㄱ은 거짓이고, 감소성으로 0<log_(a-1)(b-1)<1 및 log_(a-1)a>log_(b-1)b가 성립해 ㄴ과 ㄷ이 참이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 그래프","l4":"증가·감소"},"crossConceptKeys":[],"conditionKeys":["COND_INEQUALITY_CONSTRAINT"],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"log₄(log₃x-1)≤1/2에서 진수 조건을 먼저 붙인 뒤 밑 4와 밑 3의 증가성을 차례로 이용한다.","decisiveStep":"0<log₃x-1≤2는 3<x≤27과 같아 정수 해는 4부터 27까지 24개다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그부등식","l4":"정의역·밑 조건"},"crossConceptKeys":[],"conditionKeys":["COND_INTEGER"],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"1<x<5에서 log₂(x-1)+log₂(5-x)를 log₂{(x-1)(5-x)}로 합치고 진수의 이차식을 완전제곱으로 바꾼다.","decisiveStep":"(x-1)(5-x)=4-(x-3)²≤4이며 x=3이 정의역에 속하므로 최댓값은 log₂4=2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":24,"questionUid":"","primaryMethod":"Q(2,14)를 y=x에 대칭시킨 P(14,2)와 넓이 78을 이용해 수평선 위의 점 R을 정한다.","decisiveStep":"높이 12에서 PR=13이고 증가성으로 R=(1,2)이므로 a-b=2, a²-b=14를 풀어 a=4, b=2를 얻는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":["COND_POSITIVE"],"integrationPattern":"NONE"},
    {"ordinal":25,"questionUid":"","primaryMethod":"BC의 기울기 -1과 길이 2√2에서 C를 B의 왼쪽 위로 2씩 이동한 점으로 두고 지수함수 식에 대입한다.","decisiveStep":"C=(k-2,2^(k-1)-5)로부터 k=4를 얻고 B(4,1)에서 a=2를 구하면 A(4,9), C(2,3), D(3,0), B(4,1)의 넓이는 10이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":["COND_INEQUALITY_CONSTRAINT"],"integrationPattern":"NONE"}
  ]
}