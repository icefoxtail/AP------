 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"3^(log₃6)와 log 밑 4, 1/2인 두 항을 밑 2 로그로 고쳐 합친다.","decisiveStep":"첫 항은 6이고 나머지는 log₂6−log₂3=1이라 전체는 7이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"밑의 변환"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"세 값을 10^(1/6), 125^(1/6), 28^(1/6)으로 나타내어 같은 양의 여섯제곱근끼리 비교한다.","decisiveStep":"10<28<125이므로 A<C<B이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수의 확장","l4":"유리수 지수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"세 함수 입력을 −2, −2, 2로 계산하고 홀수 차수와 짝수 차수의 실수 거듭제곱근 개수를 각각 더한다.","decisiveStep":"세 항은 1,0,1이므로 합은 2이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"거듭제곱근","l4":"실수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"log A와 log B를 합쳐 log(AB)를 구한 뒤 log₂36을 2+2log₂3으로 쓴다.","decisiveStep":"a,b,c가 2,2,3이므로 제곱합은 17이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"u=x^(1/3), v=x^(−1/3)로 두어 uv=1과 u−v=3에서 u²+v²를 먼저 구한다.","decisiveStep":"u²+v²=11이고 u⁶+v⁶=(u²+v²)³−3u²v²(u²+v²)=1298이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수","l3":"지수법칙","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"유리판 한 장 뒤 남는 밝기 비율을 (1−x/100)으로 두고 열 장 뒤 0.05가 되는 식에서 상용로그를 취한다.","decisiveStep":"남는 비율은 1/1.349≈0.7413이라 x≈25.87, 곧 약 26이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수부등식","l4":"밑의 범위에 따른 부등호"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"그림의 직선 f(x)=x+1을 읽어 (1/2)^(1−f(x))를 밑 2의 지수함수로 바꾸고 증가 방향과 점근선을 본다.","decisiveStep":"1−f(x)=−x라서 식은 2^x이며 (0,1)을 지나고 x축을 점근선으로 갖는다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 그래프","l4":"증가·감소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"2^(2x+2)·3^(−x+1)을 12(4/3)^x로 묶어 [−1,1]에서 단조성을 이용한다.","decisiveStep":"4/3>1이라 양 끝 함수값은 9와 16이고 M+m=25이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"지수함수","l3":"지수함수의 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"제3사분면에서 첫 곡선의 x범위를 정하고 t=3^(x+1)로 바꾸어 두 곡선의 교점 조건에서 a의 양끝값을 구한다.","decisiveStep":"t가 1에서 3으로 갈 때 a는 4에서 1/3으로 감소하므로 α+β=13/3이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"x=4에서 로그 진수 조건을 세우고 |3^(−x−1)−p|=4가 양의 두 지수값을 갖는 조건을 결합한다.","decisiveStep":"로그 조건은 p<12, 두 양의 해 조건은 p>4로 모인다.","hold":"로그 진수 조건과 절댓값 지수식의 두 교점 조건을 동시에 담는 유형 경로 조합을 선택지에서 찾지 못함.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":11,"questionUid":"","primaryMethod":"주기 2인 함수의 정수점 높이와 log_(3n)x의 증가를 비교해 단위 구간마다 교점 수를 센다.","decisiveStep":"교점 수는 (3n)²−1이므로 143개 조건에서 n=4이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":12,"questionUid":"","primaryMethod":"x축 대칭인 두 동경의 기준각을 α와 −α로 두고 각의 일반각 표현에서 두 합을 계산한다.","decisiveStep":"각의 합에서 α가 없어져 360°(l+m)만 남는다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"750°와 θ/4를 한 바퀴 안의 동경으로 바꾸고 π 단위 각과 보각 삼각함수 관계를 확인한다.","decisiveStep":"ㄱ, ㄷ만 참이며 cos(π/2+x)=−sin x라 ㄹ은 거짓이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"일반각"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":14,"questionUid":"","primaryMethod":"반지름 1, 중심각 60°를 π/3 라디안으로 바꾸어 호 길이 s=rθ와 학생들의 말을 대조한다.","decisiveStep":"호 길이는 π/3이므로 호 길이를 60이라고 한 말이 틀렸다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"일반각과 호도법","l4":"호도법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":15,"questionUid":"","primaryMethod":"직선 y=3x+3에서 tan θ=3을 얻고 주기성과 보각·음각 관계로 두 사인 항을 없앤다.","decisiveStep":"tan(π+θ)=3이고 cos(π/2−θ)+sin(−θ)=0이라 값은 3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":16,"questionUid":"","primaryMethod":"tan(2x−π/2)−3에서 탄젠트 주기, 점근선 식, y=tan2x 그래프의 평행이동량을 각각 확인한다.","decisiveStep":"주기는 π/2이고 점근선은 x=nπ/2이며 가로 이동은 π/4라 ㄴ만 참이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"평행이동"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":17,"questionUid":"","primaryMethod":"0≤x≤2π에서 sin x=√2/2의 두 해를 단위원으로 정해 차를 계산한다.","decisiveStep":"α=π/4, β=3π/4이므로 β−α=π/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":18,"questionUid":"","primaryMethod":"sin(π−x)=sin x로 바꾸고 s=sin x를 두어 0≤x<2π에서 부등식을 푼다.","decisiveStep":"−1≤s≤1에서 s≤−1/2라 해 구간은 [7π/6,11π/6)이고 끝값 합은 3π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":19,"questionUid":"","primaryMethod":"점 P(−6,8)의 거리 10으로 sin θ와 cos θ를 좌표 비율에서 구해 식에 넣는다.","decisiveStep":"sin θ=4/5, cos θ=−3/5이므로 10(sin θ+cos θ)=2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 뜻","l4":"단위원"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":20,"questionUid":"","primaryMethod":"그래프의 최댓값·최솟값에서 진폭을 읽고 두 극댓점의 간격으로 주기를 정한 뒤 x=0 좌표를 쓴다.","decisiveStep":"a=3, b=2이고 3cos c=3/2와 0<c<π/2에서 c=π/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":21,"questionUid":"","primaryMethod":"두 로그를 U,V로 두고 x=1/U, y=1/V를 대입해 b+c와 b−c의 로그 곱을 정리한다.","decisiveStep":"log_a((b+c)(b−c))=2이므로 b²=a²+c²이고 b가 빗변인 직각삼각형이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그","l3":"로그의 성질","l4":"곱·몫·거듭제곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":22,"questionUid":"","primaryMethod":"f의 역함수와 이동 후 그래프를 식으로 나타내고 y=3과의 교점 두 x좌표의 중점 조건을 적용한다.","decisiveStep":"A의 x좌표는 1, B는 3^(2−a)라서 중점 식에서 3^(2−a)=27, a=−1이다.","rpmPath":{"majorUnit":"지수함수와 로그함수","midUnit":"로그함수","l3":"로그함수의 활용","l4":"그래프 교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
