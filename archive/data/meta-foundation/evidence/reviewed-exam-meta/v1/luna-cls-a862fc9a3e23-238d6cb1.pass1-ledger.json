 "items":[
  {"ordinal":1,"questionUid":"","primaryMethod":"y=3cos(ax)의 주기 4π를 2π/a와 같게 놓아 양수 a를 구한다.","decisiveStep":"2π/a=4π를 풀면 a=1/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 변환","l4":"주기·진폭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":2,"questionUid":"","primaryMethod":"tan(ax)의 점근선 x=nπ/3+π/6을 일반식 x=nπ/a+π/(2a)와 계수별로 비교한다.","decisiveStep":"nπ의 계수에서 1/a=1/3이므로 a=3이고 상수항도 π/6과 맞는다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"기본 그래프","l4":"tan"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":3,"questionUid":"","primaryMethod":"외접반지름 4와 A=30도, sin B=√3/3를 사인법칙에 넣어 BC와 AC를 각각 구한 뒤 제곱을 더한다.","decisiveStep":"a=4, b=8√3/3이므로 a²+b²=16+64/3=112/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"사인법칙","l4":"외접원 반지름"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":4,"questionUid":"","primaryMethod":"첫째항 2와 제n항 20을 등차수열 합 공식 Sn=n(a1+an)/2에 넣어 n을 구한다.","decisiveStep":"110=n(2+20)/2=11n에서 n=10이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":5,"questionUid":"","primaryMethod":"x, x+3, 4x가 등비수열일 조건 (x+3)²=x·4x로 정수 x를 찾는다.","decisiveStep":"x²-2x-3=0의 두 정수해 3,-1의 합은 2이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"중항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":6,"questionUid":"","primaryMethod":"두 시그마에서 상수항의 합을 각각 10번 더해 Σak=15를 먼저 구하고 두 번째 식에서 Σbk를 고립시킨다.","decisiveStep":"2·15-Σbk+30=40을 풀어 Σbk=20이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"합의 기호 Σ","l4":"성질"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":7,"questionUid":"","primaryMethod":"θ가 제2사분면임을 이용해 세 각 변환식을 sinθ와 cosθ로 바꾸고 sinθ=3/5에 맞는 cosθ를 대입한다.","decisiveStep":"cosθ=-4/5, tanθ=-3/4이므로 변환된 분수값은 32/15이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"삼각함수 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":8,"questionUid":"","primaryMethod":"사인법칙으로 sin A:sin B:sin C를 변의 비 3:4:5로 바꾸고 둘레 60에서 실제 변 길이를 구한다.","decisiveStep":"변은 15,20,25라 직각삼각형의 넓이는 15·20/2=150이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"삼각형의 넓이","l4":"복합도형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":9,"questionUid":"","primaryMethod":"AP=3, BP=8, AB=7을 각 P의 코사인법칙에 대입해 cos P를 계산한다.","decisiveStep":"cos P=(9+64-49)/48=1/2이므로 각 APB는 60도이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":10,"questionUid":"","primaryMethod":"최댓값 4와 최솟값 -2로 a,c를 정하고 주기 3π로 b를 구한 뒤 x=π/2를 대입한다.","decisiveStep":"a=3,c=1,b=2/3이어서 f(π/2)=3cos(π/3)+1=5/2이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":11,"questionUid":"","primaryMethod":"a4-2a10=0에서 첫째항과 공차 관계를 세워 ak=(k-16)d로 바꾸고 연속한 두 항의 곱 부호를 본다.","decisiveStep":"(k-16)(k-14)d²<0은 14<k<16을 뜻하므로 k=15이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등차수열","l4":"일반항"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":12,"questionUid":"","primaryMethod":"첫 색칠 정사각형 둘레 4와 다음 둘레비 1/2로 등비수열 합 8(1-2^-n)을 만든 뒤 7.9 초과 조건을 비교한다.","decisiveStep":"2^-6은 0.0125보다 크고 2^-7은 작으므로 최소 n은 7이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":13,"questionUid":"","primaryMethod":"a2,a5,a14의 등비중항 식에서 공차 양수 조건으로 d=2a를 얻고 세 항 합 78에 대입한다.","decisiveStep":"3a+18d=78과 d=2a에서 a=2,d=4이므로 a10=38이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":14,"questionUid":"","primaryMethod":"각 항을 2+1/k-1/(k+1)로 분해해 망원합을 만든 뒤 m에 대한 방정식을 푼다.","decisiveStep":"합은 2m+1-1/(m+1)이고 1224/25와 같아지는 자연수는 24이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"여러 가지 수열의 합","l4":"부분분수·망원급수형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":15,"questionUid":"","primaryMethod":"0<x≤π에서 sin x>0은 항상 성립하므로 2cos²x+cos x-1을 인수분해해 해 구간을 정한다.","decisiveStep":"-1<cos x<1/2가 π/3<x<π로 바뀌므로 β-α=2π/3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각방정식·부등식","l4":"주기 구간의 해"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":16,"questionUid":"","primaryMethod":"사인 그래프에서 두 주기 안의 수평선 교점 쌍은 각각 대칭축을 기준으로 합이 정해지므로 네 x좌표 합을 주기로 표현한다.","decisiveStep":"네 근의 합은 6π/k이고 cos(6π/k)=-1/2에서 가장 큰 양수 k는 9이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"교점"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":17,"questionUid":"","primaryMethod":"반원에서 ∠BAC=π/3가 가리키는 중심각을 120도로 바꾸고 BC의 4등분과 CD의 1:2 호분할로 현의 중심각을 정한다.","decisiveStep":"CD²=32, CE²=32-16√3이므로 차는 16√3이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 활용","l3":"코사인법칙","l4":"변·각 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":18,"questionUid":"","primaryMethod":"2^a,2^b,2^c의 등비중항에서 2b=a+c를 얻고 이를 세 명제 각각에 대입해 참거짓을 판정한다.","decisiveStep":"가,나는 등호 관계로 참이고 다는 3b²-(ab+bc+ca)=(a-c)²/4≥0이라 참이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"수열의 활용","l4":"조건으로 수열 결정"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":19,"questionUid":"","primaryMethod":"a(1+r+r²)=3과 a²(1+r²+r⁴)=21을 묶어 ar과 r의 방정식을 차례로 결정한다.","decisiveStep":"정수 공비는 r=-2, 첫째항은 1이므로 a5=1·(-2)^4=16이다.","rpmPath":{"majorUnit":"수열","midUnit":"등차수열과 등비수열","l3":"등비수열","l4":"합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":20,"questionUid":"","primaryMethod":"Sn=3|an|에서 an=Sn-Sn-1을 써 부호별 점화식을 만들고 a2=8,a3>0으로 a3와 a4 후보를 계산한다.","decisiveStep":"a3=12이며 a4는 18 또는 -9이므로 가능한 값의 합은 9이다.","rpmPath":{"majorUnit":"수열","midUnit":"수학적 귀납법","l3":"수열의 귀납적 정의","l4":"점화식으로 항 구하기"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":21,"questionUid":"","primaryMethod":"t=2x-π/3에서 2x=t+π/3을 원래 식에 대입해 cos²t-cos t와 각 항의 위상을 비교한다.","decisiveStep":"첫 항에서 α=π/3이고 sin(t-π/2)=-cos t이므로 β=5π/6이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수","l3":"삼각함수의 성질","l4":"주기·대칭"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":22,"questionUid":"","primaryMethod":"sin(x+π/6)=cos(x-π/3)으로 맞춘 뒤 s=cos(x-π/3)인 이차함수의 꼭짓점을 찾아 허용되는 k를 고른다.","decisiveStep":"최댓값은 s=1/2에서 나고 범위 속 후보 중 cos k<0인 k는 2π/3뿐이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":23,"questionUid":"","primaryMethod":"cos²x=1-sin²x로 바꿔 s=sin x의 이차함수에서 최대·최소가 되는 s를 찾고 각 x를 열거한다.","decisiveStep":"최대 x는 7π/6,11π/6이고 최소 x는 π/2라서 두 차의 합은 -2π이다.","rpmPath":{"majorUnit":"삼각함수","midUnit":"삼각함수의 그래프","l3":"그래프 활용","l4":"최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":24,"questionUid":"","primaryMethod":"나머지정리로 R=f(2)를 구하고 나눗셈 항등식에 x=1을 대입해 n에 관한 식을 만든다.","decisiveStep":"고2 공통수학1 선택지의 rpmPath 목록이 비어 있어 표에 있는 유형 조합으로 지정할 수 없다.","rpmPath":{"majorUnit":"","midUnit":"","l3":"","l4":""},"hold":"고2 공통수학1 선택지 파일에 유형 경로가 등록되어 있지 않다.","crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
  {"ordinal":25,"questionUid":"","primaryMethod":"ak=k(n-k+2)를 (n+2)k-k²로 전개해 자연수의 합과 제곱합 공식을 Sn에 적용한다.","decisiveStep":"Sn=n(n+1)(n+5)/6이므로 m(m+1)(m+5)=936에서 m=8이다.","rpmPath":{"majorUnit":"수열","midUnit":"수열의 합","l3":"여러 가지 수열의 합","l4":"자연수 거듭제곱의 합"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
