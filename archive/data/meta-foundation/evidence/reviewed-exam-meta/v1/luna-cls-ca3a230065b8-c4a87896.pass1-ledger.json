  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"f'(2)=0에서 매개변수 a를 구한 뒤 이계도함수의 부호로 극솟값인지 확인한다.","decisiveStep":"12-6a=0에서 a=2이고 f''(2)=12>0이므로 x=2는 극소점이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"f를 적분해 F(x)=x⁴/2-4x+C로 두고 F(0)=11로 적분상수를 정한다.","decisiveStep":"C=11을 얻어 F(2)=8-8+11=11이다.","rpmPath":{"majorUnit":"적분","midUnit":"부정적분","l3":"조건을 이용한 함수 결정","l4":"초기조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"6x²-6x+6의 원시함수 2x³-3x²+6x에 0과 1을 대입한다.","decisiveStep":"상한값 5에서 하한값 0을 빼면 정적분은 5이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분의 뜻","l4":"정적분 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"위치 -t³+5t²를 두 번 미분해 t=1의 속도와 가속도를 각각 계산한다.","decisiveStep":"v(1)=7, a(1)=4이므로 합은 11이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"속도와 가속도","l4":"위치·속도·가속도"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"x³-3x²+2의 극댓값 2와 극솟값 -2 사이에 수평선 y=-a가 오도록 한다.","decisiveStep":"세 교점 조건은 -2<-a<2, 곧 -2<a<2라서 n-m=4이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"곡선과 직선의 교점 x=0,m+4를 구하고 위쪽 곡선에서 아래쪽 직선을 뺀 넓이를 적분한다.","decisiveStep":"넓이 (m+4)³/3=729/3에서 m+4=9이므로 m=5이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"넓이","l4":"두 곡선 사이"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"홀함수 조건으로 f(x)=x³+ax를 놓고 두 수평선 y=54와 y=-54의 접점 조건을 사용한다.","decisiveStep":"양의 극솟점 r=3에서 a=-27이 되어 f(1)=-26이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"근의 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"C=∫₀²f(t)dt로 두어 f(x)=x³+x+C를 얻고 같은 구간에 다시 적분한다.","decisiveStep":"C=6+2C에서 C=-6이므로 f(1)=-4이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"f(0)=0으로 적분상수를 없앤 뒤 1/[n(n+1)]을 1/n-1/(n+1)로 바꾸어 합한다.","decisiveStep":"합이 1-1/9=8/9이므로 18k=16이다.","rpmPath":{"majorUnit":"적분","midUnit":"부정적분","l3":"부정적분 계산","l4":"다항함수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"홀수 n은 음의 무한대에서 배제하고 짝수 n에서는 도함수가 0인 x=1의 최솟값을 확인한다.","decisiveStep":"최솟값 n²-5n+5가 양수가 되는 가장 작은 짝수는 4이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"부등식 증명"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"일차 다항식 반례로 ㄱ을, f와 f'의 차수 비교로 ㄴ을, 비상수 짝함수의 양끝 거동으로 ㄷ을 판정한다.","decisiveStep":"ㄷ은 짝수 차수 비상수 다항식이 전역 극값을 가져 참이고 ㄱ, ㄴ은 거짓이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"a=2x로 바꿔 절댓값 적분을 t=a에서 나누고 완전제곱으로 구간 최대와 최소를 비교한다.","decisiveStep":"최솟값 25/4, 끝점 최대 17/2이므로 M/m=34/25이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"도함수의 판별식이 양수인 매개변수 범위에서 삼차항이 사라지는 a=1을 별도로 제외한다.","decisiveStep":"정수 후보 -3,-2,-1,0,1 중 a=1은 삼차함수가 아니어서 남는 값은 네 개다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"g(x)=x²+4/x²-3의 치역을 [1,∞)로 구한 다음 그 구간에서 f의 최솟값을 찾는다.","decisiveStep":"f'의 부호는 [1,∞)에서 x=3을 기준으로 감소 후 증가하므로 최솟값은 f(3)=14이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"P의 속도를 적분해 위치를 만들고 만나는 조건을 k=h(t)로 고쳐 t>0에서 최댓값을 구한다.","decisiveStep":"h는 t=3에서 최대 6을 가져 p²=36이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분의 활용","l3":"속도와 거리","l4":"위치 변화"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"적분으로 정의된 g를 미분해 f가 음수인 구간을 찾아 네 근의 위치를 정한다.","decisiveStep":"근은 0의 중근과 6,14이므로 f=x²(x-6)(x-14)이고 f(1)=65이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"f(2)=0과 f'(2)=0을 연립해 a,b를 구하고 다른 도함수 근에서 극솟값을 평가한다.","decisiveStep":"a=-9, b=24, m=-4여서 a+b+m=11이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"적분 등식을 두 번 미분해 f를 찾고 x=1에서 원식과 한 번 미분한 식을 함께 쓴다.","decisiveStep":"a=-3/2, b=1/2이므로 a+b=-1이다.","rpmPath":{"majorUnit":"적분","midUnit":"정적분","l3":"정적분과 함수","l4":"미분과 적분 관계"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"경계 연속성에서 f(t)=0을 얻고 세 극값 중 경계점과 도함수 극점들의 함수값 관계를 세운다.","decisiveStep":"단순근과 중근 간격 d는 4d³/27=4를 만족해 d³=27이며 답은 54이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"증가·감소와 극값","l4":"극대·극소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"위치 x(t)를 미분해 속도의 부호가 바뀌는 t=1,2를 찾고 각 위치를 대입한다.","decisiveStep":"두 방향 전환 위치가 5와 4이므로 a+b=9이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"속도와 가속도","l4":"위치·속도·가속도"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"F=f'에서 F-g'가 -1을 중근으로 갖게 하고 f-h의 도함수가 전역 부호를 유지할 판별식 조건을 더한다.","decisiveStep":"a≥5/3이며 f'(2)=9a-12이므로 최솟값은 3이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(3)","l3":"방정식과 부등식","l4":"부등식 증명"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"f의 이중근 구조를 세우고 g'=((x-2)f)'에서 g를 복원한 뒤 최소점 조건과 최소값을 맞춘다.","decisiveStep":"g의 최소점 x=1/2가 d=2를 정하고 최소값이 C=11/16을 주어 f(1)+g(1)=11/16이다.","rpmPath":{"majorUnit":"미분","midUnit":"도함수의 활용(2)","l3":"최대·최소","l4":"구간 최대·최소"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
