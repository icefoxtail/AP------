  "items": [
    {"ordinal":1,"questionUid":"","primaryMethod":"(x-1)^2으로 나눈 나머지가 x+2이므로 R(x)=a(x-1)^2+x+2로 두고, P(-1)=5를 이용해 a를 정한다.","decisiveStep":"x=-1을 대입하면 4a+1=5이므로 a=1이고 R(2)=5이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":2,"questionUid":"","primaryMethod":"세 양수의 세제곱합 조건을 합의 제곱 꼴로 인수분해해 a=b=c를 얻고 분수식에 대입한다.","decisiveStep":"두 번째 인수가 제곱차의 합이므로 0이 되려면 세 수가 모두 같아야 하고, 각 분수는 2가 된다.","rpmPath":{"majorUnit":"다항식","midUnit":"인수분해","l3":"인수분해의 활용","l4":"조건식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":3,"questionUid":"","primaryMethod":"주어진 이차방정식의 판별식을 a에 대한 식으로 정리하고, 모든 a에서 음수일 조건을 k에 적용한다.","decisiveStep":"a²+ka+5가 모든 실수 a에서 양수이려면 k²-20<0이므로 정수 k는 9개다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식","l3":"이차방정식의 근","l4":"판별식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":4,"questionUid":"","primaryMethod":"f(x)=(x²+x+1)Q(x)+x-1에 Q(x)=(x-1)Q'(x)+2를 넣어 x³-1의 배수항과 나머지를 분리한다.","decisiveStep":"(x²+x+1)(x-1)=x³-1이므로 나머지는 2x²+3x+1이고 R(2)=15이다.","rpmPath":{"majorUnit":"다항식","midUnit":"다항식의 연산","l3":"다항식의 나눗셈","l4":"몫과 나머지"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":5,"questionUid":"","primaryMethod":"z⁸=1인 주기를 이용해 zⁿ=켤레 z를 zⁿ⁺¹=1로 바꾸고 100 이하의 지수를 센다.","decisiveStep":"n+1이 8의 배수여야 하므로 n=7,15,…,95의 12개다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"i의 거듭제곱","l4":"주기성"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":6,"questionUid":"","primaryMethod":"근의 합 α+β=4와 곱 αβ=-5를 이용해 식을 (α+β)²-2αβ+αβ(α+β)로 묶는다.","decisiveStep":"각 항에 합과 곱을 대입하면 16+10-20=6이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식","l3":"근과 계수의 관계","l4":"근의 합·곱"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":7,"questionUid":"","primaryMethod":"x²-2x를 t로 치환해 (t+1)(t+3)-24를 인수분해한 뒤 원래 식으로 되돌린다.","decisiveStep":"t²+4t-21=(t-3)(t+7)이므로 되돌리면 (x-3)(x+1)(x²-2x+7)이다.","rpmPath":{"majorUnit":"다항식","midUnit":"인수분해","l3":"인수분해 공식","l4":"이차식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":8,"questionUid":"","primaryMethod":"포물선 y=2x²-5x-3과 직선 y=7x+1을 연립해 교점 x좌표의 합을 구한다.","decisiveStep":"x²-6x-2=0의 두 근의 합은 6이므로 α=1, β=6이며 α+β=7이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식과 이차함수","l3":"직선과 포물선","l4":"교점 개수"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":9,"questionUid":"","primaryMethod":"y=2x+k를 ax²+xy+2y+8=0에 대입해 x에 대한 항등식으로 정리한다.","decisiveStep":"x²항과 x항의 계수가 각각 0이어야 하므로 a=-2, k=-4이고 a+k=-6이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"항등식","l4":"미정계수법"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":10,"questionUid":"","primaryMethod":"식을 (k+1)x²+2kx+2k+4=0으로 모으고 판별식이 0인 k를 구한다.","decisiveStep":"k²-(k+1)(2k+4)=0에서 k²+6k+4=0이 되어 두 k의 합은 -6이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식","l3":"이차방정식의 근","l4":"판별식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":11,"questionUid":"","primaryMethod":"ω³=1을 이용해 n을 3으로 나눈 나머지별로 f(n)을 계산하고 세 항씩 묶어 30항을 더한다.","decisiveStep":"각 세 항의 합은 -3/2이고 30항에는 열 묶음이 있어 전체 합은 -15다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"i의 거듭제곱","l4":"주기성"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":12,"questionUid":"","primaryMethod":"u=x+y, v=xy로 두어 두 조건을 연립하고, 얻은 각 u,v가 실수 x,y를 만드는지 판별한다.","decisiveStep":"u=3, v=2만 실수근을 만들며 x²+y²=u²-2v=5로 고정되어 최댓값과 최솟값의 합은 10이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"여러 가지 방정식","l3":"연립방정식","l4":"대칭식 활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":13,"questionUid":"","primaryMethod":"삼차식 P를 (x-1)²으로 나눈 몫과 나머지를 x+a로 놓고 P(3)=10으로 a를 정한다.","decisiveStep":"a=-1이므로 P(x)=(x-1)³+(x-1)이고, (x-1)³으로 나눈 나머지는 x-1이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":14,"questionUid":"","primaryMethod":"z²-z+1=0에서 z³=-1임을 찾아 zⁿ이 실수가 되는 최소 지수 m을 구하고 6항 합을 계산한다.","decisiveStep":"m=3이고 여섯 항의 합은 (z+z²+z³)(1+z³)=0이므로 S²=0이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"i의 거듭제곱","l4":"주기성"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":15,"questionUid":"","primaryMethod":"실계수 방정식의 두 근을 2-i, 2+i로 놓아 a를 구한 뒤, 포물선이 x축에 접할 판별식 조건을 적용한다.","decisiveStep":"a=-4이고 x²-4x+k-2의 판별식을 0으로 두면 k=6이다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식과 이차함수","l3":"그래프와 근","l4":"판별식과 위치"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":16,"questionUid":"","primaryMethod":"첫 방정식의 중근 조건으로 n=m²/4를 두고, 둘째 방정식의 판별식이 양수인 정수 m,n을 센다.","decisiveStep":"m=2k, n=k²로 놓으면 k⁴-8k>0인 가능 값은 -3,-2,-1,3이어서 순서쌍은 4개다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식","l3":"이차방정식의 근","l4":"판별식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":17,"questionUid":"","primaryMethod":"직사각형의 높이를 x라 두고 닮음으로 너비를 3(4-x)/2로 나타내어 넓이 이차식을 만든다.","decisiveStep":"넓이 -3x²/2+6x는 x=2에서 꼭짓점 최댓값 6을 갖는다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식과 이차함수","l3":"최대·최소","l4":"조건식 활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":18,"questionUid":"","primaryMethod":"x=0을 원식에 대입해 Q(0)=Q(1)=0을 얻고, 최고차항이 1인 Q를 정한 뒤 나눗셈 나머지를 구한다.","decisiveStep":"Q(x)=x(x-1), P(x)=2x³+2x이며 P를 x(x+1)로 나눈 나머지는 4x라서 R(0)=0이다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":19,"questionUid":"","primaryMethod":"z를 크기 1/2인 수와 주기 8인 복소수의 곱으로 나타내어 순허수 지수와 크기 범위의 지수를 각각 센다.","decisiveStep":"순허수 조건은 n≡2,6 (mod 8)로 25개, 크기 조건은 4≤n≤10으로 7개여서 합은 32다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"복소수","l3":"i의 거듭제곱","l4":"복소수 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":20,"questionUid":"","primaryMethod":"R(x)=a(x-2)²+2x-1로 놓고 f(-1)=6을 대입해 계수 a를 정한다.","decisiveStep":"a=1이므로 R(x)=x²-2x+3이고 R(1)=2다.","rpmPath":{"majorUnit":"다항식","midUnit":"항등식과 나머지정리","l3":"나머지정리","l4":"고차식 조건"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":21,"questionUid":"","primaryMethod":"h(t)를 꼭짓점형으로 바꾸어 최고 높이를 구하고, h(t)≥25를 이차부등식으로 풀어 시간 구간을 구한다.","decisiveStep":"높이 조건은 (t-1)(t-3)≤0이어서 1초부터 3초까지, 총 2초다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"이차방정식과 이차함수","l3":"최대·최소","l4":"조건식 활용"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":22,"questionUid":"","primaryMethod":"x²을 X로 치환해 X²-X-12를 인수분해하고, 실수 범위와 복소수 범위의 인수를 차례로 적는다.","decisiveStep":"X=4,-3이므로 f(x)=(x-2)(x+2)(x²+3), 허근은 ±√3i다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"여러 가지 방정식","l3":"삼차·사차방정식","l4":"치환형"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
    {"ordinal":23,"questionUid":"","primaryMethod":"x=y+k를 x²+2y²=6에 대입해 y에 대한 이차방정식을 만들고 한 쌍의 해가 되는 k를 구한다.","decisiveStep":"판별식을 0으로 놓아 k²=9를 얻고 양수 조건으로 k=3을 택한다.","rpmPath":{"majorUnit":"방정식과 부등식","midUnit":"여러 가지 방정식","l3":"연립방정식","l4":"이차식이 포함된 연립방정식"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"}
  ]
