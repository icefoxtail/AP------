{"ordinal":1,"questionUid":"","primaryMethod":"50명 중 40명의 호전 빈도를 전체 환자 수로 나누어 한 환자의 호전 확률을 추정한다.","decisiveStep":"상대도수는 40/50=4/5이다.","rpmPath":{"majorUnit":"확률","midUnit":"확률의 뜻과 활용","l3":"확률의 기본","l4":"확률 계산"},"crossConceptKeys":[],"conditionKeys":[],"integrationPattern":"NONE"},
