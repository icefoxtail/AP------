      "id": 1,
      "content": "오른쪽 원 $O$에서 $\\\\angle x$의 크기는? (3점)",
      "choices": [
        "$25^\\\\circ$",
        "$30^\\\\circ$",
        "$35^\\\\circ$",
        "$40^\\\\circ$",
        "$45^\\\\circ$"
