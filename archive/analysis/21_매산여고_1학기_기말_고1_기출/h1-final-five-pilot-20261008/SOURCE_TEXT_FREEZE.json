    {
      "qid": 1,
      "sourcePosition": {
        "page": 1,
        "region": "left-upper"
      },
      "content": "연립방정식 $\\begin{cases}2x+y=3\\\\x^2+y^2=5\\end{cases}$을 만족시키는 두 실수 $x,y$에 대하여 $3x-y$를 구하시오. (단, $x>y$) [3.5점]",
      "choices": [
        "$-3$",
