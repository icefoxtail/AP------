    },
    {
      "qid": 3,
      "sourcePosition": {
        "page": 1,
        "region": "right-upper"
      },
      "content": "두 점 $A(-2,6)$, $B(a,-3)$에 대하여 선분 $AB$를 $b:2$로 내분하는 점 $P$의 좌표가 $(-1,3)$일 때, 선분 $AB$를 $b:2$로 외분하는 점 $Q$의 좌표를 구하시오. [4.1점]",
      "choices": [
        "$(17,-7)$",
        "$(10,-30)$",
        "$(-5,15)$",
        "$(2,-9)$",
        "$(-1,3)$"
      ],
      "sourceImageRef": null,
      "sourceTextExactParity": "PASS",
