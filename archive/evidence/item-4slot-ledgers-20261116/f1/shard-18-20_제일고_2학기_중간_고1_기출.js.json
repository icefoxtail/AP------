":"stem","quote":"여기서 (나)는 3의 배수이다."}],"method":[{"term":"귀류법","src":"solution","quote":"서로소라는 가정에 모순","evidenceType":"NAMED"},{"term":"경우분류","src":"solution","quote":"두 경우를 제곱하면","evidenceType":"NAMED"},{"term":"배수","src":"solution","quote":"$n^2$은 3의 배수이다.","evidenceType":"IMPLIED","justification":"나머지 경우를 나누어 제곱의 배수성에서 수 자체의 배수성을 추론한다."}],"condition":[{"term":"정수","src":"stem","quote":"정수 $m,n$에 대하여"},{"term":"영이아님","src":"stem","quote":"$m\\ne0$"},{"term":"조건","src":"stem","quote":"$m\\ne0$"}]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":15,"questionUid":"qid_v1_160d9d835c7c07e719e2d5e9d0c8757e54461db4a448395f92910a9b1b17b988","format":"빈칸 채우기","decisiveStep":"a²+ab+b²를 (a+b/2)²+3b²/4로 바꾸고 두 제곱항이 모두 0일 때 등호가 성립함을 확인한다.","slots":{"given":[{"term":"실수","src":"stem","quote":"실수 $a,b$에 대하여"},{"term":"부등식","src":"stem","quote":"$a^2+ab+b^2\\geq0$이 성립함"}],"goal":[{"term":"증명","src":"stem","quote":"증명하는 과정이다."},{"term":"등호조건","src":"stem","quote":"등호는 (나)일 때 성립한다."}],"method":[{"term":"완전제곱식","src":"solution","quote":"완전제곱을 만들면","evidenceType":"NAMED"},{"term":"제곱합","src":"solution","quote":"두 항 $(a+\\frac{b}{2})^2$와 $3b^2/4$","evidenceType":"IMPLIED","justification":"두 비음수 항의 합이 0이 되는 조건을 각 항이 0인 조건으로 바꾼다."},{"term":"등호조건","src":"solution","quote":"두 항이 모두 0이어야 한다.","evidenceType":"NAMED"}],"condition":[{"term":"실수","src":"stem","quote":"실수 $a,b$에 대하여"}]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":16,"questionUid":"qid_v1_c27e813850f24226e51c7f365b7ce833901a24242948b098ee9213a1ba5984b8","format":"단일 정답","decisiveStep":"4(x²+y²)−(x+√3y)²=(√3x−y)²≥0으로 목표식의 절댓값을 2√6 이하로 제한하고, 등호가 가능한 점을 조건에 대입해 양 끝값이 실제로 얻어짐을 보인다.","slots":{"given":[{"term":"원","src":"stem","quote":"$x^2+y^2=6$일 때"},{"term":"실수","src":"stem","quote":"실수 $x,y$에 대하여"}],"goal":[{"term":"최댓값","src":"stem","quote":"최댓값과 최솟값의 곱은?"},{"term":"최솟값","src":"stem","quote":"최댓값과 최솟값의 곱은?"},{"term":"곱","src":"stem","quote":"최댓값과 최솟값의 곱은?"}],"method":[{"term":"코시슈바르츠부등식","src":"solution","quote":"4(x^2+y^2)-(x+\\sqrt3y)^2","evidenceType":"IMPLIED","justification":"선형식의 제곱을 제곱합으로 제한하는 항등식은 코시슈바르츠 부등식의 적용이다."},{"term":"등호조건","src":"solution","quote":"등호가 가능한지도 확인한다.","evidenceType":"NAMED"},{"term":"연립방정식","src":"solution","quote":"$x^2+(\\sqrt3x)^2=6$","evidenceType":"IMPLIED","justification":"등호 조건 y=√3x를 원래 제약식에 대입해 등호가 성립하는 점을 찾는다."}],"condition":[{"term":"실수","src":"stem","quote":"실수 $x,y$에 대하여"}]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":17,"questionUid":"qid_v1_eb4ae8a96695d58fa6a3d43e246f22d0961704a911f1b6559f58a78e4ad7a187","format":"단일 정답","decisiveStep":"X의 세 원소에서 f(x)=2x+1의 값은 −1, 3, 7로 모두 Y에 들어가므로 그 선택지만 X에서 Y로의 함수다.","slots":{"given":[{"term":"집합","src":"stem","quote":"두 집합 $X=\\{-1,1,3\\}, Y="},{"term":"함수식","src":"choices","quote":"$f(x)=2x+1$"}],"goal":[{"term":"판정","src":"stem","quote":"함수인 것은?"},{"term":"함수","src":"stem","quote":"X$에서 $Y$로의 함수인 것은?"}],"method":[{"term":"함숫값","src":"solution","quote":"각 원소를 대입했을 때 값이 모두 공역","evidenceType":"NAMED"},{"term":"대응","src":"solution","quote":"세 값이 모두 $Y$에 속하므로 함수이다.","evidenceType":"IMPLIED","justification":"정의역의 각 원소에 대응하는 값이 공역에 속하는지 확인한다."}],"condition":[]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":18,"questionUid":"qid_v1_ff9c52183997ae84adac0365a268922417f5f1c230bbcd75da645726cba645ba","format":"단일 정답","decisiveStep":"두 구간의 기울기가 모두 양수인 경우에만 치역이 서로 겹치지 않으면서 실수 전체를 이루므로 1<a<2이고 α²+β²=5다.","slots":{"given":[{"term":"실수","src":"stem","quote":"실수 $a$의 범위가"},{"term":"조각함수","src":"stem","quote":"f(x)=\\begin{cases}"},{"term":"일대일대응","src":"stem","quote":"함수가 일대일대응이 되도록"},{"term":"매개변수","src":"stem","quote":"실수 $a$의 범위"}],"goal":[{"term":"매개변수","src":"stem","quote":"실수 $a$의 범위가"},{"term":"범위","src":"stem","quote":"$\\alpha<a<\\beta$일 때"},{"term":"합","src":"stem","quote":"$\\alpha^2+\\beta^2$의 값은?"}],"method":[{"term":"기울기","src":"solution","quote":"왼쪽 구간의 기울기는 $a-1$","evidenceType":"NAMED"},{"term":"치역","src":"solution","quote":"두 구간의 치역은 각각","evidenceType":"NAMED"},{"term":"경우분류","src":"solution","quote":"두 기울기의 부호가 반대일 때도","evidenceType":"IMPLIED","justification":"기울기 부호 조합을 나누어 일대일성과 치역의 겹침 여부를 확인한다."}],"condition":[{"term":"실수","src":"stem","quote":"실수 $a$의 범위가"},{"term":"정의역제한","src":"stem","quote":"(x\\geq2)"}]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":19,"questionUid":"qid_v1_a0ae4b3edb34679d96207d76299d1ae8e95498d8c4cf340d2b5a3adab5a6d310","format":"서술","decisiveStep":"A의 원소로 2와 6이 들어가려면 a=2이고, B에 2를 만드는 두 경우 b=1 또는 0 중 교집합이 {2,6}인 것은 b=1이다.","slots":{"given":[{"term":"집합","src":"stem","quote":"두 집합 $A=\\{1,a,a+4\\}"},{"term":"교집합","src":"stem","quote":"$A\\cap B=\\{2,6\\}$일 때"},{"term":"상수","src":"stem","quote":"두 상수 $a,b$의 값을"}],"goal":[{"term":"매개변수","src":"stem","quote":"두 상수 $a,b$의 값을 구하는"},{"term":"결정","src":"stem","quote":"두 상수 $a,b$의 값을 구하는"}],"method":[{"term":"교집합","src":"solution","quote":"$A\\cap B=\\{2,6\\}$이므로","evidenceType":"NAMED"},{"term":"경우분류","src":"solution","quote":"가능한 경우는","evidenceType":"NAMED"},{"term":"원소나열법","src":"solution","quote":"$A=\\{1,2,6\\}$이다.","evidenceType":"IMPLIED","justification":"집합의 원소를 구체적으로 나열해 교집합 조건과 비교한다."}],"condition":[]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":20,"questionUid":"qid_v1_3d3347e1c198ba8d0a9596869346fa9f1330bb36c616d27a523b521cb7a393a9","format":"소문항 묶음","decisiveStep":"드모르간 법칙으로 (A∩B)^c=A^c∪B^c를 구하고, 두 주어진 합집합의 교집합에서 B^c={1,3}을 얻어 A∩B={2,6,9}를 결정한다.","slots":{"given":[{"term":"전체집합","src":"stem","quote":"전체집합 $U$의 두 부분집합"},{"term":"부분집합","src":"stem","quote":"두 부분집합 $A,B$"},{"term":"합집합","src":"stem","quote":"$A\\cup B^c=\\{1,2,3,6,9\\}$"},{"term":"교집합","src":"stem","quote":"$(A\\cap B)^c=\\{1,3,5,7\\}$"},{"term":"여집합","src":"stem","quote":"$B^c$에 반드시 있어야 하는 원소"}],"goal":[{"term":"교집합","src":"stem","quote":"$A\\cap B$를 구하시오."},{"term":"여집합","src":"stem","quote":"$B^c$에 반드시 있어야 하는 원소"},{"term":"원소","src":"stem","quote":"있어야 하는 원소를 모두 구하시오."}],"method":[{"term":"드모르간법칙","src":"solution","quote":"드모르간 법칙으로","evidenceType":"NAMED"},{"term":"분배법칙","src":"solution","quote":"$(A\\cap A^c)\\cup B^c$","evidenceType":"IMPLIED","justification":"합집합과 교집합을 분배해 두 식의 교집합을 B^c로 정리한다."},{"term":"소거","src":"solution","quote":"$A\\cap A^c=\\varnothing$","evidenceType":"NAMED"}],"condition":[]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":21,"questionUid":"qid_v1_be608942312a24d91d4127db04c7aaab3a3b0974a1884dda6c97119a8141c967","format":"소문항 묶음","decisiveStep":"P=(1,9]가 Q에 포함되려면 9<a+1이므로 정수 a의 최솟값은 9이고, P가 R에 포함되지 않으려면 9>b−5여서 정수 b의 최댓값은 13이다.","slots":{"given":[{"term":"조건","src":"stem","quote":"세 조건 $p,q,r$가"},{"term":"진리집합","src":"stem","quote":"진리집합을 각각 $P,Q,R$이라고 할 때"},{"term":"실수","src":"stem","quote":"실수 $x$에 대하여"}],"goal":[{"term":"포함관계","src":"stem","quote":"포함관계를 적당한 기호를 이용하여 나타내고"},{"term":"매개변수","src":"stem","quote":"정수 $a$의 최솟값을 구하시오."},{"term":"최솟값","src":"stem","quote":"정수 $a$의 최솟값을 구하시오."},{"term":"최댓값","src":"stem","quote":"정수 $b$의 최댓값을 구하시오."}],"method":[{"term":"포함관계","src":"solution","quote":"$P\\subset Q$여야 한다.","evidenceType":"NAMED"},{"term":"대소비교","src":"solution","quote":"$9<a+1$이어야 한다.","evidenceType":"IMPLIED","justification":"구간 끝점의 포함 조건을 비교해 매개변수의 부등식을 얻는다."}],"condition":[{"term":"실수","src":"stem","quote":"실수 $x$에 대하여"},{"term":"정수","src":"stem","quote":"정수 $a$의 최솟값을 구하시오."}]},"reasons":{},"steps":[],"scenarioNote":""},{"ordinal":22,"questionUid":"qid_v1_dbdda34eb454764fd0efe875eca76d0e7e7f095f8483830284dc6b615e5d640e","format":"서술","decisiveStep":"f(6)을 얻으려면 2x=6에서 x=3을 구한 뒤 오른쪽 식에 대입해 f(6)=3+5=8을 계산한다.","slots":{"given":[{"term":"함수식","src":"stem","quote":"함수 $f(2x)=x+5$일 때"}],"goal":[{"term":"함숫값","src":"stem","quote":"$f(6)$의 값을 구하는"}],"method":[{"term":"일차방정식","src":"solution","quote":"$2x=6$을 푼다.","evidenceType":"NAMED"},{"term":"대입","src":"solution","quote":"이 값을 오른쪽 식에 대입하면","evidenceType":"NAMED"}],"condition":[]},"reasons":{},"steps":[],"scenarioNote":""}]}
