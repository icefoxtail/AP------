  ],
  "sourceConditions": [
    {
      "id": "source",
      "condition": "【서술형 2】 다음 그림에서 $\\mathrm{A}$, $\\mathrm{B}$, $\\mathrm{C}$는 모두 정사각형이고, $\\mathrm{A}$와 $\\mathrm{B}$의 넓이가 각각 $\\mathrm{C}$의 넓이의 $5$배, $3$배이다. 이 세 정사각형을 아래 변이 일직선이 되도록 차례로 붙여서 만든 도형의 둘레의 길이가 $12\\sqrt{5} + 6\\sqrt{3} + 6,\\text{cm}$일 때, 이 도형의 넓이를 구하여라. [7점]",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
