  "sourceConditions": [
    {
      "id": "source",
      "condition": "다음 그림은 한 칸의 가로와 세로의 길이가 각각 $1$인 모눈종이 위에 정사각형 $\\mathrm{ABCD}$와 수직선을 그린 것이다. $\\overline{\\mathrm{AB}} = \\overline{\\mathrm{AQ}}$, $\\overline{\\mathrm{AD}} = \\overline{\\mathrm{AP}}$일 때, 점 $\\mathrm{P}$에 대응하는 수를 $a$, 점 $\\mathrm{Q}$에 대응하는 수를 $b$라고 하자. 이때 $2a - 3b$의 값을 구하면? [4점]",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
