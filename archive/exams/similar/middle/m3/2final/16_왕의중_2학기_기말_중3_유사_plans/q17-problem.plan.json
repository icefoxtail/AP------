  "sourceConditions": [
    {
      "id": "source",
      "condition": "$\\square ABCD$가 원에 내접하는 것을 <보기>에서 모두 고른 것은? <보기> (ㄱ) $\\angle BAC = 42^\\circ$, $\\angle BDC = 48^\\circ$ (ㄴ) $\\angle A$의 외각이 $65^\\circ$, $\\angle C$의 외각이 $115^\\circ$ (ㄷ) $\\angle A$의 외각이 $75^\\circ$, $\\angle C$의 외각이 $75^\\circ$ (ㄹ) $\\triangle ABC$에서 $\\angle BAC = 52^\\circ$, $\\angle ACB = 48^\\circ$이고 $\\angle ADC = 100^\\circ$",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
