  "sourceConditions": [
    {
      "id": "source",
      "condition": "$1$부터 $12$까지의 자연수가 각각 하나씩 적힌 $12$등분된 정규 원판이 있다. 이 원판에 다트를 한 번 던질 때, $3$의 배수 또는 $5$의 배수가 적힌 부분을 맞힐 확률은? (단, 다트가 경계선에 꽂히거나 원판을 빗나가는 경우는 없다.) [4점]",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
