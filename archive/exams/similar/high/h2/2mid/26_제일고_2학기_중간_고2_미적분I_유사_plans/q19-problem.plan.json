      "points": [
        { "id": "O", "x": "0", "y": "0" },
        { "id": "P1", "curveX": "2" },
        { "id": "P2", "curveX": "-3/2", "unnamed": true },
        { "id": "Q1", "axis": "y", "value": "5" },
        { "id": "Q2", "axis": "y", "value": "-15/4" }
      ],
      "segments": [
