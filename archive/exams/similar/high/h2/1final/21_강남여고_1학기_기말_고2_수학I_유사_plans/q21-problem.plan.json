  ],
  "sourceConditions": [
    {
      "id": "source",
      "condition": "반지름의 길이가 $3$인 원에 내접하는 두 정삼각형 $\\mathrm{ABC}$와 $\\mathrm{DEF}$가 $\\overline{\\mathrm{EF}} \\parallel \\overline{\\mathrm{BC}}$이고 서로 반대 방향을 향하도록 놓여 있어 두 정삼각형이 겹치는 부분이 정육각형을 이룬다. 원의 내부에서 두 정삼각형의 합집합을 제외한 색칠된 부분의 넓이가 $a\\pi + b\\sqrt{3}$일 때, $a^2 + b^2$의 값은?",
      "mappedTo": "PRESERVED_ARCHIVE_BANK"
    }
  ]
