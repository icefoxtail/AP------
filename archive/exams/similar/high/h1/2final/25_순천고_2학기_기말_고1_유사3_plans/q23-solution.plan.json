    { "id": "kHigh", "condition": "k=5/4에서 오른쪽 가지에 접하는 직선 y=x+5/4, 접점 (5/4,5/2)", "mappedTo": ["panels[1].plan.graphPlan.curves[tangentRight]", "panels[1].plan.graphPlan.overlays.points[TR]", "panels[1].plan.graphPlan.overlays.callouts[tr,line]"] }
