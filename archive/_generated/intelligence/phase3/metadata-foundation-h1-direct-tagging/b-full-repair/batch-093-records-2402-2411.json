  "records": [
    {"recordIndex":2402,"manifestUid":"h1-direct-8ffdb4b74f6f712fd8b3f1090e58a982","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":13,"curriculumKey":"2022","sourceFingerprint":"8c4483d58cfa87e3483e3e4960bfbab90d84804deaeffdc7d27268021ff69426","contentFingerprint":"3bc5012473c3774e6b7a0cf88a96dae5704181819fe03386efab979f3be767f6"},"sourceEvidence":{"content":"두 실수 x,y에 대하여 두 행렬 A=[[2,2],[1,|x|]], B=[[|y|,2],[1,1]]이라 할 때, 집합 X={(x,y)|A^2-B^2=(A+B)(A-B)}가 나타내는 도형의 둘레의 길이는?","choices":["11√2","12√2","13√2","14√2","15√2"],"answer":"②","solutionExcerpt":"행렬에서는 일반적으로 곱셈의 순서를 바꿀 수 없으므로 AB=BA 조건으로 바꾸고, u=|x|, v=|y|에서 u+v=3을 얻어 마름모의 둘레 12√2를 구한다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학1","L1":"행렬","L2":"행렬","L3":"행렬의 성질","L4":"조건을 만족하는 행렬","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"행렬의 성질","secondaryConceptKeys":["행렬의 곱셈","절댓값을 이용한 자취","마름모의 둘레"],"difficultyBucket":4,"status":"B_CHECKED","decisionReason":"행렬곱의 비가환성을 이용해 AB=BA로 환원한 뒤 절댓값 합의 자취와 마름모 둘레를 계산하는 복합 조건 문제."},
    {"recordIndex":2403,"manifestUid":"h1-direct-525f14697f5e466cce629bfb1e7c59c4","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":14,"curriculumKey":"2022","sourceFingerprint":"c58cdf35eb389beaf74093acf5207a2cb4b97d1a3779bcfe57cc76b4178ee84d","contentFingerprint":"855b3806781330778cc152c07572b7110820dcd19ab98b69bea66c790e6364a6"},"sourceEvidence":{"content":"원 x²+y²+6x+4y+3=0 위의 점 (-2,1)에서의 접선이 원 x²+y²-6x+8y+k=0과 접할 때, 실수 k의 값은?","choices":["11","12","13","14","15"],"answer":"⑤","solutionExcerpt":"첫 번째 원의 접선은 x+3y-1=0이고, 두 번째 원의 중심 (3,-4)에서 이 직선까지의 거리가 √10이므로 25-k=10, k=15이다.","image":"","solutionImage":"assets/images/25_매산고_2학기_중간_고1_기출/q14-solution.svg","visualRequired":true},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"도형의 방정식","L2":"원의 방정식","L3":"두 원","L4":"공통현·공통접선 조건","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"두 원","secondaryConceptKeys":["원의 접선","점과 직선 사이의 거리","두 원의 위치 관계"],"difficultyBucket":4,"status":"B_CHECKED","decisionReason":"주어진 원의 접선을 먼저 구하고 다른 원의 중심-직선 거리와 반지름을 같게 하는 두 원의 공통접선 조건 문제."},
    {"recordIndex":2404,"manifestUid":"h1-direct-78a978c017683957b0dc5fbd7c8af258","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":15,"curriculumKey":"2022","sourceFingerprint":"5cc48e2bf2f52d1585cd8a5c6531d0ea8f3aea5bac3e11b0ee4e4401befbaa25","contentFingerprint":"7e0bead8bdfeadd8c1d1d71c1806843f1a9ceaa7c39bab3e1496ca522753fc82"},"sourceEvidence":{"content":"세 직선 x+√3y-2=0, x-√3y+10=0, y=2로 둘러싸인 삼각형의 내심의 좌표를 (a,b)라 할 때, a+b의 값은?","choices":["16-10√3","18-10√3","20-10√3","22-10√3","24-10√3"],"answer":"①","solutionExcerpt":"내심에서 세 변까지의 거리가 같다는 조건으로 두 사선까지의 거리와 y=2까지의 거리를 같게 놓아 b=20-10√3, a=-4, a+b=16-10√3을 얻는다.","image":"","solutionImage":"assets/images/25_매산고_2학기_중간_고1_기출/q15-solution.svg","visualRequired":true},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"도형의 방정식","L2":"직선의 방정식","L3":"점과 직선 사이의 거리","L4":"도형의 넓이·최소거리","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"점과 직선 사이의 거리","secondaryConceptKeys":["삼각형의 내심","직선의 방정식","거리의 절댓값 조건"],"difficultyBucket":4,"status":"B_CHECKED","decisionReason":"삼각형 내심의 등거리 조건을 세 직선의 거리식으로 세워 좌표를 구하는 문제."},
    {"recordIndex":2405,"manifestUid":"h1-direct-ab28098c653a5b5f51e26e4b2e376dfa","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":16,"curriculumKey":"2022","sourceFingerprint":"2ebf0887b64c88f4de89ac8d31efe0e7429af07c5b6a63e290237244329339f0","contentFingerprint":"2d4e63391e2ca4fd0f87aaa06374cd42b371a08e09b0ef6f4eae25d5edb425c6"},"sourceEvidence":{"content":"〈단답형1〉 좌표평면 위의 두 점 (4,-2), (-1,3) 사이의 거리가 a√b일 때, 자연수 a,b에 대하여 a+b의 값을 구하시오.","choices":[],"answer":"$7$","solutionExcerpt":"거리 공식으로 √((-1-4)^2+(3+2)^2)=√50=5√2이므로 a+b=7이다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"도형의 방정식","L2":"평면좌표","L3":"두 점 사이의 거리","L4":"거리 공식","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"두 점 사이의 거리","secondaryConceptKeys":["거리 공식","좌표평면"],"difficultyBucket":2,"status":"B_CHECKED","decisionReason":"두 점의 좌표 차를 거리 공식에 직접 대입하고 근호를 간단히 하는 기본 문제."},
    {"recordIndex":2406,"manifestUid":"h1-direct-43b0e326c4eca737caaf1a7ac599d5a2","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":17,"curriculumKey":"2022","sourceFingerprint":"7f3259f6c14fdf9dcadf01a8fe3d8c74ac70abb4e36aec00901e635aa5e2a660","contentFingerprint":"f35f69cb7ac180f283584cf0248bf0cec10a181446378d85c04e57b8a4a85fb5"},"sourceEvidence":{"content":"〈단답형2〉 2 이상 20 이하의 소수 전체의 집합 U의 부분집합 X에 3이 포함되고 S(X)가 5보다 큰 소수일 때 S(X)의 최솟값을 구하시오.","choices":[],"answer":"$17$","solutionExcerpt":"U={2,3,5,7,11,13,17,19}이고 3을 포함하면서 5보다 큰 소수가 되는 최소 합을 조사하면 X={2,3,5,7}에서 S(X)=17이다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"집합과 명제","L2":"집합의 연산","L3":"교집합과 합집합","L4":"원소 개수","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"집합과 명제","secondaryConceptKeys":["부분집합","소수의 성질","최솟값"],"difficultyBucket":3,"status":"B_CHECKED","decisionReason":"소수 집합의 부분집합 조건과 합의 소수 조건을 함께 만족하도록 작은 경우를 배제하고 최솟값을 찾는 문제."},
    {"recordIndex":2407,"manifestUid":"h1-direct-7957e9829210491ccb5877ee6b0201cc","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":18,"curriculumKey":"2022","sourceFingerprint":"09db66398d8cfaff24e1eb57c6b47ab84eada82fc0f811c3afc5c9b55b9685ef","contentFingerprint":"c6b316ca9ccbc17e15fd910b8d4f15a8ccb8f850667dfca9638e1eafeeec9ace"},"sourceEvidence":{"content":"〈단답형3〉 제1사분면의 A와 y축 위의 O가 아닌 B에 대해 AB=AO=2√5이다. A를 y=x에 대칭이동한 C가 y=2x 위에 있고 AB와 y=x,y=2x의 교점 D,E에 대해 삼각형 ODE의 외접원 넓이를 kπ라 할 때 36k를 구하시오.","choices":[],"answer":"$128$","solutionExcerpt":"대칭 조건과 AO=2√5로 A=(4,2), AB=2√5 및 B≠O로 B=(0,4)를 정하고 D=(8/3,8/3), E=(8/5,16/5)를 구한 뒤 외접원 반지름 제곱 k=32/9, 36k=128이다.","image":"","solutionImage":"assets/images/25_매산고_2학기_중간_고1_기출/q18-solution.svg","visualRequired":true},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"도형의 방정식","L2":"평면좌표","L3":"삼각형의 무게중심","L4":"좌표 도형 활용","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"좌표 도형 활용","secondaryConceptKeys":["대칭이동","직선의 방정식","외접원"],"difficultyBucket":5,"status":"B_CHECKED","decisionReason":"대칭, 거리, 직선 교점, 원의 방정식을 연쇄적으로 적용하는 다단계 좌표기하 문제."},
    {"recordIndex":2408,"manifestUid":"h1-direct-ff51a2636a1561475524c76c1c309951","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":19,"curriculumKey":"2022","sourceFingerprint":"02ae39ecbfba2b3b28fb9284f8cc7bef1c867308a4df784e4da65983b796c118","contentFingerprint":"b7b3ab860b26a15c38780bdd9fde2e29c4cd1cdd19e768e3a3b4659e906ec971"},"sourceEvidence":{"content":"〈서술형1〉 f(x)=x²-7x+20, A={x|f(x)-x-b=0}, B={x|f(x)+x-c=0}, A,B가 공집합이 아니고 n(A∪B)=2일 때 bc의 최댓값과 최솟값을 구하시오.","choices":[],"answer":"최댓값 55, 최솟값 44","solutionExcerpt":"A는 x²-8x+20-b=0, B는 x²-6x+20-c=0이다. 각 집합이 한 원소 또는 두 원소인 경우를 나누어 n(A∪B)=2를 조사하면 bc는 44,48,55이고 최댓값 55, 최솟값 44이다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학1","L1":"방정식과 부등식","L2":"이차방정식","L3":"근과 계수의 관계","L4":"근의 합·곱","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"근과 계수의 관계","secondaryConceptKeys":["이차방정식의 근","판별식","집합의 합집합","최댓값·최솟값"],"difficultyBucket":5,"status":"B_CHECKED","decisionReason":"두 이차방정식의 실근 집합의 원소 수와 합집합 조건을 경우 분류하고 근과 계수로 bc의 극값을 비교하는 서술형 문제."},
    {"recordIndex":2409,"manifestUid":"h1-direct-3b9da4e442cc5a3b0efc7812c0bfa4c8","source":{"sourceArchiveFile":"original/high/h1/2mid/25_매산고_2학기_중간_고1_기출.js","sourceOrdinal":20,"curriculumKey":"2022","sourceFingerprint":"6e3a04bcb7642a47ca25e1624f7b00198cb6c6c73766cfaa54556f5ca19652e9","contentFingerprint":"f7cd4a4b7b05b9a68d7ef049415ce0c9b78b7cc2e5e88bf896cc2a21b7082e5c"},"sourceEvidence":{"content":"〈서술형2〉 제1사분면에서 서로 다른 원 C1,C2가 직선 l:5x+12y-6=0과 x축,y축에 동시에 접한다. 두 원의 접점 P1,P2와 중심 M1,M2로 사각형 M1P1M2P2의 넓이를 구하시오.","choices":[],"answer":"$119/200$","solutionExcerpt":"중심을 (r,r)로 두고 |17r-6|=13r에서 r=1/5,3/2를 얻은 뒤 각 중심에서 l에 내린 수선의 발 P1,P2를 구하고 좌표 넓이 공식으로 119/200을 계산한다.","image":"","solutionImage":"assets/images/25_매산고_2학기_중간_고1_기출/q20-solution.svg","visualRequired":true},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"도형의 방정식","L2":"원의 방정식","L3":"두 원","L4":"공통현·공통접선 조건","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"공통현·공통접선 조건","secondaryConceptKeys":["원의 방정식","점과 직선 사이의 거리","좌표 넓이"],"difficultyBucket":5,"status":"B_CHECKED","decisionReason":"두 축과 한 직선에 동시에 접하는 두 원의 반지름을 분기해 구하고 접점 좌표와 사각형 넓이까지 연쇄 계산하는 고부담 문제."},
    {"recordIndex":2410,"manifestUid":"h1-direct-06c4ccd262e51806e2cbd6dc843b7068","source":{"sourceArchiveFile":"original/high/h1/2mid/25_순천고_2학기_중간_고1_기출.js","sourceOrdinal":1,"curriculumKey":"2022","sourceFingerprint":"cede886bde57d0d8f226f4ddb7939a0983a770ea00cc6d4766ec65e16cc09e4a","contentFingerprint":"32ef9424a0387cafd7db984ec92a4b3dcfa75aeba7b62a2fa23acc115dd414c0"},"sourceEvidence":{"content":"집합 A를 15의 약수 전체의 집합이라 할 때, 집합 A의 원소의 개수는?","choices":["2","3","4","5","6"],"answer":"③","solutionExcerpt":"15=3×5의 양의 약수는 1,3,5,15 네 개이므로 n(A)=4이다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"집합과 명제","L2":"집합의 뜻과 포함 관계","L3":"집합과 원소","L4":"유한집합 원소 개수","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"유한집합 원소 개수","secondaryConceptKeys":["소인수분해","약수의 개수"],"difficultyBucket":1,"status":"B_CHECKED","decisionReason":"15의 소인수분해를 통해 양의 약수를 직접 열거하는 단일 개념 기초 문제."},
    {"recordIndex":2411,"manifestUid":"h1-direct-e6181ac52dd831df2af9cb34a7324071","source":{"sourceArchiveFile":"original/high/h1/2mid/25_순천고_2학기_중간_고1_기출.js","sourceOrdinal":2,"curriculumKey":"2022","sourceFingerprint":"c563e0faaee7e986c8b23113d3a8b8867ada16ed7b7385770038b86e61bf22b4","contentFingerprint":"6f796d1cec08acea60840cc42ba39662d0ad5f5eb6928ab46049825f247544f1"},"sourceEvidence":{"content":"집합 {a,b,c}의 부분집합이 아닌 것은?","choices":["∅","{∅}","{a}","{b,c}","{a,b,c}"],"answer":"②","solutionExcerpt":"∅,{a},{b,c},{a,b,c}는 부분집합이지만 {∅}은 공집합을 원소로 가진 집합이므로 {a,b,c}의 부분집합이 아니다.","image":"","solutionImage":"","visualRequired":false},"canonical":{"curriculumKey":"2022","scope":"공통수학2","L1":"집합과 명제","L2":"집합의 뜻과 포함 관계","L3":"부분집합","L4":"부분집합 판정","curriculumApplicability":"DEFAULT_SCOPE","defaultSelectable":true},"primaryConcept":"부분집합","secondaryConceptKeys":["집합과 원소","원소와 부분집합 구별"],"difficultyBucket":1,"status":"B_CHECKED","decisionReason":"원소 기호와 부분집합 기호의 구별을 직접 판정하는 기본 개념 문제."}
