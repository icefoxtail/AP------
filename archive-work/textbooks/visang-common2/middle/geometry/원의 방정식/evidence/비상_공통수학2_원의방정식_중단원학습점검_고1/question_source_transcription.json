      "questionCrop": "C:\\Users\\USER\\.codex\\worktrees\\visang-circle-equation\\AP------\\archive-work\\textbooks\\visang-common2\\middle\\geometry\\원의 방정식\\evidence\\비상_공통수학2_원의방정식_중단원학습점검_고1\\question_crops\\q01.png"
