        "$4$",
        "$5$",
        "$6$"
      ],
      "contentSha256": "sha256:e881d62777ddd6748df5ac2d0a2db302d8ee18cbc0de67027c04d135978b5463",
      "choicesSha256": "sha256:d601fd23445f2769d635c0f649aaf6d04b385a7d56c029a78b68ab105d958e27"
