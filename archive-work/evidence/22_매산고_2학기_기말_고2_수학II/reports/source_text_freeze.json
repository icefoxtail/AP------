        "$102$",
        "$103$",
        "$104$"
      ],
      "contentSha256": "sha256:fca290698f37dbb68bb5353e76796219be776770b4d1394eaa1810ace328b1c0",
      "choicesSha256": "sha256:6cb38bbb60155454a5a8d9097aa286dd17f51902f24485ad476a71ad7d3ab8e9"
    },
