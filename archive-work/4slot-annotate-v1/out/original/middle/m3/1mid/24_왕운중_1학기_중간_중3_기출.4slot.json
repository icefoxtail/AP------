{"sourceOrdinal":4,"format":"단일 정답","slots":{"given":[{"term":"제곱근","src":"stem","quote":"$\\sqrt{10^{2}}"},{"term":"거듭제곱","src":"stem","quote":"(-\\sqrt{2})^{2}$"}],"goal":[{"term":"식의값","src":"stem","quote":"의 값을 구하면?"}],"method":[{"term":"절댓값","src":"solution","quote":"$\\sqrt{10^2}=|10|=10$","evidenceType":"NAMED"},{"term":"거듭제곱","src":"solution","quote":"$(-\\sqrt2)^2=2$","evidenceType":"IMPLIED","justification":"음의 제곱근을 제곱한다."}],"condition":[]},"reasons":{"method":"제곱의 제곱근은 절댓값으로, 음의 제곱근의 제곱은 양수로 계산한다."},"steps":[],"scenarioNote":""},
{"sourceOrdinal":5,"format":"단일 정답","slots":{"given":[{"term":"속도","src":"stem","quote":"속력 $v\\,m/s$는"},{"term":"제곱근","src":"stem","quote":"$v = \\sqrt{2 \\times 9.8 \\times h}$"}],"goal":[{"term":"개수","src":"stem","quote":"$h$의 값은 모두 몇 개인가?"}],"method":[{"term":"서로소","src":"solution","quote":"$5$와 $98$은 서로소이므로","evidenceType":"NAMED"},{"term":"배수","src":"solution","quote":"$v$는 $14$의 배수이다","evidenceType":"NAMED"},{"term":"대입","src":"solution","quote":"$v=14k$라 두면","evidenceType":"IMPLIED","justification":"속력을 14의 배수로 두고 높이를 표현한다."},{"term":"범위","src":"solution","quote":"$10\\le k^2<100$","evidenceType":"IMPLIED","justification":"높이의 자릿수 범위에서 정수 k의 범위를 구한다."}],"condition":[{"term":"자연수","src":"stem","quote":"자연수가 되도록 하는 세 자리 자연수"},{"term":"자릿수","src":"stem","quote":"세 자리 자연수 $h$"}]},"reasons":{"method":"제곱해 나눗셈 조건으로 속력의 배수성을 얻고 높이의 세 자리 범위에서 가능한 정수 k를 센다."},"steps":[],"scenarioNote":"진공 낙하 속력"},
{"sourceOrdinal":6,"format":"옳은 것 고르기","slots":{"given":[{"term":"유리수","src":"choices","quote":"유리수이면서 동시에 무리수가"},{"term":"무리수","src":"choices","quote":"유리수이면서 동시에 무리수가"},{"term":"무한소수","src":"choices","quote":"무한소수는 무리수이다"}],"goal":[{"term":"판정","src":"stem","quote":"설명 중 옳은 것을 고르면?"}],"method":[{"term":"정의","src":"solution","quote":"유리수와 무리수의 정의를 이용해","evidenceType":"NAMED"},{"term":"귀류법","src":"solution","quote":"두 유리수의 차가 무리수가 되는 모순","evidenceType":"IMPLIED","justification":"유리수와 무리수의 합이 유리수라 가정해 모순을 얻는다."}],"condition":[]},"reasons":{"method":"수의 분류와 순환소수의 성질을 쓰고 유리수와 무리수의 합은 귀류법으로 판별한다."},"steps":[],"scenarioNote":""},
{"sourceOrdinal":7,"format":"옳은 것 고르기","slots":{"given":[{"term":"정삼각형","src":"choices","quote":"한 변의 길이가 4인 정삼각형"},{"term":"정사각형","src":"choices","quote":"넓이가 25인 정사각형"},{"term":"순환소수","src":"choices","quote":"순환소수 $1.7\\dot{8}$"},{"term":"원","src":"choices","quote":"반지름의 길이가 2인 바퀴"}],"goal":[{"term":"무리수","src":"stem","quote":"무리수를 모두 고르면?"}],"method":[{"term":"피타고라스정리","src":"solution","quote":"정삼각형의 높이는 $2\\sqrt3$","evidenceType":"IMPLIED","justification":"정삼각형의 높이와 대각선 길이를 직각삼각형으로 구한다."},{"term":"원주","src":"solution","quote":"$2(2\\pi\\cdot2)=8\\pi$","evidenceType":"IMPLIED","justification":"원주에 회전 수를 곱한다."},{"term":"유리수","src":"solution","quote":"순환소수는 유리수이다","evidenceType":"NAMED"}],"condition":[]},"reasons":{"method":"각 길이와 이동 거리를 구하고 순환소수와 무리수 여부를 판정한다."},"steps":[],"scenarioNote":"바퀴 회전 거리"},
