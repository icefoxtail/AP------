{"sourceOrdinal":17,"format":"단일 정답","slots":{"given":[{"term":"완전제곱식","src":"stem","quote":"$(-2a-b)^{2}$"}],"goal":[{"term":"다항식","src":"stem","quote":"전개하면?"}],"method":[{"term":"곱셈공식","src":"solution","quote":"$(2a+b)^2=4a^2+4ab+b^2$","evidenceType":"NAMED"}],"condition":[]},"reasons":{"method":"전체 부호를 제곱으로 없앤 다음 합의 제곱 곱셈공식을 적용한다. 결정적 방법은 곱셈공식 하나다."},"steps":[],"scenarioNote":""},
