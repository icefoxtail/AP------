        "$7$",
        "$8$",
        "$9$",
        "$10$"
      ],
      "choicesSha256": "sha256:fc3dba98889cccd1a96f32fb71f7812a2d3b9dde603c59a1f87b932df48e085f",
      "contentChecked": true,
      "choicesChecked": true,
      "answerOrSolutionViewed": false
