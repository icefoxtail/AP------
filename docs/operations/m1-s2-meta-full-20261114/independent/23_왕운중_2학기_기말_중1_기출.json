  "items": [
    {
      "ordinal": 9,
      "questionUid": "qid_v1_ef76d7b13f398968f2b56d513b8fef8637e85244340394284f429d015f6a5e84",
      "meaning": "원탁의 일곱 위치에서 자기와 양옆의 두 이웃을 제외한 쌍을 세고, 양쪽에서 센 중복을 제거한다.",
      "nativeVerdict": "ACCEPT_ACTIVE_DIAGONAL_FORMULA_REUSE_WITH_DEFINITION_NORMALIZATION",
      "rpmVerdict": "ACCEPT_2015_RPM085",
      "reason": "고정된 원형 위치의 비인접 두 대상과 다각형의 대각선은 일대일이다. n−3 상대를 세어 n을 곱하고 2로 나누는 결정 구조가 같으므로 기존 대각선 TPL을 재사용한다. 현 PT/TPL 정의의 특정 각 총합 예시는 일반화 제안으로 분리한 것이 타당하다.",
      "difficulty": {
        "level": "중",
        "beforeBucket": 3,
        "recommendedBucket": 2,
        "boundary": "B23",
        "compatibility": "NORMAL",
        "reason": "비인접 조건을 한 번 해석하면 각 위치의 n−3 상대와 중복 제거가 바로 정해진다. 원순열 또는 경우별 배치를 선택하는 문제가 아니므로 표준 초입2를 지지한다."
      },
      "integrationVerdict": "ACCEPT_EMPTY_CC_CONDITION_AND_NONE",
      "fourSlotVerdict": "ACCEPT",
      "slotEvidence": {
        "given": [
          "원",
          "집단"
        ],
        "goal": [
          "개수"
        ],
        "method": [
          "제외",
          "중복계수",
          "개수"
        ],
        "condition": [
          "이웃하지않음",
          "중복불허"
        ],
        "note": "수학적 구조를 소재와 구분했고 양옆 제외 및 한 번씩이라는 두 제한을 모두 직접 인용했다."
      }
    },
    {
      "ordinal": 19,
      "questionUid": "qid_v1_e7b718646f90d2751ab52ea23cb4309dc2a635a823280196474fb2fc0a408e33",
      "meaning": "꼭 맞게 쌓인 세 구를 같은 반지름 r과 원기둥 높이6r로 나타내어 주어진 원기둥 부피에서 r의 세제곱을 정한 뒤 한 구의 부피에 전달한다.",
      "nativeVerdict": "ACCEPT_EXISTING_SPHERE_IN_CYLINDER_CONSTRAINT_WITH_TARGET_GENERALIZATION",
      "rpmVerdict": "ACCEPT_2015_RPM105_WITH_EXACT_NATIVE_BRIDGE_DEBT",
      "reason": "현재 TPL의 배치→공통반지름/높이→원기둥 부피 제약은 그대로이고 마지막 구의 측정량만 겉넓이에서 부피로 달라진다. 정의 일반화가 새TPL보다 타당하다. 물을 옮기거나 녹이지 않으므로 부피보존으로 분류하지 않는다.",
      "difficulty": {
        "level": "중",
        "recommendedBucket": 2,
        "boundary": "B23",
        "compatibility": "NORMAL",
        "reason": "세 지름=높이를 한 번 해석하면 주어진 원기둥 부피로 공통 r³을 구하고 구의 부피에 바로 대입하는 고정 흐름이다. 빈 공간 표본(25신흥Q12·23금당Q19)의 전체와 제외 입체를 별도로 구성하는 부피차 목표와 구별한다. B23 경계에서 현재2를 허용하며 계산식의 길이만으로 올리지 않는다."
      },
      "integrationVerdict": "ACCEPT_NONE_PRIMARY_INTERNAL_CONSTRAINT",
      "fourSlotVerdict": "ACCEPT",
      "slotEvidence": {
        "given": [
          "원기둥",
          "구"
        ],
        "goal": [
          "부피",
          "구"
        ],
        "method": [
          "지름",
          "부피"
        ],
        "condition": [
          "내접"
        ],
        "note": "지름합으로 높이를 정하는 단계와 부피식의 r³ 전달을 IMPLIED 근거가 덮는다. 꼭 맞는 배치를 내접 조건으로 기록한 의미가 원그림과 일치한다."
      }
    },
    {
      "ordinal": 24,
      "questionUid": "qid_v1_1a334d6bafecbbd4767ca4d179bcc60afa59f9cc7a17a9376dd4036c81a23ee5",
      "meaning": "사다리꼴 회전으로 생긴 원뿔대의 고리 부채꼴 전개도를 구성하고 두 호-밑면 원주의 대응으로 중심각과 전체 겉넓이를 구한다.",
      "nativeVerdict": "ACCEPT_NET_MEASURE_REUSE_WITH_CONICAL_FRUSTUM_DEFINITION_GENERALIZATION",
      "rpmVerdict": "ACCEPT_2015_RPM106",
      "reason": "원뿔을 잘라낸 입체의 전개도이며 호와 밑면 원주의 대응이라는 NET_MEASURE의 결정 구조를 두 동심 호로 적용한다. 각뿔대의 사다리꼴 옆면을 합하는 FRUSTUM_SURFACE와 구별한 제안이 타당하다.",
      "difficulty": {
        "level": "상",
        "beforeBucket": 3,
        "recommendedBucket": 4,
        "boundary": "B34",
        "compatibility": "NORMAL",
        "reason": "회전체를 식별한 뒤 평면의 고리 부채꼴로 다시 표현하고 호-원주 대응, 중심각 및 두 밑면의 합을 구조화해야 한다. 원그림에 작은 모선5와 큰 부분10이 주어지므로 닮음 추론을 추가로 요구하지는 않으며 B34 경계의4를 지지한다."
      },
      "integrationVerdict": "ACCEPT_CC_SOLID_OF_REVOLUTION_AND_SEQUENTIAL",
      "fourSlotVerdict": "ACCEPTED_AFTER_HO_METHOD_COMPLETION",
      "slotEvidence": {
        "given": [
          "사다리꼴"
        ],
        "goal": [
          "판정",
          "전개도",
          "겉넓이",
          "입체도형"
        ],
        "method": [
          "원뿔대",
          "비례식",
          "전개도",
          "겉넓이"
        ],
        "condition": [
          "축"
        ],
        "note": "현재 구조는 대체로 충분하다. 전개도 검색에서 핵심인 호-밑면 원주 대응을 구체적으로 남기기 위해 method 호를 직접 인용으로 보강한다."
      },
      "minorChanges": [
        {
          "slot": "method",
          "term": "호",
          "src": "solution",
          "quote": "큰 부채꼴의 호의 길이는 큰 밑면의 둘레",
