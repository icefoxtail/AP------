  "items": [
    {
      "ordinal": 15,
      "questionUid": "qid_v1_4877ea99dc183fe96916a71d6f790f3696d78b19d4218f08c7446b9a7d97552b",
      "meaning": "접는 선을 반사된 두 선 사이 각의 이등분선으로 읽고 직사각형 직각과 주어진 두 각을 목표각으로 옮긴다.",
      "nativeVerdict": "ACCEPT_GLOBAL_FOLDING_CORE_EXACT_REUSE",
      "rpmVerdict": "ACCEPT_FOLDING_LEAF_GAP_WITH_ORIGINAL_BASIC_PARENT",
      "reason": "정식 CORE의 정의·내부골격과 두 접기/각 이동 구조가 직접 맞는다. PT 정의 owner GEOMETRY_EQUATIONS와 binding owner MIDDLE1의 차이는 유효성 오류가 아니며 정확한2015 M1-05/BASIC binding이 실제 존재한다. 현 PT 정의에서 각 목표를 누락한 문장은 일반화 부채로 분리한다.",
      "difficulty": {
        "level": "상",
        "beforeBucket": 4,
        "recommendedBucket": 3,
        "boundary": "B34",
        "compatibility": "BORDERLINE_ACCEPTABLE",
        "status": "AUTHOR_ACCEPTED_INDEPENDENT_CORRECTION",
        "reason": "기존 해설과 CORE의 결정 흐름은 접기 각이등분과 직각·삼각형 각 이동의 표준 연쇄이다. 접는 선과 대상 선분이 주어져 있으며 새 보조선·가능성 분기·역조건을 선택하는 부담은 없다. 한 번의 접기보다 연결이 길어3이 맞으며, 두 접는 선이라는 표면 요소만으로4를 유지하지 않고 B34에서 저자와 대조한다."
      },
      "integrationVerdict": "ACCEPT_EMPTY_CC_AND_NONE_PRIMARY_INTERNAL_FOLDING",
      "fourSlotVerdict": "ACCEPTED_AFTER_EXPLICIT_CONDITION_COMPLETION",
      "minorChanges": [
        {
          "slot": "condition",
          "term": "각",
          "src": "stem",
          "quote": "$\\angle CGE=50^{\\circ}$, $\\angle DCF=18^{\\circ}$",
          "reason": "두 주어진 각의 제한을 함께 직접 결속한다."
        }
      ]
    },
    {
      "ordinal": 17,
      "questionUid": "qid_v1_46d0970904703919890161fa773121f2ece793c8039f23a6a7457eb0ea0d8069",
      "meaning": "각 보기의 변·각 자료가 존재성과 유일성을 만족하는지 ASA·SSS·SSA·세각 자료에 대조하여 유일한 삼각형 자료를 고른다.",
      "nativeVerdict": "ACCEPT_UNIQUE_TRIANGLE_DATA_EXACT_REUSE",
      "rpmVerdict": "ACCEPT_MIXED_UNIQUENESS_LEAF_GAP",
      "reason": "현 PT는 존재성과 유일조건을 함께 비교하고 현 TPL은 실제 SSA/ASA/SSS/세각의 대조를 명시한다. 하나의 특정 합동조건 leaf로 축소하지 않은 것이 적절하다.",
      "difficulty": {
        "level": "중",
        "beforeBucket": 4,
        "recommendedBucket": 2,
        "boundary": "B23",
        "compatibility": "NORMAL",
        "reason": "한 변과 양 끝각이라는 표준 자료를 알아보고 등식인 세변 및 세각만의 자료를 배제하는 익숙한 확인이다. 실제 경우를 여러 갈래 생성해 풀도록 요구하지 않으므로4→2를 지지한다."
      },
      "integrationVerdict": "ACCEPT_NONE_EXISTENCE_AND_UNIQUENESS_ARE_PRIMARY_INTERNAL",
      "fourSlotVerdict": "ACCEPTED_AFTER_EXPLICIT_CONDITION_COMPLETION",
      "slotEvidence": {
        "goal": [
          "삼각형",
          "유일성"
        ],
        "method": [
          "합동조건",
          "삼각형의세변조건",
          "끼인각",
          "삼각형"
        ],
        "candidateParent": "삼각형의세변조건은 공식id76과 구분해 후보로 선언하고 같은 method에 사전 부모 삼각형을 병기함.",
        "condition": "보기마다 주어진 자료를 비교하는 형식이므로 전체 발문의 별도 제한을 만들지 않는다."
      }
    },
    {
      "ordinal": 24,
      "questionUid": "qid_v1_f1bd6587483700dbf5fbda6b6f4a67b9720041a49332e37e9e536248a1cc6f7c",
      "meaning": "ASA로 두 삼각형을 대응시켜 AD=EC를 얻고 이미 주어진 BE=10을 사다리꼴의 두 밑변합으로 바꾸어 넓이를 구한다.",
      "nativeVerdict": "ACCEPT_TRAPEZOID_AREA_EXACT_REUSE",
      "rpmVerdict": "ACCEPT_CONGRUENCE_TO_TRAPEZOID_AREA_LEAF_GAP",
      "reason": "현 PT/TPL이 연장선의 점·교점·같은 선분으로 합동을 만든 뒤 밑변합을 복원하는 이 골격을 정확하게 정의한다. 최종 목표 넓이가 있는 소문항 묶음을 ASA 이름만으로 분류하지 않고 목적을 따르는 것이 맞다.",
      "difficulty": {
        "level": "상",
        "beforeBucket": 4,
        "recommendedBucket": 3,
        "boundary": "B34",
        "compatibility": "BORDERLINE_ACCEPTABLE",
        "status": "AUTHOR_ACCEPTED_INDEPENDENT_CORRECTION",
        "reason": "원그림(1)이 합동인 삼각형과 합동조건을 직접 요구해 풀이 접근을 안내한다. 대응변AD=EC를 BC+EC에 한 번 치환한 뒤 넓이공식으로 이어지는 표준 연결이며 새 보조선이나 비정형 재구성은 없다. 독립 검토에서는3/B34를 제안하며 현재4와의 경계 판단을 저자에게 요청했다."
      },
      "integrationVerdict": "ACCEPT_NONE_CONGRUENCE_TRANSFER_INCLUDED_IN_PRIMARY",
      "fourSlotVerdict": "ACCEPTED_AFTER_EXPLICIT_CONDITION_COMPLETION",
      "slotEvidence": {
        "goal": [
          "합동",
          "합동조건",
          "사다리꼴",
          "넓이"
        ],
        "method": [
          "맞꼭지각",
          "엇각",
          "합동조건",
          "대응변",
          "사다리꼴"
        ],
        "note": "소문항이 원그림에 인쇄되어 있어 실제 원그림을 읽었고 4칸에는 기존 해설의 직접 인용으로 결속하였다."
      },
