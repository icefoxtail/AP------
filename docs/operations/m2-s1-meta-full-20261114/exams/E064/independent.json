  "samples": [
    {
      "sourceOrdinal": 5,
      "classification": "수직평행이동으로 상수항을 바꾼 뒤 두절편 조건으로 기울기와 절편합을 구한다. 정확 RPM 수직이동 leafgap을 수용하며 단순 평행/일치 leaf를 강제하지 않음.",
      "binding": "실제 ACTIVE TT_LINE_TRANSLATION_EQUATION과 PT_MOVE_LINE_TRANSLATION 정의를 읽었다. 이동식 생성과 점·계수조건은 후보정의와 대응하지만 scoped binding/genuine resolver 등록은 미확정.",
      "crossConcept": "절편읽기와 점대입은 실제 이 TPL의 내부절차라 별도 CC 중복 없음.",
      "condition": "y축−9 평행이동이라는 실제 조작조건을 4칸 condition에 보존하고 별도 해제한을 추가하지 않음.",
      "integration": "한 이동계수목표의 내부 과정으로 NONE.",
      "difficulty": "독립2/B23와 저자2 일치. 이동뒤 절편대입의 정형연계로 현재숫자 수용.",
      "fourSlot": "함수와 두절편 given, 매개변수합goal, 실제 이동/대입 NAMED와 y축이동condition literal 확인."
    },
    {
      "sourceOrdinal": 13,
      "classification": "정점을 지나는 직선이 주어진 선분과 만나는 기울기구간. 교점좌표 하나를 구하는 RPM leaf를 강제하지 않고 exactleafgap 수용.",
      "binding": "실제 ACTIVE TPL_INTERSECTION_SEGMENT_RANGE 및 PT_LINE_INTERSECTION_CONDITION 정의의 양끝 경계직선으로 매개구간 결정이 직접대응한다. 공식target등록은 유보.",
      "crossConcept": "두끝점 대입과 경계기울기 선택은 이 primary 내부 과정으로 중복 CC 없음.",
      "condition": "선분AB와 만난다는 실제 제한을 보존. 목표인 매개범위를 입력제약으로 되넣지 않음.",
      "integration": "단일 경계선분범위 전략 내부로 NONE.",
      "difficulty": "독립3/B23와 저자2/B23 인접차이. 발문에 선분과 정점형 직선이 명시되어 양끝 경계기울기를 대입하는 정형구조로 저자2 수용.",
      "fourSlot": "직선/두점 given, 매개변수범위goal, 실제 기울기 NAMED 및 끝점대입 IMPLIED+설명, 선분condition을 확인."
    },
    {
      "sourceOrdinal": 22,
      "classification": "2022 RPM155 특수해 상태의 계수조건. 해없음으로 계수비를 정한 뒤 별도점 통과로 남은계수를 얻는다.",
      "binding": "실제 RPM155와 ACTIVE FIND_PARAMETER_FOR_NO_SOLUTION_SYSTEM 및 부모를 읽었다. 계수비같음·상수비다름과 추가점통과의 확장을 구별했다.",
      "crossConcept": "ACTIVE CC_POINT_SUBSTITUTION 실제정의는 그래프위 점의 x,y를 식에 넣어 등식 성립시키는 것. 무해조건에서 남은 b를 추가점으로 정하므로 외부CC 수용.",
      "condition": "해없음과 점(4,3)통과를 실제 conditionliteral로 보존. 해설의 b≠4는 도출사실이며 새 입력범위로 넣지 않음.",
      "integration": "무해비로a결정→추가점대입b→비율의 SEQUENTIAL.",
      "difficulty": "독립2/B23와 저자2/B23 일치. 특수해 계수비와 추가점대입의 익숙한 두단계.",
      "fourSlot": "연립일차식/점 given, 계수비율goal, 실제비율공식/대입 NAMED와 무해·점통과 condition을 확인. 비율식 분모3/−2/2는 실제 비영상수다."
    }
  ],
