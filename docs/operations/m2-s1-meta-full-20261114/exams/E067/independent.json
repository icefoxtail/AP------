  "samples": [
    {
      "sourceOrdinal": 6,
      "classification": "2022 RPM165 일차함수 판별의 source-only 구조제안. 실제 다섯 문장보기를 전부 읽어 일차성 판정범위로 명시했다.",
      "binding": "실제 RPM165와 ACTIVE COUNT_VALID_FUNCTIONS_AND_LINEAR_FUNCTIONS 및 부모를 읽었다. 함수/일차함수 개수합 후보와 현재 아닌것 하나선택의 목표차이를 related로 보존.",
      "crossConcept": "원판본의 다섯상황 난도범위와 결정적③ CC만의 불일치를 root질문에 따라 확인. r2에서 실제② 속력시간거리·③ 정사각형넓이·④ 둘레를 각각 실제ACTIVE정의와 연결하여 세CC를 수용. 기초가격산술을 새CC로 만들지 않음.",
      "condition": "원문보기의 수량과 평가범위를 보존하며 새로운 수범위는 추가하지 않았다.",
      "integration": "각 상황관계의 외부개념 입력→일차성 정의판정의 SEQUENTIAL. 서로 다른 답의 경우분기가 아니며 source-only 가설이다.",
      "difficulty": "독립2/B12/low와 저자2/B12/low 일치. 전보기 관계의 정형모델과 정의판정.",
      "fourSlot": "r2②④ 실제선택지 literal과 정사각형/넓이 given, 일차함수goal을 확인. 기존해설이 없어 method[]와 native부채를 그대로 유지."
    },
    {
      "sourceOrdinal": 17,
      "classification": "표시된 교점좌표를 연립방정식의 공통해로 읽어 계수합을 제안하는2022 RPM150. actualsolution에 의해 확인된 방법이 아닌 source-only 구조제안.",
      "binding": "실제 RPM150 주어진해 L1~4를 읽었다. 정확PT/TPL scoped binding/genuine resolver는 미등록.",
      "crossConcept": "표시좌표를 주어진해로 읽는 입력변환은 현 기본계수목표 내부이며 별도CC없음.",
      "condition": "교점 좌표표시는 actual image로 확인. 도식 증가직선의 양의x절편과 x-by=-5의 음의x절편 요구가 충돌하여 원문부채 유지.",
      "integration": "표시해에서 계수를 구하는 기본구조의 NONE은 조건부이며 verified풀이아님.",
      "difficulty": "독립2/B23와 저자2/B12의 같은조건부수치. 전체그래프 일관성은 회복되지 않았으므로 low 유지.",
      "fourSlot": "연립일차식과 좌표given, 매개계수합goal, source그림 SHA 확인. method[]와 도식 evidenceDebt를 보존."
    },
    {
      "sourceOrdinal": 22,
      "classification": "2022 RPM174 교점과 연립방정식. 실제거리시간그림에서 지연출발과 두직선식, 만나는시각의 명시된 다단계목표를 source-only로 제안.",
      "binding": "실제 ACTIVE motion-graph descriptive TPL와 부모를 읽었다. 두점→직선식→만남시각 골격과 현목표가 대응하나 추가출발시각/두식 목표를 명시하고 genuine등록은 유보.",
      "crossConcept": "거리시간그래프의 두직선식과 교점은 후보primary 자체의 내부 골격이라 중복CC 없음.",
      "condition": "실제그림에서 출발지연과 거리눈금을 확인했고 새 속력/수범위를 원문에 추가하지 않음.",
      "integration": "교점모델 내부의 연속목표로 NONE; 실제기존해설이 아니라 구조가설임을 보존.",
      "difficulty": "독립2/B23/low와 저자2/B23/low 일치. 발문이 단계순서를 제공하는 정형그림모델.",
      "fourSlot": "그래프·거리·경과시간given과 두직선방정식/경과시간goal을 확인. 시간후보는 같은slot값131과 결속. method[] 유지."
    }
  ],
