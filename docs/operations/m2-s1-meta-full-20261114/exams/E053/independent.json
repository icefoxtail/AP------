  "samples": [
    {
      "sourceOrdinal": 10,
      "classification": "실제 삼각기둥의 밑넓이·부피에서 높이를 역산하는 M1-RPM-213 각기둥 경로를 정본에서 확인했다. M1선수경로와 중2 단항식계산 target을 분리한 제안 수용.",
      "binding": "ACTIVE M1 standardmeasure 정의는 수치대입이며 실제문자식 높이역산의 target scoped binding은 미확정으로 남긴다.",
      "crossConcept": "ACTIVE CC_MONOMIAL_DIVISION 정의와 xyh=60x²y에서 몫을 취하는 실제기존해설을 대조했다.",
      "condition": "문자길이와 부피는 주어진 입력이다. 본문에 없는 부호조건을 추가하지 않는다.",
      "integration": "삼각형밑넓이와 기둥부피의 산출물이 단항식 나눗셈으로 넘어가는 SEQUENTIAL 수용.",
      "difficulty": "독립2와 저자2가 일치한다. 두표준식을 연결하는 정형변형이다.",
      "fourSlot": "각기둥410·부피219 입력과 높이218 목표를 실제 인용에서 확인했다. 부피·밑넓이 명시식 NAMED와 h만 산출한 몫의 IMPLIED+설명이 맞다."
    },
    {
      "sourceOrdinal": 20,
      "classification": "실제기존해설은 한외부점의 동일접선길이 성질이다. 내심거리나 외심각 leaf로 강제하지 않은 exact M2leafgap 수용.",
      "binding": "ACTIVE TM_TANGENT_LENGTH와 부모 PT_CIRCLE_TANGENT의 실제 정의를 확인했다. 관련후보로 남기고 중2 target binding을 확정하지 않는다.",
      "crossConcept": "동일접선길이와 부분길이합은 선택primary의 내부절차로 CC중복을 넣지 않는다.",
      "condition": "접점과 두길이는 입력이며 별도 해선택제약은 없다.",
      "integration": "동일접선 primary 내부의 두점 적용과 선분합으로 NONE 수용.",
      "difficulty": "직접성질 적용1로 독립과 저자 일치하며 학습중과 B12 인접을 수용.",
      "fourSlot": "실제접선명칭의 method NAMED와 부분선분합의 등식·IMPLIED 설명을 확인했다. goal AC길이를 다른 중간값으로 바꾸지 않는다."
    },
    {
      "sourceOrdinal": 24,
      "classification": "기존해설의 내외접반지름 결합은 M2-RPM-189이나 본문 직각꼭짓점 누락으로 조건부구조만 보존한다.",
      "binding": "ACTIVE TRIANGLE_CENTERS_COMBINED는 두중심 각·거리 관계의 결합이다. 실제해설 구조와 후보수준에서 대조하고 genuine resolver는 미완으로 남긴다.",
      "crossConcept": "CC_PYTHAGOREAN 실제세변관계와 CC_CIRCLE_CIRCUMFERENCE 실제정의의 원넓이까지 포함함을 확인했다. 두반지름 전후의 별도계산으로 수용.",
      "condition": "BC=10, CA=24는 입력이다. C직각이라는 미명시조건을 새로 보충하지 않는다.",
      "integration": "빗변→두반지름→원넓이차의 기존해설구조로 SEQUENTIAL 조건부수용.",
      "difficulty": "직각꼭짓점 누락 및 공백보기5개로 두독립판정 모두 UNKNOWN/low. 해설의 조건이 보완되었다는 뜻이 아니다.",
      "fourSlot": "직각삼각형과 두길이 입력, 두원넓이·차 목표가 일치한다. 실제 sqrt(10²+24²) 표준식을 근거로 피타고라스195를 NAMED로 한 좁은 후보 수용."
    }
  ],
