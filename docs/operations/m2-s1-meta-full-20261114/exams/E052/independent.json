  "samples": [
    {
      "sourceOrdinal": 10,
      "classification": "2015 RPM014 분배법칙에 실제 둘레식2(3a+2b)+2(a+3b)의 전개가 대응한다. 실제 계단 그림 전체 너비와 두 세로치수를 직접 확인했다.",
      "binding": "실제 정본2015 RPM014 L1~4를 읽었고 정확 ACTIVE 후보/결속 미등록 부채를 보존한다.",
      "crossConcept": "ACTIVE CC_PERIMETER는 가장자리를 따라 한바퀴 길이의 정의이며 계단형 선분을 왕복 가로세로로 환원하는 외부 기하단계에 해당한다.",
      "condition": "그림의 직각표시와 길이관계를 확인. 원문에 없는 길이 범위를 만들지 않았다.",
      "integration": "기하 둘레식이 분배전개의 입력이므로 SEQUENTIAL 수용.",
      "difficulty": "독립2/B12와 저자2/B23의 같은 수치판정. 전체길이 환원이 필요한 정형 구조로 저자경계 보존.",
      "fourSlot": "그림 given·둘레goal과 실제 해설 길이/둘레/분배법칙 인용 확인. 입력치수는 실제그림 asset evidence로 결속."
    },
    {
      "sourceOrdinal": 18,
      "classification": "2015 RPM023 계수조건. 해의 방향과 경계가 일치하는 매개계수관계를 얻은 뒤 절댓값의 두 경우를 판정한다.",
      "binding": "실제 RPM023의 해의조건/계수조건 정의를 읽었고 genuine resolver/scoped binding은 미확정.",
      "crossConcept": "ACTIVE CC_ABSOLUTE_VALUE_EQUATION의 부호 또는 경우에 따라 해구하기 정의를 직접 읽었다. |a|=3의 두 경우가 매개부등식에 외부 입력이다.",
      "condition": "x<1이라는 실제 해집합이 조건이며 양의계수는 풀이에서 도출된 사실로 입력conditionKeys를 만들지 않았다.",
      "integration": "a=3/a=-3 두 가지를 나누고 영계수를 배제하므로 CASE_BRANCH.",
      "difficulty": "독립3/B23와 저자3/B23 일치. 부등호 방향과 절댓값 두 경우를 연결하는 추가 판단이 존재한다.",
      "fourSlot": "절댓값/일차부등식 given, 매개변수합 goal, 실제 두 경우/부등식 method 및 해집합condition을 확인."
    },
    {
      "sourceOrdinal": 22,
      "classification": "2015 RPM010 단항식 나눗셈. 원기둥과 원뿔의 동일 부피로 높이를 고립시키는 계수·문자 몫 단계가 핵심이다.",
      "binding": "ACTIVE M1 solid measure와 M2 triangle-height 및 각 parent를 실제 읽었다. 전자는 수치대입, 후자는 삼각형 다항식넓이로 현 두입체 문자부피등치와 달라 related후보만 수용.",
      "crossConcept": "실제 CC_GEOMETRIC_AREA_VOLUME_FORMULA의 도형공식을 문자식으로 쓰는 정의가 원기둥·원뿔 부피식을 형성하는 외부 단계에 해당한다.",
      "condition": "물을 부어 가득 찼다는 실제 발문을 동일부피 condition으로 읽었으며 새 수량을 추가하지 않았다.",
      "integration": "두 부피공식 등치 후 단항식 몫의 SEQUENTIAL.",
      "difficulty": "독립 초기3와 저자2는 B23 인접 차이. 정형 두공식 등치와 한 번의 높이 정리로 저자2 수용.",
      "fourSlot": "두입체 given/높이 문자식goal과 실제 표준두부피식 NAMED 및 약분 인용 확인. 공백보기는 원본유지 부채."
    }
  ],
