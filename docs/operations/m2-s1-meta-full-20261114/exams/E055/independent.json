  "samples": [
    {
      "sourceOrdinal": 5,
      "classification": "2022 RPM124 조건을 만족하는 유리수. 약분후 분자9와 유한소수 조건을 함께 읽는 실제 기존해설 구조에 대응한다.",
      "binding": "실제 RPM124 정본 L1~4를 읽었고 source curriculum 미명시 및 genuine resolver/scoped binding 미등록을 분리했다.",
      "crossConcept": "분모 소인수와 공배수는 이 primary의 내부 판정이므로 중복 CC 없음.",
      "condition": "ACTIVE COND_UPPER_BOUND 실제 정의를 읽어 x<100을 수용. 원문에 없는 자연수x는 conditionKeys에 추가하지 않고 기존해설의 가정 부채로 보존.",
      "integration": "유리수 조건판정 내부의 순서로 NONE.",
      "difficulty": "독립2/B23/low와 저자2/B23/low 일치. 자연수 도메인 미명시의 표현한계 때문에 low 유지.",
      "fourSlot": "분수/분자 입력과 매개변수합 목표, 실제 소인수분해/공배수 NAMED, 유한소수·범위 제약을 literal로 확인."
    },
    {
      "sourceOrdinal": 14,
      "classification": "2022 RPM137 부등식 해의 수직선 표현. 직접 일차변형 뒤 닫힌경계와 방향을 판정한다.",
      "binding": "실제 RPM137 정본을 읽었으며 정확 ACTIVE scoped 등록은 유보.",
      "crossConcept": "일차변형과 수직선 표현은 선택 primary 내부이므로 CC 없음.",
      "condition": "발문의 단순 부등식을 주어진식으로 두고 별도 제한 조건을 만들지 않음.",
      "integration": "단일 방법 내부로 NONE.",
      "difficulty": "독립1/B12/low와 저자1/B12/low 일치. 실제 그림②는 맞지만③④⑤가 alt/해설과 다른 원문부채를 유지.",
      "fourSlot": "실제5개 수직선을 모두 열람. actual③열린3왼쪽/④닫힌3오른쪽/⑤열린3오른쪽을 확인하고 원본은 수정하지 않았다. 수직선·해집합 목표와 실제 이항/수직선 NAMED 근거 확인."
    },
    {
      "sourceOrdinal": 23,
      "classification": "하나의 두미지수 일차방정식에서 두 순서쌍의 성분을 각각 복원하는 목표. 연립방정식 해나 그래프좌표 leaf를 강제하지 않고 exact RPM gap 수용.",
      "binding": "관련 single equation/point-substitution 범위와 실제 목표가 달라 target binding 및 resolver 미등록 유지.",
      "crossConcept": "각 순서쌍 대입은 이 단일 목표의 내부 과정이라 중복 CC 없음.",
      "condition": "모두 그 식의 해라는 실제 입력관계만 condition에 보존.",
      "integration": "두 대입은 한 방법의 반복으로 NONE.",
      "difficulty": "독립1/B12와 저자1/B12 일치. 기본 대입으로 미지좌표성분을 얻는 짧은 문제.",
      "fourSlot": "일차방정식/순서쌍 given, 좌표와 곱 goal, 실제 해설의 대입 NAMED, 모두 해라는 condition을 확인."
    }
  ],
