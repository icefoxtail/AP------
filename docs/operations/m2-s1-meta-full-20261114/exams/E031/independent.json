  "samples": [
    {
      "sourceOrdinal": 12,
      "classification": "정본 M2-RPM178 밑각·꼭짓각과 실제 네 등선분의 연쇄 이등변구조가 부합하는 조건부판정이다.",
      "binding": "ACTIVE ISOSCELES_BASE_ANGLES와 M1 연쇄각추적 정의를 직접읽었다. M1후보를 참고만두고 source namespace를 옮기지 않았고 verified-final binding도 주장하지 않는다.",
      "crossConcept": "반복된 이등변각관계는 같은 primary 내부라 CC[] 조건부 수용.",
      "condition": "동일 네선분이 실제그림 표시와 일치하며 별도수범위조건을 만들지 않았다.",
      "integration": "단일 이등변관계를 여러번 쓰는 구조로 NONE 제안은 타당하다.",
      "difficulty": "독립2/저자3의 B23 차이는 연쇄횟수와 조건연결 정도에서 생긴 인접차다. 저자3low를 보존하며 solution근거부채는 유지한다.",
      "fourSlot": "실제 삼각형·주어진각·목표각·같은네길이 literal이 모두일치. 해설없어method[] 유지."
    },
    {
      "sourceOrdinal": 18,
      "classification": "M2-RPM188의 외접원·내접원 활용/반지름·각계산으로 실제외심·내심 각차목표를 포괄한다.",
      "binding": "공식 ACTIVE TPL_TRIANGLE_CENTERS_COMBINED 정의는 두중심의 각·거리관계를 함께쓰므로 현재후보수용. 실제해설과targetbinding부채 별도.",
      "crossConcept": "두중심 결합이 primaryTPL 내부여서 같은외심/내심CC를 중복하지 않은 점수용.",
      "condition": "같은삼각형의 두중심과80도 입력이실제그림과일치, 없는부호범위추가없음.",
      "integration": "선택복합중심TPL 내부단계이므로 별도외부통합NONE 제안수용.",
      "difficulty": "독립2B23와저자2B23 일치, low 유지.",
      "fourSlot": "외심·내심·주어진각, 목표각과차가실제literal에결속되고method빈칸은보존된다."
    },
    {
      "sourceOrdinal": 22,
      "classification": "문자변길이를 이용한두원기둥 부피비의 공식 M2-01 모델 및 혼합계산129를 원문구조의조건부제안으로 수용한다.",
      "binding": "공식 ACTIVE PT_M2_POLYNOMIAL_CYLINDER_VOLUME_RATIO 및 TPL_M2_CALCULATE_VOLUME_RATIO_OF_TWO_REVOLVED_CYLINDERS_DESCRIPTIVE의 실제정의를 읽었다. 두회전축/두부피/공통인수약분이포함되어 현목표와직접맞는다. source-only verifiedbinding은여전히미확정.",
      "crossConcept": "공식TPL 정의에 원기둥부피와단항식비가함께포함되어 geometryCC중복을피한판정수용.",
      "condition": "실제이미지는직사각형과직각표시, 문장의두회전축이조건이다. 원문에없는부호조건을도입하지않는다.",
      "integration": "등록후보자체가전체결합을포함하므로 NONE이외부통합없음을뜻한다.",
      "difficulty": "독립3/저자2는 B23 인접차이고 소문항이두부피와비를안내한다. 저자2low조건부제안보존수용.",
      "fourSlot": "r2는부피goal을두부피공통문장으로넓혔으며회전축이사전회전체172동의어임을확인했다. 실제literal모두일치, method[]유지."
    }
  ],
