  "samples": [
    {
      "sourceOrdinal": 8,
      "classification": "2022 RPM135 조건식 활용. 잘못 더한 결과로 원래 다항식 관계를 복원한 뒤 바르게 뺀 식의 세 계수 곱을 묻는 실제 전체 목표를 기준으로 수용.",
      "binding": "RPM135의 실제 L1~4와 표준부모를 읽었다. 기존 해설 없는 source-only 조건부 primary이며 공식 scoped PT/TPL 및 genuine resolver는 미확정이다.",
      "crossConcept": "잘못된 연산 관계 복원과 계수 대조는 primary 내부 단계다. 별도 외부 정리의 필연적 호출 근거가 없어 CC[] 조건부 제안 수용.",
      "condition": "잘못 더했다는 연산 관계를 실제 조건으로 보존했다. 계수 a,b,c에 원문에 없는 자연수 조건을 추가하지 않았다.",
      "integration": "복원 다항식의 계수 곱까지 하나의 조건식 활용 골격이며 별도 CC 결합 없이 NONE 조건부 제안.",
      "difficulty": "독립2/B23/low와 저자2/B23/low 일치. 오연산 관계를 바른 연산으로 바꾼 뒤 계수를 읽는 익숙한 변형으로 조건부 수용.",
      "fourSlot": "잘못된 결과식과 원래 뺄 다항식 given, 계수와 곱 goal, 잘못 더한 실제 조건 인용을 확인했다. 존재하지 않는 해설을 만들지 않고 method[] 및 부채를 유지했다."
    },
    {
      "sourceOrdinal": 16,
      "classification": "2022 RPM120 분모의 소인수 조건. 서로 다른 두 분수에 같은 자연수를 곱해 모두 유한소수가 되는 조건을 먼저 판정하는 실제 핵심을 primary로 수용.",
      "binding": "RPM120 L1~4와 ACTIVE CC_LEAST_COMMON_MULTIPLE의 실제 정의를 읽었다. 정본에 없는 exact PT/TPL binding은 제안하지 않았다.",
      "crossConcept": "두 분모 조건에서 생기는 배수 요구를 동시에 만족하는 가장 작은 자연수 선택은 CC_LEAST_COMMON_MULTIPLE의 실제 정의와 일치한다.",
      "condition": "원문에 명시된 자연수 A의 최소값 선택이므로 COND_NATURAL_NUMBER를 수용했다.",
      "integration": "유한소수의 분모 조건을 확보한 뒤 공통 최소배수 요구를 연결하므로 SEQUENTIAL. 분모 조건과 최소공배수 역할을 분리했다.",
      "difficulty": "독립2/B23/low와 저자2/B23/low 일치. 두 분모의 필요한 조건을 묶는 정형 연결로 조건부 수용.",
      "fourSlot": "두 분수 모두 실제 given 인용, 자연수와 가장 작은 수 goal, 자연수 condition을 확인했다. method[]와 source-only 해설 부재를 유지했다."
    },
    {
      "sourceOrdinal": 19,
      "classification": "2022 RPM141 계수 조건. 부등식 해의 수직선 표현에 맞는 계수 관계를 통해 매개변수 차를 묻는 목표로 수용.",
      "binding": "실제 RPM141 L1~4를 읽고 발문 목표와 대조했다. 개별 a,b 값의 유일성을 새로 가정하지 않고 실제 b-a 목표를 유지했다.",
      "crossConcept": "수직선의 열린 경계와 방향을 일차부등식 계수 조건으로 읽는 단계는 primary 내부이므로 중복 CC 없음.",
      "condition": "Q19 실제 PNG의 열린 점 1과 왼쪽 표시를 직접 확인했다. 닫힌 경계나 반대 방향으로 대체하지 않았다.",
      "integration": "단일 일차부등식의 해 경계/방향과 계수 관계를 연결하는 내부 과정으로 NONE 조건부 제안.",
      "difficulty": "독립2/B23/low와 저자2/B12/low는 숫자가 일치하며 인접 경계 설명만 다르다. 직접 경계 해석의 저자 B12를 보존한다.",
      "fourSlot": "주어진 매개 부등식, 실제 그림 근거, 매개변수 차 goal을 확인했다. 필요한 그림을 읽었고 method[] 및 해설 부재를 보존했다."
    }
  ],
