          "representativeQuestionUid": "qid_v1_7eae27cbf6d7b42629e570e8e660107409d345ee56e1657dfef8a4b59c1b5e81",
          "representativePrimaryMethod": "같은 원에서 부채꼴의 넓이는 중심각의 크기에 비례한다.",
          "representativeDecisiveStep": "따라서 정답은 ④이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_4be0a3e316dcc6fcfd73f4d5fc132b144704ffd210a83823a58cc27627c4fb16",
          "representativePrimaryMethod": "같은 원에서 호의 길이는 그 호에 대한 중심각의 크기에 비례한다.",
          "representativeDecisiveStep": "따라서 옳지 않은 것은 ②이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_4471d95b73c44214785108fd5f5184e780584e3819cae0601713d6247d0744a0",
          "representativePrimaryMethod": "담장 안쪽 $60^\\circ$를 제외한 영역과, 끈이 두 이웃 꼭짓점을 돌아간 뒤의 영역을 더한다.",
          "representativeDecisiveStep": "$30\\pi+\\dfrac{8}{3}\\pi=\\dfrac{98}{3}\\pi\\,\\mathrm m^2$이므로 정답은 ④이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_385d314e84730242ba2e90344059e54559444f286192d8ae88beb5835ea826c3",
          "representativePrimaryMethod": "두 원의 반지름이 서로의 중심까지 이어지므로 정삼각형이 생긴다.",
          "representativeDecisiveStep": "두 호의 길이의 합은 $2\\pi+2\\pi=4\\pi$이므로 정답은 ③이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_bf96f1e1a94e3d1d870f8dcadcfb1b43e00f25468d52ec16892851e7d7902017",
          "representativePrimaryMethod": "두 부채꼴의 교점 $E$를 이용해 정삼각형과 호의 중심각을 찾는다.",
          "representativeDecisiveStep": "$2\\pi+2\\pi+12=4\\pi+12$ cm이므로 정답은 ③이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_76bd5d12df09268493b1f61107cacb61746c366839eba4339034447ac95951e6",
          "representativePrimaryMethod": "같은 원에서 같은 중심각이 만드는 호와 현의 관계를 확인한다.",
          "representativeDecisiveStep": "따라서 옳지 않은 것은 ⑤이다."
        },
        {
          "source": "R2E_B20_B24_B28_FINAL",
          "representativeQuestionUid": "qid_v1_37458bc65f27a6f3a2ffb6fdd229d027b984e3134ff4aa5962900a0aa547154a",
          "representativePrimaryMethod": "$S_1=S_2$이면 직사각형의 넓이와 사분원의 넓이가 같아진다.",
          "representativeDecisiveStep": "$BC=2\\pi$이다."
        },
        {
          "source": "R2E_M1_B01_B31_FINAL_ADJUDICATION",
          "representativeQuestionUid": "qid_v1_2b339be51755a4617ecf14dc96bfdb987556b2c96c3ad10e8ee5b1bc27f3027e",
          "representativePrimaryMethod": "원·호·현의 정의 판정",
          "representativeDecisiveStep": "정의를 각 진술과 대조한다."
        }
      ]
    },
