  "sourceEdits": [
    {
      "ordinal": 6,
      "field": "difficultyBucket",
      "before": 4,
      "after": 3,
      "reason": "격자 길이를 피타고라스 정리로 구해 수직선에 옮김; AB=√10, CD=√13을 구하고 P의 왼쪽 위치를 반영하여 P=-√10으로 판정한다."
    },
    {
      "ordinal": 10,
      "field": "difficultyBucket",
      "before": 3,
      "after": 2,
      "reason": "한 항 및 합차 분모의 유리화 결과 판정; 한 항 분모에는 같은 근호, 합차 분모에는 켤레식을 곱하여 잘못 쓴 결과를 찾는다."
    },
    {
      "ordinal": 16,
      "field": "difficultyBucket",
      "before": 3,
      "after": 2,
      "reason": "합차공식을 연속 적용하여 지수 결정; 차례로 x²-1, x⁴-1, x⁸-1을 만들어 빈칸의 지수를 결정한다."
    },
    {
      "ordinal": 17,
      "field": "difficultyBucket",
      "before": 3,
      "after": 2,
      "reason": "각 다항식을 인수분해하여 지정 인수 포함 여부 판정; 마지막 식은 공통인수 2를 뺀 뒤 2(x-2)²가 되어 x+2가 인수가 아님을 구별한다."
    },
    {
      "ordinal": 18,
      "field": "difficultyBucket",
      "before": 4,
      "after": 3,
      "reason": "완전제곱식의 제곱근을 범위별 부호로 정리; 1<x<3에서 |x-3|=3-x, |x-1|=x-1로 풀어 두 식의 차를 정리한다."
    },
    {
      "ordinal": 22,
      "field": "difficultyBucket",
      "before": 3,
      "after": 2,
      "reason": "근호 안 소수점 이동과 주어진 근삿값 활용; 370=100·3.7, 0.37=37/100으로 바꿔 근삿값을 10배와 1/10배 한 뒤 반올림한다."
    },
    {
      "ordinal": 24,
      "field": "difficultyBucket",
      "before": 4,
      "after": 3,
      "reason": "전개도의 원둘레에서 반지름을 구해 원기둥 부피 계산; 옆면 가로=밑면 원둘레에서 r=2√2를 구하고 밑넓이와 높이를 곱한다."
    }
  ],
