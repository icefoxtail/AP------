{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apmath.local/alive/run-manifest.schema.json",
  "title": "ALIVE Run Manifest",
  "type": "object",
  "required": ["schemaVersion", "engineVersion", "runId", "status", "currentStage", "request", "sourceResolution", "stages"],
  "properties": {
    "schemaVersion": {"const": "0.1.0"},
    "engineVersion": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "status": {"enum": ["PENDING", "BLOCKED", "READY_FOR_ORCHESTRATION", "ACTIVE", "PHASE2_COMPLETE", "LOCALLY_FROZEN", "FAILED"]},
    "currentStage": {"type": "string", "pattern": "^R[0-9]{2}_"},
    "codes": {"type": "array", "items": {"type": "string"}},
    "request": {"type": "object"},
    "sourceResolution": {"type": "object"},
    "sourceRecoveryLedger": {
      "type": "object",
      "required": ["schemaVersion", "initialIncludedScopeUidSet", "initialIncludedScopeUidSetSha256", "items"],
      "properties": {
        "schemaVersion": {"const": "ALIVE_SOURCE_RECOVERY_LEDGER_v1"},
        "initialIncludedScopeUidSet": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "initialIncludedScopeUidSetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$|^sha256:[0-9a-f]{64}$"},
        "items": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    },
    "sourceRecoverySignal": {"type": "boolean"},
    "sourceRecoveryStatus": {"type": "string", "minLength": 1},
    "sourceLock": {"type": ["object", "null"]},
    "stages": {
      "type": "array",
      "minItems": 19,
      "items": {
        "type": "object",
        "required": ["stageId", "status", "evidence"],
        "properties": {
          "stageId": {"type": "string"},
          "status": {"enum": ["PENDING", "ACTIVE", "PASS", "BLOCKED", "FAIL", "UNVERIFIED", "N_A"]},
          "evidence": {"type": "array"}
        }
      }
    }
  }
}
